<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:helpers="clr-namespace:VaultGuard.WPF.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 
    Modern Theme for Vault Guard (WPF)
    
    Professional design system – Inter typography, deep dark palette,
    gradient brand accents. Aligned with VaultGuard.Models/UI/UIConstants.cs
    
    For full documentation, see: UI_DESIGN_SYSTEM.md
    -->

    <!-- ═══════════════════════════════════════════
         Colour Tokens
    ═══════════════════════════════════════════ -->

    <!-- Brand / Primary — steel blue, no purple -->
    <Color x:Key="ModernPrimaryColor">#2563EB</Color>
    <Color x:Key="ModernPrimaryLightColor">#60A5FA</Color>
    <Color x:Key="ModernPrimaryDarkColor">#1D4ED8</Color>

    <!-- Accent — subtle indigo, used sparingly -->
    <Color x:Key="ModernAccentColor">#6366F1</Color>
    <Color x:Key="ModernAccentLightColor">#818CF8</Color>

    <!-- Semantic -->
    <Color x:Key="ModernSuccessColor">#10B981</Color>
    <Color x:Key="ModernWarningColor">#F59E0B</Color>
    <Color x:Key="ModernErrorColor">#EF4444</Color>
    <Color x:Key="ModernInfoColor">#60A5FA</Color>

    <!-- Windows 11 dark mode neutral grey — zero blue tint -->
    <Color x:Key="ModernBackgroundColor">#1A1A1A</Color>
    <Color x:Key="ModernSurfaceColor">#2D2D2D</Color>
    <Color x:Key="ModernCardColor">#242424</Color>
    <Color x:Key="ModernElevatedSurfaceColor">#3A3A3A</Color>
    <Color x:Key="ModernOverlayColor">#484848</Color>
    <Color x:Key="ModernBorderColor">#FF3A3A3A</Color>
    <Color x:Key="ModernFormBackgroundColor">#141414</Color>

    <!-- Sidebar -->
    <Color x:Key="ModernSidebarBackgroundColor">#141414</Color>
    <Color x:Key="ModernNewItemButtonColor">#2563EB</Color>

    <!-- Light theme variants -->
    <Color x:Key="ModernLightBackgroundColor">#F3F4F6</Color>
    <Color x:Key="ModernLightSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ModernLightCardColor">#FFFFFF</Color>
    <Color x:Key="ModernLightFormBackgroundColor">#F9FAFB</Color>

    <!-- Text — Windows 11 dark mode white / grey -->
    <Color x:Key="ModernTextPrimaryColor">#E5E5E5</Color>
    <Color x:Key="ModernTextSecondaryColor">#9D9D9D</Color>
    <Color x:Key="ModernTextTertiaryColor">#6A6A6A</Color>

    <!-- ═══════════════════════════════════════════
         Solid Brushes
    ═══════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModernPrimaryBrush"          Color="{StaticResource ModernPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryLightBrush"     Color="{StaticResource ModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryDarkBrush"      Color="{StaticResource ModernPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="ModernAccentBrush"           Color="{StaticResource ModernAccentColor}"/>
    <SolidColorBrush x:Key="ModernAccentLightBrush"      Color="{StaticResource ModernAccentLightColor}"/>
    <SolidColorBrush x:Key="ModernSuccessBrush"          Color="{StaticResource ModernSuccessColor}"/>
    <SolidColorBrush x:Key="ModernWarningBrush"          Color="{StaticResource ModernWarningColor}"/>
    <SolidColorBrush x:Key="ModernErrorBrush"            Color="{StaticResource ModernErrorColor}"/>
    <SolidColorBrush x:Key="ModernInfoBrush"             Color="{StaticResource ModernInfoColor}"/>

    <SolidColorBrush x:Key="ModernBackgroundBrush"       Color="{StaticResource ModernBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernSurfaceBrush"          Color="{StaticResource ModernSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernCardBrush"             Color="{StaticResource ModernCardColor}"/>
    <SolidColorBrush x:Key="ModernElevatedSurfaceBrush"  Color="{StaticResource ModernElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernBorderBrush"           Color="{StaticResource ModernBorderColor}"/>
    <SolidColorBrush x:Key="ModernFormBackgroundBrush"   Color="{StaticResource ModernFormBackgroundColor}"/>

    <SolidColorBrush x:Key="ModernSidebarBackgroundBrush"
                     Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernNewItemButtonBrush"
                     Color="{StaticResource ModernNewItemButtonColor}"/>

    <!-- Button state brushes — neutral grey, no blue tint -->
    <SolidColorBrush x:Key="ModernButtonPointerOverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ModernButtonPressedBrush"     Color="#272727" />

    <!-- Suppress the default WPF dotted focus rectangle on all controls -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle StrokeThickness="0" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="ModernTextPrimaryBrush"    Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernTextSecondaryBrush"  Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="ModernTextTertiaryBrush"   Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="ModernSecondaryBrush"      Color="{StaticResource ModernAccentColor}"/>

    <!-- Fallback aliases for WinUI3 / system resource keys not provided by ModernWPF -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource ModernSurfaceColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="{StaticResource ModernTextSecondaryColor}"/>

    <!-- ModernWPF TextControl resource overrides — keeps TextBox/PasswordBox dark on all states.
         ModernWPF's built-in templates read these keys via DynamicResource so no custom Template needed. -->
    <SolidColorBrush x:Key="TextControlBackground"                    Color="#242424"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"         Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused"             Color="#242424"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled"            Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextControlForeground"                    Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"         Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused"             Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled"            Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground"         Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"  Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrush"                   Color="{StaticResource ModernBorderColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"        Color="{StaticResource ModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"            Color="{StaticResource ModernPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"           Color="{StaticResource ModernBorderColor}"/>

    <!-- ═══════════════════════════════════════════
         NavigationView overrides — keys WITHOUT ui: prefix so ModernWPF picks them up
    ═══════════════════════════════════════════ -->

    <!-- Pane backgrounds -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"      Color="#D9111111"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"     Color="#D9111111"/>
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground"          Color="#D9111111"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground"          Color="#181818"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBackground"      Color="#181818"/>

    <!-- Item foregrounds -->
    <SolidColorBrush x:Key="NavigationViewItemForeground"             Color="#D1D5DB"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"      Color="#E5E7EB"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled"     Color="#4B5563"/>

    <!-- Item backgrounds -->
    <SolidColorBrush x:Key="NavigationViewItemBackground"                    Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"             Color="#2B2B2B"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"          Color="#282828"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"              Color="#363636"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver"  Color="#2B2B2B"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"      Color="#202020"/>

    <!-- Separator — thin translucent white line, not yellow -->
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground"    Color="#FFFFFF18"/>

    <!-- Section header text -->
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground"       Color="#6B7280"/>

    <!-- NavigationView margins — zero so content fills properly -->
    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="NavigationViewMinimalContentGridMargin">0</Thickness>
    <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
    <Thickness x:Key="NavigationViewTopHeaderMargin">0</Thickness>
    <Thickness x:Key="NavigationViewContentGridMargin">0</Thickness>

    <!-- Keep the ui: prefixed versions too for any path that reads them -->
    <SolidColorBrush x:Key="ui:NavigationViewDefaultPaneBackground"   Color="#D9111111"/>
    <SolidColorBrush x:Key="ui:NavigationViewExpandedPaneBackground"  Color="#D9111111"/>
    <SolidColorBrush x:Key="ui:NavigationViewTopPaneBackground"       Color="#D9111111"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentBackground"       Color="#181818"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentGridBackground"   Color="#181818"/>
    <Thickness x:Key="ui:NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewContentGridMargin">0</Thickness>

    <!-- ═══════════════════════════════════════════
         Gradient Brushes
    ═══════════════════════════════════════════ -->

    <!-- Brand gradient: blue → indigo -->
    <LinearGradientBrush x:Key="ModernBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"  Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentColor}"   Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary gradient: steel blue tones -->
    <LinearGradientBrush x:Key="ModernPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"      Offset="0"/>
        <GradientStop Color="{StaticResource ModernPrimaryLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent gradient -->
    <LinearGradientBrush x:Key="ModernAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernAccentColor}"      Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card surface gradient -->
    <LinearGradientBrush x:Key="ModernCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2D2D2D" Offset="0"/>
        <GradientStop Color="#242424" Offset="1"/>
    </LinearGradientBrush>

    <!-- Default Button Style -->
    <Style TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,8"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Normal"/>
        <Setter Property="MinHeight"       Value="34"/>
        <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <!-- TextBox — let ModernWPF's template handle VSM animations; override only colours -->
    <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{DynamicResource TextControlBackground}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource TextControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource ModernTextPrimaryBrush}"/>
        <Setter Property="SelectionBrush"  Value="{StaticResource ModernPrimaryBrush}"/>
    </Style>

    <!-- ModernWPF's ComboBoxHelper.UpdateCornerRadius calls ResourceLookup("OverlayCornerRadius")
         and unboxes the result to CornerRadius with no null guard.  If the key is absent
         TryFindResource returns null, and unboxing null → struct throws NullReferenceException.
         Defining it here guarantees the lookup always succeeds. -->
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <!-- Also define the related corner-radius keys ModernWPF may look up. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ComboBoxDropDownCornerRadius">8</CornerRadius>

    <!-- ═══════════════════════════════════════════
         ComboBox Win11 dark mode — DynamicResource keys read by ModernWPF's internal template.
         These must live in the merged App ResourceDictionary so ModernWPF picks them up.
    ═══════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ComboBoxBackground"                         Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"              Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed"                  Color="#272727"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"                 Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"                  Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundOpen"                     Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxEditableBackground"                 Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxEditableBackgroundPointerOver"      Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxEditableBackgroundPressed"          Color="#272727"/>
    <SolidColorBrush x:Key="ComboBoxEditableBackgroundFocused"          Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxForeground"                         Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled"                 Color="#6A6A6A"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocused"                  Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush"                        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver"             Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"                 Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused"                 Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled"                Color="#333333"/>
    <SolidColorBrush x:Key="ComboBoxPlaceholderForeground"              Color="#9D9D9D"/>
    <SolidColorBrush x:Key="ComboBoxPlaceholderForegroundPointerOver"   Color="#9D9D9D"/>
    <SolidColorBrush x:Key="ComboBoxPlaceholderForegroundFocused"       Color="#9D9D9D"/>
    <SolidColorBrush x:Key="ComboBoxPlaceholderForegroundDisabled"      Color="#6A6A6A"/>
    <!-- Dropdown popup -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground"                 Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush"                Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground"            Color="#9D9D9D"/>
    <!-- Dropdown items -->
    <SolidColorBrush x:Key="ComboBoxItemBackground"                     Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"          Color="#383838"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed"              Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"             Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver"  Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed"      Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled"             Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground"                     Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed"              Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled"             Color="#6A6A6A"/>

    <!-- ComboBox — colour-only overrides via DynamicResource keys above.
         NO default Style is defined here because a keyless Style replaces ModernWPF's template
         entirely, reverting the popup to WPF's built-in white one.
         Colours are injected at the highest priority in App.xaml.cs ApplyComboBoxDarkResources(). -->

    <!-- ComboBoxItem — covers both data-generated and explicitly-added items.
         Colours come from the ComboBoxItem* DynamicResource keys so they follow the
         active light/dark theme (ThemeService updates those keys on theme change). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground"               Value="{DynamicResource ComboBoxItemForeground}"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding"                  Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemBackgroundPointerOver}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundPointerOver}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelected}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"     Value="True"/>
                                <Condition Property="IsHighlighted"  Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelectedPointerOver}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelectedPointerOver}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced PasswordBox Style with 1Password-like behavior -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background"
                Value="{DynamicResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="BorderElement"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <!-- Inline brush creates a fresh, non-frozen instance per control so
                             WPF animations can safely target Background.Color without throwing
                             InvalidOperationException on a frozen StaticResource brush. -->
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ModernSurfaceColor}"/>
                        </Border.Background>
                        <Grid>
                            <!-- PART_ContentHost is the required template part name for PasswordBox -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          IsTabStop="False"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryBrush}"/>
                            <Setter TargetName="PlaceholderText" Property="Foreground" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BorderElement" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced Modern Primary Button Style -->
    <Style x:Key="ModernPrimaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="MinWidth"        Value="100"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"

                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource ModernPrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Secondary Button Style -->
    <Style x:Key="ModernSecondaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="MinWidth"        Value="80"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ModernElevatedSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger button — red, used for destructive actions -->
    <Style x:Key="ModernDangerButtonStyle" TargetType="Button">
        <Setter Property="Background"     Value="{StaticResource ModernErrorBrush}"/>
        <Setter Property="Foreground"     Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="16,12"/>
        <Setter Property="FontSize"       Value="14"/>
        <Setter Property="FontWeight"     Value="SemiBold"/>
        <Setter Property="MinWidth"       Value="120"/>
        <Setter Property="MinHeight"      Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContentDialog button styles (PrimaryButtonStyle / SecondaryButtonStyle properties) -->
    <Style x:Key="ContentDialogPrimaryButtonStyle"   BasedOn="{StaticResource ModernPrimaryButtonStyle}"   TargetType="Button"/>
    <Style x:Key="ContentDialogSecondaryButtonStyle" BasedOn="{StaticResource ModernSecondaryButtonStyle}" TargetType="Button"/>

    <!-- Modern Card Style -->
    <Style x:Key="ModernCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource ModernCardBrush}"/>
        <Setter Property="Padding"
                Value="12"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
    </Style>

    <!-- Settings section card — same as ModernCardStyle but adds bottom margin between sections -->
    <Style x:Key="SettingsSectionStyle"
           BasedOn="{StaticResource ModernCardStyle}"
           TargetType="Border">
