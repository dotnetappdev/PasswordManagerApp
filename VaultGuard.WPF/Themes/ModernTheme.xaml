    <!-- Enhanced ui:ContentDialog Style for 1Password-like appearance with proper centering -->
    <Style x:Key="Modern1PasswordDialogStyle"
            TargetType="ui:ContentDialog">
        <Setter Property="Background"
                Value="{DynamicResource ModernFormBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="PrimaryButtonStyle"
                Value="{StaticResource ui:ContentDialogPrimaryButtonStyle}"/>
        <Setter Property="SecondaryButtonStyle"
                Value="{StaticResource ui:ContentDialogSecondaryButtonStyle}"/>
        <Setter Property="CloseButtonStyle"
                Value="{StaticResource ui:ContentDialogSecondaryButtonStyle}"/>
        <Setter Property="MaxWidth"
                Value="600"/>
        <Setter Property="MaxHeight"
                Value="800"/>
        <Setter Property="MinWidth"
                Value="400"/>
        <Setter Property="MinHeight"
                Value="200"/>
        <!-- Enhanced centering with proper positioning for all screen sizes -->
        <Setter Property="HorizontalAlignment"
                Value="Center"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0"/>
        <!-- Override template for better centering control -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ContentDialog">
                    <Grid x:Name="Container">
                        <!-- Backdrop -->
                        <Rectangle x:Name="SmokeLayerBackground"
                                   Fill="#99000000"/>
                        
                        <!-- Dialog container with absolute centering -->
                        <Border x:Name="BackgroundElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="{TemplateBinding MaxWidth}"
                                MaxHeight="{TemplateBinding MaxHeight}"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Margin="{TemplateBinding Margin}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.6" Direction="270"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title bar: title text + Windows-style "X" close button -->
                                <Border x:Name="TitleBar"
                                        Grid.Row="0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#2A2A2A"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="12,12,0,0"
                                        Padding="24,16,12,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Grid.Column="0"
                                                        Content="{TemplateBinding Title}"
                                                        ContentTemplate="{TemplateBinding TitleTemplate}"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        IsTabStop="False"/>
                                        <Button Grid.Column="1"
                                                helpers:ContentDialogCloseBehavior.IsCloseButton="True"
                                                Content="&#xE711;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Width="32" Height="32"
                                                Background="Transparent"
                                                Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Close"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="XRoot" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="XRoot" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Content area -->
                                <ScrollViewer x:Name="ContentScrollViewer"
                                              Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              IsTabStop="False"
                                              Padding="24">
                                    <ContentPresenter x:Name="Content"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                </ScrollViewer>

                                <!-- Button area -->
                                <Border x:Name="CommandSpace"
                                        Grid.Row="2"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#2A2A2A"
                                        BorderThickness="0,1,0,0"
                                        Padding="24,16"
                                        CornerRadius="0,0,12,12">
                                    <Grid x:Name="CommandAreaGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button x:Name="PrimaryButton"
                                                Grid.Column="1"
                                                Content="{TemplateBinding PrimaryButtonText}"
                                                Style="{TemplateBinding PrimaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        
                                        <Button x:Name="SecondaryButton"
                                                Grid.Column="2"
                                                Content="{TemplateBinding SecondaryButtonText}"
                                                Style="{TemplateBinding SecondaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        
                                        <Button x:Name="CloseButton"
                                                Grid.Column="3"
                                                Content="{TemplateBinding CloseButtonText}"
                                                Style="{TemplateBinding CloseButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hide Primary/Secondary buttons when the caller never set their text
                             (e.g. plain Error/Info dialogs that only use CloseButtonText) — otherwise
                             they render as blank buttons next to the real "OK"/"Cancel" button. -->
                        <Trigger Property="PrimaryButtonText" Value="{x:Static sys:String.Empty}">
                            <Setter TargetName="PrimaryButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="PrimaryButtonText" Value="{x:Null}">
                            <Setter TargetName="PrimaryButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="SecondaryButtonText" Value="{x:Static sys:String.Empty}">
                            <Setter TargetName="SecondaryButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="SecondaryButtonText" Value="{x:Null}">
                            <Setter TargetName="SecondaryButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CloseButtonText" Value="{x:Static sys:String.Empty}">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CloseButtonText" Value="{x:Null}">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


