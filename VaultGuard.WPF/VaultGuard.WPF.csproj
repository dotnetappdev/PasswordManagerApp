<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Version-specific Windows TFM so the native Windows Hello / passkey APIs
		     (Windows.Security.Credentials.KeyCredentialManager) are projected and compiled in.
		     This is what actually lets the app prompt Windows to create/store a passkey —
		     WindowsHelloService lights up via the WINDOWS10_0_17763_0_OR_GREATER symbol.
		     Requires the Windows SDK (already used by the WinUI/MAUI projects). -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- WPF only needs WinRT projection (KeyCredentialManager); it is not a packaged/MSIX app. -->
		<EnableMsixTooling>false</EnableMsixTooling>
		<UseWinUI>false</UseWinUI>
		<RootNamespace>VaultGuard.WPF</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- Display name -->
		<ApplicationTitle>VaultGuard WPF</ApplicationTitle>

		<!-- App icon: padlock with crossed keys (Assets/AppIcon.ico) -->
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.passwordmanager.wpf</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- No hardcoded Version/AssemblyVersion/FileVersion here on purpose: the SDK auto-derives all
		     three from "-p:Version=" (build-wpf.yml passes the CI-computed release version); an explicit
		     AssemblyVersion/FileVersion in the csproj would win over that CLI value and freeze the About
		     page (PopulateAboutInfo reads Assembly.GetName().Version) at whatever was hardcoded here,
		     regardless of the actual release tag. Absent -p:Version (local dev builds), the SDK's own
		     default is "1.0.0.0" anyway, so this is a no-op for that case. -->
	</PropertyGroup>

	<!-- WinForms is referenced only for the system-tray NotifyIcon. Remove its implicit
	     global using so System.Windows.Forms types don't collide with WPF namespaces.
	     Tray code uses fully-qualified names (System.Windows.Forms.NotifyIcon, etc.). -->
	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\AppIcon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Sentry" Version="5.0.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
		<PackageReference Include="ModernWpfUI" Version="0.9.6" />
		<!-- Pulled in transitively (via Sentry's windows10.0.19041 target). We only need its runtime
		     lib, not the MSIX/PRI MSBuild targets, which require Visual Studio AppX components and
		     fail on bare-CLI builds. Excluding build assets keeps `dotnet build` working everywhere. -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" ExcludeAssets="build;buildTransitive" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VaultGuard.DAL\VaultGuard.DAL.csproj" />
		<ProjectReference Include="..\VaultGuard.Models\VaultGuard.Models.csproj" />
		<ProjectReference Include="..\VaultGuard.Services\VaultGuard.Services.csproj" />
		<ProjectReference Include="..\VaultGuard.Localization\VaultGuard.Localization.csproj" />
		<ProjectReference Include="..\VaultGuard.Imports\VaultGuard.Imports.csproj" />
		<ProjectReference Include="..\VaultGuardImports.1Password\VaultGuardImports.1Password.csproj" />
		<ProjectReference Include="..\VaultGuardImports.Bitwarden\VaultGuardImports.Bitwarden.csproj" />
		<ProjectReference Include="..\VaultGuard.Crypto\VaultGuard.Crypto.csproj" />
		<ProjectReference Include="..\VaultGuard.ExceptionReporting\VaultGuard.ExceptionReporting.csproj" />
		<ProjectReference Include="..\VaultGuard.ExceptionReporting.Sentry\VaultGuard.ExceptionReporting.Sentry.csproj" />
	</ItemGroup>

	<Target Name="CopyProviderPlugins" AfterTargets="Build">
		<!-- Ensure plugin subfolders exist and copy provider DLLs (DB providers) -->
		<MakeDir Directories="$(OutputPath)plugins\SqlServer" />
		<MakeDir Directories="$(OutputPath)plugins\MySql" />
		<MakeDir Directories="$(OutputPath)plugins\Postgres" />
		<Copy SourceFiles="$(SolutionDir)VaultGuard.DAL.SqlServer\bin\$(Configuration)\net10.0\VaultGuard.DAL.SqlServer.dll" DestinationFolder="$(OutputPath)plugins\SqlServer" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.DAL.SqlServer\bin\$(Configuration)\net10.0\VaultGuard.DAL.SqlServer.dll')" />
		<Copy SourceFiles="$(SolutionDir)VaultGuard.DAL.MySql\bin\$(Configuration)\net10.0\VaultGuard.DAL.MySql.dll" DestinationFolder="$(OutputPath)plugins\MySql" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.DAL.MySql\bin\$(Configuration)\net10.0\VaultGuard.DAL.MySql.dll')" />
		<Copy SourceFiles="$(SolutionDir)VaultGuard.DAL.Postgres\bin\$(Configuration)\net10.0\VaultGuard.DAL.Postgres.dll" DestinationFolder="$(OutputPath)plugins\Postgres" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.DAL.Postgres\bin\$(Configuration)\net10.0\VaultGuard.DAL.Postgres.dll')" />

		<!-- Generic: discover all import plugin DLLs under VaultGuardImports.* projects and copy each into its own discovery folder -->
		<ItemGroup>
			<PluginDlls Include="$(OutputPath)**\VaultGuardImports.*.dll" />
			<PluginDlls Include="$(SolutionDir)VaultGuardImports.*\bin\$(Configuration)\**\VaultGuardImports.*.dll" />
		</ItemGroup>

		<!-- Compute per-plugin folder and filename metadata -->
		<ItemGroup>
			<_PluginsToCopy Include="@(PluginDlls)">
				<PluginFileName>$([System.IO.Path]::GetFileName('%(Identity)'))</PluginFileName>
				<PluginFolder>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFileNameWithoutExtension('%(Identity)')), '^VaultGuardImports\.', ''))</PluginFolder>
			</_PluginsToCopy>
		</ItemGroup>

		<MakeDir Directories="@(_PluginsToCopy->'$(OutputPath)imports\\otherpasswordmanagers\\%(PluginFolder)')" Condition=" '@(_PluginsToCopy)' != '' " />
		<Copy SourceFiles="@(_PluginsToCopy->'%(Identity)')"
			DestinationFiles="@(_PluginsToCopy->'$(OutputPath)imports\\otherpasswordmanagers\\%(PluginFolder)\\%(PluginFileName)')"
			SkipUnchangedFiles="true"
			Condition=" '@(_PluginsToCopy)' != '' " />

		<!-- Copy plugin.json files manually for known plugins -->
		<Copy SourceFiles="$(SolutionDir)VaultGuardImports.1Password\plugin.json"
			DestinationFolder="$(OutputPath)imports\otherpasswordmanagers\OnePassword"
			SkipUnchangedFiles="true"
			Condition="Exists('$(SolutionDir)VaultGuardImports.1Password\plugin.json')" />
		
		<Copy SourceFiles="$(SolutionDir)VaultGuardImports.Bitwarden\plugin.json"
			DestinationFolder="$(OutputPath)imports\otherpasswordmanagers\Bitwarden"
			SkipUnchangedFiles="true"
			Condition="Exists('$(SolutionDir)VaultGuardImports.Bitwarden\plugin.json')" />
	</Target>

</Project>
