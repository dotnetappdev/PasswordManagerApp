<Application
    x:Class="VaultGuard.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:VaultGuard.WPF.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="http://schemas.modernwpf.com/2019" />
                <!-- Base Modern Theme Resources -->
                <ResourceDictionary Source="Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:TypeToIconConverter x:Key="TypeToIconConverter"/>
            <converters:ItemToBrandBrushConverter x:Key="ItemToBrandBrushConverter"/>
            <converters:ItemToBrandImageConverter x:Key="ItemToBrandImageConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToInvertedVisibilityConverter x:Key="BoolToInvertedVisibilityConverter"/>
            <converters:FirstTimeSetupToSubtitleConverter x:Key="FirstTimeSetupToSubtitleConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:StatusToIconConverter x:Key="StatusToIconConverter"/>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <!--<converters:ApiModeToInputScopeConverter x:Key="ApiModeToInputScopeConverter"/>-->
            <converters:ApiModeToVisibilityConverter x:Key="ApiModeToVisibilityConverter"/>
            <converters:LocalModeToEnabledConverter x:Key="LocalModeToEnabledConverter"/>
            <converters:DateFormatConverter x:Key="DateFormatConverter"/>
            <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
            <converters:DateToModifiedStringConverter x:Key="DateToModifiedStringConverter"/>
            <converters:NotNullToInvertedVisibilityConverter x:Key="NotNullToInvertedVisibilityConverter"/>
            <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
            <converters:BoolNegationToVisibilityConverter x:Key="BoolNegationToVisibilityConverter"/>
            <converters:NotZeroToBoolConverter x:Key="NotZeroToBoolConverter"/>
            <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
            <converters:InitialsMultiConverter x:Key="InitialsMultiConverter"/>
            <converters:NameToAvatarBrushConverter x:Key="NameToAvatarBrushConverter"/>
            <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
            <converters:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <converters:BoolToHiddenConverter x:Key="BoolToHiddenConverter"/>
            <converters:OnlineStatusToVisibilityConverter x:Key="OnlineStatusToVisibilityConverter"/>
            <converters:OnlineStatusToBrushConverter x:Key="OnlineStatusToBrushConverter"/>
            <converters:OnlineStatusToTextConverter x:Key="OnlineStatusToTextConverter"/>

            <!-- Removed WebsiteToColorConverter (likely already in ModernTheme.xaml) -->

            <!-- Windows 11 polish: the Segoe UI Variable system font + crisp ClearType rendering
                 on every top-level window (ContentDialogs inherit it from their host window). -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
