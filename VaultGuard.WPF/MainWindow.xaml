<Window xmlns:ui="http://schemas.modernwpf.com/2019"
    x:Class="VaultGuard.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VaultGuard.WPF.Controls"
        xmlns:loc="clr-namespace:VaultGuard.WPF.Localization"
        Icon="Assets/AppIcon.ico"
        Background="{DynamicResource ModernBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <!-- Background is Transparent so the Windows 11 Mica backdrop shows through the translucent
         nav pane. On Windows 10 the Win11Chrome helper leaves the opaque Window.Background above
         as the fallback. The content frame paints its own opaque surface, so reading stays solid. -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: menu (left) + global search (centre). Shown after authentication. -->
        <Border x:Name="TopBar" Grid.Row="0" Visibility="Collapsed"
                Background="{DynamicResource ModernSurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ModernBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu x:Name="MainMenuBar" Grid.Column="0"
                      Background="Transparent"
                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                      VerticalAlignment="Center"
                      Padding="4,2">
            <MenuItem Header="{loc:T '_File'}">
                <MenuItem Header="{loc:T '_Settings'}" Click="MenuSettings_Click" InputGestureText="Ctrl+,">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:T 'Sign in from _Phone (QR)…'}" Click="MenuQrSignIn_Click"
                          ToolTip="{loc:T 'Show a QR code — scan it with the Vault Guard mobile app to sign in on this PC'}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:T 'E_xit'}" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:T '_View'}">
                <MenuItem x:Name="ToggleSideMenuMenuItem" Header="{loc:T '_Side Menu'}"
                          IsCheckable="True" IsChecked="True"
                          Click="ToggleSideMenuMenuItem_Click"
                          InputGestureText="Ctrl+B">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:T '_Help'}">
                <MenuItem Header="{loc:T 'Check for _Updates…'}" Click="MenuCheckUpdates_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:T '_Documentation'}" Click="MenuDocumentation_Click"/>
                <Separator/>
                <MenuItem Header="{loc:T '_About Vault Guard'}" Click="MenuAbout_Click"/>
            </MenuItem>
                </Menu>

                <!-- Global search: a single search box that searches the whole vault from anywhere. -->
                <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                   QueryIcon="Find"
                                   ui:ControlHelper.PlaceholderText="{loc:T 'Search Vault Guard…'}"
                                   TextChanged="SearchBox_TextChanged"
                                   QuerySubmitted="SearchBox_QuerySubmitted"
                                   SuggestionChosen="SearchBox_SuggestionChosen"
                                   TextMemberPath="Title"
                                   Style="{StaticResource ModernAutoSuggestBoxStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="480"
                                   Margin="12,6">
                    <ui:AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Brand favicon over a colour-coded tile, with the type glyph as a
                                     fallback when no icon is available — like other password managers. -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                        Margin="0,0,12,0" Background="{Binding IconBrush}">
                                    <Grid>
                                        <ui:FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding BrandImage}" Width="18" Height="18"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}"
                                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ui:AutoSuggestBox.ItemTemplate>
                </ui:AutoSuggestBox>

                <!-- Language selector: SelectedItem binds straight to LocalizationManager.CurrentLanguage,
                     so picking a language here updates every {loc:T 'Key'} binding in the app live -
                     no restart, no page reload. See VaultGuard.WPF/Localization/LocalizationManager.cs. -->
                <ComboBox x:Name="LanguageSelector" Grid.Column="2"
                          ItemsSource="{Binding AvailableLanguages, Source={x:Static loc:LocalizationManager.Instance}}"
                          SelectedItem="{Binding CurrentLanguage, Source={x:Static loc:LocalizationManager.Instance}, Mode=TwoWay}"
                          DisplayMemberPath="NativeName"
                          Width="110"
                          Margin="0,6,12,6"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="{loc:T 'Language'}"/>
            </Grid>
        </Border>

        <!-- Login Frame (shown during authentication) -->
        <Frame x:Name="LoginFrame"
               Grid.Row="1"
               x:FieldModifier="private"
               Background="{DynamicResource ModernBackgroundBrush}"
               NavigationUIVisibility="Hidden"
               Visibility="Visible"
               Navigated="Frame_Navigated"/>

        <!-- Main Navigation View (shown after authentication) -->
        <ui:NavigationView x:Name="MainNavigationView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        CompactModeThresholdWidth="0"
                        ExpandedModeThresholdWidth="0"
                        SelectionChanged="MainNavigationView_SelectionChanged"
                        Visibility="Collapsed"
                        Margin="0"
                        Padding="0"
                        FontSize="{DynamicResource MenuFontSize}">

            <!-- ModernWpf's built-in NavigationViewItem template doesn't inherit FontSize from the
                 parent NavigationView, so the "Menu & navigation" text size had no visible effect on
                 its own. Swapping in a from-scratch template (ModernNavigationViewItemStyle) to also
                 fix icon sizing was tried and reverted — ModernWpf's NavigationView internals depend
                 on specific named/typed parts from its own default item template for page navigation
                 to work at all, and replacing it broke clicking items to navigate. So this only
                 overrides FontSize on top of the untouched default style/template; sidebar icon size
                 stays stuck at its built-in fixed size until a safer way to reach it is found. -->
            <ui:NavigationView.Resources>
                <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
                    <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}"/>
                </Style>
            </ui:NavigationView.Resources>

            <!-- Pane Header: App name + profile + search + new item -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="0,0,0,4">

                    <!-- Profile row: user (left) + hamburger toggle (right, in line with the name).
                         Only rendered while the pane is open — the framework hides PaneHeader in the
                         compact rail, where the items-list copy below takes over instead. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                    <!-- Profile button -->
                    <Button x:Name="ProfileButton"
                            Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Click="ProfileButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ProfileMenu" Placement="Bottom">
                                <MenuItem Header="{loc:T 'View Profile'}" Click="ViewProfileMenuItem_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:T 'Sign Out'}" Click="Logout_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <!-- Clean template: a rounded, inset hover surface instead of the default WPF
                             button chrome, which rendered as an ugly grey selection box around the
                             user (e.g. "Administrator") in dark mode. -->
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ProfileBd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Margin="8,2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ProfileBd" Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ProfileBd" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="UserAvatarText" Text="?"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText"
                                           Text="{loc:T 'My Account'}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                <TextBlock Text="{loc:T 'Personal Vault'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE019;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Hamburger toggle — in line with the profile name, on the right. Only visible
                         while the pane is open (the rail copy below takes over once it collapses). -->
                    <Button x:Name="HeaderPaneToggleButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Width="28" Height="28" Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="PaneToggleButton_Click"
                            ToolTipService.ToolTip="{loc:T 'Expand / collapse menu'}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="HbBd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <!-- Fixed size (not the DynamicResource MenuIconSize the nav items use) - this
                                         is chrome for opening/closing the pane, not scalable content, so it
                                         doesn't grow with the user's "Menu icons" accessibility setting. -->
                                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HbBd" Property="Background" Value="{DynamicResource ModernElevatedSurfaceBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="HbBd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    </Grid>

                    <!-- Search moved to the global top bar (see TopBar above). -->

                    <!-- New Item button -->
                    <Border Padding="12,0,12,10">
                        <Button HorizontalAlignment="Stretch"
                                Height="34"
                                Click="NewItemButton_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            CornerRadius="6" Padding="10,6"
                                            BorderThickness="0"
                                            Background="{DynamicResource ModernPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:T 'New Item'}" Foreground="White"
                                                       FontSize="13" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ModernPrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- hairline divider -->
                    <Border Height="1" Background="{DynamicResource ModernBorderBrush}" Margin="0,0"/>

                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- Nav items -->
            <ui:NavigationView.MenuItems>

                <!-- ── Quick Access ── -->
                <ui:NavigationViewItem Content="{loc:T 'Dashboard'}" Tag="Home"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE80F;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="AllItemsNavItem"
                                       Content="{loc:T 'All Items'}"
                                       Background="{DynamicResource ModernBorderBrush}"
                                       Tag="AllItems"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8A5;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Favourites'}" Tag="Favorites"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE734;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── Categories ── -->
                <ui:NavigationViewItemSeparator Background="{DynamicResource ModernBorderBrush}"/>
                <ui:NavigationViewItemHeader Foreground="{DynamicResource ModernTextTertiaryBrush}" Content="{loc:T 'Categories'}"/>

                <!-- Hamburger / pane toggle — lives inside the items list (not PaneHeader, which the
                     framework hides while the pane is folded to its compact icon-only rail) so it
                     stays reachable and can re-expand the menu in every state. -->
                <Button x:Name="PaneToggleButton"
                        HorizontalAlignment="Stretch"
                        Height="28" Margin="8,2,8,8"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        Click="PaneToggleButton_Click"
                        ToolTipService.ToolTip="{loc:T 'Expand / collapse menu'}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HbBd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <!-- Fixed size - see HeaderPaneToggleButton's identical comment above. -->
                                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HbBd" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HbBd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ui:NavigationViewItem Content="{loc:T 'Logins'}" Tag="LoginCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE192;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Credit Cards'}" Tag="CreditCardCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8C7;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Secure Notes'}" Tag="SecureNotesCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE70B;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Wi-Fi Networks'}" Tag="WiFiCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE701;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Identities'}" Tag="IdentityCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE77B;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── Security ── -->
                <ui:NavigationViewItemSeparator Background="{DynamicResource ModernBorderBrush}"/>
                <ui:NavigationViewItemHeader Foreground="{DynamicResource ModernTextTertiaryBrush}" Content="{loc:T 'Security'}"/>

                <!-- Passkeys: hidden from the menu — manage them from Settings → Security instead -->
                <!-- Vaults: managed entirely from the sidebar VAULTS list (create/rename/delete) -->

                <ui:NavigationViewItem Content="{loc:T 'Security Center'}" Tag="Security"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8E1;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── Manage ── -->
                <ui:NavigationViewItemSeparator Background="{DynamicResource ModernBorderBrush}"/>
                <ui:NavigationViewItemHeader Foreground="{DynamicResource ModernTextTertiaryBrush}" Content="{loc:T 'Manage'}"/>

                <ui:NavigationViewItem Content="{loc:T 'Manage Categories'}" Tag="Categories"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8FD;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Vaults row — a real NavigationViewItem so its icon/text land on exactly the
                     same indentation as "Manage Categories" above (hand-tuned Grid margins drifted
                     out of alignment); the inline "+" creates a vault, the user's vaults list itself
                     renders just below via VaultsNavPanel. -->
                <ui:NavigationViewItem Focusable="False" SelectsOnInvoked="False" IsHitTestVisible="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE72E;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                    <Grid IsHitTestVisible="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T 'Vaults'}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Padding="0" Width="32" Height="32" MinWidth="0" MinHeight="0"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{loc:T 'Add Vault'}"
                                Click="AddVaultNavButton_Click">
                            <TextBlock Text="&#xE109;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </ui:NavigationViewItem>
                <StackPanel x:Name="VaultsNavPanel" Margin="0,0,0,8"/>

                <ui:NavigationViewItem Content="{loc:T 'Import / Export'}" Tag="Import"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8B5;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'API Keys'}" Tag="ApiKeys"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE192;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Audit Logs'}" Tag="AuditLogs"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE81C;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Translations'}" Tag="Translations"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE775;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── More (moved from pinned footer so everything scrolls together) ── -->
                <ui:NavigationViewItemSeparator Background="{DynamicResource ModernBorderBrush}"/>
                <ui:NavigationViewItemHeader Foreground="{DynamicResource ModernTextTertiaryBrush}" Content="{loc:T 'More'}"/>

                <ui:NavigationViewItem Content="{loc:T 'Archive'}" Tag="Archive"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE7B8;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Recently Deleted'}" Tag="RecentlyDeleted"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE74D;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'Settings'}" Tag="Settings"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE713;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:T 'About'}" Tag="About">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE946;" FontSize="{DynamicResource MenuIconSize}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <!-- Pane footer: dynamic vaults + tags (capped so the scrollable menu keeps room) -->
            <ui:NavigationView.PaneFooter>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170" Margin="0,0,0,4">
                <StackPanel Margin="0,0,0,8">
                    <!-- hairline divider -->
                    <Border Height="1" Background="{DynamicResource ModernBorderBrush}" Margin="0,4"/>

                    <!-- Dynamic tags -->
                    <Grid Margin="16,10,8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T 'TAGS'}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Padding="4" MinWidth="0" MinHeight="0"
                                ToolTipService.ToolTip="{loc:T 'Add Tag'}"
                                Click="AddTagNavButton_Click">
                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="SidebarTagsPanel"/>
                </StackPanel>
                </ScrollViewer>
            </ui:NavigationView.PaneFooter>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame"
                   Background="{DynamicResource ModernBackgroundBrush}"
                   NavigationUIVisibility="Hidden"
                   Navigated="Frame_Navigated"/>

        </ui:NavigationView>

        <!-- Toast overlay — sits on top of everything, bottom-right -->
        <controls:ToastHost Grid.Row="1"
                            IsHitTestVisible="True"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Panel.ZIndex="9999"/>
    </Grid>
</Window>
