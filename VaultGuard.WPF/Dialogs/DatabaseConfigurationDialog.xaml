<Window x:Class="PasswordManager.WPF.Dialogs.DatabaseConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Database Configuration"
        Width="720"
        MinWidth="600"
        Height="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ModernBackgroundBrush}"
        Foreground="{DynamicResource ModernTextPrimaryBrush}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <!-- Local label style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Browse button style (compact, secondary look) -->
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ModernElevatedSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ModernBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Hint/caption style -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ModernTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Provider selector -->
            <RowDefinition Height="Auto"/>
            <!-- Tab area -->
            <RowDefinition Height="*"/>
            <!-- Bottom button row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             Provider selector row
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ModernSurfaceBrush}"
                BorderBrush="{DynamicResource ModernBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Database Provider:"
                           Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <ComboBox x:Name="ProviderComboBox"
                          Grid.Column="1"
                          SelectedIndex="0"
                          SelectionChanged="ProviderComboBox_SelectionChanged"
                          MinWidth="200">
                    <ComboBoxItem Content="SQLite" Tag="Sqlite"/>
                    <ComboBoxItem Content="SQL Server" Tag="SqlServer"/>
                    <ComboBoxItem Content="MySQL" Tag="MySql"/>
                    <ComboBoxItem Content="PostgreSQL" Tag="PostgreSql"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════
             Content area — one panel per provider
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ─────── SQLite panel ─────── -->
            <Grid x:Name="SqlitePanel" Visibility="Visible">
                <TabControl Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="SQLite Database"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- Database File Path -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Database File Path"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SqliteDatabasePathTextBox"
                                                 Grid.Column="0"
                                                 MinWidth="200"
                                                 Margin="0,0,6,0"
                                                 ui:ControlHelper.PlaceholderText="Path to .db file"/>
                                        <Button Grid.Column="1"
                                                Content="..."
                                                Style="{StaticResource BrowseButtonStyle}"
                                                Click="BrowseSqliteFile_Click"
                                                ToolTip="Choose file location"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintTextStyle}"
                                               Text="Leave empty to use the default application data location."/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ─────── SQL Server panel ─────── -->
            <Grid x:Name="SqlServerPanel" Visibility="Collapsed">
                <TabControl Background="Transparent"
                            BorderThickness="0">

                    <!-- General tab -->
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Server Connection"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- Server -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerHostTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="e.g. localhost or 192.168.1.10"/>
                                </StackPanel>

                                <!-- Instance -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Instance Name (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerInstanceTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="e.g. SQLEXPRESS"/>
                                </StackPanel>

                                <!-- Port -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerPortTextBox"
                                             MinWidth="200"
                                             Text="1433"/>
                                </StackPanel>

                                <!-- Database -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Database" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerDatabaseTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="Database name"/>
                                </StackPanel>

                                <Separator Margin="0,8,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>
                                <TextBlock Text="Authentication"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Authentication Mode -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Authentication Mode" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="SqlServerAuthModeComboBox"
                                              MinWidth="200"
                                              SelectedIndex="1"
                                              SelectionChanged="SqlServerAuthMode_SelectionChanged">
                                        <ComboBoxItem Content="Windows Authentication" Tag="WindowsAuthentication"/>
                                        <ComboBoxItem Content="SQL Server Authentication" Tag="SqlServerAuthentication"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Username (hidden for Windows auth) -->
                                <StackPanel x:Name="SqlServerUsernamePanel" Margin="0,0,0,8">
                                    <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerUsernameTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="SQL Server username"/>
                                </StackPanel>

                                <!-- Password (hidden for Windows auth) -->
                                <StackPanel x:Name="SqlServerPasswordPanel" Margin="0,0,0,8">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="SqlServerPasswordBox"
                                                 MinWidth="200"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Security tab -->
                    <TabItem Header="Security">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Encryption &amp; Certificate"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- Encryption -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Encryption" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="SqlServerEncryptionComboBox"
                                              MinWidth="200"
                                              SelectedIndex="1"
                                              SelectionChanged="SqlServerEncryption_SelectionChanged">
                                        <ComboBoxItem Content="None" Tag="None"/>
                                        <ComboBoxItem Content="Optional" Tag="Optional"/>
                                        <ComboBoxItem Content="Mandatory" Tag="Mandatory"/>
                                        <ComboBoxItem Content="Strict" Tag="Strict"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Trust Server Certificate -->
                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="SqlServerTrustCertCheckBox"
                                              Content="Trust Server Certificate"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Server Certificate (only shown for Mandatory/Strict) -->
                                <StackPanel x:Name="SqlServerCertificatePanel"
                                            Margin="0,0,0,8"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Server Certificate (thumbprint or path)"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerCertificateTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="Certificate thumbprint or file path"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Connection tab -->
                    <TabItem Header="Connection">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Network &amp; Timeouts"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- Network Protocol -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Network Protocol" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="SqlServerProtocolComboBox"
                                              MinWidth="200"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Default" Tag="Default"/>
                                        <ComboBoxItem Content="TCP/IP" Tag="TcpIp"/>
                                        <ComboBoxItem Content="Named Pipes" Tag="NamedPipes"/>
                                        <ComboBoxItem Content="Shared Memory" Tag="SharedMemory"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Packet Size -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Packet Size" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerPacketSizeTextBox"
                                             MinWidth="200"
                                             Text="4096"/>
                                    <TextBlock Text="Valid range: 512–32767 bytes"
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>

                                <!-- Connection Timeout -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Connection Timeout (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerConnTimeoutTextBox"
                                             MinWidth="200"
                                             Text="15"/>
                                </StackPanel>

                                <!-- Command Timeout -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Command Timeout (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerCmdTimeoutTextBox"
                                             MinWidth="200"
                                             Text="30"/>
                                </StackPanel>

                                <!-- Application Name -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Application Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerAppNameTextBox"
                                             MinWidth="200"
                                             Text="PasswordManager"/>
                                </StackPanel>

                                <!-- Workstation ID -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Workstation ID (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerWorkstationTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="Leave empty to use machine name"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Advanced tab -->
                    <TabItem Header="Advanced">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Advanced Settings"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- MARS -->
                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="SqlServerMarsCheckBox"
                                              Content="Multiple Active Result Sets (MARS)"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Application Intent -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Application Intent" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="SqlServerAppIntentComboBox"
                                              MinWidth="200"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="ReadWrite" Tag="ReadWrite"/>
                                        <ComboBoxItem Content="ReadOnly" Tag="ReadOnly"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Multi-Subnet Failover -->
                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="SqlServerMultiSubnetCheckBox"
                                              Content="Multi-Subnet Failover"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Failover Partner -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Failover Partner (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerFailoverTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="Failover server name"/>
                                </StackPanel>

                                <Separator Margin="0,8,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>
                                <TextBlock Text="Connection Pooling"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Pooling -->
                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="SqlServerPoolingCheckBox"
                                              Content="Enable Connection Pooling"
                                              IsChecked="True"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                              Checked="SqlServerPooling_Changed"
                                              Unchecked="SqlServerPooling_Changed"/>
                                </StackPanel>

                                <!-- Pool sizes (shown when pooling enabled) -->
                                <StackPanel x:Name="SqlServerPoolSizePanel" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Min Pool Size" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="SqlServerMinPoolTextBox"
                                                     MinWidth="80"
                                                     Text="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Max Pool Size" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="SqlServerMaxPoolTextBox"
                                                     MinWidth="80"
                                                     Text="100"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Separator Margin="0,8,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- Additional Parameters -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Additional Parameters (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SqlServerAdditionalParamsTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="key=value;key2=value2"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ─────── MySQL panel ─────── -->
            <Grid x:Name="MySqlPanel" Visibility="Collapsed">
                <TabControl Background="Transparent"
                            BorderThickness="0">

                    <!-- General tab -->
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Server Connection"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlHostTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="e.g. localhost"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlPortTextBox"
                                             MinWidth="200"
                                             Text="3306"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Database" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlDatabaseTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="Database name"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlUsernameTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="MySQL username"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="MySqlPasswordBox"
                                                 MinWidth="200"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SSL tab -->
                    <TabItem Header="SSL">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="SSL / TLS Configuration"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- SSL Mode -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="SSL Mode" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="MySqlSslModeComboBox"
                                              MinWidth="200"
                                              SelectedIndex="1"
                                              SelectionChanged="MySqlSslMode_SelectionChanged">
                                        <ComboBoxItem Content="None" Tag="None"/>
                                        <ComboBoxItem Content="Preferred" Tag="Preferred"/>
                                        <ComboBoxItem Content="Required" Tag="Required"/>
                                        <ComboBoxItem Content="Verify CA (VerifyCA)" Tag="VerifyCA"/>
                                        <ComboBoxItem Content="Verify Full (VerifyFull)" Tag="VerifyFull"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Certificate paths (shown for VerifyCA / VerifyFull) -->
                                <StackPanel x:Name="MySqlCertPathsPanel" Visibility="Collapsed">
                                    <!-- CA Certificate -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="CA Certificate Path" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MySqlSslCaTextBox"
                                                     Grid.Column="0"
                                                     MinWidth="200"
                                                     Margin="0,0,6,0"
                                                     ui:ControlHelper.PlaceholderText="Path to CA certificate"/>
                                            <Button Grid.Column="1"
                                                    Content="..."
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="BrowseMySqlCa_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Client Certificate -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Client Certificate Path" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MySqlSslCertTextBox"
                                                     Grid.Column="0"
                                                     MinWidth="200"
                                                     Margin="0,0,6,0"
                                                     ui:ControlHelper.PlaceholderText="Path to client certificate"/>
                                            <Button Grid.Column="1"
                                                    Content="..."
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="BrowseMySqlCert_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Client Key -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Client Key Path" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MySqlSslKeyTextBox"
                                                     Grid.Column="0"
                                                     MinWidth="200"
                                                     Margin="0,0,6,0"
                                                     ui:ControlHelper.PlaceholderText="Path to client key file"/>
                                            <Button Grid.Column="1"
                                                    Content="..."
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="BrowseMySqlKey_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Advanced tab -->
                    <TabItem Header="Advanced">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Advanced Settings"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Connection Timeout (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlConnTimeoutTextBox"
                                             MinWidth="200"
                                             Text="30"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Command Timeout (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlCmdTimeoutTextBox"
                                             MinWidth="200"
                                             Text="30"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Character Set" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MySqlCharSetTextBox"
                                             MinWidth="200"
                                             Text="utf8mb4"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="MySqlAllowZeroDateTimeCheckBox"
                                              Content="Allow Zero DateTime"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="MySqlAllowUserVariablesCheckBox"
                                              Content="Allow User Variables"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                </StackPanel>

                                <Separator Margin="0,8,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>
                                <TextBlock Text="Connection Pooling"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="MySqlPoolingCheckBox"
                                              Content="Enable Connection Pooling"
                                              IsChecked="True"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                              Checked="MySqlPooling_Changed"
                                              Unchecked="MySqlPooling_Changed"/>
                                </StackPanel>

                                <StackPanel x:Name="MySqlPoolSizePanel" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Min Pool Size" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="MySqlMinPoolTextBox"
                                                     MinWidth="80"
                                                     Text="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Max Pool Size" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="MySqlMaxPoolTextBox"
                                                     MinWidth="80"
                                                     Text="100"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ─────── PostgreSQL panel ─────── -->
            <Grid x:Name="PostgreSqlPanel" Visibility="Collapsed">
                <TabControl Background="Transparent"
                            BorderThickness="0">

                    <!-- General tab -->
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Server Connection"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgHostTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="e.g. localhost"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgPortTextBox"
                                             MinWidth="200"
                                             Text="5432"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Database" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgDatabaseTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="Database name"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgUsernameTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="PostgreSQL username"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="PgPasswordBox"
                                                 MinWidth="200"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SSL tab -->
                    <TabItem Header="SSL">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="SSL / TLS Configuration"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <!-- SSL Mode -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="SSL Mode" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="PgSslModeComboBox"
                                              MinWidth="200"
                                              SelectedIndex="2"
                                              SelectionChanged="PgSslMode_SelectionChanged">
                                        <ComboBoxItem Content="Disable" Tag="Disable"/>
                                        <ComboBoxItem Content="Allow" Tag="Allow"/>
                                        <ComboBoxItem Content="Prefer" Tag="Prefer"/>
                                        <ComboBoxItem Content="Require" Tag="Require"/>
                                        <ComboBoxItem Content="Verify CA (VerifyCA)" Tag="VerifyCA"/>
                                        <ComboBoxItem Content="Verify Full (VerifyFull)" Tag="VerifyFull"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Certificate paths (shown for VerifyCA / VerifyFull) -->
                                <StackPanel x:Name="PgCertPathsPanel" Visibility="Collapsed">
                                    <!-- SSL Certificate -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="SSL Certificate Path" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PgSslCertTextBox"
                                                     Grid.Column="0"
                                                     MinWidth="200"
                                                     Margin="0,0,6,0"
                                                     ui:ControlHelper.PlaceholderText="Path to SSL certificate"/>
                                            <Button Grid.Column="1"
                                                    Content="..."
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="BrowsePgSslCert_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- SSL Key -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="SSL Key Path" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PgSslKeyTextBox"
                                                     Grid.Column="0"
                                                     MinWidth="200"
                                                     Margin="0,0,6,0"
                                                     ui:ControlHelper.PlaceholderText="Path to SSL key file"/>
                                            <Button Grid.Column="1"
                                                    Content="..."
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="BrowsePgSslKey_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Root Certificate -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Root Certificate Path" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PgSslRootCertTextBox"
                                                     Grid.Column="0"
                                                     MinWidth="200"
                                                     Margin="0,0,6,0"
                                                     ui:ControlHelper.PlaceholderText="Path to root certificate"/>
                                            <Button Grid.Column="1"
                                                    Content="..."
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="BrowsePgSslRootCert_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Advanced tab -->
                    <TabItem Header="Advanced">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="560">
                                <TextBlock Text="Advanced Settings"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Margin="0,0,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Connection Timeout (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgConnTimeoutTextBox"
                                             MinWidth="200"
                                             Text="30"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Command Timeout (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgCmdTimeoutTextBox"
                                             MinWidth="200"
                                             Text="30"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Application Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgAppNameTextBox"
                                             MinWidth="200"
                                             Text="PasswordManager"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Search Path" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PgSearchPathTextBox"
                                             MinWidth="200"
                                             ui:ControlHelper.PlaceholderText="public"/>
                                </StackPanel>

                                <Separator Margin="0,8,0,16"
                                           Background="{DynamicResource ModernBorderBrush}"/>
                                <TextBlock Text="Connection Pooling"
                                           Style="{StaticResource SectionHeaderStyle}"/>

                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="PgPoolingCheckBox"
                                              Content="Enable Connection Pooling"
                                              IsChecked="True"
                                              Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                              Checked="PgPooling_Changed"
                                              Unchecked="PgPooling_Changed"/>
                                </StackPanel>

                                <StackPanel x:Name="PgPoolSizePanel" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Min Pool Size" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="PgMinPoolTextBox"
                                                     MinWidth="80"
                                                     Text="1"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Max Pool Size" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="PgMaxPoolTextBox"
                                                     MinWidth="80"
                                                     Text="100"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════
             Bottom button row
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModernSurfaceBrush}"
                BorderBrush="{DynamicResource ModernBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status text -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource ModernTextSecondaryBrush}"/>

                <!-- Test Connection -->
                <Button x:Name="TestConnectionButton"
                        Grid.Column="1"
                        Style="{DynamicResource ModernSecondaryButtonStyle}"
                        Click="TestConnection_Click"
                        Padding="14,8"
                        MinWidth="130"
                        MinHeight="36">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Save -->
                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Style="{DynamicResource ModernPrimaryButtonStyle}"
                        Click="Save_Click"
                        Padding="14,8"
                        MinWidth="90"
                        MinHeight="36">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Cancel -->
                <Button x:Name="CancelButton"
                        Grid.Column="5"
                        Style="{DynamicResource ModernSecondaryButtonStyle}"
                        Click="Cancel_Click"
                        Padding="14,8"
                        MinWidth="90"
                        MinHeight="36">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
