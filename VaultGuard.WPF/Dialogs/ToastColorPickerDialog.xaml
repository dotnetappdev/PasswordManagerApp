<Window x:Class="VaultGuard.WPF.Dialogs.ToastColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Toast"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModernBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Customize Toast"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: old-school palette + primary/secondary swatches ===== -->
            <StackPanel Grid.Column="0" Width="300">

                <TextBlock Text="Color palette" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource ModernTextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Left-click = Primary (accent) · Right-click = Secondary (background)"
                           FontSize="11" Opacity="0.7"
                           Foreground="{DynamicResource ModernTextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <!-- Classic sunken 3D border around the swatch grid -->
                <Border BorderBrush="#FF808080" BorderThickness="1" Background="#FF3A3A3A"
                        Padding="3" HorizontalAlignment="Left">
                    <Border BorderBrush="#FF202020" BorderThickness="1" Padding="2">
                        <UniformGrid x:Name="PaletteHost" Columns="8" />
                    </Border>
                </Border>

                <!-- MS Paint-style overlapping primary/secondary indicator -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Grid Width="56" Height="56" Margin="0,0,16,0">
                        <Border x:Name="SecondarySwatch" Width="34" Height="34"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#0A1929"
                                BorderBrush="#FF808080" BorderThickness="1">
                            <Border BorderBrush="#FFFFFFFF" BorderThickness="1"/>
                        </Border>
                        <Border x:Name="PrimarySwatch" Width="34" Height="34"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#60A5FA"
                                BorderBrush="#FF808080" BorderThickness="1">
                            <Border BorderBrush="#FFFFFFFF" BorderThickness="1"/>
                        </Border>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Primary" Width="68" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            <TextBox x:Name="PrimaryHexBox" Width="92" Text="#60A5FA"
                                     FontFamily="Consolas" FontSize="12"
                                     LostFocus="HexBox_LostFocus" Tag="primary"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Secondary" Width="68" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            <TextBox x:Name="SecondaryHexBox" Width="92" Text="#0A1929"
                                     FontFamily="Consolas" FontSize="12"
                                     LostFocus="HexBox_LostFocus" Tag="secondary"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ===== Right: icon picker + live preview ===== -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Icon" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource ModernTextPrimaryBrush}" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="6" Background="{DynamicResource ModernSurfaceBrush}">
                    <WrapPanel x:Name="IconHost"/>
                </Border>

                <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource ModernTextPrimaryBrush}" Margin="0,18,0,6"/>
                <Border x:Name="PreviewHost" MinHeight="90"/>
            </StackPanel>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Height="32" Margin="0,0,8,0"
                    Style="{DynamicResource ModernPrimaryButtonStyle}"
                    IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="32"
                    Style="{DynamicResource ModernSecondaryButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
