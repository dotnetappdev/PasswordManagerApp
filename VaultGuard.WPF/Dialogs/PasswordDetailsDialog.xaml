<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019"
               x:Class="VaultGuard.WPF.Dialogs.PasswordDetailsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:VaultGuard.WPF.Controls"
               Style="{StaticResource Modern1PasswordDialogStyle}">

    <ui:ContentDialog.Title>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="TypeIconBorder" Width="32" Height="32" CornerRadius="8"
                        Background="#1D4ED8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TypeIconText" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="Item" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                    <TextBlock x:Name="DialogSubtitleText" Text="Login" FontSize="11"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="EditItemButton" Style="{StaticResource ModernPrimaryButtonStyle}"
                        Click="EditItemButton_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Edit"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteItemButton" Style="{StaticResource ModernDangerButtonStyle}"
                        Click="DeleteItemButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Delete"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ui:ContentDialog.Title>

    <ScrollViewer MaxHeight="620" MaxWidth="540" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,4,8">

            <!-- ── LOGIN DETAILS ─────────────────────────────────── -->
            <StackPanel x:Name="LoginDetailsPanel" Visibility="Collapsed">
                <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Login Details" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Username -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Username / Email" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:ReadOnlyField x:Name="UsernameText" Grid.Column="0"/>
                                <Button Grid.Column="1" x:Name="CopyUsernameButton" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}" Margin="6,0,0,0"
                                        Click="CopyUsernameButton_Click" ToolTipService.ToolTip="Copy username">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Password" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:ReadOnlyField x:Name="PasswordText" Grid.Column="0"/>
                                <Button Grid.Column="1" x:Name="TogglePasswordButton" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}" Margin="6,0,4,0"
                                        Click="TogglePasswordButton_Click" ToolTipService.ToolTip="Show / Hide password">
                                    <TextBlock x:Name="TogglePasswordIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Grid.Column="2" x:Name="CopyPasswordButton" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="CopyPasswordButton_Click" ToolTipService.ToolTip="Copy password">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Website -->
                        <StackPanel x:Name="UrlPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock x:Name="UrlLabel" Text="Website" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:ReadOnlyField x:Name="UrlText" Grid.Column="0"/>
                                <Button Grid.Column="1" x:Name="CopyUrlButton" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}" Margin="6,0,4,0"
                                        Click="CopyUrlButton_Click" ToolTipService.ToolTip="Copy URL">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Grid.Column="2" x:Name="OpenUrlButton" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="OpenUrlButton_Click" ToolTipService.ToolTip="Open in browser">
                                    <TextBlock Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel x:Name="LoginNotesPanel" Visibility="Collapsed">
                            <TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}"/>
                            <Border Background="{DynamicResource ModernCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="LoginNotesText" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── CREDIT CARD DETAILS ────────────────────────────── -->
            <StackPanel x:Name="CreditCardDetailsPanel" Visibility="Collapsed">
                <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Card Details" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Cardholder -->
                        <StackPanel x:Name="CardholderPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Text="Cardholder Name" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <controls:ReadOnlyField x:Name="CardholderText" Grid.Column="0"/>
                                <Button Grid.Column="1" Width="36" Height="34" Margin="6,0,0,0"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="CopyCardholderButton_Click" ToolTipService.ToolTip="Copy name">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Card Number -->
                        <StackPanel x:Name="CardNumberPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Text="Card Number" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:ReadOnlyField x:Name="CardNumberText" Grid.Column="0"/>
                                <Button Grid.Column="1" x:Name="ToggleCardNumberButton" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}" Margin="6,0,4,0"
                                        Click="ToggleCardNumberButton_Click" ToolTipService.ToolTip="Show / Hide number">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Grid.Column="2" Width="36" Height="34"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="CopyCardNumberButton_Click" ToolTipService.ToolTip="Copy number">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Expiry / CVV row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ExpiryPanel" Visibility="Collapsed">
                                <TextBlock Text="Expiry Date" Style="{StaticResource FormLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="ExpiryText" Grid.Column="0"/>
                                    <Button Grid.Column="1" Width="36" Height="34" Margin="4,0,0,0"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="CopyExpiryButton_Click" ToolTipService.ToolTip="Copy expiry">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="CvvPanel" Visibility="Collapsed">
                                <TextBlock Text="CVV" Style="{StaticResource FormLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="CvvText" Grid.Column="0"/>
                                    <Button Grid.Column="1" Width="36" Height="34" Margin="4,0,0,0"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="CopyCvvButton_Click" ToolTipService.ToolTip="Copy CVV">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Card Type / Bank -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="CardTypePanel" Visibility="Collapsed">
                                <TextBlock Text="Card Network" Style="{StaticResource FormLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="CardTypeText" Grid.Column="0"/>
                                    <Button Grid.Column="1" Width="36" Height="34" Margin="4,0,0,0"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="CopyCardTypeButton_Click" ToolTipService.ToolTip="Copy card type">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="IssuingBankPanel" Visibility="Collapsed">
                                <TextBlock Text="Issuing Bank" Style="{StaticResource FormLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="IssuingBankText" Grid.Column="0"/>
                                    <Button Grid.Column="1" Width="36" Height="34" Margin="4,0,0,0"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="CopyIssuingBankButton_Click" ToolTipService.ToolTip="Copy bank name">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── SECURE NOTE ────────────────────────────────────── -->
            <StackPanel x:Name="SecureNoteDetailsPanel" Visibility="Collapsed">
                <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,0,0,10">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Note Contents" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource ModernCardBackgroundBrush}"
                                BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <TextBlock x:Name="SecureNoteContentText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                       FontSize="13" LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── METADATA ──────────────────────────────────────── -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Created" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="CreatedText" FontSize="13"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Last Modified" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="ModifiedText" FontSize="13"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- hidden compat refs (code-behind references these names) -->
            <TextBlock x:Name="TitleText"    Visibility="Collapsed"/>
            <TextBlock x:Name="TypeText"     Visibility="Collapsed"/>
            <TextBlock x:Name="CategoryText" Visibility="Collapsed"/>
            <TextBlock x:Name="DescriptionLabel" Visibility="Collapsed"/>
            <TextBlock x:Name="DescriptionText"  Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
