<?xml version="1.0" encoding="utf-8"?>
<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="VaultGuard.WPF.Dialogs.TwoFactorSetupDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Two-Factor Authentication"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               CloseButtonText="Close">

    <Grid Background="{DynamicResource ModernFormBackgroundBrush}"
          MinWidth="440"
          MaxWidth="480"
          MaxHeight="620">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">

                <!-- ============ STEP: STATUS (2FA already enabled) ============ -->
                <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource ModernSuccessBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <TextBlock Text="Two-factor authentication is enabled" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="BackupCodesRemainingText"
                               FontSize="13"
                               Margin="0,0,0,16"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>

                    <TextBlock Text="Confirm your master password and a current code to manage 2FA:"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>

                    <TextBlock Text="Master password" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <PasswordBox x:Name="StatusMasterPasswordBox" Style="{DynamicResource ModernPasswordBoxStyle}" Margin="0,0,0,10"/>

                    <TextBlock Text="Current 6-digit code" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <TextBox x:Name="StatusCodeBox" Style="{DynamicResource ModernTextBoxStyle}" MaxLength="8" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="DisableButton" Content="Disable 2FA"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Click="DisableButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="RegenerateButton" Content="Regenerate Backup Codes"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Click="RegenerateButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusErrorText" FontSize="12" Foreground="{DynamicResource ModernErrorBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

                    <!-- Regenerated backup codes (shown in-place after a successful regenerate) -->
                    <StackPanel x:Name="RegeneratedCodesPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <Border Background="{DynamicResource ModernWarningBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <TextBlock Text="New backup codes — save these now. Your previous codes no longer work."
                                       Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                        <ItemsControl x:Name="RegeneratedCodesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="14" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="CopyRegeneratedCodesButton" Content="Copy All Codes"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Click="CopyRegeneratedCodesButton_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ STEP: ENABLE - MASTER PASSWORD ============ -->
                <StackPanel x:Name="MasterPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="Protect your vault with Google Authenticator, Microsoft Authenticator, or Authy."
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <TextBlock Text="Enter your master password to begin." FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <PasswordBox x:Name="StartMasterPasswordBox" Style="{DynamicResource ModernPasswordBoxStyle}" Margin="0,0,0,12"/>

                    <Button x:Name="ContinueButton" Content="Continue"
                            Style="{StaticResource ModernPrimaryButtonStyle}"
                            Click="ContinueButton_Click" HorizontalAlignment="Left"/>

                    <TextBlock x:Name="MasterPasswordErrorText" FontSize="12" Foreground="{DynamicResource ModernErrorBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ============ STEP: ENABLE - QR + SECRET + VERIFY ============ -->
                <StackPanel x:Name="QrPanel" Visibility="Collapsed">
                    <TextBlock Text="1. Scan this QR code with your authenticator app:" FontSize="13" Margin="0,0,0,10"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Image x:Name="QrCodeImage" Width="208" Height="208"/>
                    </Border>

                    <TextBlock Text="Or enter this code manually:" FontSize="12"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SecretKeyText" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                              TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0"
                              Margin="0,0,0,16"/>

                    <TextBlock Text="2. Enter the 6-digit code from your authenticator app:" FontSize="13" Margin="0,0,0,8"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <TextBox x:Name="VerifyCodeBox" Style="{DynamicResource ModernTextBoxStyle}" MaxLength="8" Margin="0,0,0,12"/>

                    <Button x:Name="VerifyButton" Content="Verify &amp; Enable"
                            Style="{StaticResource ModernPrimaryButtonStyle}"
                            Click="VerifyButton_Click" HorizontalAlignment="Left"/>

                    <TextBlock x:Name="QrErrorText" FontSize="12" Foreground="{DynamicResource ModernErrorBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ============ STEP: BACKUP CODES (after successful verify) ============ -->
                <StackPanel x:Name="BackupCodesPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource ModernSuccessBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <TextBlock Text="Authenticator app enabled!" Foreground="White" FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="{DynamicResource ModernWarningBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="Save these backup codes now. Each can be used once to sign in if you lose access to your authenticator app — they're your way back in."
                                   Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
                    </Border>

                    <Border Background="{DynamicResource ModernSurfaceBrush}" BorderBrush="{DynamicResource ModernBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <ItemsControl x:Name="BackupCodesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="14" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CopyBackupCodesButton" Content="Copy All Codes"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Click="CopyBackupCodesButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DoneButton" Content="Done"
                                Style="{StaticResource ModernPrimaryButtonStyle}"
                                Click="DoneButton_Click"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:ContentDialog>
