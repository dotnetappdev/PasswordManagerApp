<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019"
               x:Class="VaultGuard.WPF.Dialogs.UserRegistrationDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:converters="clr-namespace:VaultGuard.WPF.Converters"
               Title="Create Your Account"
               PrimaryButtonText="Create Account"
               SecondaryButtonText="Cancel"
               DefaultButton="Primary"
               MinWidth="480">
    <!-- Use element syntax so the brush is a local non-frozen instance.
         Setting Background="{DynamicResource ...}" uses a frozen ResourceDictionary brush
         which causes InvalidOperationException when ModernWPF's animation tries to
         target its Color sub-property at path (0).(1). -->
    <ui:ContentDialog.Background>
        <SolidColorBrush Color="#13151F"/>
    </ui:ContentDialog.Background>

    <ui:ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Field container — Background set as a local non-frozen brush in XAML
             to avoid ModernWPF animation errors on frozen ResourceDictionary brushes -->
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="#1E2130"/></Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value><SolidColorBrush Color="#FFFFFF" Opacity="0.1"/></Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="#1A1D27"/></Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Requirement row text (met) -->
        <Style x:Key="ReqMetStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Requirement row text (unmet) -->
        <Style x:Key="ReqUnmetStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5A5F78"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Minimal flat button for icon toggles -->
        <Style x:Key="RevealButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:ContentDialog.Resources>

    <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="440" Margin="0,8,0,4">

            <!-- ── Personal Information ───────────────────────────────── -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Personal Information"
                                   FontSize="{DynamicResource DialogFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- First Name -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="First Name"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border x:Name="FirstNameBorder" x:FieldModifier="private"
                                Style="{StaticResource FieldBorderStyle}">
                            <TextBox x:Name="FirstNameTextBox" x:FieldModifier="private"
                                     BorderThickness="0" FontSize="{DynamicResource DialogFontSize}"
                                     Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                     ui:ControlHelper.PlaceholderText="Enter your first name"
                                     TextChanged="FirstNameTextBox_TextChanged">
                                <TextBox.Background><SolidColorBrush Color="#1E2130"/></TextBox.Background>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <!-- Last Name -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Last Name"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border x:Name="LastNameBorder" x:FieldModifier="private"
                                Style="{StaticResource FieldBorderStyle}">
                            <TextBox x:Name="LastNameTextBox" x:FieldModifier="private"
                                     BorderThickness="0" FontSize="{DynamicResource DialogFontSize}"
                                     Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                     ui:ControlHelper.PlaceholderText="Enter your last name"
                                     TextChanged="LastNameTextBox_TextChanged">
                                <TextBox.Background><SolidColorBrush Color="#1E2130"/></TextBox.Background>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel>
                        <TextBlock Text="Email Address"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border x:Name="EmailBorder" x:FieldModifier="private"
                                Style="{StaticResource FieldBorderStyle}">
                            <TextBox x:Name="EmailTextBox" x:FieldModifier="private"
                                     BorderThickness="0" FontSize="{DynamicResource DialogFontSize}"
                                     Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                     ui:ControlHelper.PlaceholderText="you@example.com"
                                     TextChanged="EmailTextBox_TextChanged">
                                <TextBox.Background><SolidColorBrush Color="#1E2130"/></TextBox.Background>
                            </TextBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Master Password ────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Your Master Password"
                                   FontSize="{DynamicResource DialogTitleFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Warning banner -->
                    <Border Background="#1E2A1A" BorderBrush="#10B98130"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,0,0,16">
                        <TextBlock FontSize="{DynamicResource DialogLabelFontSize}" Foreground="#86EFAC" TextWrapping="Wrap">
                            This password encrypts all your data. We can never recover it — write it down and keep it safe.
                        </TextBlock>
                    </Border>

                    <!-- Password field -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Master Password"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border x:Name="MasterPasswordBorder" x:FieldModifier="private"
                                Style="{StaticResource FieldBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="MasterPasswordBox" x:FieldModifier="private"
                                             Grid.Column="0"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                             FontSize="{DynamicResource DialogFontSize}" FontFamily="Consolas"
                                             ui:ControlHelper.PlaceholderText="Create a strong master password"
                                             PasswordChanged="MasterPasswordBox_PasswordChanged">
                                    <PasswordBox.Background><SolidColorBrush Color="Transparent"/></PasswordBox.Background>
                                </PasswordBox>
                                <TextBox x:Name="MasterPasswordVisibleBox" x:FieldModifier="private"
                                         Grid.Column="0"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                         FontSize="{DynamicResource DialogFontSize}" FontFamily="Consolas"
                                         IsReadOnly="True" Visibility="Collapsed">
                                    <TextBox.Background><SolidColorBrush Color="Transparent"/></TextBox.Background>
                                </TextBox>
                                <Button x:Name="DlgMasterRevealBtn" x:FieldModifier="private"
                                        Grid.Column="1"
                                        Style="{StaticResource RevealButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="DlgMasterRevealBtn_Click">
                                    <TextBlock x:Name="DlgMasterRevealIcon" x:FieldModifier="private"
                                               Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource DialogFontSize}" Foreground="#5A5F78"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Strength segments + label -->
                    <StackPanel x:Name="PasswordStrengthPanel" x:FieldModifier="private"
                                Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid Height="4" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DlgSeg1" x:FieldModifier="private" Grid.Column="0" CornerRadius="2">
                                <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.1"/></Border.Background>
                            </Border>
                            <Border x:Name="DlgSeg2" x:FieldModifier="private" Grid.Column="2" CornerRadius="2">
                                <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.1"/></Border.Background>
                            </Border>
                            <Border x:Name="DlgSeg3" x:FieldModifier="private" Grid.Column="4" CornerRadius="2">
                                <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.1"/></Border.Background>
                            </Border>
                            <Border x:Name="DlgSeg4" x:FieldModifier="private" Grid.Column="6" CornerRadius="2">
                                <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.1"/></Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="PasswordStrengthText" x:FieldModifier="private"
                                   FontSize="{DynamicResource DialogLabelFontSize}" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                    </StackPanel>

                    <!-- Requirements checklist -->
                    <Border Background="#0F1117" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PASSWORD REQUIREMENTS"
                                       FontSize="{DynamicResource DialogLabelFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="ReqLengthText"  x:FieldModifier="private"
                                       Text="○  At least 8 characters" Style="{StaticResource ReqUnmetStyle}"/>
                            <TextBlock x:Name="ReqUpperText"   x:FieldModifier="private"
                                       Text="○  One uppercase letter"  Style="{StaticResource ReqUnmetStyle}"/>
                            <TextBlock x:Name="ReqLowerText"   x:FieldModifier="private"
                                       Text="○  One lowercase letter"  Style="{StaticResource ReqUnmetStyle}"/>
                            <TextBlock x:Name="ReqNumberText"  x:FieldModifier="private"
                                       Text="○  One number"            Style="{StaticResource ReqUnmetStyle}"/>
                            <TextBlock x:Name="ReqSpecialText" x:FieldModifier="private"
                                       Text="○  One special character" Style="{StaticResource ReqUnmetStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Confirm password -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Confirm Master Password"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border x:Name="ConfirmPasswordBorder" x:FieldModifier="private"
                                Style="{StaticResource FieldBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ConfirmPasswordBox" x:FieldModifier="private"
                                             Grid.Column="0"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                             FontSize="{DynamicResource DialogFontSize}" FontFamily="Consolas"
                                             ui:ControlHelper.PlaceholderText="Re-enter your master password"
                                             PasswordChanged="ConfirmPasswordBox_PasswordChanged">
                                    <PasswordBox.Background><SolidColorBrush Color="Transparent"/></PasswordBox.Background>
                                </PasswordBox>
                                <TextBox x:Name="ConfirmPasswordVisibleBox" x:FieldModifier="private"
                                         Grid.Column="0"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                         FontSize="{DynamicResource DialogFontSize}" FontFamily="Consolas"
                                         IsReadOnly="True" Visibility="Collapsed">
                                    <TextBox.Background><SolidColorBrush Color="Transparent"/></TextBox.Background>
                                </TextBox>
                                <Button x:Name="DlgConfirmRevealBtn" x:FieldModifier="private"
                                        Grid.Column="1"
                                        Style="{StaticResource RevealButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="DlgConfirmRevealBtn_Click">
                                    <TextBlock x:Name="DlgConfirmRevealIcon" x:FieldModifier="private"
                                               Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource DialogFontSize}" Foreground="#5A5F78"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Hint -->
                    <StackPanel>
                        <TextBlock Text="Password Hint  (optional)"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <TextBox x:Name="PasswordHintTextBox" x:FieldModifier="private"
                                     BorderThickness="0" FontSize="{DynamicResource DialogFontSize}"
                                     Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                     ui:ControlHelper.PlaceholderText="A clue to jog your memory">
                                <TextBox.Background><SolidColorBrush Color="#1E2130"/></TextBox.Background>
                            </TextBox>
                        </Border>
                        <TextBlock FontSize="{DynamicResource DialogLabelFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="2,4,0,0"
                                   Text="Hint is stored unencrypted — don't include the password itself."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Account Role (admin-only) ──────────────────────────── -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{Binding CanCreateAdminAccount, Mode=OneWay,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Account Role"
                                   FontSize="{DynamicResource DialogFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Admin toggle -->
                    <Border Background="#1E2130" CornerRadius="8" BorderBrush="#FFFFFF1A"
                            BorderThickness="1" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Administrator Account"
                                           FontWeight="SemiBold" FontSize="{DynamicResource DialogFontSize}"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                <TextBlock Text="Full access to features and user management"
                                           FontSize="{DynamicResource DialogLabelFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="AdminToggleSwitch" x:FieldModifier="private"
                                             Grid.Column="1" VerticalAlignment="Center"
                                             OnContent="" OffContent=""
                                             Toggled="AdminToggleSwitch_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Role picker -->
                    <StackPanel Margin="0,0,0,10"
                                Visibility="{Binding ShowRoleSelection, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="User Role"
                                   FontSize="{DynamicResource DialogFontSize}" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <ComboBox x:Name="RoleComboBox" x:FieldModifier="private"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="RoleComboBox_SelectionChanged">
                                <ComboBox.Background><SolidColorBrush Color="Transparent"/></ComboBox.Background>
                                <ComboBoxItem Content="Parent User"   Tag="Parent"/>
                                <ComboBoxItem Content="Standard User" Tag="User" IsSelected="True"/>
                                <ComboBoxItem Content="Child User"    Tag="Child"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Role description -->
                    <Border Background="{DynamicResource ModernSurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource ModernBorderBrush}"
                            BorderThickness="1" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource DialogFontSize}" Foreground="#60A5FA"
                                       VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <TextBlock x:Name="RoleDescriptionTextBlock" x:FieldModifier="private"
                                       FontSize="{DynamicResource DialogLabelFontSize}" Foreground="#93C5FD"
                                       TextWrapping="Wrap"
                                       Text="Standard users can manage their own passwords."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Error message ──────────────────────────────────────── -->
            <Border x:Name="ErrorMessageBorder" x:FieldModifier="private"
                    Background="#3B0F0F" BorderBrush="#EF444460"
                    BorderThickness="1" CornerRadius="8"
                    Padding="14,12" Margin="0,0,0,4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{DynamicResource DialogTitleFontSize}" Foreground="#F87171"
                               VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock x:Name="ErrorMessageTextBlock" x:FieldModifier="private"
                               FontSize="{DynamicResource DialogFontSize}" Foreground="#FCA5A5"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
