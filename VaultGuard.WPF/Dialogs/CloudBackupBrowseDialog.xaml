<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019"
               x:Class="VaultGuard.WPF.Dialogs.CloudBackupBrowseDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Browse Backup"
               PrimaryButtonText="Import Selected"
               CloseButtonText="Cancel"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               MinWidth="520"
               MaxWidth="640">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header info -->
        <Border Grid.Row="0" Background="#1A2744" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="#2563EB" Margin="0,0,12,0">
                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="BackupDateText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                    <TextBlock x:Name="BackupCountText" FontSize="12"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Select all / filter row -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAllCheck" Content="Select all" IsChecked="True"
                          Checked="SelectAllCheck_Changed" Unchecked="SelectAllCheck_Changed"
                          Margin="0,0,16,0"/>
                <TextBlock x:Name="SelectedCountText" FontSize="12"
                           Foreground="{DynamicResource ModernTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="SearchBox" Width="160"
                     ui:ControlHelper.PlaceholderText="Filter…"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- Item list grouped by type -->
        <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemsPanel" Margin="0,0,4,0"/>
        </ScrollViewer>
    </Grid>
</ui:ContentDialog>
