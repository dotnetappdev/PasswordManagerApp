<?xml version="1.0" encoding="utf-8"?>
<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="VaultGuard.WPF.Dialogs.ItemTypeSelectionDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="What would you like to add?"
               PrimaryButtonText=""
               CloseButtonText=""
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               Background="{DynamicResource ModernFormBackgroundBrush}"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               PrimaryButtonStyle="{StaticResource ContentDialogPrimaryButtonStyle}"
               CloseButtonStyle="{StaticResource ContentDialogSecondaryButtonStyle}"
              MaxWidth="760"
              MaxHeight="760">

    <ScrollViewer>
        <StackPanel xmlns:ui="http://schemas.modernwpf.com/2019"
    Margin="16">
           <TextBlock Text="What would you like to add?"
                      FontSize="40"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,4,0,12"/>

           <!-- Search Box -->
           <ui:AutoSuggestBox x:Name="ItemSearchBox"
                            ui:ControlHelper.PlaceholderText="Try searching anything"
                            QueryIcon="Find"
                            Style="{StaticResource ModernAutoSuggestBoxStyle}"
                            CornerRadius="8"
                            Height="40"
                            FontSize="16"/>

            <!-- Main Category Grid - 6 core item types in 3x2 layout -->
            <Grid x:Name="MainCategoryGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top row - Main categories matching navigation menu -->
                <Button x:Name="LoginButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Click="CategoryButton_Click"
                        Tag="Login"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#2563EB"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Login"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SecureNoteButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Click="CategoryButton_Click"
                        Tag="Secure Note"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#f59e0b"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Secure Note"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CreditCardButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Click="CategoryButton_Click"
                        Tag="Credit Card"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#10b981"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Credit Card"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Second row -->
                <Button x:Name="IdentityButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Click="CategoryButton_Click"
                        Tag="Identity"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#8b5cf6"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Identity"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="PasswordButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Click="CategoryButton_Click"
                        Tag="Password"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#ef4444"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE1F5;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Password"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="PasskeyButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Click="CategoryButton_Click"
                        Tag="Passkey"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#ec4899"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Passkey"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Show more / less toggle -->
            <Button x:Name="ShowMoreButton"
                    Click="ShowMoreButton_Click"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ShowMoreText" Text="Show more"
                               FontSize="14" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                    <TextBlock x:Name="ShowMoreChevron" Text=" &#xE76C;"
                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Extended types panel (collapsed by default) -->
            <StackPanel x:Name="ExtendedTypesPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <UniformGrid Columns="2">
                    <!-- SSH Key -->
                    <Button Click="CategoryButton_Click" Tag="SSH Key" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#0F766E" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="SSH Key" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- API Credentials -->
                    <Button Click="CategoryButton_Click" Tag="API Credentials" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#7C3AED" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="API Credentials" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Bank Account -->
                    <Button Click="CategoryButton_Click" Tag="Bank Account" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#D97706" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Bank Account" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Crypto Wallet -->
                    <Button Click="CategoryButton_Click" Tag="Crypto Wallet" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#B45309" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8CA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Crypto Wallet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Database -->
                    <Button Click="CategoryButton_Click" Tag="Database" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#0369A1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xF1C3;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Database" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Driver License -->
                    <Button Click="CategoryButton_Click" Tag="Driver License" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#1D4ED8" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Driver License" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Email Account -->
                    <Button Click="CategoryButton_Click" Tag="Email Account" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#0891B2" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Email Account" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Medical Record -->
                    <Button Click="CategoryButton_Click" Tag="Medical Record" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#BE185D" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Medical Record" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Membership -->
                    <Button Click="CategoryButton_Click" Tag="Membership" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#6D28D9" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Membership" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Outdoor License -->
                    <Button Click="CategoryButton_Click" Tag="Outdoor License" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#15803D" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE910;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Outdoor License" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Passport -->
                    <Button Click="CategoryButton_Click" Tag="Passport" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#1E40AF" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Passport" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Rewards -->
                    <Button Click="CategoryButton_Click" Tag="Rewards" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#C2410C" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Rewards" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Server -->
                    <Button Click="CategoryButton_Click" Tag="Server" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#374151" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xECC6;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Server" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Social Security Number -->
                    <Button Click="CategoryButton_Click" Tag="Social Security Number" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#1D4ED8" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Social Security No." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Software License -->
                    <Button Click="CategoryButton_Click" Tag="Software License" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#4338CA" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Software License" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Wireless Router -->
                    <Button Click="CategoryButton_Click" Tag="Wireless Router" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#0891B2" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Wireless Router" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Document -->
                    <Button Click="CategoryButton_Click" Tag="Document" Style="{StaticResource CardButtonStyle}" Margin="4" MinHeight="56">
                        <StackPanel Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                            <Border Background="#64748B" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Document" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <Border Background="{DynamicResource ModernSurfaceBrush}"
                    BorderBrush="{DynamicResource ModernBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Migrate data into VaultGuard"
                               FontSize="18"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
