<?xml version="1.0" encoding="utf-8"?>
<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="VaultGuard.WPF.Dialogs.TagDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:VaultGuard.WPF.Controls"
               Title="New Tag"
               PrimaryButtonText="Save"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               PrimaryButtonStyle="{StaticResource ui:ContentDialogPrimaryButtonStyle}"
               CloseButtonStyle="{StaticResource ui:ContentDialogSecondaryButtonStyle}">

    <Grid xmlns:ui="http://schemas.modernwpf.com/2019"
    Background="{DynamicResource ModernFormBackgroundBrush}"
          MaxWidth="450"
          MaxHeight="500">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">

                <!-- Error Message -->
                <Border x:Name="ErrorMessageBorder"
                        Background="{StaticResource ModernErrorBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText"
                               Text=""
                               Foreground="White"
                               FontSize="{DynamicResource DialogFontSize}"
                               FontWeight="Medium"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Tag Name Field -->
                <StackPanel Margin="8">
                    <TextBlock Text="Name"
                               FontSize="{DynamicResource DialogFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource ModernBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="TagNameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter tag name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="{DynamicResource DialogFontSize}"
                                     MaxLength="50"/>
                            <controls:ReadOnlyField x:Name="TagNameTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Tag Description Field -->
                <StackPanel Margin="8">
                    <TextBlock Text="Description"
                               FontSize="{DynamicResource DialogFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource ModernBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="TagDescriptionTextBox"
                                     ui:ControlHelper.PlaceholderText="Add description (optional)"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="{DynamicResource DialogFontSize}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="80"
                                     MaxLength="200"/>
                            <controls:ReadOnlyField x:Name="TagDescriptionTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Tag Color Selection -->
                <StackPanel Margin="8">
                    <TextBlock Text="Color"
                               FontSize="{DynamicResource DialogFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="TagColorComboBox"
                                      Grid.Column="0"
                                      ui:ControlHelper.PlaceholderText="Choose color"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="{DynamicResource DialogFontSize}"
                                      SelectedIndex="0">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#3b82f6"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Blue"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#10b981"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Green"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#f59e0b"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Orange"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#ef4444"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Red"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#8b5cf6"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Purple"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#ec4899"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Pink"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#6b7280"
                                                 Width="18"
                                                 Height="18"/>
                                        <TextBlock Text="Gray"
                                                   FontSize="{DynamicResource DialogFontSize}"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <Ellipse x:Name="ColorPreview"
                                     Grid.Column="1"
                                     Fill="#3b82f6"
                                     Width="22"
                                     Height="22"
                                     Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Color display for read-only -->
                <controls:ReadOnlyField x:Name="TagColorTextDisplay"
                                        Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:ContentDialog>
