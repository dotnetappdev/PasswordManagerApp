<Window x:Class="VaultGuard.WPF.Dialogs.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Guard Quick Access"
        Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Quick Access: a keyboard-first search box over whatever app you're in. Drawn in the app's dark palette. -->
    <Border Margin="16" CornerRadius="12" Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6C8DF3" Offset="0"/>
                            <GradientStop Color="#FF2252DA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <TextBox x:Name="SearchBox" FontSize="18" Foreground="#FFE5E5E5" Background="Transparent" BorderThickness="0"
                             CaretBrush="#FFE5E5E5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="Search Vault Guard"/>
                    <TextBlock x:Name="Placeholder" Text="Search Vault Guard" FontSize="18" Foreground="#FF7A7A7A"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Grid>
            </Grid>

            <Border Height="1" Background="#FF2E2E2E"/>

            <!-- Locked: the vault has to be unlocked in the app first. -->
            <StackPanel x:Name="LockedPanel" Margin="20,16" Visibility="Collapsed">
                <TextBlock Text="Vault Guard is locked" FontSize="15" FontWeight="SemiBold" Foreground="#FFE5E5E5"/>
                <TextBlock Text="Unlock it to search your vault. Press Enter to open Vault Guard." Margin="0,4,0,12" Foreground="#FF9D9D9D" TextWrapping="Wrap"/>
                <Button x:Name="UnlockButton" Content="Unlock Vault Guard" HorizontalAlignment="Left" Padding="14,6" Click="UnlockButton_Click"/>
            </StackPanel>

            <ListBox x:Name="Results" MaxHeight="420" Background="Transparent" BorderThickness="0" Margin="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                     MouseDoubleClick="Results_MouseDoubleClick" AutomationProperties.Name="Results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" CornerRadius="8" Padding="10,8" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FF2A3550"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{Binding AvatarBrush}">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="#FFE5E5E5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="#FF9D9D9D" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="#FF7A7A7A" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Margin="20,8,20,14" Foreground="#FF9D9D9D" Visibility="Collapsed" TextWrapping="Wrap"/>

            <Border Background="#FF191919" CornerRadius="0,0,12,12" Padding="16,8">
                <TextBlock x:Name="FooterText" Foreground="#FF8A8A8A" FontSize="11" TextWrapping="Wrap"
                           Text="Enter: copy password   ·   Shift+Enter: copy username   ·   Ctrl+Enter: copy one-time code   ·   Alt+Enter: open   ·   Esc: close"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
