<Page
    x:Class="PasswordManager.WPF.Views.SecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Security Dashboard" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                    <TextBlock Text="A health check of every credential in your vault"
                               FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RescanButton" Click="RescanButton_Click"
                        Style="{StaticResource ModernSecondaryButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Re-scan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Score + summary row -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Score card -->
                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,12,0" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="ScoreCircle" Width="150" Height="150" CornerRadius="75"
                                BorderThickness="6" BorderBrush="#333333" Background="#1A1A1A">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ScoreText" Text="—" FontSize="44" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                <TextBlock x:Name="RatingText" Text="" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="CredentialsText" Text="" FontSize="12"
                                   Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Summary tiles -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,6,0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#EA580C" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="WeakCountText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Weak" FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="6,0,6,0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#D97706" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ReusedCountText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Reused" FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}" Margin="6,0,6,0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DC2626" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UnsecuredCountText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Unsecured" FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ModernCardStyle}" Margin="6,0,6,0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="No2faCountText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="No 2FA" FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource ModernCardStyle}" Margin="6,0,0,0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#0891B2" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="OldCountText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Old" FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- All clear -->
            <Border x:Name="AllClearBorder" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Everything looks great — no weak, reused, or old passwords found."
                               FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Issue sections -->
            <ItemsControl x:Name="IssueSectionsList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                           Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12"
                                                           Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
