<Page
    x:Class="VaultGuard.WPF.Views.AuditLogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:loc="clr-namespace:VaultGuard.WPF.Localization"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">

            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Border Background="{StaticResource ModernSuccessBrush}" Width="32" Height="32">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{loc:T 'Audit Logs'}" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T 'Track all activity on your account'}"
                                   Style="{StaticResource ModernCaptionStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource ModernSecondaryButtonStyle}"
                            Click="RefreshButton_Click" Margin="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="8,6">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T 'Refresh'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" Grid.Column="0"
                             ui:ControlHelper.PlaceholderText="🔍 Search logs…"
                             TextChanged="Filter_Changed"
                             Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0"/>

                    <ComboBox x:Name="ActionComboBox" Grid.Column="1"
                              SelectionChanged="Filter_Changed"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox x:Name="EntityTypeComboBox" Grid.Column="2"
                              SelectionChanged="Filter_Changed"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button Grid.Column="3" x:Name="ClearFiltersButton" Style="{StaticResource ModernSecondaryButtonStyle}"
                            Click="ClearFiltersButton_Click">
                        <TextBlock Text="{loc:T 'Clear filters'}" Margin="8,6"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Logs list -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="4">
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T 'Action'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="1" Text="{loc:T 'Entity Type'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="2" Text="{loc:T 'Item'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="3" Text="{loc:T 'Status'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="4" Text="{loc:T 'Timestamp'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource ModernBorderBrush}" Margin="0,0,0,4"/>

                    <ItemsControl x:Name="LogsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Action}" VerticalAlignment="Center"
                                                   Foreground="{Binding ActionBrush}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EntityType}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EntityName}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StatusGlyph}" VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets" Foreground="{Binding StatusBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TimestampText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" FontSize="12"/>
                                        <Button Grid.Column="5" Width="32" Height="32" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="DetailsButton_Click"
                                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTipService.ToolTip="{loc:T 'View changes'}">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyStateText" Text="{loc:T 'No audit logs found'}"
                               Style="{StaticResource ModernCaptionStyle}" HorizontalAlignment="Center" Margin="0,24" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
