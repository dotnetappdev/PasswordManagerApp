<Page
    x:Class="VaultGuard.WPF.Views.ApiKeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:loc="clr-namespace:VaultGuard.WPF.Localization"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">

            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Border Background="{StaticResource ModernSuccessBrush}" Width="32" Height="32">
                                <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{loc:T 'API Keys'}" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T 'Let external apps, including the mobile apps, authenticate to your vault'}"
                                   Style="{StaticResource ModernCaptionStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource ModernSecondaryButtonStyle}"
                            Click="RefreshButton_Click" Margin="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="8,6">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T 'Refresh'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Create new key -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="8">
                    <TextBlock Text="{loc:T 'Create New API Key'}" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewKeyNameTextBox" Grid.Column="0"
                                 ui:ControlHelper.PlaceholderText="e.g. &quot;My iPhone&quot;, &quot;Backup Script&quot;"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" x:Name="CreateKeyButton" Style="{StaticResource ModernPrimaryButtonStyle}"
                                Click="CreateKeyButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:T 'Create API Key'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Keys list -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="4">
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T 'Name'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="1" Text="{loc:T 'Created'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="2" Text="{loc:T 'Last Used'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                        <TextBlock Grid.Column="3" Text="{loc:T 'Status'}" FontWeight="SemiBold" Style="{StaticResource ModernCaptionStyle}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource ModernBorderBrush}" Margin="0,0,0,4"/>

                    <ItemsControl x:Name="ApiKeysItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LastUsedText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                                   Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        <Button Grid.Column="4" Width="32" Height="32" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="RevokeKeyButton_Click"
                                                ToolTipService.ToolTip="{loc:T 'Revoke key'}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyStateText" Text="{loc:T 'No API keys found. Create your first API key to get started.'}"
                               Style="{StaticResource ModernCaptionStyle}" HorizontalAlignment="Center" Margin="0,24" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
