<Page
    x:Class="VaultGuard.WPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{DynamicResource ModernBackgroundBrush}">

    <Grid Margin="16,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0" Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{DynamicResource ModernElevatedSurfaceBrush}"
                               CornerRadius="8"
                               Width="32"
                               Height="32"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="16"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Settings" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Configure your password manager preferences and security"
                              Style="{StaticResource ModernCaptionStyle}"/>
                </StackPanel>
            </Border>

            <!-- Tabbed settings: groups sections so each screen needs little or no scrolling.
                 Within each tab the cards flow into two columns on wide windows. -->
            <TabControl Grid.Row="1" Margin="0,8,0,0"
                        Style="{StaticResource SettingsTabControlStyle}">
                <TabItem Header="Appearance">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

            <!-- Appearance Settings -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="#5B4FCF" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Appearance" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="16">
                        <StackPanel Margin="8">
                            <TextBlock Text="Theme" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>

                            <!-- Tile picker, like Windows' own theme/contrast-theme picker — a small
                                 preview swatch per option instead of one long dropdown list.
                                 UniformGrid keeps all five tiles the same size in one tidy row
                                 instead of letting a WrapPanel wrap two of them unevenly. -->
                            <UniformGrid x:Name="ThemeTilesPanel" Columns="5" Margin="0,8,0,0">

                                <Border x:Name="ThemeTile_Light" Tag="Light"
                                        Height="98" Margin="0,0,8,0" CornerRadius="8"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                        Cursor="Hand" MouseLeftButtonDown="ThemeTile_Click">
                                    <StackPanel Margin="8" VerticalAlignment="Center">
                                        <Border Height="48" CornerRadius="5" Background="#F8FAFC" BorderThickness="1" BorderBrush="#E2E8F0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Aa" FontSize="16" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                                <Border Width="28" Height="3" CornerRadius="2" Background="#2563EB" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Light" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ThemeTile_Dark" Tag="Dark"
                                        Height="98" Margin="0,0,8,0" CornerRadius="8"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                        Cursor="Hand" MouseLeftButtonDown="ThemeTile_Click">
                                    <StackPanel Margin="8" VerticalAlignment="Center">
                                        <Border Height="48" CornerRadius="5" Background="#1A1A1A" BorderThickness="1" BorderBrush="#3A3A3A">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Aa" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                <Border Width="28" Height="3" CornerRadius="2" Background="#2563EB" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Dark" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ThemeTile_System" Tag="System"
                                        Height="98" Margin="0,0,8,0" CornerRadius="8"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                        Cursor="Hand" MouseLeftButtonDown="ThemeTile_Click">
                                    <StackPanel Margin="8" VerticalAlignment="Center">
                                        <Border Height="48" CornerRadius="5" BorderThickness="1" BorderBrush="#888888" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F8FAFC"/>
                                                <Border Grid.Column="1" Background="#1A1A1A"/>
                                                <TextBlock Text="Aa" FontSize="16" FontWeight="Bold" Foreground="#888888"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Grid.ColumnSpan="2"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="System" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ThemeTile_HighContrast" Tag="High Contrast"
                                        Height="98" Margin="0,0,8,0" CornerRadius="8"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                        Cursor="Hand" MouseLeftButtonDown="ThemeTile_Click">
                                    <StackPanel Margin="8" VerticalAlignment="Center">
                                        <Border Height="48" CornerRadius="5" Background="#000000" BorderThickness="1" BorderBrush="#FFFFFF">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Aa" FontSize="16" FontWeight="Bold" Foreground="#FFFF00" HorizontalAlignment="Center"/>
                                                <Border Width="28" Height="3" CornerRadius="2" Background="#00FFFF" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="High Contrast" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ThemeTile_Windows" Tag="Windows"
                                        Height="98" Margin="0,0,0,0" CornerRadius="8"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                        Cursor="Hand" MouseLeftButtonDown="ThemeTile_Click">
                                    <StackPanel Margin="8" VerticalAlignment="Center">
                                        <Border Height="48" CornerRadius="5" Background="#1A1A1A" BorderThickness="1" BorderBrush="#3A3A3A">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="WindowsTileSwatch" Text="&#xE770;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" Foreground="#0067C0" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Aa" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Windows" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="Changes take effect immediately. &quot;Windows&quot; follows your Windows accent colour and light/dark setting; &quot;High Contrast&quot; mirrors any Windows contrast theme you have turned on."
                                      Style="{StaticResource ModernCaptionStyle}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="520"/>
                        </StackPanel>
                        <StackPanel Margin="8">
                            <TextBlock Text="Default View" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                            <ComboBox x:Name="DefaultViewComboBox"
                                     Style="{StaticResource ModernComboBoxStyle}" MinWidth="200">
                                <ComboBoxItem Content="All Items" IsSelected="True"/>
                                <ComboBoxItem Content="Logins"/>
                                <ComboBoxItem Content="Credit Cards"/>
                                <ComboBoxItem Content="Favorites"/>
                            </ComboBox>
                        </StackPanel>
                        <ui:ToggleSwitch Header="Show item count in navigation sidebar"
                                  IsOn="True" Margin="8,4,8,4"/>
                        <ui:ToggleSwitch Header="Animate list transitions"
                                  IsOn="True" Margin="8,4,8,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Toast Notifications -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="#F59E0B" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Toast Notifications" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="16">
                        <TextBlock Text="Pick the accent (primary) colour, background (secondary) colour and icon used for each kind of pop-up notification."
                                  Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8"/>

                        <!-- One row per toast type; the preview chip is rebuilt in code-behind. -->
                        <StackPanel x:Name="ToastRowsHost" Margin="8,0,8,0"/>

                        <StackPanel Orientation="Horizontal" Margin="8,12,8,0">
                            <Button Style="{StaticResource ModernPrimaryButtonStyle}" Click="SaveToastColors_Click">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModernSecondaryButtonStyle}" Margin="8,0,0,0" Click="ResetToastColors_Click">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reset to Defaults"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Vault Management -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="#059669" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Vaults" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="16">
                        <TextBlock Text="Vaults let you organise your passwords into separate, named buckets — for example Personal, Work, and Finance. Each vault has its own colour and icon."
                                  Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8"/>
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                    Click="ManageVaultsButton_Click">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Manage Vaults"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                    Margin="8,0,0,0" Click="SeedVaultsButton_Click">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Seed Default Vaults"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Password Generator -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="#DC2626" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Password Generator" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="16">
                        <TextBlock Text="Configure the default settings for the built-in password generator."
                                  Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8"/>
                        <StackPanel Margin="8">
                            <TextBlock Text="Default Password Length" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="PasswordLengthSlider" Minimum="8" Maximum="64" Value="20"
                                        Width="240" VerticalAlignment="Center"
                                        ValueChanged="PasswordLengthSlider_ValueChanged"/>
                                <TextBlock x:Name="PasswordLengthLabel" Text="20" Margin="12,0,0,0"
                                          FontWeight="SemiBold" FontSize="16"
                                          Foreground="{StaticResource ModernAccentBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text=" characters" VerticalAlignment="Center"
                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Margin="8">
                            <CheckBox x:Name="PwdUppercase"  Content="Uppercase (A-Z)"   IsChecked="True" Margin="0,0,16,4"/>
                            <CheckBox x:Name="PwdLowercase"  Content="Lowercase (a-z)"   IsChecked="True" Margin="0,0,16,4"/>
                            <CheckBox x:Name="PwdNumbers"    Content="Numbers (0-9)"      IsChecked="True" Margin="0,0,16,4"/>
                            <CheckBox x:Name="PwdSymbols"    Content="Symbols (!@#$...)"  IsChecked="True" Margin="0,0,16,4"/>
                        </WrapPanel>
                        <StackPanel Margin="8">
                            <TextBlock Text="Preview" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GeneratedPasswordPreview"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="13"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="Click Generate to preview"/>
                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource ModernPrimaryButtonStyle}"
                                        Click="GeneratePreviewPassword_Click">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Accessibility">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

                        <!-- Display / Zoom -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="20">
                                <StackPanel Orientation="Horizontal" Margin="12">
                                    <Border Background="#2563EB" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Display &amp; Zoom" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="16">
                                    <TextBlock Text="Make everything in the app larger or smaller, like the zoom in 1Password. Affects the whole window."
                                              Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8"/>

                                    <Grid Margin="8,4,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="UI zoom" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="ZoomValueText" Text="100%"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="ZoomSlider" Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                                            Margin="8,2,8,0" ValueChanged="ZoomSlider_ValueChanged"/>
                                    <Button x:Name="ResetZoomButton" Content="Reset to 100%"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            HorizontalAlignment="Left" Margin="8,10,0,0" Padding="12,6"
                                            Click="ResetZoomButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Text size -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="20">
                                <StackPanel Orientation="Horizontal" Margin="12">
                                    <Border Background="#059669" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Text &amp; Menu Size" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="16">
                                    <TextBlock Text="Set the base font size used by menus and text throughout the app."
                                              Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8"/>

                                    <Grid Margin="8,4,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Font size" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="FontSizeValueText" Text="14 pt"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="FontSizeSlider" Minimum="11" Maximum="22" SmallChange="1" LargeChange="2"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="8,2,8,0" ValueChanged="FontSizeSlider_ValueChanged"/>
                                    <Button x:Name="ResetFontButton" Content="Reset to default"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            HorizontalAlignment="Left" Margin="8,10,0,0" Padding="12,6"
                                            Click="ResetFontButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Per-section text size -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="20">
                                <StackPanel Orientation="Horizontal" Margin="12">
                                    <Border Background="#0EA5E9" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Per-Section Text Size" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="16">
                                    <TextBlock Text="Fine-tune the text size for individual areas. These stack on top of the global font size above."
                                              Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8"/>

                                    <!-- Menu -->
                                    <Grid Margin="8,6,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Menu &amp; navigation" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox Grid.Column="1" x:Name="MenuFontCombo" Tag="Menu"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="SectionFontCombo_SelectionChanged"/>
                                    </Grid>

                                    <!-- Quick Actions -->
                                    <Grid Margin="8,10,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Quick actions" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox Grid.Column="1" x:Name="QuickActionsFontCombo" Tag="QuickActions"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="SectionFontCombo_SelectionChanged"/>
                                    </Grid>

                                    <!-- Details -->
                                    <Grid Margin="8,10,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Item details" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox Grid.Column="1" x:Name="DetailsFontCombo" Tag="Details"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="SectionFontCombo_SelectionChanged"/>
                                    </Grid>

                                    <!-- Dialogs -->
                                    <Grid Margin="8,10,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Dialogs &amp; popups" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox Grid.Column="1" x:Name="DialogsFontCombo" Tag="Dialogs"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="SectionFontCombo_SelectionChanged"/>
                                    </Grid>

                                    <!-- Global (item cards / list rows) -->
                                    <Grid Margin="8,10,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Global (item cards)" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox Grid.Column="1" x:Name="GlobalFontCombo" Tag="Global"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="SectionFontCombo_SelectionChanged"/>
                                    </Grid>

                                    <!-- Card icons -->
                                    <Grid Margin="8,10,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Card icons" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox Grid.Column="1" x:Name="CardIconsFontCombo" Tag="CardIcons"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="SectionFontCombo_SelectionChanged"/>
                                    </Grid>

                                    <Button x:Name="ResetSectionFontsButton" Content="Reset all sections"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            HorizontalAlignment="Left" Margin="8,14,0,0" Padding="12,6"
                                            Click="ResetSectionFontsButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Motion & contrast -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="20">
                                <StackPanel Orientation="Horizontal" Margin="12">
                                    <Border Background="#8b5cf6" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Motion &amp; Contrast" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="16">
                                    <ui:ToggleSwitch x:Name="ReduceMotionToggle" Header="Reduce motion"
                                                     OffContent="Off" OnContent="On"
                                                     Margin="8,4,8,0" Toggled="ReduceMotionToggle_Toggled"/>
                                    <TextBlock Text="Minimises animations and transitions for a calmer, steadier interface."
                                              Style="{StaticResource ModernCaptionStyle}" Opacity="0.7" Margin="8,0,8,10" TextWrapping="Wrap"/>

                                    <ui:ToggleSwitch x:Name="HighContrastToggle" Header="High contrast"
                                                     OffContent="Off" OnContent="On"
                                                     Margin="8,4,8,0" Toggled="HighContrastToggle_Toggled"/>
                                    <TextBlock Text="Boosts contrast between text and backgrounds to improve readability."
                                              Style="{StaticResource ModernCaptionStyle}" Opacity="0.7" Margin="8,0,8,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Security">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

            <!-- Security Settings -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{StaticResource ModernErrorBrush}"
                              
                               Width="24"
                               Height="24"
                               CornerRadius="6"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Security" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="16">
                        <Button x:Name="TwoFactorButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,8"
                               Click="TwoFactorButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Two-Factor Authentication" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TwoFactorStatusText" Text="Not enabled" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ForgetDeviceButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,8"
                               ToolTip="Clears the saved master password for this profile on this device, so your next sign-in (even with 2FA enabled) requires your master password again."
                               Click="ForgetDeviceButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Forget This Device" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ui:ToggleSwitch x:Name="PasscodeToggle"
                                     Header="Require Passcode on Launch"
                                     IsOn="{Binding RequirePasscode, Mode=TwoWay}"
                                     Toggled="PasscodeToggle_Toggled"
                                     Margin="0,0,0,8"/>

                        <ui:ToggleSwitch x:Name="PasskeysToggle"
                                     Header="Enable Passkey Sign-In"
                                     IsOn="{Binding EnablePasskeys, Mode=TwoWay}"
                                     Toggled="PasskeysToggle_Toggled"
                                     Margin="0,0,0,8"/>

                        <!-- Step-up verification: only takes effect when 2FA is enabled. When on, the
                             matching destructive action first asks for a current authenticator/recovery code. -->
                        <TextBlock Text="Require authenticator code for"
                                   Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"
                                   Margin="0,4,0,4"/>
                        <ui:ToggleSwitch x:Name="RequireCodeVaultDeleteToggle"
                                     Header="Deleting a vault"
                                     IsOn="{Binding RequireCodeOnVaultDelete, Mode=TwoWay}"
                                     Margin="0,0,0,4"/>
                        <ui:ToggleSwitch x:Name="RequireCodeItemDeleteToggle"
                                     Header="Deleting a password item"
                                     IsOn="{Binding RequireCodeOnItemDelete, Mode=TwoWay}"
                                     Margin="0,0,0,8"/>
                        <ui:ToggleSwitch x:Name="NumberMatchApprovalsToggle"
                                     Header="Number-matching approvals"
                                     IsOn="{Binding NumberMatchApprovals, Mode=TwoWay}"
                                     Margin="0,0,0,2"/>
                        <TextBlock Text="2FA-style number matching on important actions — editing, deleting or saving password items and categories, and changing your master password. Approve by tapping the matching number on your phone (valid for 60 seconds)."
                                   TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="0,0,0,8"/>

                        <Button x:Name="ChangePasswordButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Click="ChangePasswordButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Change Master Password"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ManagePasskeysButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,8,0,0"
                               Click="ManagePasskeysButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage Passkeys"/>
                            </StackPanel>
                        </Button>

                        <!-- WhatsApp-style "Linked Devices": shows a QR the mobile app scans to sign in -->
                        <Button x:Name="LinkedDevicesButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,8,0,0"
                               Click="LinkedDevicesButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE8CE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Linked Devices"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Margin="8">
                            <TextBlock Text="Session Timeout" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="SessionTimeoutComboBox"
                                     ItemsSource="{Binding TimeoutOptions}"
                                     SelectedItem="{Binding SessionTimeoutMinutes, Mode=TwoWay}"
                                     SelectionChanged="SessionTimeoutComboBox_SelectionChanged"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="200"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Storage">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

            <!-- Database Settings -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{StaticResource ModernWarningBrush}"
                              
                               Width="24"
                               Height="24"
                               CornerRadius="6"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE8F7;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Authentication and Storage" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="16">
                        <StackPanel Margin="8">
                            <TextBlock Text="Authentication Mode" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="AuthModeComboBox"
                                     ItemsSource="{Binding AuthenticationModes}"
                                     SelectedItem="{Binding AuthenticationMode, Mode=TwoWay}"
                                     SelectionChanged="AuthModeComboBox_SelectionChanged"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="240"/>
                        </StackPanel>
                        
                        <!-- 1Password Connect (API import) — always available; used by the mobile apps. -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                                BorderBrush="{DynamicResource ModernBorderBrush}">
                            <StackPanel Margin="16">
                                <TextBlock Text="Import from 1Password (API)"
                                           Style="{StaticResource ModernBodyStyle}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Save your 1Password Connect server URL and access token (or a Service Account token). The mobile apps use this to import directly; on desktop you can still import a 1PUX/CSV file from the Import page."
                                           Style="{StaticResource ModernCaptionStyle}"
                                           TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <StackPanel Margin="8">
                                    <TextBlock Text="Connect server URL"
                                               Style="{StaticResource ModernCaptionStyle}"
                                               FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding OnePasswordHost, Mode=TwoWay}"
                                             ui:ControlHelper.PlaceholderText="https://connect.example.com"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinWidth="360"/>
                                </StackPanel>
                                <StackPanel Margin="8">
                                    <TextBlock Text="Access token"
                                               Style="{StaticResource ModernCaptionStyle}"
                                               FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding OnePasswordToken, Mode=TwoWay}"
                                             ui:ControlHelper.PlaceholderText="Connect / Service Account token"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinWidth="360"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ApiSettingsPanel"
                               Style="{StaticResource SettingsSectionStyle}"
                               BorderBrush="{DynamicResource ModernBorderBrush}"
                               Visibility="{Binding AuthenticationMode, Converter={StaticResource ApiModeToVisibilityConverter}}">
                            <StackPanel Margin="16">
                                <TextBlock Text="API Configuration"
                                          Style="{StaticResource ModernBodyStyle}"
                                          FontWeight="SemiBold"/>
                                <StackPanel Margin="8">
                                    <TextBlock Text="API Base URL" 
                                              Style="{StaticResource ModernCaptionStyle}"
                                              FontWeight="SemiBold"/>
                                    <TextBox x:Name="ApiUrlTextBox"
                                            Text="{Binding ApiBaseUrl, Mode=TwoWay}"
                                            ui:ControlHelper.PlaceholderText="https://vaultguardapi.dotnetappdevni.com"
                                            Style="{StaticResource ModernTextBoxStyle}"
                                            MinWidth="360"/>
                                    <TextBlock Text="Configure the base URL for the Vault Guard API server." 
                                              Style="{StaticResource ModernCaptionStyle}"
                                              TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="8">
                                    <TextBlock Text="API Key"
                                              Style="{StaticResource ModernCaptionStyle}"
                                              FontWeight="SemiBold"/>
                                    <TextBox x:Name="ApiKeyTextBox" Text="{Binding ApiKey, Mode=TwoWay}"
                                            ui:ControlHelper.PlaceholderText="vg_..."
                                            Style="{StaticResource ModernTextBoxStyle}"
                                            MinWidth="360"/>
                                </StackPanel>
                                <Border Margin="8,4,8,4" Padding="12" CornerRadius="8"
                                        Background="{DynamicResource ModernElevatedSurfaceBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Generate a real key from this API"
                                                  Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6"
                                                  Style="{StaticResource ModernCaptionStyle}"
                                                  Text="A key only works against the API server that created it. Enter your account email and master password to have the API above issue a key into its own database — that's the key the test needs. (A locally-made key is rejected by the remote API with 401/403.)"/>
                                        <TextBox x:Name="IssueEmailTextBox"
                                                ui:ControlHelper.PlaceholderText="you@example.com"
                                                Style="{StaticResource ModernTextBoxStyle}" MinWidth="360" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="IssueMasterPasswordBox"
                                                Style="{StaticResource ModernPasswordBoxStyle}" MinWidth="360"/>
                                        <Button x:Name="GenerateApiKeyFromServerButton" Margin="0,8,0,0"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource ModernSecondaryButtonStyle}"
                                               Click="GenerateApiKeyFromServerButton_Click">
                                            <StackPanel Orientation="Horizontal" Margin="8">
                                                <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate key from server &amp; save"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="8">
                                    <TextBlock Text="Client ID"
                                              Style="{StaticResource ModernCaptionStyle}"
                                              FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding ApiClientId, Mode=TwoWay}"
                                            ui:ControlHelper.PlaceholderText="Optional client id"
                                            Style="{StaticResource ModernTextBoxStyle}"
                                            MinWidth="360"/>
                                </StackPanel>
                                <StackPanel Margin="8">
                                    <TextBlock Text="Client Secret"
                                              Style="{StaticResource ModernCaptionStyle}"
                                              FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding ApiClientSecret, Mode=TwoWay}"
                                            ui:ControlHelper.PlaceholderText="Optional client secret"
                                            Style="{StaticResource ModernTextBoxStyle}"
                                            MinWidth="360"/>
                                </StackPanel>
                                <TextBlock Text="SQL Server details for the API database"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          FontWeight="SemiBold"
                                          Margin="8,12,8,0"/>
                                <TextBlock Text="These values are shared with the API and Blazor settings so one SQL Server setup can be reused everywhere."
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Margin="8,0,8,4"
                                          TextWrapping="Wrap"/>
                                <UniformGrid Columns="2" Margin="8,0,8,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Server"
                                                  Style="{StaticResource ModernCaptionStyle}"
                                                  FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding ApiDbServer, Mode=TwoWay}"
                                                ui:ControlHelper.PlaceholderText="sql.example.com"
                                                Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="Database"
                                                  Style="{StaticResource ModernCaptionStyle}"
                                                  FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding ApiDbName, Mode=TwoWay}"
                                                ui:ControlHelper.PlaceholderText="VaultGuard"
                                                Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="8,0,8,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="User"
                                                  Style="{StaticResource ModernCaptionStyle}"
                                                  FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding ApiDbUser, Mode=TwoWay}"
                                                ui:ControlHelper.PlaceholderText="sa"
                                                Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="Password"
                                                  Style="{StaticResource ModernCaptionStyle}"
                                                  FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding ApiDbPassword, Mode=TwoWay}"
                                                ui:ControlHelper.PlaceholderText="Database password"
                                                Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="8,8,8,0">
                                    <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                           Click="TestApiConnectionButton_Click">
                                        <StackPanel Orientation="Horizontal" Margin="8">
                                            <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Test API Connection"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="8">
                            <TextBlock Text="Database Provider (Local Mode Only)" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="DatabaseProviderComboBox"
                                     IsEnabled="{Binding AuthenticationMode, Converter={StaticResource LocalModeToEnabledConverter}}"
                                     SelectedIndex="{Binding SelectedDatabaseProviderIndex, Mode=TwoWay}"
                                     SelectionChanged="DatabaseProviderComboBox_SelectionChanged"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="240">
                                <ComboBoxItem IsSelected="True"/>
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- SQLite Path Configuration -->
                        <StackPanel x:Name="SqlitePathPanel"
                                   Margin="8"
                                   Visibility="Visible">
                            <TextBlock Text="Current SQLite Database Location" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <TextBox x:Name="CurrentDbPathTextBox"
                                    IsReadOnly="True"
                                    Style="{StaticResource ModernTextBoxStyle}"
                                    MinWidth="360"
                                    FontFamily="Consolas"
                                    FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="OpenDatabaseFolderButton_Click"
                                       ToolTipService.ToolTip="Open the database folder in File Explorer">
                                    <StackPanel Orientation="Horizontal" Margin="6">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Folder"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="CopyDatabasePathButton_Click"
                                       ToolTipService.ToolTip="Copy database path to clipboard">
                                    <StackPanel Orientation="Horizontal" Margin="6">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copy Path"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="This is the active database file location. To change it, configure the database provider below." 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                            
                            <TextBlock Text="Custom SQLite Database Path" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"
                                      Margin="0,12,0,0"/>
                            <TextBox x:Name="SqlitePathTextBox"
                                    Text="{Binding SqliteDatabasePath, Mode=TwoWay}"
                                    ui:ControlHelper.PlaceholderText="passwordmanager.db"
                                    Style="{StaticResource ModernTextBoxStyle}"
                                    MinWidth="360"/>
                            <TextBlock Text="Path to the SQLite database file (absolute or relative to app data folder)." 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               IsEnabled="{Binding AuthenticationMode, Converter={StaticResource LocalModeToEnabledConverter}}"
                               Click="ConfigureDatabaseButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE8F7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Configure Database Connection"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Seed Data Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="SeedDataButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   HorizontalAlignment="Left"
                                   IsEnabled="{Binding AuthenticationMode, Converter={StaticResource LocalModeToEnabledConverter}}"
                                   Click="SeedDataButton_Click"
                                   ToolTipService.ToolTip="Seed categories, collections, and tags for the current user">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Seed Sample Data"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearSeedDataButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   HorizontalAlignment="Left"
                                   Margin="8,0,0,0"
                                   IsEnabled="{Binding AuthenticationMode, Converter={StaticResource LocalModeToEnabledConverter}}"
                                   Click="ClearSeedDataButton_Click"
                                   ToolTipService.ToolTip="Remove all seed/test data for the current user">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Clear Seed Data"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <ui:ToggleSwitch x:Name="SyncToggle"
                                     Header="Enable Cloud Sync"
                                     IsOn="{Binding EnableSync, Mode=TwoWay}"
                                     Toggled="SyncToggle_Toggled"
                                     Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Backup, Import &amp; Export">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

            <!-- Cloud Backup Settings -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{DynamicResource ModernSurfaceBrush}"
                              
                               Width="24"
                               Height="24"
                               CornerRadius="6"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Cloud Backup" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="16">
                        <ui:ToggleSwitch x:Name="CloudBackupToggle"
                                         Header="Enable Automatic Cloud Backup"
                                         OnContent="On" OffContent="Off"
                                         IsOn="{Binding EnableCloudBackup, Mode=TwoWay}"
                                         Toggled="CloudBackupToggle_Toggled"
                                         HorizontalAlignment="Left"
                                         Margin="0,0,0,4"/>

                        <!-- Always visible (toggling this with the EnableCloudBackup converter while the
                             provider combo realized caused a mid-layout re-parent crash). -->
                        <StackPanel Margin="8">
                            <TextBlock Text="Cloud Provider"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="CloudProviderComboBox"
                                     ItemsSource="{Binding AvailableCloudProviders}"
                                     SelectedValue="{Binding SelectedCloudProvider, Mode=TwoWay}"
                                     SelectedValuePath="Provider"
                                     DisplayMemberPath="DisplayName"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     SelectionChanged="CloudProviderComboBox_SelectionChanged"
                                     MinWidth="200"/>
                        </StackPanel>

                        <!-- Backup Schedule Settings (kept above the per-provider Test Connection actions) -->
                        <StackPanel Margin="8,4,8,8">
                            <TextBlock Text="Backup Schedule"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox
                                     ItemsSource="{Binding ScheduleIntervalOptions}"
                                     SelectedValue="{Binding BackupScheduleInterval, Mode=TwoWay}"
                                     SelectedValuePath="Interval"
                                     DisplayMemberPath="DisplayName"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="200"/>

                            <!-- Time Picker for preferred backup time -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding AutoBackupEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Preferred Backup Time"
                                          Style="{StaticResource ModernCaptionStyle}"/>
                                <TextBlock Text="{Binding NextScheduledBackupFormatted}"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                          Visibility="{Binding NextScheduledBackupFormatted, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Google Drive OAuth Settings -->
                        <StackPanel Margin="8" x:Name="GoogleDriveSettingsPanel"
                                    Visibility="{Binding IsGoogleDriveSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Google Drive — OAuth Credentials"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="Create OAuth 2.0 credentials (type: Desktop app) at console.cloud.google.com. Enable the Google Drive API, then paste the Client ID and Secret below."
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                      Margin="0,4,0,8"/>

                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="Client ID" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding GoogleDriveClientId, Mode=TwoWay}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="123456789-abc...apps.googleusercontent.com"
                                         MinWidth="400"/>
                            </StackPanel>

                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="Client Secret" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="GDriveClientSecretBox"
                                             Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="GDriveClientSecretBox_PasswordChanged"
                                             MinWidth="400"/>
                            </StackPanel>

                            <!-- Connection status -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8"
                                       Visibility="{Binding GoogleDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                         Foreground="{StaticResource ModernSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GoogleDriveAccountInfo}"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{StaticResource ModernSuccessBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                       Click="ConnectGoogleDriveButton_Click"
                                       Visibility="{Binding GoogleDriveConnected, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Connect Google Drive"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="DisconnectGoogleDriveButton_Click"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding GoogleDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Disconnect"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- OneDrive OAuth Settings -->
                        <StackPanel Margin="8" x:Name="OneDriveSettingsPanel"
                                    Visibility="{Binding IsOneDriveSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="OneDrive — Sign in with Microsoft"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>

                            <TextBlock Text="Sign in seamlessly with VaultGuard's built-in Microsoft app registration — just click Sign in, no setup required."
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                      Margin="0,4,0,8"/>

                            <!-- Connection status, plus a live green/red reachability dot driven by a
                                 background timer (SettingsPage.xaml.cs) that pings OneDrive periodically
                                 without requiring the user to restart the app. -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8"
                                       Visibility="{Binding OneDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                         Foreground="{StaticResource ModernSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OneDriveAccountInfo}"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{StaticResource ModernSuccessBrush}"
                                          VerticalAlignment="Center"/>
                                <Border Width="8" Height="8" CornerRadius="4" Margin="10,0,4,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding OneDriveOnline, Converter={StaticResource OnlineStatusToBrushConverter}}"
                                        Visibility="{Binding OneDriveOnline, Converter={StaticResource OnlineStatusToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding OneDriveOnline, Converter={StaticResource OnlineStatusToTextConverter}}"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{Binding OneDriveOnline, Converter={StaticResource OnlineStatusToBrushConverter}}"
                                          Visibility="{Binding OneDriveOnline, Converter={StaticResource OnlineStatusToVisibilityConverter}}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                       Click="ConnectOneDriveButton_Click"
                                       Visibility="{Binding OneDriveConnected, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sign in with Microsoft"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="DisconnectOneDriveButton_Click"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding OneDriveConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sign out"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- NAS / Network Drive Configuration -->
                        <StackPanel Margin="8" x:Name="NetworkLocationPanel"
                                    Visibility="{Binding IsNetworkLocationSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="NAS / Network Drive"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="Back up to a NAS or any network share. Pick one of the network drives mapped on this PC, or type a UNC path directly. Tick &quot;Requires authentication&quot; if the share needs its own username and password."
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                      Margin="0,4,0,8"/>

                            <!-- Mapped drives detected on this machine -->
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="Mapped network drives" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="MappedDriveComboBox"
                                              ItemsSource="{Binding MappedDrives}"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="MappedDriveComboBox_SelectionChanged"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ui:ControlHelper.PlaceholderText="No mapped drives — type a UNC path below"
                                              MinWidth="320"/>
                                    <Button x:Name="RefreshMappedDrivesButton"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="RefreshMappedDrivesButton_Click"
                                            Margin="8,0,0,0" VerticalAlignment="Bottom"
                                            ToolTip="Re-scan mapped drives">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="4"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="Path (UNC or mapped drive)" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="NetworkPathTextBox"
                                            Text="{Binding NetworkPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ui:ControlHelper.PlaceholderText="\\server\share\folder or Z:\backups"
                                            Style="{StaticResource ModernTextBoxStyle}"
                                            MinWidth="320"/>
                                    <Button x:Name="ChooseNetworkLocationButton"
                                           Style="{StaticResource ModernSecondaryButtonStyle}"
                                           Click="ChooseNetworkLocationButton_Click"
                                           Margin="8,0,0,0" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Margin="8">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Browse"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ui:ToggleSwitch Header="Requires authentication (share has its own credentials)"
                                     IsOn="{Binding NasRequireAuth, Mode=TwoWay}"
                                     Margin="0,8,0,4"/>

                            <!-- Credentials, only when the share requires them -->
                            <StackPanel Margin="0,0,0,4"
                                        Visibility="{Binding NasRequireAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="Username" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NasUsername, Mode=TwoWay}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             ui:ControlHelper.PlaceholderText="DOMAIN\user or nasuser"
                                             MinWidth="320"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="Password" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="NasPasswordBox"
                                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                                 PasswordChanged="NasPasswordBox_PasswordChanged"
                                                 MinWidth="320"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding NasStatus}"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Margin="0,4,0,8"/>

                            <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                   Click="TestNasConnectionButton_Click"
                                   HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Test Connection"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- FTP / FTPS Settings -->
                        <StackPanel Margin="8" x:Name="FtpSettingsPanel"
                                    Visibility="{Binding IsFtpSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="FTP / FTPS Connection"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="Save backups to any FTP or FTPS site — a remote server or hosting account. To back up to a NAS or network share on your LAN, use the NAS / Network Drive provider instead. Combine this with the Backup Schedule above to run off-site backups automatically."
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                      Margin="0,4,0,8"/>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding FtpHost, Mode=TwoWay}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             ui:ControlHelper.PlaceholderText="nas.local or 192.168.1.10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding FtpPort, Mode=TwoWay}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="Username" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding FtpUsername, Mode=TwoWay}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         MinWidth="300"/>
                            </StackPanel>

                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="Password" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="FtpPasswordBox"
                                             Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="FtpPasswordBox_PasswordChanged"
                                             MinWidth="300"/>
                            </StackPanel>

                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="Remote Directory" Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding FtpRemoteDirectory, Mode=TwoWay}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="/backups/passwordmanager"
                                         MinWidth="300"/>
                            </StackPanel>

                            <ui:ToggleSwitch Header="Use FTPS (FTP over TLS) — recommended"
                                     IsOn="{Binding FtpUseFtps, Mode=TwoWay}"
                                     Margin="0,4,0,8"/>

                            <TextBlock Text="{Binding FtpStatus}"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,8"/>

                            <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                   Click="TestFtpConnectionButton_Click"
                                   HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Test Connection"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="12">
                            <TextBlock Text="Backup Management"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="CreateBackupButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="CreateBackupButton_Click"
                                       Margin="0,0,12,0"
                                       IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Create Backup"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="RefreshBackupsButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="RefreshBackupsButton_Click"
                                       IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button x:Name="RestoreFromFileButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="RestoreFromFileButton_Click"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,10,0,0"
                                   IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="8,14" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restore from File" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- iPhone-style save points list -->
                            <TextBlock Text="SAVE POINTS" FontSize="10" FontWeight="SemiBold"
                                      Margin="4,8,0,6" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>

                            <ItemsControl x:Name="BackupsListView" ItemsSource="{Binding AvailableBackups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="12"
                                               Background="#12FFFFFF"
                                               BorderBrush="#25FFFFFF" BorderThickness="1">
                                            <Grid Margin="14,12,14,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Cloud icon -->
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                       Background="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                                              FontSize="18" Foreground="White"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Date / meta -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CreatedAtFormatted}"
                                                              FontSize="14" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ServiceName}" FontSize="11"
                                                                  Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                                        <TextBlock Text=" · " FontSize="11"
                                                                  Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11"
                                                                  Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <!-- Browse button -->
                                                    <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                                           Padding="8,5" Margin="0,0,6,0"
                                                           Click="BrowseBackupButton_Click"
                                                           ToolTipService.ToolTip="Browse items and selectively restore"
                                                           Tag="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                                      FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Browse" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Restore All button -->
                                                    <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                                           Padding="14,6" Margin="0,0,6,0" MinWidth="124"
                                                           Click="RestoreBackupButton_Click"
                                                           ToolTipService.ToolTip="Restore entire backup — replaces all current data"
                                                           Tag="{Binding}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                                      FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Restore All" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Delete -->
                                                    <Button Background="#CC2222" Foreground="White"
                                                           BorderThickness="0" Padding="8,5"
                                                           Click="DeleteBackupButton_Click"
                                                           ToolTipService.ToolTip="Delete this backup"
                                                           Tag="{Binding}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state shown when there are no save points yet -->
                            <Border Margin="0,2,0,0" CornerRadius="12" Padding="20,24"
                                   Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                   Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                              HorizontalAlignment="Center" Opacity="0.5"
                                              Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    <TextBlock Text="No save points yet"
                                              FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                              Margin="0,10,0,2"/>
                                    <TextBlock Text="Create a backup to store an encrypted copy of your vault in the cloud. It'll appear here, ready to browse or restore."
                                              FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                              Opacity="0.65" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Browser Export Settings -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{StaticResource ModernWarningBrush}"
                              
                               Width="24"
                               Height="24"
                               CornerRadius="6"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Browser Export" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="12">
                        <TextBlock Text="Export passwords to browser password managers" 
                                  Style="{StaticResource ModernCaptionStyle}"
                                  TextWrapping="Wrap"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Button x:Name="ExportToChromeButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="ExportToBrowserButton_Click"
                                   Tag="Chrome">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Export to Chrome"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="ExportToEdgeButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="ExportToBrowserButton_Click"
                                   Tag="Edge">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Export to Edge"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Import/Export Settings -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{StaticResource ModernSuccessBrush}"
                              
                               Width="24"
                               Height="24"
                               CornerRadius="6"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Local Import/Export" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="16">
                        <StackPanel Margin="8">
                            <TextBlock Text="Export Path" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                        Text="{Binding ExportPath, Mode=TwoWay}" 
                                        IsReadOnly="True" 
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="ChooseExportFolderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        
                        <Button x:Name="ExportButton"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Click="ExportButton_Click"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE8C5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export All Passwords"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Import Section -->
                        <!-- User Selection -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Import For" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"
                                      AutomationProperties.HeadingLevel="Level3"/>
                            <ComboBox x:Name="ImportUserModeComboBox"
                                     MinWidth="240"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     SelectionChanged="ImportUserModeComboBox_SelectionChanged"
                                     AutomationProperties.Name="Select import target mode"
                                     AutomationProperties.HelpText="Choose how to distribute imported passwords to users">
                                <ComboBoxItem
                                            Content="Current User (your account only)"
                                            Tag="current"
                                            IsSelected="True"
                                            AutomationProperties.Name="Current User - Import passwords only for your account"/>
                                <ComboBoxItem
                                            Content="All Users"
                                            Tag="all"
                                            AutomationProperties.Name="All Users - Import passwords accessible to all system users"/>
                                <ComboBoxItem
                                            Content="Select Multiple Users…"
                                            Tag="multiple"
                                            AutomationProperties.Name="Select Multiple Users - Choose specific users to import passwords for"/>
                            </ComboBox>
                            
                            <!-- Multi-user selection panel -->
                            <StackPanel x:Name="MultiUserSelectionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="Select Users" 
                                          Style="{StaticResource ModernCaptionStyle}"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,4"/>
                                <Border BorderBrush="{DynamicResource ModernBorderBrush}"
                                       BorderThickness="1"
                                      
                                       MaxHeight="200">
                                    <ListView x:Name="UserSelectionListView"
                                             SelectionMode="Multiple"
                                             AutomationProperties.Name="Select users for import">
                                        <!-- Users will be populated dynamically -->
                                    </ListView>
                                </Border>
                            </StackPanel>
                            
                            <TextBlock x:Name="ImportUserHintText"
                                      Text="Passwords will be imported to your current account"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Import From" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"
                                      AutomationProperties.HeadingLevel="Level3"/>
                            <ComboBox x:Name="ImportTypeComboBox"
                                     MinWidth="240"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     SelectionChanged="ImportTypeComboBox_SelectionChanged"
                                     AutomationProperties.Name="Select password manager import source"
                                     AutomationProperties.HelpText="Choose the password manager format you want to import from, such as 1Password, Bitwarden, Chrome, or other supported formats">
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Margin="8">
                            <TextBlock Text="Select File" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"
                                      AutomationProperties.HeadingLevel="Level3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ImportFilePathTextBox"
                                        Grid.Column="0" 
                                        IsReadOnly="True"
                                        ui:ControlHelper.PlaceholderText="Choose a file to import..."
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        AutomationProperties.Name="Selected import file path"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="BrowseImportFileButton"
                                       Grid.Column="1" 
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="BrowseImportFileButton_Click"
                                       AutomationProperties.Name="Browse for import file"
                                       AutomationProperties.HelpText="Open file picker to select a password export file to import">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Browse"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="StartImportButton"
                                   Style="{StaticResource ModernPrimaryButtonStyle}"
                                   Click="StartImportButton_Click"
                                   IsEnabled="False"
                                   MinWidth="140"
                                   AutomationProperties.Name="Start password import"
                                   AutomationProperties.HelpText="Begin importing passwords from the selected file">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Start Import" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="ClearImportButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="ClearImportButton_Click"
                                   MinWidth="120"
                                   Margin="8,0,0,0"
                                   AutomationProperties.Name="Clear import selections"
                                   AutomationProperties.HelpText="Reset all import selections and start over">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <!-- Import Status -->
                        <Border x:Name="ImportStatusBorder"
                               Background="{DynamicResource ModernSurfaceBrush}"
                               BorderBrush="#333333"
                               BorderThickness="1"
                              
                               Padding="16"
                               Margin="0,12,0,0"
                               Visibility="Collapsed"
                               AutomationProperties.Name="Import status panel"
                               AutomationProperties.LiveSetting="Assertive">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <ui:ProgressRing x:Name="ImportProgressRing" 
                                                 IsActive="False" 
                                                 Width="20" 
                                                 Height="20"
                                                 AutomationProperties.Name="Import progress indicator"/>
                                    <TextBlock x:Name="ImportStatusText"
                                              Text="Ready to import"
                                              Style="{StaticResource ModernBodyStyle}"
                                              FontWeight="SemiBold"
                                              AutomationProperties.LiveSetting="Assertive"/>
                                </StackPanel>
                                
                                <!-- Progress Bar -->
                                <StackPanel x:Name="ImportProgressPanel" Margin="4" Visibility="Collapsed">
                                    <Grid>
                                        <ProgressBar x:Name="ImportProgressBar"
                                                    Height="8"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="0"
                                                    IsIndeterminate="True"/>
                                    </Grid>
                                    <TextBlock x:Name="ImportProgressText"
                                              Text="Processing..."
                                              Style="{StaticResource ModernCaptionStyle}"
                                              Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                              AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                
                                <TextBox x:Name="ImportResultText"
                                         Text=""
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         MaxHeight="160"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="12"
                                         Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                         AutomationProperties.LiveSetting="Assertive"/>
                                <Button x:Name="OpenImportLogButton"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Click="OpenImportLogButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Log File" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Maintenance">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

            <!-- Database Management -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="{StaticResource ModernWarningBrush}"
                              
                               Width="24"
                               Height="24"
                               CornerRadius="6"
                               Margin="0,0,10,0">
                            <TextBlock Text="&#xE8F7;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Database Management" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="16">
                        <!-- Reset Password Data -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                               Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{StaticResource ModernErrorBrush}">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" 
                                             FontSize="16"
                                             Foreground="{StaticResource ModernWarningBrush}"/>
                                    <TextBlock Text="Reset Password Data" 
                                              FontWeight="SemiBold"
                                              FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Clears all password items, collections, categories, and tags while preserving your user account and login credentials." 
                                          Style="{StaticResource ModernCaptionStyle}"
                                          TextWrapping="Wrap"
                                          Opacity="0.8"/>
                                
                                <Button x:Name="ResetDataButton"
                                       Background="Transparent"
                                       BorderBrush="{StaticResource ModernWarningBrush}"
                                       BorderThickness="1"
                                       Foreground="{StaticResource ModernWarningBrush}"
                                       Padding="16,10"
                                       HorizontalAlignment="Left"
                                       Click="ResetDataButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ModernWarningBrush}"/>
                                        <TextBlock Text="Reset Password Data" Foreground="{StaticResource ModernWarningBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Delete Seed Data (keeps user accounts) -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                               Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{StaticResource ModernWarningBrush}">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                             FontSize="16"
                                             Foreground="{StaticResource ModernWarningBrush}"/>
                                    <TextBlock Text="Delete Seed Data"
                                              FontWeight="SemiBold"
                                              FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Removes the built-in demo data (password items, categories, collections, tags) and stops it being re-added on next launch. Your user accounts are always kept."
                                          Style="{StaticResource ModernCaptionStyle}"
                                          TextWrapping="Wrap"
                                          Opacity="0.8"/>

                                <CheckBox x:Name="KeepCategoriesCheckBox"
                                         Content="Keep my categories, collections &amp; tags (only delete items)"
                                         Margin="8,8,8,4"/>

                                <Button x:Name="DeleteSeedDataButton"
                                       Background="Transparent"
                                       BorderBrush="{StaticResource ModernWarningBrush}"
                                       BorderThickness="1"
                                       Foreground="{StaticResource ModernWarningBrush}"
                                       Padding="16,10"
                                       HorizontalAlignment="Left"
                                       Click="DeleteSeedDataButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ModernWarningBrush}"/>
                                        <TextBlock Text="Delete Seed Data" Foreground="{StaticResource ModernWarningBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Delete User Accounts (keep admins) -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                               Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{StaticResource ModernErrorBrush}">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                             FontSize="16"
                                             Foreground="{StaticResource ModernErrorBrush}"/>
                                    <TextBlock Text="Delete User Accounts"
                                              FontWeight="SemiBold"
                                              FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Permanently deletes all non-admin user accounts (including the built-in demo/test user) and the data they own. Accounts in the Admin role are kept."
                                          Style="{StaticResource ModernCaptionStyle}"
                                          TextWrapping="Wrap"
                                          Opacity="0.8"/>

                                <Button x:Name="DeleteUsersButton"
                                       Background="Transparent"
                                       BorderBrush="{StaticResource ModernErrorBrush}"
                                       BorderThickness="1"
                                       Foreground="{StaticResource ModernErrorBrush}"
                                       Padding="16,10"
                                       HorizontalAlignment="Left"
                                       Click="DeleteUsersButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ModernErrorBrush}"/>
                                        <TextBlock Text="Delete Users (keep admins)" Foreground="{StaticResource ModernErrorBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Reset All Data — master/account-destroying danger zone -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                               Background="#1A0F0F"
                               BorderBrush="#DA3633"
                               BorderThickness="2">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                             FontSize="16"
                                             Foreground="#F85149"/>
                                    <TextBlock Text="Reset All Database Tables"
                                              FontWeight="SemiBold"
                                              FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="⚠️ DANGER: Clears ALL database tables including user accounts. This will log you out and reset the database to default state." 
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{StaticResource ModernErrorBrush}"
                                          TextWrapping="Wrap"
                                          FontWeight="SemiBold"/>
                                
                                <Button x:Name="ResetAllButton"
                                       Background="{StaticResource ModernErrorBrush}"
                                       Foreground="White"
                                       BorderThickness="0"
                                      
                                       Padding="16,12"
                                       HorizontalAlignment="Left"
                                       Click="ResetAllButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reset All Tables"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <!-- Secure Wipe Database -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                               Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="#dc2626"
                               BorderThickness="2">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE107;" FontFamily="Segoe MDL2 Assets" 
                                             FontSize="16"
                                             Foreground="#dc2626"/>
                                    <TextBlock Text="Secure Wipe Database" 
                                              FontWeight="Bold"
                                              Foreground="#dc2626"
                                              FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="🔒 SECURE DELETE: Clears all tables and securely deletes the database file (SQLite only). For SQL Server, clears all tables. Cannot be undone!" 
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="#dc2626"
                                          TextWrapping="Wrap"
                                          FontWeight="Bold"/>
                                
                                <Button x:Name="SecureWipeButton"
                                       Background="#dc2626"
                                       Foreground="White"
                                       BorderThickness="0"
                                      
                                       Padding="16,12"
                                       HorizontalAlignment="Left"
                                       Click="SecureWipeButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE107;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Secure Wipe"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <!-- Reseed Sample Data -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                               Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="#333333">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" 
                                             FontSize="16"
                                             Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    <TextBlock Text="Reseed Sample Data" 
                                              FontWeight="SemiBold"
                                              FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Adds sample categories, collections, and password items to help you get started. Does not delete existing data." 
                                          Style="{StaticResource ModernCaptionStyle}"
                                          TextWrapping="Wrap"
                                          Opacity="0.8"/>
                                
                                <Button x:Name="ReseedSampleButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Background="{DynamicResource ModernSurfaceBrush}"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       Click="ReseedSampleButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reseed Sample Data"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Shortcuts">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

                        <!-- Key Bindings: General -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="20">
                                <StackPanel Orientation="Horizontal" Margin="12">
                                    <Border Background="#5B4FCF" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Keyboard Shortcuts — General" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="16,8,16,4">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="New item" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + N" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Focus / run search" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + F  ·  Enter" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Clear search" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Esc" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Open Settings" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + ," FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lock vault" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + L" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Key Bindings: Selected item -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="20">
                                <StackPanel Orientation="Horizontal" Margin="12">
                                    <Border Background="#059669" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Keyboard Shortcuts — Selected Item" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="16,8,16,4">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Copy password" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + C" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Copy username" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + Shift + C" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Open &amp; fill in browser" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + O" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Edit item" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Ctrl + E" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Delete item" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="8,3">
                                            <TextBlock Text="Del" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="These shortcuts are active throughout the app. Item actions apply to the currently selected item. Custom rebinding is coming soon."
                                               Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="About">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <WrapPanel Orientation="Horizontal" ItemWidth="560" MaxWidth="1132" HorizontalAlignment="Left">

            <!-- About -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <Border Background="#1D4ED8" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="About VaultGuard" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Logo -->
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16" Margin="0,0,20,0"
                                Background="{StaticResource ModernPrimaryGradientBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="VaultGuard Vault Guard"
                                      FontSize="18" FontWeight="SemiBold"
                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock x:Name="AppVersionText" Text="Version 1.0.0 · Windows Desktop"
                                      Style="{StaticResource ModernCaptionStyle}" Margin="0,4,0,0"/>
                            <TextBlock Text="The best open-source password manager for Windows and Web."
                                      Style="{StaticResource ModernCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Separator Margin="0,12" Background="#333"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Build"
                                          Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BuildDateText"
                                          Text="2025" Style="{StaticResource ModernCaptionStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Platform"
                                          Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="WPF · Windows Desktop"
                                          Style="{StaticResource ModernCaptionStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime"
                                          Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RuntimeText"
                                          Text=".NET" Style="{StaticResource ModernCaptionStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Encryption"
                                          Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="AES-256-GCM"
                                          Style="{StaticResource ModernCaptionStyle}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Built with " Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{DynamicResource ModernTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="#E0245E" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BuiltWithText" Text=" using .NET"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{DynamicResource ModernTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Configurable update source (JSON version manifest on GitHub) -->
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Product Update URL"
                                          Style="{StaticResource ModernCaptionStyle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Points to a JSON version manifest (app name, version, features, whether a restart is required, and the installer download link)."
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                          TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <TextBox Text="{Binding UpdateManifestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        ui:ControlHelper.PlaceholderText="https://raw.githubusercontent.com/.../version.json"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="CheckUpdatesButton" Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="CheckUpdatesButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="6">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for Updates"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernSecondaryButtonStyle}" Margin="8,0,0,0"
                                        Click="OpenDocumentationButton_Click">
                                    <StackPanel Orientation="Horizontal" Margin="6">
                                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        <TextBlock Text="Documentation"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Update Status Panel (hidden until check runs) -->
                            <Border x:Name="UpdateStatusPanel" Visibility="Collapsed"
                                    Background="{DynamicResource ModernCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,12,0,0" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                                               Style="{StaticResource ModernCaptionStyle}"/>
                                    <TextBlock x:Name="UpdateFeaturesText" TextWrapping="Wrap" Visibility="Collapsed"
                                               Style="{StaticResource ModernCaptionStyle}"
                                               Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                               Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed"
                                                 Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="DownloadUpdateButton" Visibility="Collapsed"
                                                Style="{StaticResource ModernPrimaryButtonStyle}"
                                                Click="DownloadUpdateButton_Click">
                                            <StackPanel Orientation="Horizontal" Margin="6">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                <TextBlock Text="Download &amp; Install"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="OpenReleasesButton" Visibility="Collapsed"
                                                Style="{StaticResource ModernSecondaryButtonStyle}" Margin="8,0,0,0"
                                                Click="OpenReleasesButton_Click">
                                            <StackPanel Orientation="Horizontal" Margin="6">
                                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                <TextBlock Text="View on GitHub"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sentry Error Reporting -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#DC2626" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Error Reporting (Sentry.io)" Style="{StaticResource ModernHeading3Style}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Paste your Sentry DSN below to enable automatic crash and error reporting. Leave blank to disable. The DSN is stored locally and never shared."
                              Style="{StaticResource ModernCaptionStyle}"
                              Foreground="{DynamicResource ModernTextSecondaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Sentry DSN"
                              Style="{StaticResource ModernCaptionStyle}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,4"/>
                    <TextBox x:Name="SentryDsnTextBox"
                            Text="{Binding SentryDsn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ModernTextBoxStyle}"
                            ui:ControlHelper.PlaceholderText="https://key@o123456.ingest.sentry.io/project-id"
                            Margin="0,0,0,12"/>
                    <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="SaveSentrySettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save &amp; Apply" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Loading Indicator -->
            <Border Grid.Row="1" Style="{StaticResource SettingsSectionStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="32"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="16" HorizontalAlignment="Center">
                    <ui:ProgressRing IsActive="True" Width="32" Height="32"/>
                    <TextBlock Text="Saving settings..." 
                              Style="{StaticResource ModernBodyStyle}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
</Page>
