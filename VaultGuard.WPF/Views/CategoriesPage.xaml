<Page
    x:Class="VaultGuard.WPF.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">
            
            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Border Background="{StaticResource ModernSuccessBrush}"
                                  
                                   Width="32"
                                   Height="32">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" 
                                         FontSize="16"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Categories" 
                                      Style="{StaticResource ModernHeading3Style}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Organize your passwords with custom categories"
                                  Style="{StaticResource ModernCaptionStyle}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               Click="RefreshButton_Click"
                               Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AddCategoryButton"
                               Style="{StaticResource ModernPrimaryButtonStyle}"
                               Click="AddCategoryButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Add Category" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Search -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="8">
                    <TextBlock Text="Search Categories" 
                              Style="{StaticResource ModernCaptionStyle}"
                              FontWeight="SemiBold"/>
                    <TextBox x:Name="SearchTextBox"
                            ui:ControlHelper.PlaceholderText="🔍 Search categories..."
                            Text="{Binding SearchText, Mode=TwoWay}"
                            Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>
            </Border>
            
            <!-- Categories Content -->
            <Grid MinHeight="400">
                
                <!-- Loading Indicator -->
                <Border Style="{StaticResource ModernCardStyle}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Padding="48"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="20" HorizontalAlignment="Center">
                        <ui:ProgressRing IsActive="True" Width="48" Height="48"/>
                        <TextBlock Text="Loading categories..." 
                                  Style="{StaticResource ModernBodyStyle}"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Categories GridView -->
                <ListView x:Name="CategoriesGridView"
                         ItemsSource="{Binding Categories}"
                         Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="CategoriesGridView_SelectionChanged">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CategoryCard"
                                   Width="264"
                                   MinHeight="158"
                                   CornerRadius="14"
                                   Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                   BorderBrush="#55FFFFFF"
                                   BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#000000" Opacity="0.35"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Coloured accent strip along the top so each card reads brightly -->
                                    <Border Grid.Row="0" Height="4" VerticalAlignment="Top" CornerRadius="14,14,0,0"
                                           Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"/>

                                    <!-- Category header: icon + name -->
                                    <StackPanel Grid.Row="0" Margin="18,20,18,12">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                                                   Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                   Opacity="0.28"/>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22"
                                                     Width="46" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource ModernTextPrimaryBrush}"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                      FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,0,0"
                                                      TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Description}"
                                                  FontSize="12.5"
                                                  Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                  TextWrapping="Wrap"
                                                  TextTrimming="CharacterEllipsis"
                                                  MaxHeight="36"
                                                  Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Footer action bar -->
                                    <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0"
                                           CornerRadius="0,0,14,14" Background="#1FFFFFFF">
                                        <Grid Margin="14,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Favourite toggle -->
                                            <Button Grid.Column="0" x:Name="ToggleFavoriteButton"
                                                   Background="Transparent" BorderThickness="0"
                                                   HorizontalAlignment="Left" Width="32" Height="32" Padding="0"
                                                   Click="ToggleFavoriteButton_Click"
                                                   ToolTipService.ToolTip="Toggle favourite">
                                                <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ModernTextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ModernWarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <!-- Edit + Delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Width="32" Height="32" Padding="0"
                                                       Background="Transparent" BorderThickness="0"
                                                       Click="EditCategoryButton_Click"
                                                       ToolTipService.ToolTip="Edit category">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                             Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                                </Button>
                                                <Button Width="32" Height="32" Padding="0"
                                                       Background="Transparent" BorderThickness="0"
                                                       Click="DeleteCategoryButton_Click"
                                                       ToolTipService.ToolTip="Delete category">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                             Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ModernPrimaryBrush}"/>
                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,0,16,16"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                </ListView>
                
                <!-- Empty State -->
                <Border Style="{StaticResource ModernElevatedCardStyle}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Padding="48"
                       Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="20" HorizontalAlignment="Center">
                        <Border Background="{StaticResource ModernSuccessBrush}"
                              
                               Width="80"
                               Height="80"
                               HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="36"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Margin="8" HorizontalAlignment="Center">
                            <TextBlock Text="No categories found" 
                                      Style="{StaticResource ModernHeading3Style}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Create your first category to organize your passwords" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Button Style="{StaticResource ModernPrimaryButtonStyle}"
        Click="AddCategoryButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Margin="8">
                                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    <TextBlock Text="Add Your First Category"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Border>
                
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
