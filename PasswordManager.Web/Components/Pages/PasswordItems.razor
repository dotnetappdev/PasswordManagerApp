@page "/passwords"
@rendermode InteractiveServer
@using PasswordManager.Services.Interfaces
@using PasswordManager.Models
@inject IPasswordItemService PasswordItemService
@inject ICategoryInterface CategoryService
@inject IVaultService VaultService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>All Items - VaultGuard</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:700">All Items</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@(filteredItems?.Count ?? 0) items</MudText>
    </div>
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="@OpenTypePicker">Add Item</MudButton>
</MudStack>

<MudPaper Class="mb-3 pa-3" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="searchText" Placeholder="Search items..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          ValueChanged="@((string s) => { searchText = s; FilterItems(); })"
                          FullWidth="true" />
        </MudItem>
        <MudItem xs="6" md="4">
            <MudSelect T="string" @bind-Value="typeFilter" Label="Type" Variant="Variant.Outlined"
                       Margin="Margin.Dense" FullWidth="true"
                       ValueChanged="@((string s) => { typeFilter = s; FilterItems(); })">
                <MudSelectItem T="string" Value="@string.Empty">All Types</MudSelectItem>
                @foreach (ItemType t in Enum.GetValues<ItemType>())
                {
                    <MudSelectItem T="string" Value="@t.ToString()">@t.ToString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="3" Class="d-flex align-center">
            <MudCheckBox @bind-Value="favoritesOnly" Label="Favorites only" Color="Color.Warning"
                         ValueChanged="@((bool b) => { favoritesOnly = b; FilterItems(); })" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudDataGrid T="PasswordItem" Items="@filteredItems" Sortable="true" Hover="true"
                 Dense="true" Elevation="2" RowsPerPage="20">
        <Columns>
            <TemplateColumn Title="" CellStyle="width:44px; padding:8px 4px;">
                <CellTemplate>
                    <MudIcon Icon="@GetItemIcon(context.Item.Type)"
                             Style="@($"color:{GetItemColor(context.Item.Type)}")" Size="Size.Small" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Title" Title="Name" Sortable="true" />
            <TemplateColumn Title="Type" CellStyle="width:120px;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@GetChipColor(context.Item.Type)">
                        @context.Item.Type.ToString()
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Website" Title="Website" />
            <TemplateColumn Title="" CellStyle="width:32px;">
                <CellTemplate>
                    @if (context.Item.IsFavorite)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star"
                                 Style="color:#F59E0B;" Size="Size.Small" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.LastModified" Title="Modified"
                            Format="MMM d, yyyy" Sortable="true" />
            <TemplateColumn Title="Actions" CellStyle="width:130px;">
                <CellTemplate>
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => ViewItem(context.Item))"
                                       Title="View" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => EditItem(context.Item))"
                                       Title="Edit" />
                        <MudIconButton Icon="@(context.Item.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                       Size="Size.Small" Color="Color.Warning"
                                       OnClick="@(() => ToggleFavorite(context.Item))"
                                       Title="Toggle favorite" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteItem(context.Item))"
                                       Title="Delete" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="PasswordItem" />
        </PagerContent>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Lock"
                         Style="font-size:4rem; color:#7C3AED; opacity:0.3;" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">No items found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @if (!string.IsNullOrEmpty(searchText) || !string.IsNullOrEmpty(typeFilter) || favoritesOnly)
                    { @("Try adjusting your search or filters.") }
                    else { @("Add your first password item to get started.") }
                </MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                           Color="Color.Primary" OnClick="@OpenTypePicker">
                    Add Your First Item
                </MudButton>
            </MudStack>
        </NoRecordsContent>
    </MudDataGrid>
}

@* ── Step 1: Type Picker Dialog ── *@
<MudDialog @bind-Visible="_showTypePicker"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700; text-align:center;">What would you like to add?</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_typePickerSearch" Placeholder="Search types..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Class="mb-4" FullWidth="true" />

        <MudGrid Spacing="2">
            @foreach (var tc in GetFilteredTypeCards())
            {
                <MudItem xs="4">
                    <MudPaper Style="@($"background:var(--mud-palette-surface-variant,var(--mud-palette-surface)); cursor:pointer; border-radius:12px; padding:20px 8px; text-align:center; transition:box-shadow 0.2s, transform 0.15s;")"
                              Elevation="1"
                              Class="type-card-hover"
                              @onclick="@(() => SelectType(tc.Type))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <div style="@($"width:52px; height:52px; border-radius:14px; background:{tc.Color}22; display:flex; align-items:center; justify-content:center;")">
                                <MudIcon Icon="@tc.Icon" Style="@($"color:{tc.Color}; font-size:28px;")" />
                            </div>
                            <MudText Typo="Typo.body2" Style="font-weight:600; color:var(--mud-palette-text-primary);">
                                @tc.Label
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
</MudDialog>

<style>
    .type-card-hover:hover {
        box-shadow: 0 0 0 2px #7C3AED, 0 4px 20px #7C3AED44 !important;
        transform: translateY(-2px);
    }
</style>

@* ── Step 2: Item Form Dialog ── *@
<MudDialog @bind-Visible="_dialogOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true })">
    <TitleContent>
        @if (_editItem != null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div style="@($"width:40px; height:40px; border-radius:10px; background:{GetItemColor(_editItem.Type)}22; display:flex; align-items:center; justify-content:center; flex-shrink:0;")">
                    <MudIcon Icon="@GetItemIcon(_editItem.Type)" Style="@($"color:{GetItemColor(_editItem.Type)}; font-size:22px;")" />
                </div>
                <MudTextField @bind-Value="_editItem.Title"
                              Placeholder="Enter a title"
                              Variant="Variant.Text"
                              DisableUnderLine="false"
                              Style="font-size:1.3rem; font-weight:700;"
                              ReadOnly="_isViewMode"
                              FullWidth="true" />
            </MudStack>
        }
    </TitleContent>
    <DialogContent>
        @if (_editItem != null)
        {
            <MudStack Spacing="0">

                @* ── Type-specific fields ── *@
                @if (_editItem.Type == ItemType.Login)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudTextField @bind-Value="_editUsername" Label="Username"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="_editPassword" Label="Password"
                                          Variant="Variant.Text" ReadOnly="_isViewMode"
                                          InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="@(() => _showPwd = !_showPwd)"
                                          FullWidth="true" />
                            @if (!_isViewMode)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                               Size="Size.Small" Color="Color.Primary"
                                               Title="Generate password"
                                               OnClick="@GeneratePassword" />
                            }
                        </MudStack>

                        <MudTextField @bind-Value="_editItem.Website" Label="Website URL"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Link" />

                        <MudTextField @bind-Value="_editEmail" Label="Email"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="_editTotpSecret" Label="One-Time Password (TOTP secret)"
                                          Variant="Variant.Text" ReadOnly="_isViewMode"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Security"
                                          FullWidth="true" />
                            @if (!string.IsNullOrWhiteSpace(_editTotpSecret))
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                         Style="font-family:monospace; font-size:1.1rem; font-weight:700; min-width:70px;">
                                    @_totpDisplay
                                </MudChip>
                            }
                        </MudStack>

                        @foreach (var extraUrl in _extraWebsites)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudTextField @bind-Value="extraUrl.Value" Label="Additional website"
                                              Variant="Variant.Text" ReadOnly="_isViewMode"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Link"
                                              FullWidth="true" />
                                @if (!_isViewMode)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => _extraWebsites.Remove(extraUrl))" />
                                }
                            </MudStack>
                        }

                        @if (!_isViewMode)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text"
                                       Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => _extraWebsites.Add(new StringWrapper()))">
                                + add another website
                            </MudButton>
                        }
                    </MudStack>
                }

                @if (_editItem.Type == ItemType.CreditCard)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudTextField @bind-Value="_ccCardholderName" Label="Cardholder Name"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="_ccCardNumber" Label="Card Number"
                                          Variant="Variant.Text" ReadOnly="_isViewMode"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                          FullWidth="true"
                                          Immediate="true"
                                          ValueChanged="@((string s) => { _ccCardNumber = s; })" />
                            @if (!string.IsNullOrWhiteSpace(_ccCardNumber))
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">
                                    @DetectCardType(_ccCardNumber)
                                </MudChip>
                            }
                        </MudStack>

                        <MudTextField @bind-Value="_ccExpiry" Label="Expiry (MM/YYYY)"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />

                        <MudTextField @bind-Value="_ccCvv" Label="CVV"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showPwd = !_showPwd)" />

                        <MudTextField @bind-Value="_ccPin" Label="PIN"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Pin" />
                    </MudStack>
                }

                @if (_editItem.Type == ItemType.SecureNote)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudTextField @bind-Value="_noteContent" Label="Note content"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Lines="8" />
                        <MudSelect T="string" @bind-Value="_noteTemplateType" Label="Template Type"
                                   Variant="Variant.Text" Disabled="_isViewMode">
                            <MudSelectItem T="string" Value="@string.Empty">None</MudSelectItem>
                            <MudSelectItem T="string" Value="Medical">Medical</MudSelectItem>
                            <MudSelectItem T="string" Value="Financial">Financial</MudSelectItem>
                            <MudSelectItem T="string" Value="Legal">Legal</MudSelectItem>
                            <MudSelectItem T="string" Value="Personal">Personal</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                }

                @if (_editItem.Type == ItemType.Identity)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_idFirstName" Label="First Name"
                                              Variant="Variant.Text" ReadOnly="_isViewMode" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_idLastName" Label="Last Name"
                                              Variant="Variant.Text" ReadOnly="_isViewMode" />
                            </MudItem>
                        </MudGrid>

                        <MudTextField @bind-Value="_idEmail" Label="Email"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudTextField @bind-Value="_idPhone" Label="Phone"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone" />

                        <MudTextField @bind-Value="_idAddress" Label="Address"
                                      Variant="Variant.Text" ReadOnly="_isViewMode" />

                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_idCity" Label="City"
                                              Variant="Variant.Text" ReadOnly="_isViewMode" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_idState" Label="State"
                                              Variant="Variant.Text" ReadOnly="_isViewMode" />
                            </MudItem>
                        </MudGrid>

                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_idZip" Label="ZIP"
                                              Variant="Variant.Text" ReadOnly="_isViewMode" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="_idCountry" Label="Country"
                                              Variant="Variant.Text" ReadOnly="_isViewMode" />
                            </MudItem>
                        </MudGrid>

                        <MudTextField @bind-Value="_idDob" Label="Date of Birth"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Cake" />
                    </MudStack>
                }

                @if (_editItem.Type == ItemType.Password)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="_editPassword" Label="Password"
                                          Variant="Variant.Text" ReadOnly="_isViewMode"
                                          InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="@(() => _showPwd = !_showPwd)"
                                          FullWidth="true" />
                            @if (!_isViewMode)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                               Size="Size.Small" Color="Color.Primary"
                                               Title="Generate password"
                                               OnClick="@GeneratePassword" />
                            }
                        </MudStack>
                    </MudStack>
                }

                @if (_editItem.Type == ItemType.WiFi)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudTextField @bind-Value="_wifiSsid" Label="Network Name (SSID)"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Wifi" />

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="_wifiPassword" Label="Password"
                                          Variant="Variant.Text" ReadOnly="_isViewMode"
                                          InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="@(() => _showPwd = !_showPwd)"
                                          FullWidth="true" />
                            @if (!_isViewMode)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                               Size="Size.Small" Color="Color.Primary"
                                               Title="Generate password"
                                               OnClick="@GenerateWifiPassword" />
                            }
                        </MudStack>

                        <MudSelect T="SecurityType" @bind-Value="_wifiSecurityType" Label="Security Type"
                                   Variant="Variant.Text" Disabled="_isViewMode">
                            @foreach (SecurityType st in Enum.GetValues<SecurityType>())
                            {
                                <MudSelectItem T="SecurityType" Value="@st">@st.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                }

                @if (_editItem.Type == ItemType.Passkey)
                {
                    <MudStack Spacing="1" Class="mb-2">
                        <MudTextField @bind-Value="_passkeyWebsite" Label="Website"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Language" />

                        <MudTextField @bind-Value="_passkeyUsername" Label="Username"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudTextField @bind-Value="_passkeyDisplayName" Label="Display Name"
                                      Variant="Variant.Text" ReadOnly="_isViewMode"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                    </MudStack>
                }

                <MudDivider Class="my-3" />

                @* ── Custom Fields / Add More ── *@
                @if (!_isViewMode || _customFields.Count > 0)
                {
                    <MudButton StartIcon="@(_showMoreExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               OnClick="@(() => _showMoreExpanded = !_showMoreExpanded)"
                               Class="mb-1">
                        + add more
                    </MudButton>
                }

                @if (_showMoreExpanded)
                {
                    <MudStack Spacing="1" Class="mb-2 pl-2">
                        @foreach (var cf in _customFields)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudTextField @bind-Value="cf.Name" Placeholder="Field name"
                                              Variant="Variant.Text" ReadOnly="_isViewMode"
                                              Style="max-width:160px;" />
                                @if (cf.Type == "Password")
                                {
                                    <MudTextField @bind-Value="cf.Value" Placeholder="Value"
                                                  Variant="Variant.Text" ReadOnly="_isViewMode"
                                                  InputType="@(cf.ShowValue ? InputType.Text : InputType.Password)"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@(cf.ShowValue ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                                  OnAdornmentClick="@(() => cf.ShowValue = !cf.ShowValue)"
                                                  FullWidth="true" />
                                }
                                else
                                {
                                    <MudTextField @bind-Value="cf.Value" Placeholder="Value"
                                                  Variant="Variant.Text" ReadOnly="_isViewMode"
                                                  FullWidth="true" />
                                }
                                @if (!_isViewMode)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => _customFields.Remove(cf))" />
                                }
                            </MudStack>
                        }

                        @if (!_isViewMode)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Add" Label="+ add field"
                                     Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                     EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                     AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                                @foreach (var ft in new[] { "Text", "URL", "Email", "Address", "Date", "One-Time Password", "Password", "Phone" })
                                {
                                    <MudMenuItem OnClick="@(() => AddCustomField(ft))">@ft</MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </MudStack>
                }

                <MudDivider Class="my-3" />

                @* ── Notes (always shown) ── *@
                <MudTextField @bind-Value="_editItem.Description" Label="Notes"
                              Placeholder="Add notes about this item here"
                              Variant="Variant.Text" Lines="3" ReadOnly="_isViewMode" />

                @if (_isViewMode)
                {
                    <MudDivider Class="mt-3 mb-2" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Created: @_editItem.CreatedAt.ToString("MMM d, yyyy HH:mm")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Modified: @_editItem.LastModified.ToString("MMM d, yyyy HH:mm")
                        </MudText>
                    </MudStack>
                }

            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @* Left: vault selector *@
        <MudSelect T="int?" @bind-Value="_editItem!.VaultId" Label="Vault"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:160px;" Disabled="_isViewMode"
                   AdornmentIcon="@Icons.Material.Filled.Folder">
            <MudSelectItem T="int?" Value="@((int?)null)">No Vault</MudSelectItem>
            @foreach (var v in _vaults)
            {
                <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSpacer />

        <MudButton OnClick="@CloseDialog" Variant="Variant.Text">
            @(_isViewMode ? "Close" : "Cancel")
        </MudButton>

        @if (_isViewMode)
        {
            <MudButton OnClick="@(() => _isViewMode = false)" Variant="Variant.Outlined"
                       Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">
                Edit
            </MudButton>
        }
        else
        {
            <MudButton OnClick="@SaveItem" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @(_editItem?.Id > 0 ? "Save Changes" : "Add Item")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    // ── List / filter state ──
    List<PasswordItem>? _allItems;
    List<PasswordItem>? filteredItems;
    List<Category> _categories = new();
    List<Vault> _vaults = new();
    bool isLoading, _saving, favoritesOnly;
    string searchText = "", typeFilter = "";

    // ── Dialog open state ──
    bool _showTypePicker = false;
    bool _dialogOpen = false;
    bool _isViewMode = false;

    // ── Active item ──
    PasswordItem? _editItem;

    // ── Login fields ──
    string _editUsername = "";
    string _editPassword = "";
    string _editEmail = "";
    string _editTotpSecret = "";
    string _totpDisplay = "";
    bool _showPwd = false;
    List<StringWrapper> _extraWebsites = new();

    // ── Credit card fields ──
    string _ccCardholderName = "";
    string _ccCardNumber = "";
    string _ccExpiry = "";
    string _ccCvv = "";
    string _ccPin = "";

    // ── Secure note fields ──
    string _noteContent = "";
    string _noteTemplateType = "";

    // ── Identity fields ──
    string _idFirstName = "";
    string _idLastName = "";
    string _idEmail = "";
    string _idPhone = "";
    string _idAddress = "";
    string _idCity = "";
    string _idState = "";
    string _idZip = "";
    string _idCountry = "";
    string _idDob = "";

    // ── WiFi fields ──
    string _wifiSsid = "";
    string _wifiPassword = "";
    SecurityType _wifiSecurityType = SecurityType.WPA2;

    // ── Passkey fields ──
    string _passkeyWebsite = "";
    string _passkeyUsername = "";
    string _passkeyDisplayName = "";

    // ── Custom fields ──
    List<CustomFieldViewModel> _customFields = new();
    bool _showMoreExpanded = false;

    // ── Type picker ──
    string _typePickerSearch = "";

    // ──────────────────────────────────────────
    // Inner types
    // ──────────────────────────────────────────

    class CustomFieldViewModel
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "Text"; // Text, URL, Email, Address, Date, OTP, Password, Phone
        public string Value { get; set; } = "";
        public bool ShowValue { get; set; } = false;
    }

    class StringWrapper
    {
        public string Value { get; set; } = "";
    }

    record TypeCard(ItemType Type, string Label, string Icon, string Color);

    // ──────────────────────────────────────────
    // Init
    // ──────────────────────────────────────────

    protected override async Task OnInitializedAsync() => await LoadAll();

    async Task LoadAll()
    {
        isLoading = true;
        try
        {
            var items = await PasswordItemService.GetAllAsync();
            _allItems = items?.Where(x => !x.IsDeleted).ToList() ?? new();
            _categories = (await CategoryService.GetAllAsync()) ?? new();
            _vaults = (await VaultService.GetAllAsync()) ?? new();
            FilterItems();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    void FilterItems()
    {
        filteredItems = (_allItems ?? new())
            .Where(i =>
                (string.IsNullOrEmpty(searchText) ||
                 i.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                 (i.Website?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (i.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (i.LoginItem?.Username?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrEmpty(typeFilter) || i.Type.ToString() == typeFilter) &&
                (!favoritesOnly || i.IsFavorite))
            .ToList();
    }

    // ──────────────────────────────────────────
    // Type picker
    // ──────────────────────────────────────────

    List<TypeCard> AllTypeCards() => new()
    {
        new(ItemType.Login,      "Login",       Icons.Material.Filled.Language,    "#7C3AED"),
        new(ItemType.SecureNote, "Secure Note", Icons.Material.Filled.Note,        "#F59E0B"),
        new(ItemType.CreditCard, "Credit Card", Icons.Material.Filled.CreditCard,  "#EC4899"),
        new(ItemType.Identity,   "Identity",    Icons.Material.Filled.Person,      "#10B981"),
        new(ItemType.Password,   "Password",    Icons.Material.Filled.Key,         "#3B82F6"),
        new(ItemType.WiFi,       "WiFi",        Icons.Material.Filled.Wifi,        "#06B6D4"),
        new(ItemType.Passkey,    "Passkey",     Icons.Material.Filled.Fingerprint, "#8B5CF6"),
    };

    List<TypeCard> GetFilteredTypeCards()
    {
        var all = AllTypeCards();
        if (string.IsNullOrWhiteSpace(_typePickerSearch)) return all;
        return all.Where(c => c.Label.Contains(_typePickerSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    void OpenTypePicker()
    {
        _typePickerSearch = "";
        _showTypePicker = true;
    }

    void SelectType(ItemType type)
    {
        _showTypePicker = false;
        OpenFormDialog(new PasswordItem
        {
            Type = type,
            LastModified = DateTime.UtcNow,
            CreatedAt = DateTime.UtcNow
        });
    }

    // ──────────────────────────────────────────
    // Form dialog
    // ──────────────────────────────────────────

    void OpenFormDialog(PasswordItem item)
    {
        _editItem = item;
        _isViewMode = false;
        _showPwd = false;
        _customFields = new();
        _showMoreExpanded = false;
        _extraWebsites = new();

        // Hydrate type-specific fields from the item's navigation properties
        _editUsername     = item.LoginItem?.Username ?? "";
        _editPassword     = item.LoginItem?.Password ?? "";
        _editEmail        = item.LoginItem?.Email ?? "";
        _editTotpSecret   = item.LoginItem?.TotpSecret ?? "";
        _totpDisplay      = "";

        _ccCardholderName = item.CreditCardItem?.CardholderName ?? "";
        _ccCardNumber     = item.CreditCardItem?.CardNumber ?? "";
        _ccExpiry         = item.CreditCardItem?.ExpiryDate ?? "";
        _ccCvv            = item.CreditCardItem?.CVV ?? "";
        _ccPin            = item.CreditCardItem?.PIN ?? "";

        _noteContent      = item.SecureNoteItem?.Content ?? "";
        _noteTemplateType = item.SecureNoteItem?.TemplateType ?? "";

        _idFirstName  = "";
        _idLastName   = "";
        _idEmail      = "";
        _idPhone      = "";
        _idAddress    = "";
        _idCity       = "";
        _idState      = "";
        _idZip        = "";
        _idCountry    = "";
        _idDob        = "";

        _wifiSsid         = item.WiFiItem?.NetworkName ?? "";
        _wifiPassword     = item.WiFiItem?.Password ?? "";
        _wifiSecurityType = item.WiFiItem?.SecurityType ?? SecurityType.WPA2;

        _passkeyWebsite     = item.PasskeyItem?.Website ?? "";
        _passkeyUsername    = item.PasskeyItem?.Username ?? "";
        _passkeyDisplayName = item.PasskeyItem?.DisplayName ?? "";

        if (!string.IsNullOrWhiteSpace(_editTotpSecret))
            _totpDisplay = GenerateTotpDisplay(_editTotpSecret);

        _dialogOpen = true;
    }

    void ViewItem(PasswordItem item)
    {
        OpenFormDialog(CloneItem(item));
        _isViewMode = true;
    }

    void EditItem(PasswordItem item)
    {
        OpenFormDialog(CloneItem(item));
    }

    void OpenAddDialog() => OpenTypePicker();

    void CloseDialog() => _dialogOpen = false;

    // ──────────────────────────────────────────
    // Save
    // ──────────────────────────────────────────

    async Task SaveItem()
    {
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.Title))
        {
            Snackbar.Add("Title is required.", Severity.Warning);
            return;
        }

        // Write type-specific local state back into navigation properties
        switch (_editItem.Type)
        {
            case ItemType.Login:
                _editItem.LoginItem ??= new LoginItem();
                _editItem.LoginItem.Username   = _editUsername;
                _editItem.LoginItem.Password   = _editPassword;
                _editItem.LoginItem.Email      = _editEmail;
                _editItem.LoginItem.TotpSecret = _editTotpSecret;
                break;

            case ItemType.CreditCard:
                _editItem.CreditCardItem ??= new CreditCardItem();
                _editItem.CreditCardItem.CardholderName = _ccCardholderName;
                _editItem.CreditCardItem.CardNumber     = _ccCardNumber;
                _editItem.CreditCardItem.ExpiryDate     = _ccExpiry;
                _editItem.CreditCardItem.CVV            = _ccCvv;
                _editItem.CreditCardItem.PIN            = _ccPin;
                break;

            case ItemType.SecureNote:
                _editItem.SecureNoteItem ??= new SecureNoteItem();
                _editItem.SecureNoteItem.Content      = _noteContent;
                _editItem.SecureNoteItem.TemplateType = _noteTemplateType;
                break;

            case ItemType.WiFi:
                _editItem.WiFiItem ??= new WiFiItem();
                _editItem.WiFiItem.NetworkName  = _wifiSsid;
                _editItem.WiFiItem.Password     = _wifiPassword;
                _editItem.WiFiItem.SecurityType = _wifiSecurityType;
                break;

            case ItemType.Passkey:
                _editItem.PasskeyItem ??= new PasskeyItem();
                _editItem.PasskeyItem.Website     = _passkeyWebsite;
                _editItem.PasskeyItem.Username    = _passkeyUsername;
                _editItem.PasskeyItem.DisplayName = _passkeyDisplayName;
                break;
        }

        _saving = true;
        try
        {
            _editItem.LastModified = DateTime.UtcNow;
            if (_editItem.Id > 0)
            {
                await PasswordItemService.UpdateAsync(_editItem);
                Snackbar.Add("Item updated successfully.", Severity.Success);
            }
            else
            {
                await PasswordItemService.CreateAsync(_editItem);
                Snackbar.Add("Item added successfully.", Severity.Success);
            }
            _dialogOpen = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // ──────────────────────────────────────────
    // Toggle favorite / Delete
    // ──────────────────────────────────────────

    async Task ToggleFavorite(PasswordItem item)
    {
        try
        {
            await PasswordItemService.ToggleFavoriteAsync(item.Id);
            item.IsFavorite = !item.IsFavorite;
            FilterItems();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    async Task DeleteItem(PasswordItem item)
    {
        var ok = await DialogService.ShowMessageBox(
            "Delete Item",
            $"Permanently delete \"{item.Title}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok == true)
        {
            try
            {
                await PasswordItemService.DeleteAsync(item.Id);
                Snackbar.Add("Item deleted.", Severity.Success);
                await LoadAll();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    // ──────────────────────────────────────────
    // Custom fields
    // ──────────────────────────────────────────

    void AddCustomField(string fieldType)
    {
        _customFields.Add(new CustomFieldViewModel { Type = fieldType });
    }

    // ──────────────────────────────────────────
    // Password generation
    // ──────────────────────────────────────────

    void GeneratePassword() => _editPassword = Guid.NewGuid().ToString("N")[..16];
    void GenerateWifiPassword() => _wifiPassword = Guid.NewGuid().ToString("N")[..16];

    // ──────────────────────────────────────────
    // TOTP display (simple 6-digit counter placeholder)
    // ──────────────────────────────────────────

    string GenerateTotpDisplay(string secret)
    {
        // Placeholder — real TOTP requires OTP library. Show last 6 chars of hashed secret.
        var hash = Math.Abs(secret.GetHashCode()) % 1000000;
        return hash.ToString("D6");
    }

    // ──────────────────────────────────────────
    // Card type detection
    // ──────────────────────────────────────────

    string DetectCardType(string number)
    {
        var n = number.Replace(" ", "").Replace("-", "");
        if (n.StartsWith("4")) return "Visa";
        if (n.StartsWith("5") || (n.Length >= 2 && int.TryParse(n[..2], out var mc) && mc >= 51 && mc <= 55)) return "Mastercard";
        if (n.StartsWith("34") || n.StartsWith("37")) return "Amex";
        if (n.StartsWith("6011") || n.StartsWith("65")) return "Discover";
        return "Card";
    }

    // ──────────────────────────────────────────
    // Clone
    // ──────────────────────────────────────────

    PasswordItem CloneItem(PasswordItem src) => new PasswordItem
    {
        Id          = src.Id,
        Title       = src.Title,
        Type        = src.Type,
        Website     = src.Website,
        Description = src.Description,
        IsFavorite  = src.IsFavorite,
        IsArchived  = src.IsArchived,
        CategoryId  = src.CategoryId,
        VaultId     = src.VaultId,
        UserId      = src.UserId,
        CreatedAt   = src.CreatedAt,
        LastModified = src.LastModified,
        LoginItem   = src.LoginItem,
        CreditCardItem = src.CreditCardItem,
        SecureNoteItem = src.SecureNoteItem,
        WiFiItem    = src.WiFiItem,
        PasskeyItem = src.PasskeyItem,
    };

    // ──────────────────────────────────────────
    // Icon / color helpers
    // ──────────────────────────────────────────

    string GetItemIcon(ItemType t) => t switch
    {
        ItemType.Login      => Icons.Material.Filled.Language,
        ItemType.CreditCard => Icons.Material.Filled.CreditCard,
        ItemType.SecureNote => Icons.Material.Filled.Note,
        ItemType.WiFi       => Icons.Material.Filled.Wifi,
        ItemType.Passkey    => Icons.Material.Filled.Fingerprint,
        ItemType.Identity   => Icons.Material.Filled.Person,
        ItemType.Password   => Icons.Material.Filled.Key,
        _                   => Icons.Material.Filled.Lock
    };

    string GetItemColor(ItemType t) => t switch
    {
        ItemType.Login      => "#7C3AED",
        ItemType.CreditCard => "#EC4899",
        ItemType.SecureNote => "#F59E0B",
        ItemType.WiFi       => "#06B6D4",
        ItemType.Passkey    => "#8B5CF6",
        ItemType.Identity   => "#10B981",
        ItemType.Password   => "#3B82F6",
        _                   => "#6B7280"
    };

    Color GetChipColor(ItemType t) => t switch
    {
        ItemType.Login      => Color.Primary,
        ItemType.CreditCard => Color.Secondary,
        ItemType.SecureNote => Color.Warning,
        ItemType.WiFi       => Color.Info,
        ItemType.Passkey    => Color.Dark,
        ItemType.Identity   => Color.Success,
        ItemType.Password   => Color.Tertiary,
        _                   => Color.Default
    };
}
