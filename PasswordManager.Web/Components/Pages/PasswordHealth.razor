@page "/password-health"
@rendermode InteractiveServer
@using PasswordManager.Services.Interfaces
@using PasswordManager.Models
@inject IPasswordItemService PasswordItemService
@inject ISnackbar Snackbar

<PageTitle>Password Health - VaultGuard</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:700">Password Health</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Security analysis of your vault</MudText>
    </div>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined"
               Color="Color.Primary" OnClick="@LoadData" Disabled="@isLoading">
        Refresh
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    @* Security Score gauge row *@
    <MudPaper Class="pa-6 mb-4 rounded-lg" Elevation="2">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" md="4" Class="d-flex flex-column align-center justify-center">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-3">Overall Security Score</MudText>
                <div style="position:relative; display:inline-flex; align-items:center; justify-content:center;">
                    <MudProgressCircular Value="@score"
                                        Color="@(score >= 80 ? Color.Success : score >= 50 ? Color.Warning : Color.Error)"
                                        Size="Size.Large"
                                        StrokeWidth="8"
                                        Min="0" Max="100" />
                    <div style="position:absolute; text-align:center;">
                        <MudText Typo="Typo.h5" Style="font-weight:700; line-height:1;">@score</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">/100</MudText>
                    </div>
                </div>
                <MudChip T="string" Class="mt-3"
                         Color="@(score >= 80 ? Color.Success : score >= 50 ? Color.Warning : Color.Error)"
                         Text="@(score >= 80 ? "Strong" : score >= 50 ? "Fair" : "Needs Work")" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">Score Breakdown</MudText>
                <MudStack Spacing="2">
                    <div>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Typo="Typo.body2">Recently Changed Passwords</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">
                                @recentlyChanged.Count / @loginItems.Count
                            </MudText>
                        </MudStack>
                        <MudProgressLinear Value="@(loginItems.Count > 0 ? (double)recentlyChanged.Count / loginItems.Count * 100 : 0)"
                                          Color="Color.Success" Rounded="true" Size="Size.Small" />
                    </div>
                    <div>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Typo="Typo.body2">Two-Factor Authentication Enabled</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">
                                @has2FA.Count / @loginItems.Count
                            </MudText>
                        </MudStack>
                        <MudProgressLinear Value="@(loginItems.Count > 0 ? (double)has2FA.Count / loginItems.Count * 100 : 0)"
                                          Color="Color.Info" Rounded="true" Size="Size.Small" />
                    </div>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* Stat cards *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #7C3AED;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color:#7C3AED; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@loginItems.Count</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Login Items</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #10B981;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#10B981; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@recentlyChanged.Count</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Recently Changed</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #F59E0B;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:#F59E0B; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@needsUpdate.Count</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Need Attention</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #3B82F6;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Style="color:#3B82F6; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@has2FA.Count</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Has 2FA</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Detail sections *@
    <MudExpansionPanels MultiExpansion="true" Elevation="2" Class="rounded-lg">

        @* Needs Password Update *@
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:#F59E0B;" />
                    <MudText Style="font-weight:600;">Needs Password Update</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Text="@needsUpdate.Count.ToString()" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not changed in 90+ days or never changed</MudText>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if (needsUpdate.Count == 0)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#10B981; font-size:3rem;" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">All passwords are up to date!</MudText>
                    </MudStack>
                }
                else
                {
                    <MudDataGrid T="PasswordItem" Items="@needsUpdate" Sortable="true" Hover="true"
                                 Dense="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => x.Title" Title="Name" Sortable="true" />
                            <TemplateColumn Title="Username">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.LoginItem?.Username ?? "—")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Last Changed" Sortable="false">
                                <CellTemplate>
                                    @if (context.Item.LoginItem?.PasswordLastChanged == null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Text="Never" />
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">
                                            @context.Item.LoginItem.PasswordLastChanged.Value.ToString("MMM d, yyyy")
                                        </MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Type" CellStyle="width:120px;">
                                <CellTemplate>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                             Text="@context.Item.Type.ToString()" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary" Class="pa-4">No items found.</MudText>
                        </NoRecordsContent>
                    </MudDataGrid>
                }
            </ChildContent>
        </MudExpansionPanel>

        @* No 2FA *@
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.NoEncryption" Style="color:#EC4899;" />
                    <MudText Style="font-weight:600;">No 2FA Configured</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Text="@noTwoFactor.Count.ToString()" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Login items without two-factor authentication</MudText>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if (noTwoFactor.Count == 0)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Style="color:#10B981; font-size:3rem;" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">All login items have 2FA configured!</MudText>
                    </MudStack>
                }
                else
                {
                    <MudDataGrid T="PasswordItem" Items="@noTwoFactor" Sortable="true" Hover="true"
                                 Dense="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => x.Title" Title="Name" Sortable="true" />
                            <TemplateColumn Title="Username">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.LoginItem?.Username ?? "—")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Website">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.LoginItem?.Website ?? context.Item.LoginItem?.WebsiteUrl ?? "—")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="2FA Status" CellStyle="width:140px;">
                                <CellTemplate>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Text="Not Configured" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary" Class="pa-4">No items found.</MudText>
                        </NoRecordsContent>
                    </MudDataGrid>
                }
            </ChildContent>
        </MudExpansionPanel>

        @* Recently Updated — healthy items *@
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#10B981;" />
                    <MudText Style="font-weight:600;">Recently Updated</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Text="@recentlyUpdated30.Count.ToString()" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Changed within the last 30 days</MudText>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if (recentlyUpdated30.Count == 0)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Style="color:#8B90A7; font-size:3rem;" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">No passwords changed in the last 30 days.</MudText>
                    </MudStack>
                }
                else
                {
                    <MudDataGrid T="PasswordItem" Items="@recentlyUpdated30" Sortable="true" Hover="true"
                                 Dense="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => x.Title" Title="Name" Sortable="true" />
                            <TemplateColumn Title="Username">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.LoginItem?.Username ?? "—")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Last Changed" Sortable="false">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Style="color:#10B981; font-weight:500;">
                                        @context.Item.LoginItem!.PasswordLastChanged!.Value.ToString("MMM d, yyyy")
                                    </MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="2FA" CellStyle="width:100px;">
                                <CellTemplate>
                                    @if (context.Item.LoginItem?.EncryptedTotpSecret != null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Text="Enabled" />
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Text="None" />
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary" Class="pa-4">No items found.</MudText>
                        </NoRecordsContent>
                    </MudDataGrid>
                }
            </ChildContent>
        </MudExpansionPanel>

    </MudExpansionPanels>
}

@code {
    bool isLoading = true;
    int score;

    List<PasswordItem> loginItems = new();
    List<PasswordItem> recentlyChanged = new();
    List<PasswordItem> needsUpdate = new();
    List<PasswordItem> has2FA = new();
    List<PasswordItem> noTwoFactor = new();
    List<PasswordItem> recentlyUpdated30 = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    async Task LoadData()
    {
        isLoading = true;
        try
        {
            var allItemsEnum = await PasswordItemService.GetAllAsync();
            var allItems = allItemsEnum?.ToList() ?? new();

            loginItems = allItems
                .Where(x => !x.IsDeleted && !x.IsArchived && x.LoginItem != null)
                .ToList();

            recentlyChanged = loginItems
                .Where(x => x.LoginItem!.PasswordLastChanged > DateTime.UtcNow.AddDays(-90))
                .ToList();

            needsUpdate = loginItems
                .Where(x => x.LoginItem!.PasswordLastChanged == null
                         || x.LoginItem!.PasswordLastChanged < DateTime.UtcNow.AddDays(-90))
                .ToList();

            has2FA = loginItems
                .Where(x => x.LoginItem!.EncryptedTotpSecret != null)
                .ToList();

            noTwoFactor = loginItems
                .Where(x => x.LoginItem!.EncryptedTotpSecret == null)
                .ToList();

            recentlyUpdated30 = loginItems
                .Where(x => x.LoginItem!.PasswordLastChanged > DateTime.UtcNow.AddDays(-30))
                .ToList();

            // Score: base 50 + up to 30 for recently changed ratio + up to 20 for 2FA ratio
            score = 50;
            if (loginItems.Count > 0)
            {
                score += (int)(30.0 * recentlyChanged.Count / loginItems.Count);
                score += (int)(20.0 * has2FA.Count / loginItems.Count);
            }
            score = Math.Min(100, score);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
