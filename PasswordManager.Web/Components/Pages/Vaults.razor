@page "/vaults"
@using PasswordManager.Services.Interfaces
@using PasswordManager.Models
@inject IVaultService VaultService
@inject IAuthService AuthService

<PageTitle>Vaults - Password Manager</PageTitle>

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-2">
                        <span class="bi bi-shield-lock-fill"></span> Vaults
                    </h1>
                    <p class="text-muted">Manage your password vaults</p>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="ShowCreateDialog">
                        <span class="bi bi-plus-circle"></span> Add Vault
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (vaults?.Any() == true)
    {
        <div class="row g-4">
            @foreach (var vault in vaults)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        🔐 @vault.Name
                                        @if (vault.IsDefault)
                                        {
                                            <span class="badge bg-success ms-2">Default</span>
                                        }
                                    </h5>
                                    <p class="card-text text-muted small">@vault.Description</p>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <span class="bi bi-three-dots-vertical"></span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><button class="dropdown-item" @onclick="() => EditVault(vault)">Edit</button></li>
                                        <li><button class="dropdown-item text-danger" @onclick="() => DeleteVault(vault)">Delete</button></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="mt-auto">
                                <small class="text-muted">
                                    @vault.PasswordItems?.Count items
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">No vaults found</h4>
            <p>Create your first vault to organize your passwords</p>
            <button class="btn btn-primary mt-3" @onclick="ShowCreateDialog">
                <span class="bi bi-plus-circle"></span> Create Vault
            </button>
        </div>
    }
</div>

@code {
    private List<PasswordManager.Models.Vault>? vaults;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadVaults();
    }

    private async Task LoadVaults()
    {
        try
        {
            isLoading = true;
            vaults = await VaultService.GetAllAsync();
        }
        catch (Exception ex)
        {
            // Log error
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateDialog()
    {
        // TODO: Implement create dialog
        // For now, create a simple vault programmatically
        CreateVaultAsync();
    }

    private async Task CreateVaultAsync()
    {
        try
        {
            var vault = new PasswordManager.Models.Vault
            {
                Name = "New Vault",
                Description = "Created from web interface",
                UserId = AuthService.CurrentUser?.Id ?? string.Empty
            };

            await VaultService.CreateAsync(vault);
            await LoadVaults();
        }
        catch (Exception ex)
        {
            // Log error
        }
    }

    private void EditVault(PasswordManager.Models.Vault vault)
    {
        // TODO: Implement edit dialog
    }

    private async Task DeleteVault(PasswordManager.Models.Vault vault)
    {
        try
        {
            await VaultService.DeleteAsync(vault.Id);
            await LoadVaults();
        }
        catch (Exception ex)
        {
            // Log error
        }
    }
}
