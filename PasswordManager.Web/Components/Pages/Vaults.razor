@page "/vaults"
@rendermode InteractiveServer
@using PasswordManager.Services.Interfaces
@using PasswordManager.Models
@inject IVaultService VaultService
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Vaults - VaultGuard</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:700">Vaults</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Organize your passwords into secure vaults</MudText>
    </div>
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="OpenAddDialog">New Vault</MudButton>
</MudStack>

@if (isLoading)
{
    <MudGrid>
        @for (int i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" />
            </MudItem>
        }
    </MudGrid>
}
else if (vaults?.Any() == true)
{
    <MudGrid>
        @foreach (var vault in vaults)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Style="@($"border-top: 4px solid {(vault.Color ?? "#7C3AED")}; height:100%;")">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Shield"
                                         Style="@($"color:{(vault.Color ?? "#7C3AED")}; font-size:1.8rem;")" />
                                <div>
                                    <MudText Typo="Typo.h6" Style="font-weight:600;">@vault.Name</MudText>
                                    @if (vault.IsDefault)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="mt-1">Default</MudChip>
                                    }
                                </div>
                            </MudStack>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Default">
                                <MudMenuItem OnClick="@(() => OpenEditDialog(vault))">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                        <MudText>Edit</MudText>
                                    </MudStack>
                                </MudMenuItem>
                                @if (!vault.IsDefault)
                                {
                                    <MudMenuItem OnClick="@(() => SetDefault(vault))">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small" />
                                            <MudText>Set as Default</MudText>
                                        </MudStack>
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => DeleteVault(vault))">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                     Style="color:#EF4444;" />
                                            <MudText Color="Color.Error">Delete</MudText>
                                        </MudStack>
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </MudStack>

                        @if (!string.IsNullOrEmpty(vault.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@vault.Description</MudText>
                        }

                        <MudDivider Class="my-3" />

                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Items</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:600;">
                                    @(vault.PasswordItems?.Count ?? 0)
                                </MudText>
                            </MudStack>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Created</MudText>
                                <MudText Typo="Typo.body2">@vault.CreatedAt.ToString("MMM d, yyyy")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudPaper Class="pa-12 text-center" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Shield"
                 Style="font-size:4rem; color:#7C3AED; opacity:0.3;" />
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No vaults yet</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Create a vault to start organizing your passwords.
        </MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                   Color="Color.Primary" Class="mt-3" OnClick="OpenAddDialog">
            Create First Vault
        </MudButton>
    </MudPaper>
}

@* Add/Edit Dialog *@
<MudDialog @bind-Visible="_dialogVisible"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingVault?.Id > 0 ? "Edit Vault" : "New Vault")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editingVault != null)
        {
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_editingVault.Name" Label="Vault Name *"
                              Variant="Variant.Outlined" Required="true"
                              Placeholder="e.g. Personal, Work, Family" />
                <MudTextField @bind-Value="_editingVault.Description" Label="Description"
                              Variant="Variant.Outlined" Lines="2"
                              Placeholder="Optional description for this vault" />
                <MudTextField @bind-Value="_editingVault.Color" Label="Color (hex)"
                              Variant="Variant.Outlined" Placeholder="#7C3AED"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Palette" />
                <MudCheckBox @bind-Value="_editingVault.IsDefault" Label="Set as default vault"
                             Color="Color.Primary" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="@SaveVault" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_editingVault?.Id > 0 ? "Save Changes" : "Create Vault")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    List<Vault>? vaults;
    bool isLoading = true;
    bool _dialogVisible = false;
    bool isSaving = false;
    Vault? _editingVault;

    protected override async Task OnInitializedAsync() => await LoadVaults();

    async Task LoadVaults()
    {
        isLoading = true;
        try
        {
            vaults = await VaultService.GetAllAsync() ?? new List<Vault>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading vaults: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    void OpenAddDialog()
    {
        _editingVault = new Vault
        {
            UserId = AuthService.CurrentUser?.Id ?? string.Empty,
            Color = "#7C3AED"
        };
        _dialogVisible = true;
    }

    void OpenEditDialog(Vault vault)
    {
        _editingVault = new Vault
        {
            Id = vault.Id,
            Name = vault.Name,
            Description = vault.Description,
            IsDefault = vault.IsDefault,
            Color = vault.Color,
            Icon = vault.Icon,
            UserId = vault.UserId
        };
        _dialogVisible = true;
    }

    async Task SaveVault()
    {
        if (_editingVault == null || string.IsNullOrWhiteSpace(_editingVault.Name))
        {
            Snackbar.Add("Vault name is required.", Severity.Warning);
            return;
        }
        isSaving = true;
        try
        {
            if (_editingVault.Id > 0)
            {
                await VaultService.UpdateAsync(_editingVault);
                Snackbar.Add("Vault updated successfully.", Severity.Success);
            }
            else
            {
                _editingVault.UserId = AuthService.CurrentUser?.Id ?? string.Empty;
                await VaultService.CreateAsync(_editingVault);
                Snackbar.Add("Vault created successfully.", Severity.Success);
            }
            _dialogVisible = false;
            await LoadVaults();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving vault: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task SetDefault(Vault vault)
    {
        try
        {
            await VaultService.SetAsDefaultAsync(vault.Id);
            Snackbar.Add($"\"{vault.Name}\" set as default vault.", Severity.Success);
            await LoadVaults();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    async Task DeleteVault(Vault vault)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete Vault",
            $"Delete \"{vault.Name}\"? Items in this vault will not be deleted.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                await VaultService.DeleteAsync(vault.Id);
                Snackbar.Add("Vault deleted.", Severity.Success);
                await LoadVaults();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting vault: {ex.Message}", Severity.Error);
            }
        }
    }

    void CloseDialog() => _dialogVisible = false;
}
