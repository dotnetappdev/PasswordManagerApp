<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom web.config. On `dotnet publish` the ASP.NET Core SDK transforms this file: it fills in
  processPath/arguments (%LAUNCHER_PATH%/%LAUNCHER_ARGS% -> .\VaultGuard.API.exe for a self-contained
  publish) and sets hostingModel from <AspNetCoreHostingModel> in the .csproj. Everything else here —
  notably stdoutLogEnabled / stdoutLogFile — is preserved as written.

  NOTE: stdout logging is for troubleshooting startup/crash only. Set stdoutLogEnabled back to "false"
  once the app is healthy (the file grows unbounded and every write hits disk). The .\logs folder must
  exist on the server for the file to be written.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout.txt"
                  hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
