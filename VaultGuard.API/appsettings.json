{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=NOVADESKTOP;Database=VaultGuardDB;Username=sa;Password=sa12345;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "PostgresConnection": "Host=localhost;Database=VaultGuardDB;Username=postgres;Password=your_password;Port=5432",
    "MySqlConnection": "Server=localhost;Database=VaultGuardDB;User=root;Password=your_password;Port=3306;",
    "SqliteConnection": "Data Source=passwordmanager.db",
    "SqlServerConnection": "Server=localhost;Database=VaultGuard;User Id=sa;Password=your_password;"
  },
  "DatabaseProvider": "Sqlite",
  "Sync": {
    "EnableAutoSync": true,
    "SyncIntervalMinutes": 30,
    "ConflictResolution": "LastWriteWins"
  },
  "ApiSettings": {
    "Title": "Vault Guard API",
    "Version": "v1",
    "Description": "A comprehensive password management API with sync capabilities"
  },

  "Encryption": {
    "MasterKeyIterations": 600000,
    "AuthHashIterations": 600000,
    "MinIterations": 600000,
    "MaxIterations": 1000000
  },
  "Supabase": {
    "Url": "https://your-project.supabase.co",
    "ApiKey": "your-supabase-api-key"
  },
  "SmsSettings": {
    "Provider": "Twilio",
    "Enabled": false,
    "DefaultCountryCode": "+1",
    "CodeLength": 6,
    "ExpirationMinutes": 5,
    "MaxAttempts": 3,
    "MaxSmsPerHour": 10,
    "MessageTemplate": "Your Vault Guard verification code is: {code}. This code will expire in {expiration} minutes.",
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromPhoneNumber": ""
    },
    "AwsSns": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "us-east-1",
      "SenderName": "Vault Guard"
    },
    "AzureCommunication": {
      "ConnectionString": "",
      "FromPhoneNumber": ""
    }
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "development",
    "TracesSampleRate": 1.0,
    "SendDefaultPii": false,
    "AttachStacktrace": true,
    "Debug": false
  },
  "ExceptionReporting": {
    "SentryDsn": ""
  }
}
