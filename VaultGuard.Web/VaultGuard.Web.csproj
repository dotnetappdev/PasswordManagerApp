<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
	  <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
	  <PackageReference Include="Sentry.AspNetCore" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultGuard.Components.Shared\VaultGuard.Components.Shared.csproj" />
    <ProjectReference Include="..\VaultGuard.Models\VaultGuard.Models.csproj" />
    <ProjectReference Include="..\VaultGuard.Services\VaultGuard.Services.csproj" />
    <ProjectReference Include="..\VaultGuard.DAL\VaultGuard.DAL.csproj" />
    <ProjectReference Include="..\VaultGuard.DAL.SqlServer\VaultGuard.DAL.SqlServer.csproj" />
    <ProjectReference Include="..\VaultGuard.DAL.MySql\VaultGuard.DAL.MySql.csproj" />
    <ProjectReference Include="..\VaultGuard.DAL.SupaBase\VaultGuard.DAL.SupaBase.csproj" />
    <ProjectReference Include="..\VaultGuard.Crypto\VaultGuard.Crypto.csproj" />
    <ProjectReference Include="..\VaultGuard.Imports\VaultGuard.Imports.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.1Password\VaultGuardImports.1Password.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Bitwarden\VaultGuardImports.Bitwarden.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Apple\VaultGuardImports.Apple.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Chrome\VaultGuardImports.Chrome.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Dashlane\VaultGuardImports.Dashlane.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Edge\VaultGuardImports.Edge.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Enpass\VaultGuardImports.Enpass.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Firefox\VaultGuardImports.Firefox.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.KeePass\VaultGuardImports.KeePass.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Keeper\VaultGuardImports.Keeper.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.LastPass\VaultGuardImports.LastPass.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.NordPass\VaultGuardImports.NordPass.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.RoboForm\VaultGuardImports.RoboForm.csproj" />
    <ProjectReference Include="..\VaultGuardImports\VaultGuardImports.Safari\VaultGuardImports.Safari.csproj" />
    <ProjectReference Include="..\VaultGuard.ExceptionReporting\VaultGuard.ExceptionReporting.csproj" />
    <ProjectReference Include="..\VaultGuard.ExceptionReporting.Sentry\VaultGuard.ExceptionReporting.Sentry.csproj" />
  </ItemGroup>

  <!-- Prevent Development config from being copied into outputs/publish to avoid MSIX payload collisions -->
  <ItemGroup>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Each referenced VaultGuardImports.* plugin project ships its own plugin.json with
       CopyToOutputDirectory. Referencing all of them here makes every plugin.json land at the same relative
       publish path ('plugin.json'), which fails publish with NETSDK1152 (duplicate output files). The web
       app doesn't use these root-level files — it discovers plugins from imports/otherpasswordmanagers/<name>/
       at runtime — so drop the transitive plugin.json copies from this project's publish output. -->
  <Target Name="RemoveDuplicateImportPluginJson" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'plugin.json'" />
    </ItemGroup>
  </Target>

</Project>
