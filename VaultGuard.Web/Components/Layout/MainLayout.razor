@inherits LayoutComponentBase
@implements IDisposable
@inject VaultGuard.Components.Shared.Services.ThemeService ThemeService
@inject IJSRuntime JS
@inject VaultGuard.Services.Interfaces.IAuthService AuthService
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="@ScaleStyle">
<MudLayout>
    <MudAppBar Elevation="0" Style="background: var(--mud-palette-appbar-background); border-bottom: 1px solid var(--mud-palette-divider);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight:700; color: var(--mud-palette-text-primary);">🔐 Vault Guard</MudText>
        <MudSpacer />
        <MudTooltip Text="@(ThemeService.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton data-testid="theme-toggle" Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@ToggleDarkMode" />
        </MudTooltip>
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Href="/profile">Profile</MudMenuItem>
            <MudMenuItem Href="/settings">Settings</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="@SignOut">Sign Out</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               Style="background: var(--mud-palette-drawer-background);">
        <MudNavMenu>
            <!-- Quick Access (mirrors the WPF desktop navigation) -->
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/passwords" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Lock">All Items</MudNavLink>
            <MudNavLink Href="/passwords?fav=true" Icon="@Icons.Material.Filled.Star">Favourites</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">CATEGORIES</MudText>
            <MudNavLink Href="/passwords?type=Login" Icon="@Icons.Material.Filled.Login">Logins</MudNavLink>
            <MudNavLink Href="/passwords?type=CreditCard" Icon="@Icons.Material.Filled.CreditCard">Credit Cards</MudNavLink>
            <MudNavLink Href="/passwords?type=SecureNote" Icon="@Icons.Material.Filled.StickyNote2">Secure Notes</MudNavLink>
            <MudNavLink Href="/passwords?type=WiFi" Icon="@Icons.Material.Filled.Wifi">Wi-Fi Networks</MudNavLink>
            <MudNavLink Href="/passwords?type=Identity" Icon="@Icons.Material.Filled.Badge">Identities</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">SECURITY</MudText>
            <MudNavLink Href="/security" Icon="@Icons.Material.Filled.HealthAndSafety">Security Center</MudNavLink>
            <MudNavLink Href="/passkeys" Icon="@Icons.Material.Filled.Fingerprint">Passkeys</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">MANAGE</MudText>
            <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
            <MudNavLink Href="/collections" Icon="@Icons.Material.Filled.FolderSpecial">Collections</MudNavLink>
            <MudNavLink Href="/tags" Icon="@Icons.Material.Filled.Tag">Tags</MudNavLink>
            <MudNavLink Href="/vaults" Icon="@Icons.Material.Filled.Shield">Vaults</MudNavLink>
            <MudNavLink Href="/api-keys" Icon="@Icons.Material.Filled.Key">API Keys</MudNavLink>
            <MudNavLink Href="/import" Icon="@Icons.Material.Filled.ImportExport">Import / Export</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">MORE</MudText>
            <MudNavLink Href="/passwords?status=archived" Icon="@Icons.Material.Filled.Archive">Archive</MudNavLink>
            <MudNavLink Href="/passwords?status=deleted" Icon="@Icons.Material.Filled.DeleteSweep">Recently Deleted</MudNavLink>
            <MudNavLink Href="/audit-logs" Icon="@Icons.Material.Filled.History">Audit Logs</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Info" OnClick="@(() => _aboutOpen = true)">About</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
</div>

<MudDialog @bind-Visible="_aboutOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Style="vertical-align:middle;" />
            About
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center text-center">
            <MudAvatar Color="Color.Primary" Style="width:64px; height:64px;" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Style="font-size:2rem;" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Style="font-weight:700;">Vault Guard</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Version 1.0.0 · Web (Blazor · .NET 10)</MudText>
            <MudText Typo="Typo.body2" Class="mt-3">
                The best open-source password manager for Windows and Web.
                End-to-end encrypted with AES-256-GCM.
            </MudText>
            <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">© @DateTime.Now.Year VaultGuard</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Href="https://github.com/dotnetappdev/passwordmanager" Target="_blank"
                   StartIcon="@Icons.Material.Filled.Description">Documentation</MudButton>
        <MudButton Color="Color.Primary" OnClick="@(() => _aboutOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    bool _drawerOpen = true;
    bool _aboutOpen = false;

    MudTheme _theme = new();

    protected override void OnInitialized()
    {
        _theme = VaultGuard.Components.Shared.Services.ThemeService.BuildTheme(ThemeService.AccentColor, ThemeService.IsHighContrast);
        ThemeService.ThemeSettingsChanged += OnThemeSettingsChanged;
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    // CSS zoom string for the app root (invariant culture so "1.2" not "1,2").
    private string ScaleStyle =>
        $"zoom: {ThemeService.UiScale.ToString(System.Globalization.CultureInfo.InvariantCulture)};";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Resolve "System" to the browser's actual preference on first paint.
            await ThemeService.DetectAndApplySystemThemeAsync(JS);
            await InvokeAsync(StateHasChanged);

            // WPF-style unlock gate: the main app requires an authenticated session. Login/Setup use the
            // chrome-free EmptyLayout so they're never gated here. Fail-open on error so a JS hiccup can't
            // lock the user out entirely.
            try
            {
                if (!await AuthService.IsAuthenticatedAsync())
                    Navigation.NavigateTo("/login");
            }
            catch (Exception ex)
            {
                VaultGuard.Services.Logging.AppLogger.Warning("Auth gate check failed; allowing access", ex);
            }
        }
    }

    private void OnThemeSettingsChanged()
    {
        _theme = VaultGuard.Components.Shared.Services.ThemeService.BuildTheme(ThemeService.AccentColor, ThemeService.IsHighContrast);
        InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(object? sender, bool isDark) => InvokeAsync(StateHasChanged);

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    void ToggleDarkMode() => ThemeService.ToggleDarkMode();

    async Task SignOut()
    {
        try { await AuthService.LogoutAsync(); }
        catch (Exception ex) { VaultGuard.Services.Logging.AppLogger.Warning("Sign out failed", ex); }
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        ThemeService.ThemeSettingsChanged -= OnThemeSettingsChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
    }
}
