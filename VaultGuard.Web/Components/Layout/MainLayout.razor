@inherits LayoutComponentBase
@inject VaultGuard.Components.Shared.Services.ThemeService ThemeService

<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Style="background: var(--mud-palette-drawer-background); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight:700; background: linear-gradient(135deg, #2563EB, #60A5FA); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">🔐 Vault Guard</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@ToggleDarkMode" />
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Direction="Direction.Bottom" OffsetY="true">
            <MudMenuItem Href="/profile">Profile</MudMenuItem>
            <MudMenuItem Href="/settings">Settings</MudMenuItem>
            <MudDivider />
            <MudMenuItem>Sign Out</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Color="Color.Transparent">
        <MudNavMenu>
            <!-- Quick Access -->
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/passwords" Icon="@Icons.Material.Filled.Lock">All Items</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">SECURITY</MudText>
            <MudNavLink Href="/security" Icon="@Icons.Material.Filled.HealthAndSafety">Security Dashboard</MudNavLink>
            <MudNavLink Href="/passkeys" Icon="@Icons.Material.Filled.Fingerprint">Passkeys</MudNavLink>
            <MudNavLink Href="/vaults" Icon="@Icons.Material.Filled.Shield">Vaults</MudNavLink>
            <MudNavLink Href="/api-keys" Icon="@Icons.Material.Filled.Key">API Keys</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">ORGANISE</MudText>
            <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
            <MudNavLink Href="/collections" Icon="@Icons.Material.Filled.FolderSpecial">Collections</MudNavLink>
            <MudNavLink Href="/tags" Icon="@Icons.Material.Filled.Tag">Tags</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">MORE</MudText>
            <MudNavLink Href="/import" Icon="@Icons.Material.Filled.ImportExport">Import / Export</MudNavLink>
            <MudNavLink Href="/audit-logs" Icon="@Icons.Material.Filled.History">Audit Logs</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Info" OnClick="@(() => _aboutOpen = true)">About</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<MudDialog @bind-Visible="_aboutOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Style="vertical-align:middle;" />
            About
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center text-center">
            <MudAvatar Color="Color.Primary" Style="width:64px; height:64px;" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Style="font-size:2rem;" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Style="font-weight:700;">VaultGuard Vault Guard</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Version 1.0.0 · Web (Blazor · .NET 10)</MudText>
            <MudText Typo="Typo.body2" Class="mt-3">
                The best open-source password manager for Windows and Web.
                End-to-end encrypted with AES-256-GCM.
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">© @DateTime.Now.Year VaultGuard</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Href="https://github.com/dotnetappdev/passwordmanager" Target="_blank"
                   StartIcon="@Icons.Material.Filled.Description">Documentation</MudButton>
        <MudButton Color="Color.Primary" OnClick="@(() => _aboutOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = true;
    bool _aboutOpen = false;

    MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563EB",
            PrimaryLighten = "#60A5FA",
            PrimaryDarken = "#1D4ED8",
            Secondary = "#6366F1",
            AppbarBackground = "#2563EB",
            AppbarText = "#FFFFFF",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#2563EB",
            PrimaryLighten = "#60A5FA",
            PrimaryDarken = "#1D4ED8",
            Secondary = "#6366F1",
            AppbarBackground = "#141414",
            AppbarText = "#E5E5E5",
            Background = "#1A1A1A",
            BackgroundGray = "#141414",
            Surface = "#2D2D2D",
            DrawerBackground = "#141414",
            DrawerText = "#E5E5E5",
            TextPrimary = "#E5E5E5",
            TextSecondary = "#9D9D9D",
        }
    };

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
}
