@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using VaultGuard.Localization
@inject VaultGuard.Components.Shared.Services.ThemeService ThemeService
@inject IJSRuntime JS
@inject VaultGuard.Services.Interfaces.IAuthService AuthService
@inject VaultGuard.Services.Interfaces.IVaultService VaultService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@if (!_authorized)
{
    @* AUTH GATE: not authenticated (or still verifying). Render a chrome-free themed blank page while we
       redirect to /login. Crucially we do NOT render @Body here, so protected pages are never instantiated
       and no vault data is ever loaded or shown before the gate. This runs in OnParametersSetAsync (before
       the first render), so the dashboard can never flash on screen ahead of the login page. *@
    <MudThemeProvider Theme="_theme" IsDarkMode="@ThemeService.IsDarkMode" />
    <div style="min-height:100vh; background: var(--mud-palette-background);"></div>
}
else
{
<MudThemeProvider Theme="_theme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="@ScaleStyle">
<MudLayout>
    <MudAppBar Elevation="0" Style="background: var(--mud-palette-appbar-background); border-bottom: 1px solid var(--mud-palette-divider);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight:700; color: var(--mud-palette-text-primary);">🔐 Vault Guard</MudText>
        <MudSpacer />
        <MudTooltip Text="@(ThemeService.IsDarkMode ? L["Switch to light mode"] : L["Switch to dark mode"])">
            <MudIconButton data-testid="theme-toggle" Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@ToggleDarkMode" />
        </MudTooltip>
        <LanguageSelector />
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Href="/profile">@L["Profile"]</MudMenuItem>
            <MudMenuItem Href="/settings">@L["Settings"]</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="@SignOut">@L["Sign Out"]</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               Style="background: var(--mud-palette-drawer-background);">
        <MudNavMenu>
            <!-- Quick Access (mirrors the WPF desktop navigation) -->
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@L["Dashboard"]</MudNavLink>
            <MudNavLink Href="/passwords" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Lock">@L["All Items"]</MudNavLink>
            <MudNavLink Href="/passwords?fav=true" Icon="@Icons.Material.Filled.Star">@L["Favourites"]</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">@L["CATEGORIES"]</MudText>
            <MudNavLink Href="/passwords?type=Login" Icon="@Icons.Material.Filled.Login">@L["Logins"]</MudNavLink>
            <MudNavLink Href="/passwords?type=CreditCard" Icon="@Icons.Material.Filled.CreditCard">@L["Credit Cards"]</MudNavLink>
            <MudNavLink Href="/passwords?type=SecureNote" Icon="@Icons.Material.Filled.StickyNote2">@L["Secure Notes"]</MudNavLink>
            <MudNavLink Href="/passwords?type=WiFi" Icon="@Icons.Material.Filled.Wifi">@L["Wi-Fi Networks"]</MudNavLink>
            <MudNavLink Href="/passwords?type=Identity" Icon="@Icons.Material.Filled.Badge">@L["Identities"]</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">@L["SECURITY"]</MudText>
            <MudNavLink Href="/security" Icon="@Icons.Material.Filled.HealthAndSafety">@L["Security Center"]</MudNavLink>
            <MudNavLink Href="/passkeys" Icon="@Icons.Material.Filled.Fingerprint">@L["Passkeys"]</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">@L["MANAGE"]</MudText>
            <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category">@L["Categories"]</MudNavLink>
            <MudNavLink Href="/collections" Icon="@Icons.Material.Filled.FolderSpecial">@L["Collections"]</MudNavLink>
            <MudNavLink Href="/tags" Icon="@Icons.Material.Filled.Tag">@L["Tags"]</MudNavLink>
            <MudNavGroup Title="@L["Vaults"]" Icon="@Icons.Material.Filled.Shield" Expanded="false">
                <MudNavLink Href="/vaults" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.GridView">@L["All Vaults"]</MudNavLink>
                @if (_vaults is { Count: > 0 })
                {
                    @foreach (var v in _vaults)
                    {
                        <MudNavLink Href="@($"/passwords?vaultId={v.Id}")" Icon="@Icons.Material.Filled.Shield">
                            @(string.IsNullOrWhiteSpace(v.Icon) ? "" : v.Icon + " ")@v.Name
                        </MudNavLink>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color:#6B7280;">@L["No vaults yet"]</MudText>
                }
            </MudNavGroup>
            <MudNavLink Href="/api-keys" Icon="@Icons.Material.Filled.Key">@L["API Keys"]</MudNavLink>
            <MudNavLink Href="/import" Icon="@Icons.Material.Filled.ImportExport">@L["Import / Export"]</MudNavLink>
            <MudNavLink Href="/translations" Icon="@Icons.Material.Filled.Translate">@L["Translations"]</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:#6B7280; font-weight:600; letter-spacing:0.5px;">@L["MORE"]</MudText>
            <MudNavLink Href="/passwords?status=archived" Icon="@Icons.Material.Filled.Archive">@L["Archive"]</MudNavLink>
            <MudNavLink Href="/passwords?status=deleted" Icon="@Icons.Material.Filled.DeleteSweep">@L["Recently Deleted"]</MudNavLink>
            <MudNavLink Href="/audit-logs" Icon="@Icons.Material.Filled.History">@L["Audit Logs"]</MudNavLink>
            <MudNavGroup Title="@L["Settings"]" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                <MudNavLink Href="/settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Tune">@L["All Settings"]</MudNavLink>
                @foreach (var t in SettingsTabs)
                {
                    <MudNavLink Href="@($"/settings?tab={t.Key}")" Icon="@t.Value">@t.Key</MudNavLink>
                }
            </MudNavGroup>
            <MudNavLink Icon="@Icons.Material.Filled.Info" OnClick="@(() => _aboutOpen = true)">@L["About"]</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
</div>

<MudDialog @bind-Visible="_aboutOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Style="vertical-align:middle;" />
            About
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center text-center">
            <MudAvatar Color="Color.Primary" Style="width:64px; height:64px;" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Style="font-size:2rem;" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Style="font-weight:700;">Vault Guard</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Version 1.0.0 · Web (Blazor · .NET 10)</MudText>
            <MudText Typo="Typo.body2" Class="mt-3">
                The best open-source password manager for Windows and Web.
                End-to-end encrypted with AES-256-GCM.
            </MudText>
            <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">© @DateTime.Now.Year VaultGuard</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Href="https://github.com/dotnetappdev/passwordmanager" Target="_blank"
                   StartIcon="@Icons.Material.Filled.Description">Documentation</MudButton>
        <MudButton Color="Color.Primary" OnClick="@(() => _aboutOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>
}

@code {
    bool _drawerOpen = true;
    bool _aboutOpen = false;

    // Auth gate state. Starts false so nothing protected renders until we've verified the vault is unlocked.
    bool _authorized;

    // Vaults shown as sub-items under the "Vaults" nav group. Loaded once after auth passes; each links to
    // the item list filtered to that vault. Never blocks the drawer if loading fails.
    List<VaultGuard.Models.Vault>? _vaults;
    bool _vaultsLoaded;

    // Settings tabs mirrored as nav sub-items → /settings?tab=<name>. Order/names match the MudTabPanels in
    // Settings.razor (which reads the ?tab= query param to open the right panel).
    static readonly IReadOnlyList<KeyValuePair<string, string>> SettingsTabs = new[]
    {
        new KeyValuePair<string, string>("Security",      Icons.Material.Filled.Security),
        new KeyValuePair<string, string>("Appearance",    Icons.Material.Filled.Palette),
        new KeyValuePair<string, string>("Database",      Icons.Material.Filled.Storage),
        new KeyValuePair<string, string>("Sync",          Icons.Material.Filled.Sync),
        new KeyValuePair<string, string>("Notifications", Icons.Material.Filled.Notifications),
        new KeyValuePair<string, string>("Vaults",        Icons.Material.Filled.Shield),
        new KeyValuePair<string, string>("Generator",     Icons.Material.Filled.Key),
        new KeyValuePair<string, string>("Encryption",    Icons.Material.Filled.EnhancedEncryption),
        new KeyValuePair<string, string>("Shortcuts",     Icons.Material.Filled.Keyboard),
        new KeyValuePair<string, string>("Maintenance",   Icons.Material.Filled.Build),
        new KeyValuePair<string, string>("About",         Icons.Material.Filled.Info),
    };

    // Routes that never require the vault to be unlocked. Login/Setup already use EmptyLayout (so they don't
    // pass through this layout at all), but keeping them here makes the gate safe even if that ever changes.
    static readonly string[] PublicPaths = { "/login", "/setup", "/register", "/profilelogin" };

    MudTheme _theme = new();

    protected override void OnInitialized()
    {
        _theme = VaultGuard.Components.Shared.Services.ThemeService.BuildTheme(ThemeService.AccentColor, ThemeService.IsHighContrast);
        ThemeService.ThemeSettingsChanged += OnThemeSettingsChanged;
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    // Runs before every render, including the first and after each navigation — so the auth check completes
    // before @Body is ever rendered. This is what prevents the dashboard from flashing ahead of login.
    protected override async Task OnParametersSetAsync()
    {
        await EnforceAuthAsync();
    }

    private bool IsPublicPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var q = path.IndexOf('?');
        if (q >= 0) path = path.Substring(0, q);
        path = "/" + path.Trim('/');
        return PublicPaths.Any(p => string.Equals(p, path, StringComparison.OrdinalIgnoreCase));
    }

    private async Task EnforceAuthAsync()
    {
        if (IsPublicPath())
        {
            _authorized = true;
            return;
        }

        bool authenticated;
        try
        {
            authenticated = await AuthService.IsAuthenticatedAsync();
        }
        catch (Exception ex)
        {
            // Fail CLOSED — an auth-check error must never expose the vault.
            VaultGuard.Services.Logging.AppLogger.Warning("Auth gate check failed; redirecting to login", ex);
            authenticated = false;
        }

        _authorized = authenticated;
        if (authenticated && !_vaultsLoaded)
        {
            // Populate the Vaults nav sub-menu. Best-effort — a failure here must never break the layout.
            _vaultsLoaded = true;
            try { _vaults = await VaultService.GetAllAsync(); }
            catch (Exception ex) { VaultGuard.Services.Logging.AppLogger.Warning("Failed to load vaults for nav menu", ex); }
        }
        if (!authenticated)
        {
            // Send them to the chrome-free login page. NavigateTo during prerender throws a handled
            // NavigationException that performs the redirect server-side (no dashboard is ever sent).
            Navigation.NavigateTo("/login");
        }
    }

    // CSS zoom string for the app root (invariant culture so "1.2" not "1,2").
    private string ScaleStyle =>
        $"zoom: {ThemeService.UiScale.ToString(System.Globalization.CultureInfo.InvariantCulture)};";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Resolve "System" to the browser's actual preference on first paint.
            await ThemeService.DetectAndApplySystemThemeAsync(JS);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnThemeSettingsChanged()
    {
        _theme = VaultGuard.Components.Shared.Services.ThemeService.BuildTheme(ThemeService.AccentColor, ThemeService.IsHighContrast);
        InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(object? sender, bool isDark) => InvokeAsync(StateHasChanged);

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    void ToggleDarkMode() => ThemeService.ToggleDarkMode();

    async Task SignOut()
    {
        try { await AuthService.LogoutAsync(); }
        catch (Exception ex) { VaultGuard.Services.Logging.AppLogger.Warning("Sign out failed", ex); }
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        ThemeService.ThemeSettingsChanged -= OnThemeSettingsChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
    }
}
