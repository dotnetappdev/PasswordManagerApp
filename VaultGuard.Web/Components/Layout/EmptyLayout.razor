@inherits LayoutComponentBase
@inject VaultGuard.Components.Shared.Services.ThemeService ThemeService

@* Chrome-free layout for auth/onboarding pages (login, setup) — no nav drawer or app bar, but keeps the
   MudBlazor providers + WPF-matching dark palette so dialogs, snackbars and theming still work. *@
<MudThemeProvider Theme="_theme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="min-height:100vh; background: var(--mud-palette-background);">
    @Body
</div>

@code {
    // Minimal theme mirroring the WPF desktop palette (neutral grey surfaces; buttons stay blue, never purple).
    readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#71717A",
            Background = "#F5F6F8",
            Surface = "#FFFFFF",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#71717A",
            PrimaryLighten = "#A3A3AB",
            PrimaryDarken = "#52525B",
            Background = "#1A1A1A",         // WPF ModernBackgroundColor
            BackgroundGray = "#242424",    // WPF ModernCardColor
            Surface = "#2D2D2D",           // WPF ModernSurfaceColor
            TextPrimary = "#E5E5E5",        // WPF ModernTextPrimaryColor
            TextSecondary = "#9D9D9D",      // WPF ModernTextSecondaryColor
            Divider = "#3A3A3A",            // WPF ModernBorderColor
        }
    };
}
