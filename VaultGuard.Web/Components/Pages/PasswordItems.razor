@page "/passwords"
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using VaultGuard.Services.Interfaces
@using VaultGuard.Services.Utilities
@using VaultGuard.Models
@using Vault = VaultGuard.Models.Vault
@inject IPasswordItemService PasswordItemService
@inject ICategoryInterface CategoryService
@inject IVaultService VaultService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject VaultGuard.Web.Services.AppNotificationService Notify
@inject IPasswordStrengthService StrengthService
@inject ITotpService TotpService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>All Items - VaultGuard</PageTitle>

@* ── Three-pane master-detail layout (mirrors the WPF desktop app): items list | resizable
     splitter | detail panel. The global app nav (All Items/Favourites/Logins/etc.) already
     lives in MainLayout's drawer, so this page only owns the list + detail panes. ── *@
<div style="display:flex; height:calc(100vh - 96px); margin:-16px; overflow:hidden;">

    <!-- Column 1: Items List -->
    <div id="pm-list-col" style="width:380px; min-width:280px; max-width:640px; flex-shrink:0; display:flex; flex-direction:column; background:var(--mud-palette-surface); border-right:1px solid var(--mud-palette-divider);">

        <div style="padding:16px; border-bottom:1px solid var(--mud-palette-divider);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (_currentVault != null && !string.IsNullOrWhiteSpace(_currentVault.Icon))
                        {
                            <span style="font-size:1.4rem; line-height:1;">@_currentVault.Icon</span>
                        }
                        <MudText Typo="Typo.h6" Style="font-weight:700">@HeaderTitle</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(_currentVault != null ? $"Vault · {filteredItems?.Count ?? 0} items" : $"{filteredItems?.Count ?? 0} items")
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                               Title="Add item" OnClick="@OpenAddDialog" />
            </MudStack>

            <MudTextField Value="@searchText" Placeholder="Search items..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          ValueChanged="@((string s) => { searchText = s; FilterItems(); })"
                          FullWidth="true" Class="mb-2" />

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="string" Value="@typeFilter" Label="Type" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="flex:1;"
                           ValueChanged="@((string s) => { typeFilter = s; FilterItems(); })">
                    <MudSelectItem T="string" Value="@string.Empty">All Types</MudSelectItem>
                    @foreach (ItemType t in Enum.GetValues<ItemType>())
                    {
                        <MudSelectItem T="string" Value="@t.ToString()">@t.ToString()</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox Value="@favoritesOnly" Label="Favorites" Color="Color.Warning" Dense="true"
                             ValueChanged="@((bool b) => { favoritesOnly = b; FilterItems(); })" />
            </MudStack>
        </div>

        <div style="flex:1; overflow-y:auto;">
            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (filteredItems == null || !filteredItems.Any())
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Lock"
                             Style="font-size:3rem; color:#71717A; opacity:0.3;" />
                    <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="mud-text-secondary">
                        @if (!string.IsNullOrEmpty(searchText) || !string.IsNullOrEmpty(typeFilter) || favoritesOnly)
                        { @("No items match your search or filters.") }
                        else { @("Add your first password item to get started.") }
                    </MudText>
                </MudStack>
            }
            else
            {
                @foreach (var item in filteredItems)
                {
                    var isSelected = selectedItem?.Id == item.Id;
                    var capturedItem = item;
                    <div class="pm-list-item @(isSelected ? "pm-list-item--selected" : "")"
                         @onclick="@(() => SelectItem(capturedItem))"
                         style="@($"display:flex; align-items:center; padding:10px 16px; cursor:pointer; border-bottom:1px solid var(--mud-palette-divider); background:{(isSelected ? "var(--pm-sidebar-active)" : "transparent")};")">
                        <div style="@($"width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-right:12px; flex-shrink:0; background:{GetItemColor(item.Type)};")">
                            @if (!string.IsNullOrWhiteSpace(GetBrandIconSource(item)))
                            {
                                <img src="@GetBrandIconSource(item)"
                                     style="width:22px; height:22px; border-radius:4px; object-fit:contain;"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                <MudIcon Icon="@GetItemIcon(item.Type)" Style="color:white; font-size:18px; display:none;" Size="Size.Small" />
                            }
                            else
                            {
                                <MudIcon Icon="@GetItemIcon(item.Type)" Style="color:white; font-size:18px;" Size="Size.Small" />
                            }
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @item.Title
                                @if (item.IsFavorite)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning"
                                             Style="font-size:12px; margin-left:4px; vertical-align:middle;" />
                                }
                            </div>
                            <div style="font-size:12px; color:var(--mud-palette-text-secondary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @GetItemSubtitle(item)
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Splitter -->
    <div id="pm-splitter" style="width:6px; flex-shrink:0; cursor:col-resize; background:var(--mud-palette-divider);"></div>

    <!-- Column 2: Detail Panel -->
    <div style="flex:1; overflow-y:auto; background:var(--mud-palette-background); min-width:300px;">
        @if (selectedItem == null)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%; padding:48px;">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:80px; opacity:0.15;" />
                <MudText Typo="Typo.h6" Style="opacity:0.35; margin-top:16px;">Select an item to view details</MudText>
            </MudStack>
        }
        else
        {
            <div style="padding:32px;">
                <div style="display:flex; align-items:flex-start; margin-bottom:28px; gap:16px;">
                    <div style="@($"width:56px; height:56px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; background:{GetItemColor(selectedItem.Type)};")">
                        @if (!string.IsNullOrWhiteSpace(GetBrandIconSource(selectedItem)))
                        {
                            <img src="@GetBrandIconSource(selectedItem)"
                                 style="width:32px; height:32px; border-radius:6px; object-fit:contain;"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <MudIcon Icon="@GetItemIcon(selectedItem.Type)" Style="color:white; font-size:28px; display:none;" />
                        }
                        else
                        {
                            <MudIcon Icon="@GetItemIcon(selectedItem.Type)" Style="color:white; font-size:28px;" />
                        }
                    </div>
                    <div style="flex:1; min-width:0; padding-top:4px;">
                        <MudText Typo="Typo.h5" Style="font-weight:700; margin-bottom:6px; word-break:break-word;">@selectedItem.Title</MudText>
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                            <MudChip T="string" Size="Size.Small" Color="@GetChipColor(selectedItem.Type)" Variant="Variant.Text">@selectedItem.Type.ToString()</MudChip>
                            @if (selectedItem.IsFavorite)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Filled.Star">Favorite</MudChip>
                            }
                            @if (selectedItem.CategoryId.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@GetCategoryName(selectedItem.CategoryId)</MudChip>
                            }
                        </div>
                    </div>
                    <MudIconButton Icon="@(selectedItem.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                   Color="Color.Warning" Title="Toggle favorite" OnClick="@(() => ToggleFavorite(selectedItem))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Title="Edit" OnClick="@(() => EditItem(selectedItem))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Title="Delete" OnClick="@(() => DeleteItem(selectedItem))" />
                </div>

                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:0 40px;">
                    @if (selectedItem.Type is ItemType.Login or ItemType.Password)
                    {
                        @DetailField("Username", selectedItem.Username, copyable: true)
                        @DetailPasswordField("Password", selectedItem.Password, "pw")
                        @if (!string.IsNullOrEmpty(selectedItem.WebsiteUrl))
                        {
                            @DetailLinkField("Website", selectedItem.WebsiteUrl)
                        }
                    }
                    else if (selectedItem.Type == ItemType.CreditCard)
                    {
                        var card = selectedItem.CreditCardItem;
                        @DetailField("Cardholder Name", card?.CardholderName)
                        @DetailPasswordField("Card Number", card?.CardNumber, "cn")
                        @DetailField("Expiry", card?.ExpiryDate)
                        @DetailPasswordField("CVV", card?.CVV, "cvv")
                        @DetailField("Card Type", card?.CardType.ToString())
                        @DetailField("Issuing Bank", card?.IssuingBank)
                        @DetailLinkField("Online Banking", card?.OnlineBankingUrl)
                    }
                    else if (selectedItem.Type == ItemType.WiFi)
                    {
                        var wifi = selectedItem.WiFiItem;
                        @DetailField("Network Name (SSID)", wifi?.NetworkName ?? selectedItem.Title)
                        @DetailPasswordField("Password", wifi?.Password, "wifipw")
                        @DetailField("Security", wifi?.SecurityType.ToString())
                        @DetailField("Router IP", wifi?.RouterIP)
                    }
                    else if (selectedItem.Type == ItemType.Passkey)
                    {
                        var pk = selectedItem.PasskeyItem;
                        @DetailField("Username / Display Name", pk?.Username ?? pk?.DisplayName)
                        @DetailLinkField("Website", pk?.WebsiteUrl ?? pk?.Website)
                        @DetailField("Device", pk?.DeviceType)
                    }
                    else if (selectedItem.Type == ItemType.Identity)
                    {
                        @DetailField("Username", selectedItem.Username, copyable: true)
                        @DetailLinkField("Website", selectedItem.WebsiteUrl)
                    }
                </div>

                @if ((selectedItem.Type is ItemType.Login or ItemType.Password) && !string.IsNullOrEmpty(_detailTotpSecret))
                {
                    <div style="display:flex; align-items:center; gap:12px; padding:12px 16px; margin-bottom:18px; max-width:420px; background:color-mix(in srgb, var(--mud-palette-primary) 8%, transparent); border-radius:10px; border:1px solid color-mix(in srgb, var(--mud-palette-primary) 20%, transparent);">
                        <div style="font-family:'Consolas',monospace; font-size:26px; font-weight:700; color:var(--mud-palette-primary); letter-spacing:4px; flex:1;">
                            @(_detailTotpCode.Length == 6 ? _detailTotpCode[..3] + " " + _detailTotpCode[3..] : _detailTotpCode)
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap:2px;">
                            <div style="font-size:18px; font-weight:700; color:@(_detailTotpRemaining <= 5 ? "var(--mud-palette-error)" : "var(--mud-palette-text-secondary)");">@_detailTotpRemaining</div>
                            <div style="font-size:10px; color:var(--mud-palette-text-disabled);">SEC</div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary"
                                       Title="Copy code" OnClick="@(() => CopyAsync(_detailTotpCode, "Verification code"))" />
                    </div>
                }

                @if (selectedItem.Type == ItemType.SecureNote)
                {
                    @DetailNoteField("Notes", selectedItem.Description ?? selectedItem.SecureNoteItem?.Content)
                }
                else if (!string.IsNullOrEmpty(selectedItem.Description))
                {
                    @DetailNoteField("Notes", selectedItem.Description)
                }

                @if (selectedItem.Tags != null && selectedItem.Tags.Any())
                {
                    <div style="margin-top:20px;">
                        <div style="font-size:11px; font-weight:700; letter-spacing:1px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:8px;">Tags</div>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                            @foreach (var tag in selectedItem.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag.Name</MudChip>
                            }
                        </div>
                    </div>
                }

                @{
                    var visibleCustomFields = selectedItem.CustomFields?
                        .Where(f => !string.Equals(f.Name, TotpHelper.TotpCustomFieldName, StringComparison.OrdinalIgnoreCase))
                        .ToList() ?? new List<CustomField>();
                }
                @if (visibleCustomFields.Count > 0)
                {
                    <div style="margin-top:20px;">
                        <div style="font-size:11px; font-weight:700; letter-spacing:1px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:8px;">Custom Fields</div>
                        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:0 40px;">
                            @foreach (var field in visibleCustomFields)
                            {
                                @DetailField(field.Name, field.Value, copyable: true)
                            }
                        </div>
                    </div>
                }

                <div style="margin-top:28px; padding-top:16px; border-top:1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Modified @selectedItem.LastModified.ToLocalTime().ToString("MMM d, yyyy 'at' HH:mm")
                        &nbsp;·&nbsp;
                        Created @selectedItem.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                    </MudText>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .pm-list-item:hover {
        background: var(--pm-sidebar-hover) !important;
    }
</style>

@* Add/Edit/View Dialog *@
<MudDialog @bind-Visible="_dialogOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600">
            @if (_isViewMode) { @("View Item") }
            else if (_editItem?.Id > 0) { @("Edit Item") }
            else { @("Add New Item") }
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_editItem != null)
        {
            <MudStack Spacing="3">
                <MudSelect T="ItemType" @bind-Value="_editItem.Type" Label="Item Type"
                           Variant="Variant.Outlined" Required="true" Disabled="_isViewMode">
                    @foreach (ItemType t in Enum.GetValues<ItemType>())
                    {
                        <MudSelectItem T="ItemType" Value="@t">@t.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_editItem.Title" Label="Title *"
                              Variant="Variant.Outlined" Required="true" ReadOnly="_isViewMode" />

                <MudTextField @bind-Value="_editItem.Website" Label="Website URL"
                              Variant="Variant.Outlined" ReadOnly="_isViewMode" />

                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Brand icon</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (!string.IsNullOrWhiteSpace(GetBrandIconSource(_editItem)))
                        {
                            <img src="@GetBrandIconSource(_editItem)" alt="Brand icon preview"
                                 style="width:32px; height:32px; border-radius:8px; object-fit:contain; background:var(--mud-palette-surface); padding:4px;"
                                 onerror="this.onerror=null;this.style.display='none';" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Medium" />
                        }
                        <MudText Typo="Typo.caption">We’ll try the company icon from the website automatically. Upload an image to override it.</MudText>
                    </MudStack>
                    @if (!_isViewMode)
                    {
                        <InputFile OnChange="OnBrandIconSelected" accept="image/*" />
                        @if (HasCustomBrandIcon(_editItem))
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearBrandIcon">
                                Remove uploaded icon
                            </MudButton>
                        }
                    }
                </MudStack>

                @if (_editItem.Type == ItemType.Login || _editItem.Type == ItemType.Password)
                {
                    <MudDivider />
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Login Credentials</MudText>
                    <MudTextField @bind-Value="_editUsername" Label="Username / Email"
                                  Variant="Variant.Outlined" ReadOnly="_isViewMode"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person" />
                    <MudTextField @bind-Value="_editPassword" Label="Password"
                                  Variant="Variant.Outlined" ReadOnly="_isViewMode"
                                  Immediate="true"
                                  InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPwd = !_showPwd)" />

                    @if (!_isViewMode && !string.IsNullOrEmpty(_editPassword))
                    {
                        var strength = StrengthService.Evaluate(_editPassword);
                        <div class="d-flex align-center" style="gap:4px; margin-top:4px;">
                            @for (int i = 1; i <= 4; i++)
                            {
                                var on = i <= Math.Max(1, strength.Score);
                                <div style="@($"height:5px; border-radius:3px; flex:1; background:{(on ? strength.ColorHex : "#3333334d")};")"></div>
                            }
                        </div>
                        <div class="d-flex justify-space-between" style="margin-top:2px;">
                            <MudText Typo="Typo.caption" Style="@($"color:{strength.ColorHex}; font-weight:600;")">@strength.Label</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Crack time: @strength.CrackTimeDisplay</MudText>
                        </div>
                    }

                    @if (!_isViewMode)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-1"
                                   Style="align-self:flex-start;"
                                   StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="@ToggleGenerator">
                            @(_showGenerator ? "Hide password generator" : "Generate strong password")
                        </MudButton>
                        @if (_showGenerator)
                        {
                            <MudPaper Outlined="true" Class="pa-3 mt-1">
                                <div class="d-flex align-center justify-space-between mb-2">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Password Generator</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Refresh"
                                               OnClick="@RegeneratePassword">Regenerate</MudButton>
                                </div>
                                <MudPaper Outlined="true" Class="pa-2 mb-3 d-flex align-center justify-space-between"
                                          Style="gap:8px;">
                                    <MudText Typo="Typo.body1"
                                             Style="font-family:Consolas,monospace; word-break:break-all;">@_genPreview</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               OnClick="@UseGeneratedPassword">Use Password</MudButton>
                                </MudPaper>
                                <div class="d-flex align-center mb-2" style="gap:8px;">
                                    <MudText Typo="Typo.caption" Style="width:56px;">Length</MudText>
                                    <MudSlider T="int" Value="_genLength" ValueChanged="@OnGenLengthChanged"
                                               Min="8" Max="64" Step="1" Color="Color.Primary" Class="flex-grow-1" />
                                    <MudText Typo="Typo.body2" Style="width:28px; text-align:right; font-weight:600;">@_genLength</MudText>
                                </div>
                                <div class="d-flex flex-wrap" style="gap:8px;">
                                    <MudChip T="string" Variant="@(_genUpper ? Variant.Filled : Variant.Outlined)"
                                             Color="Color.Primary" OnClick="@(() => ToggleGenOption("upper"))">A–Z Uppercase</MudChip>
                                    <MudChip T="string" Variant="@(_genLower ? Variant.Filled : Variant.Outlined)"
                                             Color="Color.Primary" OnClick="@(() => ToggleGenOption("lower"))">a–z Lowercase</MudChip>
                                    <MudChip T="string" Variant="@(_genNumbers ? Variant.Filled : Variant.Outlined)"
                                             Color="Color.Primary" OnClick="@(() => ToggleGenOption("numbers"))">0–9 Numbers</MudChip>
                                    <MudChip T="string" Variant="@(_genSymbols ? Variant.Filled : Variant.Outlined)"
                                             Color="Color.Primary" OnClick="@(() => ToggleGenOption("symbols"))">!@@# Symbols</MudChip>
                                </div>
                            </MudPaper>
                        }

                        <MudTextField @bind-Value="_editTotp" Label="Authenticator key (TOTP)"
                                      Variant="Variant.Outlined" Immediate="true"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Pin"
                                      HelperText="Base32 secret or otpauth:// URI — generates verification codes" />
                    }
                    else if (!string.IsNullOrEmpty(_currentTotpCode))
                    {
                        <MudPaper Outlined="true" Class="pa-3 mt-2 d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Verification code (TOTP)</MudText>
                                <MudText Typo="Typo.h5" Style="font-family:monospace; letter-spacing:3px;">@_currentTotpCode</MudText>
                            </div>
                            <div class="d-flex align-center" style="gap:8px;">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_totpRemaining s</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="CopyTotp" />
                            </div>
                        </MudPaper>
                    }
                }

                @if (_isViewMode && _editProtected && !_notesRevealed)
                {
                    <MudPaper Outlined="true" Class="pa-3 d-flex align-center justify-space-between">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Protected note — hidden</MudText>
                        </div>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => _notesRevealed = true)">Reveal</MudButton>
                    </MudPaper>
                }
                else
                {
                    <MudTextField @bind-Value="_editItem.Description" Label="Notes"
                                  Variant="Variant.Outlined" Lines="3" ReadOnly="_isViewMode" />
                }

                @if (!_isViewMode)
                {
                    <MudSwitch T="bool" @bind-Value="_editProtected" Color="Color.Primary"
                               Label="Protect this note (hide content until revealed)" />
                }

                @if (!_isViewMode)
                {
                    <MudSelect T="int?" @bind-Value="_editItem.CategoryId" Label="Category"
                               Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">No Category</MudSelectItem>
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="_editItem.VaultId" Label="Vault"
                               Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">No Vault</MudSelectItem>
                        @foreach (var v in _vaults)
                        {
                            <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudCheckBox @bind-Value="_editItem.IsFavorite" Label="Add to Favorites"
                                 Color="Color.Warning" />
                }
                else
                {
                    @if (_editItem.IsFavorite)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Style="color:#F59E0B;" />
                            <MudText Typo="Typo.body2">Marked as favorite</MudText>
                        </MudStack>
                    }
                    <MudDivider />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2">Category: @GetCategoryName(_editItem.CategoryId)</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Created: @_editItem.CreatedAt.ToString("MMM d, yyyy HH:mm")
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Modified: @_editItem.LastModified.ToString("MMM d, yyyy HH:mm")
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseDialog" Variant="Variant.Text">
            @(_isViewMode ? "Close" : "Cancel")
        </MudButton>
        @if (_isViewMode)
        {
            <MudButton OnClick="@(() => _isViewMode = false)" Variant="Variant.Outlined"
                       Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">
                Edit
            </MudButton>
        }
        else
        {
            <MudButton OnClick="@SaveItem" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @(_editItem?.Id > 0 ? "Save Changes" : "Add Item")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    List<PasswordItem>? _allItems;
    List<PasswordItem>? filteredItems;
    List<Category> _categories = new();
    List<Vault> _vaults = new();
    bool isLoading, _dialogOpen, _saving, _showPwd, favoritesOnly, _isViewMode;
    string searchText = "", typeFilter = "";
    PasswordItem? _editItem;
    string _editUsername = "", _editPassword = "";
    string _editTotp = "";
    string? _currentTotpCode;

    // Inline password generator (mirrors the WPF AddPasswordDialog generator)
    bool _showGenerator;
    int _genLength = 20;
    bool _genUpper = true, _genLower = true, _genNumbers = true, _genSymbols = true;
    string _genPreview = "";

    void ToggleGenerator()
    {
        _showGenerator = !_showGenerator;
        if (_showGenerator && string.IsNullOrEmpty(_genPreview)) RegeneratePassword();
    }

    void OnGenLengthChanged(int value)
    {
        _genLength = value;
        RegeneratePassword();
    }

    void ToggleGenOption(string opt)
    {
        switch (opt)
        {
            case "upper": _genUpper = !_genUpper; break;
            case "lower": _genLower = !_genLower; break;
            case "numbers": _genNumbers = !_genNumbers; break;
            case "symbols": _genSymbols = !_genSymbols; break;
        }
        RegeneratePassword();
    }

    void RegeneratePassword()
    {
        // Same character sets as the WPF generator, using a cryptographic RNG.
        string chars = "";
        if (_genUpper) chars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        if (_genLower) chars += "abcdefghijklmnopqrstuvwxyz";
        if (_genNumbers) chars += "0123456789";
        if (_genSymbols) chars += "!@#$%^&*()-_=+[]{}|;:,.<>?";
        if (string.IsNullOrEmpty(chars)) chars = "abcdefghijklmnopqrstuvwxyz";

        var sb = new System.Text.StringBuilder(_genLength);
        for (int i = 0; i < _genLength; i++)
            sb.Append(chars[System.Security.Cryptography.RandomNumberGenerator.GetInt32(chars.Length)]);
        _genPreview = sb.ToString();
    }

    void UseGeneratedPassword()
    {
        if (string.IsNullOrEmpty(_genPreview)) RegeneratePassword();
        _editPassword = _genPreview;
        _showPwd = true;
        _showGenerator = false;
    }
    int _totpRemaining;
    System.Timers.Timer? _totpTimer;
    bool _editProtected;
    bool _notesRevealed;

    // ── Detail pane selection + its own live TOTP display (separate from the dialog's) ──
    PasswordItem? selectedItem;
    readonly HashSet<string> revealedFields = new();
    string? _detailTotpSecret;
    string _detailTotpCode = "------";
    int _detailTotpRemaining = 30;
    System.Timers.Timer? _detailTotpTimer;

    [SupplyParameterFromQuery] public int? VaultId { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "fav")] public bool FavQuery { get; set; }

    Vault? _currentVault;
    int? _loadedVaultId;
    bool _initialised;
    string? _appliedTypeQuery;
    bool _appliedFavQuery;

    string HeaderTitle => _currentVault?.Name
        ?? (favoritesOnly ? "Favourites"
            : (!string.IsNullOrEmpty(typeFilter) ? typeFilter + "s" : "All Items"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("vgSplitter.init", "pm-splitter", "pm-list-col", 280, 640); }
            catch (System.Exception ex) { VaultGuard.Services.Logging.AppLogger.Warning("Splitter init failed", ex); }
        }
    }

    // Reload whenever the vault query parameter changes (navigating between vaults
    // reuses this component, so OnParametersSet — not OnInitialized — is the hook).
    protected override async Task OnParametersSetAsync()
    {
        // Apply category/favourite filters coming from the WPF-style nav links (/passwords?type=Login, ?fav=true).
        var filterChanged = _appliedTypeQuery != TypeQuery || _appliedFavQuery != FavQuery;
        if (filterChanged)
        {
            _appliedTypeQuery = TypeQuery;
            _appliedFavQuery = FavQuery;
            typeFilter = TypeQuery ?? "";
            favoritesOnly = FavQuery;
        }

        if (!_initialised || _loadedVaultId != VaultId)
        {
            _initialised = true;
            _loadedVaultId = VaultId;
            await LoadAll();
        }
        else if (filterChanged)
        {
            FilterItems();
        }
    }

    async Task LoadAll()
    {
        isLoading = true;
        try
        {
            _categories = (await CategoryService.GetAllAsync()) ?? new();
            _vaults = (await VaultService.GetAllAsync()) ?? new();

            if (VaultId.HasValue)
            {
                // Items scoped to the selected vault; header shows the vault name (never the id).
                _currentVault = _vaults.FirstOrDefault(v => v.Id == VaultId.Value);
                var items = await VaultService.GetItemsAsync(VaultId.Value);
                _allItems = items?.Where(x => !x.IsDeleted).ToList() ?? new();
            }
            else
            {
                // No vault → the default "All Items" view.
                _currentVault = null;
                var items = await PasswordItemService.GetAllAsync();
                _allItems = items?.Where(x => !x.IsDeleted).ToList() ?? new();
            }
            FilterItems();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    void FilterItems()
    {
        filteredItems = (_allItems ?? new())
            .Where(i =>
                (string.IsNullOrEmpty(searchText) ||
                 i.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                 (i.Website?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (i.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (i.LoginItem?.Username?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrEmpty(typeFilter) || i.Type.ToString() == typeFilter) &&
                (!favoritesOnly || i.IsFavorite))
            .ToList();

        // Keep the detail pane's selection in sync if the selected item fell out of the filter.
        if (selectedItem != null && filteredItems.All(i => i.Id != selectedItem.Id))
        {
            SelectItem(null);
        }
    }

    // ── Detail pane selection ────────────────────────────────────────────────
    void SelectItem(PasswordItem? item)
    {
        selectedItem = item;
        revealedFields.Clear();
        StartDetailTotp(item);
    }

    void ToggleReveal(string key)
    {
        if (!revealedFields.Remove(key))
            revealedFields.Add(key);
    }

    async Task CopyAsync(string? value, string label = "Copied")
    {
        if (string.IsNullOrEmpty(value)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add($"{label} copied to clipboard.", Severity.Success);
        }
        catch (System.Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Warning("Clipboard copy failed", ex);
            Snackbar.Add("Copy failed — clipboard access may be blocked.", Severity.Warning);
        }
    }

    void StartDetailTotp(PasswordItem? item)
    {
        _detailTotpTimer?.Stop();
        _detailTotpSecret = item != null ? TotpHelper.GetSecret(item) : null;
        if (string.IsNullOrEmpty(_detailTotpSecret))
        {
            _detailTotpCode = "------";
            _detailTotpRemaining = 30;
            return;
        }
        UpdateDetailTotp();
        _detailTotpTimer ??= new System.Timers.Timer(1000) { AutoReset = true };
        _detailTotpTimer.Elapsed -= OnDetailTotpTick;
        _detailTotpTimer.Elapsed += OnDetailTotpTick;
        _detailTotpTimer.Start();
    }

    void OnDetailTotpTick(object? _, System.Timers.ElapsedEventArgs __)
    {
        UpdateDetailTotp();
        InvokeAsync(StateHasChanged);
    }

    void UpdateDetailTotp()
    {
        if (string.IsNullOrEmpty(_detailTotpSecret)) return;
        try
        {
            _detailTotpCode = TotpService.GenerateCode(_detailTotpSecret) ?? "------";
            _detailTotpRemaining = TotpService.GetRemainingSeconds(30);
        }
        catch (System.Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Warning("TOTP generation failed", ex);
            _detailTotpCode = "------";
            _detailTotpRemaining = 30;
        }
    }

    // ── Detail field render fragments (label + value, with copy/reveal actions) ──
    RenderFragment DetailField(string label, string? value, bool copyable = false)
    {
        if (string.IsNullOrEmpty(value)) return _ => { };
        return
        @<div style="display:flex; align-items:flex-start; margin-bottom:18px;">
            <div style="flex:1; min-width:0;">
                <div style="font-size:11px; font-weight:700; letter-spacing:1px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:4px;">@label</div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="font-size:14px; word-break:break-all; flex:1;">@value</div>
                    @if (copyable)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Default"
                                       Title="@($"Copy {label}")" OnClick="@(() => CopyAsync(value, label))" />
                    }
                </div>
            </div>
        </div>;
    }

    RenderFragment DetailNoteField(string label, string? value)
    {
        if (string.IsNullOrEmpty(value)) return _ => { };
        return
        @<div style="display:flex; align-items:flex-start; margin-bottom:18px;">
            <div style="flex:1; min-width:0;">
                <div style="font-size:11px; font-weight:700; letter-spacing:1px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:4px;">@label</div>
                <div style="font-size:14px; white-space:pre-wrap; word-break:break-word; padding:12px; background:var(--mud-palette-surface); border-radius:8px; border:1px solid var(--mud-palette-divider);">@value</div>
            </div>
        </div>;
    }

    RenderFragment DetailLinkField(string label, string? url)
    {
        if (string.IsNullOrEmpty(url)) return _ => { };
        return
        @<div style="display:flex; align-items:flex-start; margin-bottom:18px;">
            <div style="flex:1; min-width:0;">
                <div style="font-size:11px; font-weight:700; letter-spacing:1px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:4px;">@label</div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <MudLink Href="@url" Target="_blank" Style="font-size:14px; word-break:break-all;">@url</MudLink>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Default"
                                   Title="Copy URL" OnClick="@(() => CopyAsync(url, label))" />
                </div>
            </div>
        </div>;
    }

    RenderFragment DetailPasswordField(string label, string? value, string key)
    {
        if (string.IsNullOrEmpty(value)) return _ => { };
        return
        @<div style="display:flex; align-items:flex-start; margin-bottom:18px;">
            <div style="flex:1; min-width:0;">
                <div style="font-size:11px; font-weight:700; letter-spacing:1px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:4px;">@label</div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="font-size:14px; font-family:monospace; word-break:break-all; flex:1;">
                        @(revealedFields.Contains(key) ? value : new string('•', Math.Min(value?.Length ?? 0, 12)))
                    </div>
                    <MudIconButton Icon="@(revealedFields.Contains(key) ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                   Size="Size.Small" Color="Color.Default"
                                   Title="@(revealedFields.Contains(key) ? "Hide" : "Show")" OnClick="@(() => ToggleReveal(key))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Default"
                                   Title="@($"Copy {label}")" OnClick="@(() => CopyAsync(value, label))" />
                </div>
            </div>
        </div>;
    }

    string GetItemSubtitle(PasswordItem item) => item.Type switch
    {
        ItemType.Login      => item.Username ?? item.WebsiteUrl ?? "",
        ItemType.CreditCard => item.CreditCardItem?.CardholderName ?? "",
        ItemType.SecureNote => item.Description ?? "",
        ItemType.WiFi       => item.WiFiItem?.NetworkName ?? item.Title,
        ItemType.Passkey    => item.PasskeyItem?.Username ?? item.PasskeyItem?.WebsiteUrl ?? "",
        _                   => item.Username ?? ""
    };

    void OpenAddDialog()
    {
        _editItem = new PasswordItem { Type = ItemType.Login, LastModified = DateTime.UtcNow, CreatedAt = DateTime.UtcNow, VaultId = VaultId };
        _editUsername = "";
        _editPassword = "";
        _editTotp = "";
        _editProtected = false;
        _notesRevealed = false;
        _showPwd = false;
        _isViewMode = false;
        StopTotp();
        _dialogOpen = true;
    }

    void ViewItem(PasswordItem item)
    {
        _editItem = CloneItem(item);
        _editUsername = item.LoginItem?.Username ?? "";
        _editPassword = "";
        _editTotp = TotpHelper.GetSecret(_editItem) ?? "";
        _editProtected = ProtectedItemHelper.IsProtected(_editItem);
        _notesRevealed = false;
        _showPwd = false;
        _isViewMode = true;
        _dialogOpen = true;
        StartTotp();
    }

    void EditItem(PasswordItem item)
    {
        _editItem = CloneItem(item);
        _editUsername = item.LoginItem?.Username ?? "";
        _editPassword = "";
        _editTotp = TotpHelper.GetSecret(_editItem) ?? "";
        _editProtected = ProtectedItemHelper.IsProtected(_editItem);
        _notesRevealed = false;
        _showPwd = false;
        _isViewMode = false;
        StopTotp();
        _dialogOpen = true;
    }

    void StartTotp()
    {
        StopTotp();
        if (_editItem == null) return;

        var secret = TotpHelper.GetSecret(_editItem);
        if (string.IsNullOrEmpty(secret) || !TotpService.TryParse(secret, out _, out _, out _))
        {
            _currentTotpCode = null;
            return;
        }

        UpdateTotp();
        _totpTimer = new System.Timers.Timer(1000) { AutoReset = true };
        _totpTimer.Elapsed += async (_, _) =>
        {
            UpdateTotp();
            await InvokeAsync(StateHasChanged);
        };
        _totpTimer.Start();
    }

    void UpdateTotp()
    {
        var secret = _editItem != null ? TotpHelper.GetSecret(_editItem) : null;
        _currentTotpCode = TotpService.GenerateCode(secret);
        _totpRemaining = TotpService.GetRemainingSeconds(30);
    }

    void StopTotp()
    {
        _totpTimer?.Stop();
        _totpTimer?.Dispose();
        _totpTimer = null;
        _currentTotpCode = null;
    }

    async Task CopyTotp()
    {
        var code = TotpService.GenerateCode(TotpHelper.GetSecret(_editItem));
        if (!string.IsNullOrEmpty(code))
        {
            try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", code); } catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
            Snackbar.Add("Verification code copied.", Severity.Success);
        }
    }

    public void Dispose()
    {
        StopTotp();
        _detailTotpTimer?.Stop();
        _detailTotpTimer?.Dispose();
    }

    PasswordItem CloneItem(PasswordItem src) => new PasswordItem
    {
        Id = src.Id,
        Title = src.Title,
        Type = src.Type,
        Website = src.Website,
        Description = src.Description,
        IsFavorite = src.IsFavorite,
        IsArchived = src.IsArchived,
        CategoryId = src.CategoryId,
        VaultId = src.VaultId,
        UserId = src.UserId,
        CreatedAt = src.CreatedAt,
        LastModified = src.LastModified,
        LoginItem = src.LoginItem,
        CustomFields = src.CustomFields?.Select(field => new CustomField
        {
            Id = field.Id,
            Name = field.Name,
            Value = field.Value,
            Type = field.Type,
            IsRequired = field.IsRequired,
            IsProtected = field.IsProtected,
            DisplayOrder = field.DisplayOrder,
            PasswordItemId = field.PasswordItemId,
            CreatedAt = field.CreatedAt,
            LastModified = field.LastModified
        }).ToList() ?? new List<CustomField>()
    };

    async Task SaveItem()
    {
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.Title))
        {
            Snackbar.Add("Title is required.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            _editItem.LastModified = DateTime.UtcNow;
            TotpHelper.SetSecret(_editItem, _editTotp);
            ProtectedItemHelper.SetProtected(_editItem, _editProtected);

            // VaultId is a transient property — persist the choice by attaching the item to the
            // vault's collection so vault filtering picks it up (mirrors the WPF behaviour).
            if (_editItem.VaultId.HasValue)
            {
                var collectionId = await VaultService.GetDefaultCollectionIdAsync(_editItem.VaultId.Value);
                if (collectionId.HasValue) _editItem.CollectionId = collectionId;
            }

            bool wasSelected = selectedItem?.Id == _editItem.Id;

            if (_editItem.Id > 0)
            {
                await PasswordItemService.UpdateAsync(_editItem);
                Snackbar.Add("Item updated successfully.", Severity.Success);
            }
            else
            {
                await PasswordItemService.CreateAsync(_editItem);
                Snackbar.Add("Item added successfully.", Severity.Success);
            }
            _dialogOpen = false;
            await LoadAll();

            // Keep the detail pane showing the item that was just edited.
            if (wasSelected)
            {
                var refreshed = filteredItems?.FirstOrDefault(i => i.Id == _editItem.Id);
                if (refreshed != null) SelectItem(refreshed);
            }
        }
        catch (Exception ex)
        {
            await Notify.ShowErrorAsync("The item couldn't be saved. Please try again.", ex);
        }
        finally
        {
            _saving = false;
        }
    }

    async Task ToggleFavorite(PasswordItem item)
    {
        try
        {
            await PasswordItemService.ToggleFavoriteAsync(item.Id);
            item.IsFavorite = !item.IsFavorite;
            FilterItems();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    async Task DeleteItem(PasswordItem item)
    {
        var ok = await DialogService.ShowMessageBox(
            "Delete Item",
            $"Permanently delete \"{item.Title}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok == true)
        {
            try
            {
                await PasswordItemService.DeleteAsync(item.Id);
                Snackbar.Add("Item deleted.", Severity.Success);
                if (selectedItem?.Id == item.Id) SelectItem(null);
                await LoadAll();
            }
            catch (Exception ex)
            {
                await Notify.ShowErrorAsync("The item couldn't be deleted.", ex);
            }
        }
    }

    void CloseDialog()
    {
        StopTotp();
        _dialogOpen = false;
    }

    string GetCategoryName(int? categoryId)
        => categoryId.HasValue
            ? (_categories.FirstOrDefault(c => c.Id == categoryId.Value)?.Name ?? "Uncategorized")
            : "Uncategorized";

    string GetItemIcon(ItemType t) => t switch
    {
        ItemType.Login => Icons.Material.Filled.Language,
        ItemType.CreditCard => Icons.Material.Filled.CreditCard,
        ItemType.SecureNote => Icons.Material.Filled.Note,
        ItemType.WiFi => Icons.Material.Filled.Wifi,
        ItemType.Passkey => Icons.Material.Filled.Fingerprint,
        ItemType.Identity => Icons.Material.Filled.Person,
        _ => Icons.Material.Filled.Lock
    };

    string GetItemColor(ItemType t) => t switch
    {
        ItemType.Login => "#71717A",
        ItemType.CreditCard => "#EC4899",
        ItemType.SecureNote => "#10B981",
        ItemType.WiFi => "#71717A",
        ItemType.Passkey => "#F59E0B",
        ItemType.Identity => "#8B5CF6",
        _ => "#6B7280"
    };

    Color GetChipColor(ItemType t) => t switch
    {
        ItemType.Login => Color.Primary,
        ItemType.CreditCard => Color.Secondary,
        ItemType.SecureNote => Color.Success,
        ItemType.WiFi => Color.Info,
        ItemType.Passkey => Color.Warning,
        _ => Color.Default
    };

    string? GetBrandIconSource(PasswordItem? item)
        => item?.Type == ItemType.Login ? BrandIconHelper.GetBrandIconSource(item) : null;

    bool HasCustomBrandIcon(PasswordItem? item)
        => item != null && BrandIconHelper.GetCustomBrandIconDataUrl(item) != null;

    async Task OnBrandIconSelected(InputFileChangeEventArgs e)
    {
        if (_editItem == null)
        {
            return;
        }

        try
        {
            var file = e.File;
            if (file == null)
            {
                return;
            }

            if (string.IsNullOrWhiteSpace(file.ContentType) || !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                Snackbar.Add("Please choose an image file for the brand icon.", Severity.Warning);
                return;
            }

            await using var stream = file.OpenReadStream(BrandIconHelper.MaxBrandIconBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";
            BrandIconHelper.SetCustomBrandIcon(_editItem, dataUrl);
        }
        catch (IOException)
        {
            Snackbar.Add("Brand icons must be 1 MB or smaller.", Severity.Warning);
        }
    }

    void ClearBrandIcon()
    {
        if (_editItem != null)
        {
            BrandIconHelper.SetCustomBrandIcon(_editItem, null);
        }
    }
}
