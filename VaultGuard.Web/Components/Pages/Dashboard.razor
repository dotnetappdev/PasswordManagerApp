@page "/"
@using VaultGuard.Services.Interfaces
@using VaultGuard.Models
@inject IPasswordItemService PasswordItemService
@inject IVaultService VaultService
@inject ICategoryInterface CategoryService
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Dashboard - VaultGuard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1" Style="font-weight:700">Dashboard</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">Welcome back! Here's your security overview.</MudText>

@if (isLoading)
{
    <MudGrid>
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #2563EB; cursor:pointer;"
                      @onclick="@(() => Nav.NavigateTo("/passwords"))">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color:#2563EB; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@totalPasswords</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Items</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #10B981; cursor:pointer;"
                      @onclick="@(() => Nav.NavigateTo("/passwords?fav=true"))">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Style="color:#10B981; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@favoriteCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Favorites</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #F59E0B; cursor:pointer;"
                      @onclick="@(() => Nav.NavigateTo("/vaults"))">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color:#F59E0B; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@vaultCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Vaults</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left: 4px solid #EC4899; cursor:pointer;"
                      @onclick="@(() => Nav.NavigateTo("/categories"))">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Style="color:#EC4899; font-size:2rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Style="font-weight:700">@categoryCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Categories</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600">Recent Items</MudText>
                @if (recentItems?.Any() == true)
                {
                    <MudList T="PasswordItem">
                        @foreach (var item in recentItems.Take(8))
                        {
                            <MudListItem T="PasswordItem" Icon="@GetItemIcon(item.Type)">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body1" Style="font-weight:500">@item.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Type.ToString() &bull; @item.LastModified.ToString("MMM d, yyyy")</MudText>
                                    </MudStack>
                                    @if (item.IsFavorite)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Style="color:#F59E0B; font-size:1.1rem;" />
                                    }
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                    <MudButton Href="/passwords" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">View All Items &rarr;</MudButton>
                }
                else
                {
                    <MudText Color="Color.Secondary">No items yet. <MudLink Href="/passwords">Add your first password</MudLink></MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600">Quick Actions</MudText>
                <MudStack Spacing="2">
                    <MudButton Href="/passwords" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Add Password</MudButton>
                    <MudButton Href="/import" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">Import Passwords</MudButton>
                    <MudButton Href="/vaults" StartIcon="@Icons.Material.Filled.Shield" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true">Manage Vaults</MudButton>
                    <MudButton Href="/passkeys" StartIcon="@Icons.Material.Filled.Fingerprint" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true">Manage Passkeys</MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600">Item Types</MudText>
                @foreach (var kv in itemTypeCounts)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2"
                              Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo($"/passwords?type={kv.Key}"))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@GetItemIcon(kv.Key)" Style="@($"color:{GetItemColor(kv.Key)}; font-size:1.1rem;")" />
                            <MudText Typo="Typo.body2">@kv.Key.ToString()</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Text="@kv.Value.ToString()" />
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    bool isLoading = true;
    int totalPasswords, favoriteCount, vaultCount, categoryCount;
    List<PasswordItem>? recentItems;
    Dictionary<ItemType, int> itemTypeCounts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allItemsEnum = await PasswordItemService.GetAllAsync();
            var allItems = allItemsEnum?.ToList() ?? new List<PasswordItem>();
            var activeItems = allItems.Where(x => !x.IsDeleted && !x.IsArchived).ToList();

            recentItems = activeItems.OrderByDescending(x => x.LastModified).Take(10).ToList();
            totalPasswords = activeItems.Count;
            favoriteCount = activeItems.Count(x => x.IsFavorite);

            itemTypeCounts = activeItems
                .GroupBy(x => x.Type)
                .ToDictionary(g => g.Key, g => g.Count());

            var vaults = await VaultService.GetAllAsync();
            vaultCount = vaults?.Count ?? 0;

            var categories = await CategoryService.GetAllAsync();
            categoryCount = categories?.Count ?? 0;
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
        finally
        {
            isLoading = false;
        }
    }

    string GetItemIcon(ItemType type) => type switch
    {
        ItemType.Login => Icons.Material.Filled.Language,
        ItemType.CreditCard => Icons.Material.Filled.CreditCard,
        ItemType.SecureNote => Icons.Material.Filled.Note,
        ItemType.WiFi => Icons.Material.Filled.Wifi,
        ItemType.Passkey => Icons.Material.Filled.Fingerprint,
        ItemType.Identity => Icons.Material.Filled.Person,
        _ => Icons.Material.Filled.Lock
    };

    string GetItemColor(ItemType type) => type switch
    {
        ItemType.Login => "#2563EB",
        ItemType.CreditCard => "#EC4899",
        ItemType.SecureNote => "#10B981",
        ItemType.WiFi => "#3B82F6",
        ItemType.Passkey => "#F59E0B",
        ItemType.Identity => "#8B5CF6",
        _ => "#6B7280"
    };
}
