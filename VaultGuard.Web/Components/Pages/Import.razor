@page "/import"
@using Microsoft.AspNetCore.Components.Forms
@using VaultGuard.Services.Interfaces
@using VaultGuard.Imports.Interfaces
@inject IDatabaseResetService ResetService
@inject IImportService ImportService
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>Import - VaultGuard</PageTitle>

<MudText Typo="Typo.h4" Style="font-weight:700" Class="mb-1">Import Passwords</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Import from your existing password manager. Your data is processed locally.
</MudText>

<MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Choose your password manager</MudText>
<MudGrid Class="mb-6">
    @foreach (var pm in passwordManagers)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard @onclick="@(() => SelectManager(pm.Key))" Class="cursor-pointer"
                     Style="@(selectedManager == pm.Key
                               ? "border: 2px solid #2563EB; transition: all 0.2s;"
                               : "border: 2px solid transparent; transition: all 0.2s;")"
                     Elevation="@(selectedManager == pm.Key ? 4 : 1)">
                <MudCardContent Class="text-center pa-3">
                    <MudText Style="font-size:2.2rem; line-height:1.2;">@pm.Value.Icon</MudText>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600; margin-top:6px;">@pm.Value.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@pm.Value.Format</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (selectedManager != null)
{
    var pm = passwordManagers[selectedManager];
    <MudPaper Class="pa-6 rounded-xl" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudText Style="font-size:1.8rem;">@pm.Icon</MudText>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:600;">Import from @pm.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Format: @pm.Format</MudText>
            </div>
        </MudStack>

        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@pm.Instructions</MudAlert>

        <MudFileUpload T="IBrowserFile" FilesChanged="@OnFileSelected"
                       Accept="@pm.FileTypes" MaximumFileCount="1">
            <ActivatorContent>
                <MudPaper Class="pa-8 rounded-xl text-center"
                          Style="border: 2px dashed rgba(124,58,237,0.5); cursor:pointer; transition: background 0.2s;"
                          Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload"
                             Style="font-size:3rem; color:#2563EB; opacity:0.8;" />
                    <MudText Typo="Typo.body1" Class="mt-2" Style="font-weight:500;">
                        Drop your export file here or click to browse
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Supported formats: @pm.FileTypes
                    </MudText>
                </MudPaper>
            </ActivatorContent>
        </MudFileUpload>

        @if (selectedFile != null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Style="font-size:1rem;" />
                        <MudText Typo="Typo.body2" Style="font-weight:500;">@selectedFile.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@(FormatLabel(selectedFile.Name) == "1PUX" ? Color.Primary : Color.Default)"
                                 Text="@($"({FormatLabel(selectedFile.Name)})")" />
                    </MudStack>
                    <MudText Typo="Typo.caption">@((selectedFile.Size / 1024.0).ToString("F1")) KB</MudText>
                </MudStack>
            </MudAlert>
        }

        @if (importResult != null)
        {
            <MudAlert Severity="@(importResult.Value.Success ? Severity.Success : Severity.Error)"
                      Class="mt-3">
                @importResult.Value.Message
            </MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Filled"
                       Color="Color.Primary" OnClick="@RunImport"
                       Disabled="@(selectedFile == null || isImporting)">
                @if (isImporting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Importing...")
                }
                else
                {
                    @("Import Passwords")
                }
            </MudButton>
            @if (selectedFile != null && !isImporting)
            {
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           OnClick="@ClearSelection">Clear</MudButton>
            }
        </MudStack>
    </MudPaper>
}

@if (selectedManager == null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        <MudText Typo="Typo.body2">
            Select a password manager above to get started. Your data is never sent to any server —
            all processing happens locally in your browser.
        </MudText>
    </MudAlert>
}

<MudPaper Class="pa-6 rounded-xl mt-6" Elevation="2" Style="border: 1px solid rgba(239,68,68,0.3);">
    <MudText Typo="Typo.h6" Style="font-weight:600; color:#EF4444;" Class="mb-1">Maintenance</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Reset the vault before importing a fresh export. These actions cannot be undone.
    </MudText>
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudButton StartIcon="@Icons.Material.Filled.DeleteSweep" Variant="Variant.Filled"
                   Color="Color.Error" OnClick="@ClearVaultData" Disabled="@isClearing">
            Clear Vault Data
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.PersonRemove" Variant="Variant.Outlined"
                   Color="Color.Error" OnClick="@ClearUsers" Disabled="@isClearing">
            Clear Users (keep admins)
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    bool isClearing = false;

    async Task ClearVaultData()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Clear Vault Data",
            "This permanently deletes all vault items, categories, collections and tags. User accounts are kept. Continue?",
            yesText: "Yes, continue", cancelText: "Cancel");
        if (confirmed != true) return;

        isClearing = true;
        try
        {
            var result = await ResetService.ResetDataTablesAsync();
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to clear vault data: {ex.Message}", Severity.Error);
        }
        finally { isClearing = false; }
    }

    async Task ClearUsers()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Clear Users",
            "This permanently deletes all non-admin user accounts and the data they own. Admin accounts are left intact. Continue?",
            yesText: "Yes, continue", cancelText: "Cancel");
        if (confirmed != true) return;

        isClearing = true;
        try
        {
            var result = await ResetService.ClearNonAdminUsersAsync();
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to clear users: {ex.Message}", Severity.Error);
        }
        finally { isClearing = false; }
    }

    string? selectedManager;
    IBrowserFile? selectedFile;
    bool isImporting = false;
    (bool Success, string Message)? importResult;

    record VaultGuardInfo(string Name, string Icon, string Format, string Instructions, string FileTypes);

    readonly Dictionary<string, VaultGuardInfo> passwordManagers = new()
    {
        ["1password"] = new("1Password", "🔐", "1PUX / CSV",
            "In 1Password, go to File → Export → All Vaults. Choose 1PUX or CSV format.",
            ".1pux,.csv"),
        ["bitwarden"] = new("Bitwarden", "🛡️", "JSON / CSV",
            "In Bitwarden web vault, go to Tools → Export Vault. Choose JSON format for best results.",
            ".json,.csv"),
        ["lastpass"] = new("LastPass", "⭐", "CSV",
            "In LastPass, go to Account Options → Advanced → Export. Save as CSV.",
            ".csv"),
        ["dashlane"] = new("Dashlane", "🔷", "CSV / JSON",
            "In Dashlane, go to My Account → Export Data. Choose CSV format.",
            ".csv,.json"),
        ["keepass"] = new("KeePass", "🔑", "XML / CSV",
            "In KeePass, go to File → Export. Choose KeePass XML 2.x format for full data.",
            ".xml,.csv"),
        ["chrome"] = new("Google Chrome", "🌐", "CSV",
            "In Chrome, go to Settings → Autofill → Vault Guard → Export passwords.",
            ".csv"),
        ["firefox"] = new("Firefox", "🦊", "CSV",
            "In Firefox, go to Passwords → ⋮ menu → Export Passwords.",
            ".csv"),
        ["edge"] = new("Microsoft Edge", "💎", "CSV",
            "In Edge, go to Settings → Passwords → ⋮ → Export passwords.",
            ".csv"),
        ["safari"] = new("Safari", "🧭", "CSV",
            "On Mac, go to File → Export → Passwords. Requires macOS Monterey or later.",
            ".csv"),
        ["nordpass"] = new("NordPass", "🔒", "CSV",
            "In NordPass, go to Settings → Import/Export → Export Items.",
            ".csv"),
        ["keeper"] = new("Keeper", "🏆", "CSV / JSON",
            "In Keeper, go to Settings → Export. Choose CSV format.",
            ".csv,.json"),
        ["enpass"] = new("Enpass", "🔮", "JSON",
            "In Enpass, go to File → Export → Enpass JSON. Enter your vault password when prompted.",
            ".json"),
        ["roboform"] = new("RoboForm", "🤖", "CSV",
            "In RoboForm, go to RoboForm menu → Options → Account & Data → Export.",
            ".csv"),
        ["apple"] = new("Apple Passwords", "🍎", "CSV",
            "On iPhone/Mac: Settings → Passwords → ⋮ → Export Passwords.",
            ".csv"),
        ["sticky"] = new("Sticky Password", "🍯", "CSV / XML",
            "In Sticky Password, go to Menu → Export. Choose CSV format.",
            ".csv,.xml"),
    };

    void SelectManager(string key)
    {
        selectedManager = key;
        selectedFile = null;
        importResult = null;
    }

    void OnFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        importResult = null;
    }

    void ClearSelection()
    {
        selectedFile = null;
        importResult = null;
    }

    protected override void OnInitialized()
    {
        // Register the built-in providers explicitly. Referencing the provider types forces their
        // assemblies to load so ImportService can resolve them by name.
        ImportService.RegisterProvider(new VaultGuardImports.OnePassword.Providers.OnePasswordImportProvider());
        ImportService.RegisterProvider(new VaultGuardImports.Bitwarden.BitwardenImportPlugin());
    }

    // Returns a short, upper-case format label from a file name so 1PUX and CSV are easy to tell apart.
    static string FormatLabel(string? fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName ?? string.Empty).TrimStart('.').ToUpperInvariant();
        return ext switch
        {
            "1PUX" or "1PU" => "1PUX",
            "" => "FILE",
            _ => ext
        };
    }

    // Maps a password-manager card key to a registered import provider name (null = not yet supported).
    static string? MapProvider(string key) => key switch
    {
        "1password" => "1Password",
        "bitwarden" => "bitwarden",
        _ => null
    };

    const long MaxImportBytes = 10 * 1024 * 1024;

    async Task RunImport()
    {
        if (selectedFile == null || selectedManager == null) return;
        isImporting = true;
        importResult = null;
        try
        {
            // Validate file size (max 10 MB)
            if (selectedFile.Size > MaxImportBytes)
            {
                importResult = (false, "File is too large. Maximum size is 10 MB.");
                return;
            }

            var providerName = MapProvider(selectedManager);
            if (providerName is null)
            {
                importResult = (false,
                    $"{passwordManagers[selectedManager].Name} import isn't available in the web app yet. " +
                    "1Password (1PUX/CSV) and Bitwarden (CSV) are supported.");
                return;
            }

            // Copy to a seekable MemoryStream — required for .1pux (zip) parsing.
            using var ms = new MemoryStream();
            await using (var rs = selectedFile.OpenReadStream(MaxImportBytes))
            {
                await rs.CopyToAsync(ms);
            }
            ms.Position = 0;

            var userId = AuthService.CurrentUser?.Id;
            var result = await ImportService.ImportPasswordsAsync(providerName, ms, selectedFile.Name, userId);

            if (result.Success)
            {
                var msg = $"Imported {result.SuccessfulImports} of {result.TotalItemsProcessed} item(s) from {selectedFile.Name}. " +
                          "They're now in All Items.";
                if (result.FailedImports > 0)
                    msg += $" {result.FailedImports} item(s) could not be imported.";
                importResult = (true, msg);
            }
            else
            {
                importResult = (false, result.ErrorMessage ?? "Import failed. Please check the file and try again.");
            }
        }
        catch (Exception ex)
        {
            importResult = (false, $"Import failed: {ex.Message}");
        }
        finally
        {
            isImporting = false;
        }
    }
}
