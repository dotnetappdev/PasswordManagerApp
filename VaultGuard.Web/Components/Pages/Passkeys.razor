@page "/passkeys"
@using VaultGuard.Services.Interfaces
@using VaultGuard.Models
@using VaultGuard.Models.DTOs.Auth
@using Microsoft.JSInterop
@inject IPasskeyService PasskeyService
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageTitle>Passkeys - VaultGuard</PageTitle>

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-5">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <div style="width:52px; height:52px; border-radius:14px; display:flex; align-items:center; justify-content:center;
                    background: linear-gradient(135deg, #71717A 0%, #A3A3AB 100%);">
            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Style="color:white; font-size:1.7rem;" />
        </div>
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:700; line-height:1.1;">Passkeys</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Passwordless authentication credentials</MudText>
        </div>
    </MudStack>

    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="@OpenRegisterDialog">
        Register Passkey
    </MudButton>
</MudStack>

<!-- ── Stats ──────────────────────────────────────────────────────────────── -->
<MudGrid Class="mb-5">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2" Style="border-radius:12px; border-left:4px solid #71717A;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <div style="width:44px; height:44px; border-radius:10px; background:#1E3A5F;
                            display:flex; align-items:center; justify-content:center;">
                    <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Style="color:#A3A3AB;" />
                </div>
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight:700;">@(passkeys?.Count ?? 0)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Registered Passkeys</MudText>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2" Style="@($"border-radius:12px; border-left:4px solid {(passkeyStatus?.IsEnabled == true ? "#10B981" : "#6B7280")};")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <div style="@($"width:44px; height:44px; border-radius:10px; background:{(passkeyStatus?.IsEnabled == true ? "#14532D" : "#1F2937")}; display:flex; align-items:center; justify-content:center;")">
                    <MudIcon Icon="@(passkeyStatus?.IsEnabled == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Style="@($"color:{(passkeyStatus?.IsEnabled == true ? "#4ADE80" : "#9D9D9D")};")"/>
                </div>
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight:600;">
                        @(passkeyStatus?.IsEnabled == true ? "Enabled" : "Disabled")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Passkey Status</MudText>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2" Style="border-radius:12px; border-left:4px solid #A3A3AB;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <div style="width:44px; height:44px; border-radius:10px; background:#1E3A5F;
                            display:flex; align-items:center; justify-content:center;">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color:#A3A3AB;" />
                </div>
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight:600;">FIDO2</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">WebAuthn Standard</MudText>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2" Style="border-radius:12px; border-left:4px solid #4ADE80;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <div style="width:44px; height:44px; border-radius:10px; background:#14532D;
                            display:flex; align-items:center; justify-content:center;">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Style="color:#4ADE80;" />
                </div>
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight:600;">Zero</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Phishing Risk</MudText>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- ── Info Banner ────────────────────────────────────────────────────────── -->
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" Dense="false" Style="border-radius:12px;">
    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Info" Style="margin-top:1px;" Size="Size.Small"/>
        <div>
            <MudText Typo="Typo.subtitle2" Style="font-weight:600;">What are Passkeys?</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Passkeys replace passwords with device-bound cryptographic keys protected by your
                biometrics (fingerprint, face) or device PIN. They are phishing-resistant by design
                and cannot be stolen via data breaches because the private key never leaves your device.
            </MudText>
        </div>
    </MudStack>
</MudAlert>

<!-- ── Loading ────────────────────────────────────────────────────────────── -->
@if (isLoading)
{
    <MudGrid>
        @for (int i = 0; i < 3; i++)
        {
            <MudItem xs="12">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="84px" Style="border-radius:12px;" />
            </MudItem>
        }
    </MudGrid>
}
else if (passkeys?.Any() == true)
{
    <!-- ── Passkey Cards ─────────────────────────────────────────────────── -->
    <MudText Typo="Typo.subtitle2" Class="mb-3 mud-text-secondary">
        @passkeys.Count passkey@(passkeys.Count == 1 ? "" : "s") registered
    </MudText>
    @foreach (var pk in passkeys)
    {
        <MudPaper Class="pa-0 mb-3" Elevation="2"
                  Style="border-radius:12px; border:1px solid rgba(255,255,255,0.06); overflow:hidden;">
            <div style="display:grid; grid-template-columns:auto 1fr auto; align-items:center; padding:18px 20px; gap:16px;">
                <!-- Device Icon -->
                <div style="width:52px; height:52px; border-radius:12px; background:#1E3A5F;
                            display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <MudIcon Icon="@GetDeviceIcon(pk.DeviceType)"
                             Style="color:#A3A3AB; font-size:1.6rem;" />
                </div>

                <!-- Info -->
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600; line-height:1.2;">@pk.Name</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(pk.DeviceType ?? "Unknown device")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">·</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Last used: @(pk.LastUsedAt?.ToString("MMM d, yyyy") ?? "Never")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">·</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Registered @pk.CreatedAt.ToString("MMM d, yyyy")
                        </MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="1" Class="mt-2">
                        @if (pk.IsBackedUp)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                     Icon="@Icons.Material.Filled.CloudDone">Synced</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                     Icon="@Icons.Material.Filled.PhoneAndroid">Device-bound</MudChip>
                        }
                        @if (pk.RequiresUserVerification)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                     Icon="@Icons.Material.Filled.VerifiedUser">UV Required</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">FIDO2</MudChip>
                        @if (pk.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Inactive</MudChip>
                        }
                    </MudStack>
                </div>

                <!-- Actions -->
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Default"
                               OnClick="@(() => DeletePasskey(pk))"
                               Title="Remove passkey"
                               Size="Size.Medium" />
            </div>
        </MudPaper>
    }
}
else
{
    <!-- ── Empty State ───────────────────────────────────────────────────── -->
    <MudPaper Class="pa-12 text-center" Elevation="1"
              Style="border-radius:16px; border:1px dashed rgba(37,99,235,0.3);">
        <div style="width:80px; height:80px; border-radius:20px; margin:0 auto 20px;
                    background:linear-gradient(135deg,#71717A,#A3A3AB);
                    display:flex; align-items:center; justify-content:center;">
            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Style="color:white; font-size:2.5rem;" />
        </div>
        <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-2">No passkeys registered</MudText>
        <MudText Typo="Typo.body2" Style="max-width:400px; margin:0 auto;" Class="mb-5 mud-text-secondary">
            Register a passkey to enable fast, secure passwordless sign-in across all your devices.
        </MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@OpenRegisterDialog" Size="Size.Large">
            Register Your First Passkey
        </MudButton>
    </MudPaper>
}

<!-- ── Supported Sites ────────────────────────────────────────────────────── -->
<MudPaper Class="pa-4 mt-5" Elevation="1"
          Style="border-radius:12px; border:1px solid rgba(255,255,255,0.06);">
    <MudText Typo="Typo.subtitle2" Class="mb-3 mud-text-secondary">
        Popular passkey-supported sites
    </MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        @foreach (var site in new[] { "🔍 Google", "🍎 Apple ID", "🐙 GitHub", "🛒 Amazon",
                                       "🪟 Microsoft", "📘 LinkedIn", "🎮 PlayStation", "💼 Dropbox" })
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="border-radius:8px;">@site</MudChip>
        }
    </MudStack>
</MudPaper>

<!-- ── Register Dialog ────────────────────────────────────────────────────── -->
<MudDialog @bind-Visible="_registerDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Style="color:#A3A3AB;" />
            <MudText Typo="Typo.h6">Register New Passkey</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                Your browser or device will prompt you to use biometrics or your PIN to register the passkey.
            </MudAlert>
            <MudTextField @bind-Value="_passkeyName" Label="Passkey Name *"
                          Variant="Variant.Outlined" Required="true"
                          Placeholder="e.g. MacBook Pro Touch ID, iPhone 15, YubiKey 5" />
            <MudTextField @bind-Value="_masterPasswordForPasskey" Label="Master Password"
                          InputType="InputType.Password" Variant="Variant.Outlined" Required="true"
                          HelperText="Required to authorize the registration" />
            <MudCheckBox T="bool" @bind-Value="_storeInVault" Label="Store passkey metadata in encrypted vault"
                         Color="Color.Primary" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseRegisterDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="@RegisterPasskey" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@isRegistering" StartIcon="@Icons.Material.Filled.Fingerprint">
            @if (isRegistering) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Register Passkey
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ── Delete Dialog ──────────────────────────────────────────────────────── -->
<MudDialog @bind-Visible="_deleteDialogVisible" Options="_deleteDialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
            <MudText Typo="Typo.h6" Color="Color.Error">Remove Passkey</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Dense="true">
                Removing this passkey will prevent you from using it to sign in.
                Ensure you have another authentication method available.
            </MudAlert>
            <MudText Typo="Typo.body1">
                Remove passkey: <strong>@_deletingPasskey?.Name</strong>?
            </MudText>
            <MudTextField @bind-Value="_masterPasswordForDelete" Label="Master Password"
                          InputType="InputType.Password" Variant="Variant.Outlined" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseDeleteDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="@ConfirmDeletePasskey" Variant="Variant.Filled" Color="Color.Error"
                   Disabled="@isDeleting">
            @if (isDeleting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Remove Passkey
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    List<PasskeyDto>? passkeys;
    PasskeyStatusDto? passkeyStatus;
    bool isLoading = true;
    bool _registerDialogVisible = false;
    bool _deleteDialogVisible = false;
    bool isRegistering = false;
    bool isDeleting = false;

    string _passkeyName = string.Empty;
    string _masterPasswordForPasskey = string.Empty;
    bool _storeInVault = true;

    PasskeyDto? _deletingPasskey;
    string _masterPasswordForDelete = string.Empty;

    DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    DialogOptions _deleteDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync() => await LoadPasskeys();

    async Task LoadPasskeys()
    {
        isLoading = true;
        try
        {
            var userId = AuthService.CurrentUser?.Id;
            if (string.IsNullOrEmpty(userId)) { passkeys = new(); return; }
            var response = await PasskeyService.GetUserPasskeysAsync(userId);
            passkeys = response?.Passkeys ?? new();
            passkeyStatus = await PasskeyService.GetPasskeyStatusAsync(userId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading passkeys: {ex.Message}", Severity.Error);
            passkeys = new();
        }
        finally { isLoading = false; }
    }

    void OpenRegisterDialog()
    {
        _passkeyName = string.Empty;
        _masterPasswordForPasskey = string.Empty;
        _storeInVault = true;
        _registerDialogVisible = true;
    }

    void CloseRegisterDialog() => _registerDialogVisible = false;

    async Task RegisterPasskey()
    {
        if (string.IsNullOrWhiteSpace(_passkeyName))
        { Snackbar.Add("Passkey name is required.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_masterPasswordForPasskey))
        { Snackbar.Add("Master password is required.", Severity.Warning); return; }

        var userId = AuthService.CurrentUser?.Id;
        if (string.IsNullOrEmpty(userId)) { Snackbar.Add("Not authenticated.", Severity.Error); return; }

        isRegistering = true;
        try
        {
            // 1. Ask the server for WebAuthn creation options (validates the master password).
            var startDto = new PasskeyRegistrationStartDto
            {
                PasskeyName = _passkeyName,
                MasterPassword = _masterPasswordForPasskey,
                StoreInVault = _storeInVault
            };
            var start = await PasskeyService.StartPasskeyRegistrationAsync(userId, startDto);
            if (start == null)
            { Snackbar.Add("Failed to start registration. Check your master password.", Severity.Error); return; }

            // 2. Run the browser WebAuthn ceremony (prompts biometric/PIN/security key).
            string attestationJson;
            try
            {
                attestationJson = await JSRuntime.InvokeAsync<string>("passkey.createForServer", start.CredentialCreationOptions);
            }
            catch (Exception)
            {
                Snackbar.Add("Passkey creation was cancelled or is not supported on this device.", Severity.Warning);
                return;
            }

            // 3. Send the attestation back; the SERVER cryptographically verifies it before saving.
            var completeDto = new PasskeyRegistrationCompleteDto
            {
                Challenge = start.Challenge,
                CredentialResponse = attestationJson,
                OriginalOptionsJson = start.CredentialCreationOptions,
                PasskeyName = _passkeyName,
                StoreInVault = _storeInVault,
                DeviceType = "web"
            };
            var ok = await PasskeyService.CompletePasskeyRegistrationAsync(userId, completeDto);
            if (ok)
            {
                Snackbar.Add($"Passkey \"{_passkeyName}\" registered.", Severity.Success);
                _registerDialogVisible = false;
                await LoadPasskeys();
            }
            else
            {
                Snackbar.Add("Passkey registration could not be verified. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { isRegistering = false; }
    }

    void DeletePasskey(PasskeyDto pk)
    {
        _deletingPasskey = pk;
        _masterPasswordForDelete = string.Empty;
        _deleteDialogVisible = true;
    }

    void CloseDeleteDialog() => _deleteDialogVisible = false;

    async Task ConfirmDeletePasskey()
    {
        if (_deletingPasskey == null) return;
        if (string.IsNullOrWhiteSpace(_masterPasswordForDelete))
        { Snackbar.Add("Master password is required.", Severity.Warning); return; }

        var userId = AuthService.CurrentUser?.Id;
        if (string.IsNullOrEmpty(userId)) return;

        isDeleting = true;
        try
        {
            var dto = new PasskeyDeleteDto { MasterPassword = _masterPasswordForDelete };
            var ok = await PasskeyService.DeletePasskeyAsync(userId, _deletingPasskey.Id, dto);
            if (ok)
            { Snackbar.Add($"Passkey \"{_deletingPasskey.Name}\" removed.", Severity.Success); _deleteDialogVisible = false; await LoadPasskeys(); }
            else
            { Snackbar.Add("Failed to remove. Check your master password.", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { isDeleting = false; }
    }

    string GetDeviceIcon(string? deviceType) => deviceType?.ToLower() switch
    {
        "android"                               => Icons.Material.Filled.Android,
        "ios" or "iphone" or "ipad"             => Icons.Material.Filled.PhoneIphone,
        "windows"                               => Icons.Material.Filled.Window,
        "mac" or "macos"                        => Icons.Material.Filled.LaptopMac,
        "yubikey" or "security-key" or "hardware" => Icons.Material.Filled.Key,
        "chrome" or "google"                    => Icons.Material.Filled.Language,
        _                                       => Icons.Material.Filled.Fingerprint
    };
}
