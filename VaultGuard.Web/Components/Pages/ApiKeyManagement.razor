@page "/api-keys"
@using VaultGuard.Models
@using VaultGuard.Services.Interfaces
@inject IApiKeyService ApiKeyService
@inject IAuthService AuthService
@inject IApiKeySqliteMirror SqliteMirror
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject VaultGuard.Web.Services.AppNotificationService Notify
@inject ILicenseClientService LicenseClient

<PageTitle>API Key Management</PageTitle>

@if (!LicenseClient.HasFeature(VaultGuard.Models.Licensing.LicenseFeature.ApiAccess))
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h4" Class="mb-4">API Key Management</MudText>
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                API access is a <strong>Pro</strong> feature. Activate a license key under
                <MudLink Href="/settings">Settings → License</MudLink> to unlock it.
            </MudAlert>
        </MudPaper>
    </MudContainer>
}
else
{
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-4">API Key Management</MudText>

        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudText>
                API keys let external apps — including the native <strong>VaultGuard.Ios</strong> and
                <strong>VaultGuard.Android</strong> apps — authenticate to your vault. When you create a key here,
                it is generated by this web app and stored in <strong>both</strong> the primary SQL database and a
                per-user local <strong>SQLite</strong> database, so the same key works whether a device connects to
                the API/SQL backend or a local SQLite vault. Only a hash of the key is ever stored.
            </MudText>
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h5" Class="mb-3">Create New API Key</MudText>

                    <MudTextField T="string" @bind-Value="newApiKeyName"
                                  Label="API Key Name"
                                  Variant="Variant.Outlined"
                                  HelperText="Give your API key a descriptive name (e.g., 'My iPhone', 'Pixel 8', 'Backup Script')"
                                  Class="mb-3" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="CreateApiKey"
                               Disabled="@(string.IsNullOrWhiteSpace(newApiKeyName) || isCreating)"
                               StartIcon="@Icons.Material.Filled.Add">
                        @(isCreating ? "Creating…" : "Create API Key")
                    </MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h5" Class="mb-3">How to Use in the Mobile Apps</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">1. Create an API key with a descriptive name.</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">2. Copy the generated key value (shown only once).</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        3. In the app's connection setup, enter your <strong>API URL</strong> and paste the key:
                    </MudText>
                    <MudPaper Class="pa-2" Elevation="1" Style="background-color: #f5f5f5; font-family: monospace;">
                        X-API-Key: your-api-key-here
                    </MudPaper>
                    @if (!string.IsNullOrEmpty(localDbPath))
                    {
                        <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">
                            Local SQLite copy for this account:<br /><code>@localDbPath</code>
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h5" Class="mb-3">Your API Keys</MudText>

        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (apiKeys?.Any() == true)
        {
            <MudTable Items="@apiKeys" Dense="true" Hover="true" Class="mt-4">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Last Used</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Class="mr-2" />
                        @context.Name
                    </MudTd>
                    <MudTd DataLabel="Created">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                    <MudTd DataLabel="Last Used">@(context.LastUsedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small" T="string">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteApiKey(context.Id)"
                                       title="Revoke API Key" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                <MudText>No API keys found. Create your first API key to get started.</MudText>
            </MudAlert>
        }
    </MudPaper>
</MudContainer>
}

<!-- API Key Display Dialog -->
<MudDialog @bind-Visible="showApiKeyDialog" Options="dialogOptions">
    <DialogContent>
        <MudAlert Severity="Severity.Success" Class="mb-4">
            <MudText Typo="Typo.h6">API Key Created Successfully!</MudText>
        </MudAlert>

        <MudText Class="mb-2">Your new API key:</MudText>
        <MudTextField T="string" @bind-Value="generatedApiKey"
                      Label="API Key"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      Adornment="Adornment.End"
                      OnAdornmentClick="CopyApiKey"
                      Class="mb-3" />

        <MudAlert Severity="Severity.Info" Class="mb-3">
            <MudText Typo="Typo.body2">
                Stored in the primary SQL database and mirrored to your local SQLite database
                @if (!string.IsNullOrEmpty(localDbPath))
                {
                    <text>(<code>@localDbPath</code>)</text>
                }.
            </MudText>
        </MudAlert>

        <MudAlert Severity="Severity.Warning">
            <MudText Typo="Typo.body2">
                <strong>Important:</strong> This is the only time you'll see this API key.
                Copy it now and store it securely.
            </MudText>
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseApiKeyDialog" Color="Color.Primary" Variant="Variant.Filled">
            I've Copied the Key
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ApiKey>? apiKeys;
    private string newApiKeyName = string.Empty;
    private string generatedApiKey = string.Empty;
    private string? localDbPath;
    private bool isLoading = false;
    private bool isCreating = false;
    private bool showApiKeyDialog = false;

    private DialogOptions dialogOptions = new()
    {
        CloseOnEscapeKey = false,
        CloseButton = false,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    protected override async Task OnInitializedAsync()
    {
        try { LicenseClient.LoadCached(); }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }

        await LoadApiKeys();
    }

    private async Task<string?> CurrentUserIdAsync()
        => AuthService.CurrentUser?.Id ?? await AuthService.GetCurrentUserIdAsync();

    private async Task LoadApiKeys()
    {
        try
        {
            isLoading = true;
            var userId = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("You must be signed in to manage API keys.", Severity.Warning);
                apiKeys = new List<ApiKey>();
                return;
            }

            apiKeys = await ApiKeyService.GetUserApiKeysAsync(userId);
            localDbPath = SqliteMirror.GetDatabasePath(userId);
        }
        catch (Exception ex)
        {
            await Notify.ShowErrorAsync("The API keys couldn't be loaded.", ex);
            apiKeys = new List<ApiKey>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateApiKey()
    {
        if (string.IsNullOrWhiteSpace(newApiKeyName))
            return;

        try
        {
            isCreating = true;
            var userId = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("You must be signed in to create an API key.", Severity.Warning);
                return;
            }

            // Generated by this web app and dual-stored (primary SQL DB + per-user SQLite) inside the service.
            var created = await ApiKeyService.CreateApiKeyAsync(newApiKeyName, userId);

            // CreateApiKeyAsync returns the plaintext key value in KeyHash for one-time display.
            generatedApiKey = created.KeyHash;
            showApiKeyDialog = true;
            newApiKeyName = string.Empty;
            await LoadApiKeys();
            Snackbar.Add("API key created and stored in SQL + local SQLite.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Notify.ShowErrorAsync("The API key couldn't be created.", ex);
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task DeleteApiKey(Guid apiKeyId)
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("You must be signed in to revoke an API key.", Severity.Warning);
                return;
            }

            var ok = await ApiKeyService.DeleteApiKeyAsync(apiKeyId, userId);
            if (ok)
            {
                await LoadApiKeys();
                Snackbar.Add("API key revoked (SQL + local SQLite).", Severity.Success);
            }
            else
            {
                Snackbar.Add("API key not found.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            await Notify.ShowErrorAsync("The API key couldn't be revoked.", ex);
        }
    }

    private async Task CopyApiKey()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", generatedApiKey);
            Snackbar.Add("API key copied to clipboard!", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to copy to clipboard. Please copy manually.", Severity.Warning);
        }
    }

    private void CloseApiKeyDialog()
    {
        showApiKeyDialog = false;
        generatedApiKey = string.Empty;
    }
}
