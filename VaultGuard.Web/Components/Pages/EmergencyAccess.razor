@page "/emergency"
@using VaultGuard.Services.Emergency
@using VaultGuard.Web.Services
@using VaultGuard.DAL
@using VaultGuard.Models
@inject EmergencyAccessService Emergency
@inject EmergencySession Session
@inject VaultGuard.Services.Interfaces.IAuthService AuthService
@inject VaultGuardDbContext Db
@inject ISnackbar Snackbar

<PageTitle>Emergency access - VaultGuard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Emergency access</MudText>
<MudText Class="mb-5 mud-text-secondary">
    Let someone you trust ask for read-only access to your vault, for example if something happens to you. They get it
    after a waiting period you choose, unless you decline, so you stay in control while you can.
</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Your trusted contacts</MudText>
            <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">They need a Vault Guard account on this server.</MudText>
            <div class="d-flex gap-2 flex-wrap align-end">
                <MudTextField T="string" @bind-Value="_email" Label="Their email" Style="min-width:220px;" />
                <MudSelect T="int" @bind-Value="_wait" Label="Waiting period" Style="min-width:150px;">
                    @foreach (var d in EmergencyAccessService.AllowedWaitDays) { <MudSelectItem Value="d">@(d == 1 ? "1 day" : $"{d} days")</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">Add</MudButton>
            </div>
            @foreach (var g in _mine)
            {
                <MudPaper Class="pa-3 mt-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);">
                    <div class="d-flex align-center">
                        <div style="flex:1; min-width:0;">
                            <MudText Style="font-weight:600;">@g.GranteeEmail</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Describe(g)</MudText>
                        </div>
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveAsync(g))">Remove</MudButton>
                    </div>
                    @if (g.Status == EmergencyStatus.Requested)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            They asked for access. It opens on @(g.AvailableUtc?.ToLocalTime().ToString("f")) unless you decline.
                        </MudAlert>
                        <div class="d-flex gap-2 mt-2">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Decline(g))">Decline</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Approve(g))">Allow now</MudButton>
                        </div>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">People who trust you</MudText>
            @if (_theirs.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Nobody has added you yet.</MudText>
            }
            @foreach (var g in _theirs)
            {
                <MudPaper Class="pa-3 mt-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);">
                    <MudText Style="font-weight:600;">@g.GrantorEmail</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@DescribeForMe(g)</MudText>
                    <div class="d-flex gap-2 mt-2">
                        @if (g.Status is EmergencyStatus.Ready or EmergencyStatus.Pending)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => RequestAsync(g))">Request access</MudButton>
                        }
                        @if (g.IsOpen(DateTime.UtcNow))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenAsync(g))">Open their vault</MudButton>
                        }
                    </div>
                </MudPaper>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_opened != null)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true">
        <div class="d-flex align-center mb-2">
            <MudText Typo="Typo.h6" Style="flex:1;">@_openedFrom's vault (read-only)</MudText>
            <MudButton Size="Size.Small" OnClick="@(() => _opened = null)">Close</MudButton>
        </div>
        <MudTable Items="_opened" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent><MudTh>Item</MudTh><MudTh>Username</MudTh><MudTh>Password</MudTh><MudTh>Website</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Item">@context.Title</MudTd>
                <MudTd DataLabel="Username">@(context.LoginItem?.Username ?? context.WiFiItem?.NetworkName)</MudTd>
                <MudTd DataLabel="Password"><code>@(context.LoginItem?.Password ?? context.WiFiItem?.Password ?? context.CreditCardItem?.CardNumber)</code></MudTd>
                <MudTd DataLabel="Website">@(context.LoginItem?.WebsiteUrl)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private string _email = "";
    private int _wait = 7;
    private List<EmergencyGrant> _mine = new(), _theirs = new();
    private List<PasswordItem>? _opened;
    private string? _openedFrom;

    // The user comes from the browser's vault session (JS interop), so load after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (await Session.LoadAsync()) { Reload(); StateHasChanged(); }
    }

    private void Reload()
    {
        var me = Session.UserId;
        if (me == null) return;
        _mine = Emergency.ForGrantor(me).OrderBy(g => g.GranteeEmail).ToList();
        _theirs = Emergency.ForGrantee(me).OrderBy(g => g.GrantorEmail).ToList();
    }

    private static string Describe(EmergencyGrant g) => g.Status switch
    {
        EmergencyStatus.Pending => $"Waiting for them to sign in to Vault Guard once · {g.WaitDays}-day wait",
        EmergencyStatus.Approved => "You allowed access: they can open your vault",
        EmergencyStatus.Requested => "Requested access",
        _ => $"Can ask for access · {g.WaitDays}-day wait"
    };

    private static string DescribeForMe(EmergencyGrant g) => g.Status switch
    {
        EmergencyStatus.Requested when g.IsOpen(DateTime.UtcNow) => "Access is open (read-only).",
        EmergencyStatus.Requested => $"You asked. Access opens on {g.AvailableUtc?.ToLocalTime():f} unless they decline.",
        EmergencyStatus.Approved => "They allowed access (read-only).",
        _ => $"You can ask for access. It opens {g.WaitDays} day(s) later unless they decline."
    };

    private async Task AddAsync()
    {
        var user = Session.UserId == null ? null : await Db.Users.FindAsync(Session.UserId);
        if (user == null) return;
        var (_, error) = Emergency.AddContact(Db, user, _email, _wait);
        if (error != null) { Snackbar.Add(error, Severity.Warning); return; }
        // Wrap the vault key for them now if they've already signed in once.
        var key = await Session.VaultKeyCopyAsync();
        if (key != null) { try { Emergency.OnUnlocked(user.Id, key); } finally { System.Security.Cryptography.CryptographicOperations.ZeroMemory(key); } }
        Snackbar.Add($"{_email} is now a trusted contact.", Severity.Success);
        _email = "";
        Reload();
    }

    private Task RemoveAsync(EmergencyGrant g) { Emergency.Remove(g.Id, Session.UserId!); Reload(); return Task.CompletedTask; }
    private void Decline(EmergencyGrant g) { Emergency.Decline(g.Id, Session.UserId!); Snackbar.Add("Declined.", Severity.Info); Reload(); }
    private void Approve(EmergencyGrant g) { Emergency.Approve(g.Id, Session.UserId!); Snackbar.Add("They can now open your vault (read-only).", Severity.Info); Reload(); }

    private Task RequestAsync(EmergencyGrant g)
    {
        if (Emergency.Request(g.Id, Session.UserId!)) Snackbar.Add($"Asked. {g.GrantorEmail} will see your request when they sign in.", Severity.Info);
        Reload();
        return Task.CompletedTask;
    }

    private async Task OpenAsync(EmergencyGrant g)
    {
        var mine = await Session.VaultKeyCopyAsync();
        if (mine == null) { Snackbar.Add("Unlock your vault first.", Severity.Warning); return; }
        byte[]? theirs = null;
        try
        {
            theirs = Emergency.OpenVaultKey(g.Id, Session.UserId!, mine, out var error);
            if (theirs == null) { Snackbar.Add(error ?? "Not available.", Severity.Warning); return; }
            _opened = await Emergency.ReadItemsAsync(Db, g.Id, Session.UserId!, theirs);
            _openedFrom = g.GrantorEmail;
        }
        finally
        {
            System.Security.Cryptography.CryptographicOperations.ZeroMemory(mine);
            if (theirs != null) System.Security.Cryptography.CryptographicOperations.ZeroMemory(theirs);
        }
    }
}
