    // ── Database ─────────────────────────────────────────────────────────────────
    void UseDesktopDbLocation()
    {
        _sqliteDbPath = DesktopDbPath;
        Snackbar.Add("Pointed at the desktop app's vault location.", Severity.Info);
    }

    void UseDefaultDbLocation()
    {
        _sqliteDbPath = System.IO.Path.Combine(PlatformService.GetAppDataDirectory(), "data", "passwordmanager.db");
    }

    async Task CopyDbPath()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _sqliteDbPath); Snackbar.Add("Path copied.", Severity.Success); }
        catch { Snackbar.Add("Couldn't copy — select and copy manually.", Severity.Info); }
