    async Task SeedTestData()
    {
        _dbBusy = true;
        try
        {
            using var scope = Services.CreateScope();
            var ctx = scope.ServiceProvider.GetRequiredService<VaultGuard.DAL.VaultGuardDbContext>();
            // Seed under the CURRENT signed-in user so the demo items belong to the account that already
            // has the master key entered (otherwise they attach to a seeded default account and you get
            // prompted to sign into that one).
            var userId = await CurrentUserIdAsync()
                         ?? ctx.Users.Select(u => u.Id).FirstOrDefault()
                         ?? VaultGuard.DAL.Seed.TestDataSeeder.TestUserId;
            VaultGuard.DAL.Seed.TestDataSeeder.SeedTestData(ctx, userId);
            Snackbar.Add("Demo vault data seeded into the configured database.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Notify.ShowErrorAsync("Couldn't seed the demo vault data.", ex);
        }
        finally { _dbBusy = false; }
        await Task.CompletedTask;
    }

    async Task TestApiConnection()
    {
        if (string.IsNullOrWhiteSpace(_apiBaseUrl)) { Snackbar.Add("Enter the API base URL first.", Severity.Warning); return; }
        var baseUri = _apiBaseUrl.TrimEnd('/');
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(10);

            // 1) Reachability — unauthenticated health check.
            try
            {
                var health = await client.GetAsync($"{baseUri}/health");
                if (!health.IsSuccessStatusCode)
                    Snackbar.Add($"Health check returned {(int)health.StatusCode} {health.ReasonPhrase} — trying an authenticated call anyway.", Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not reach the API at {baseUri}: {ex.Message}", Severity.Error);
                return;
            }

            // 2) No key yet → we can only confirm reachability.
            if (string.IsNullOrWhiteSpace(_apiKey))
            {
                Snackbar.Add("API is reachable. Generate or paste an API Key to test authenticated access.", Severity.Info);
                return;
            }

            // 3) Real authenticated call with the key — proves the key works AND returns actual data.
            using var req = new HttpRequestMessage(System.Net.Http.HttpMethod.Get, $"{baseUri}/api/passworditems");
            req.Headers.Add("X-API-Key", _apiKey);
            var resp = await client.SendAsync(req);

            if (resp.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                Snackbar.Add("API reachable, but the API Key was rejected (401/403). The key must be one registered on THIS API's database.", Severity.Error);
                return;
            }
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Authenticated call returned {(int)resp.StatusCode} {resp.ReasonPhrase}.", Severity.Warning);
                return;
            }

            // Parse the response and report a real value (item count) so the test proves data flows.
            var body = await resp.Content.ReadAsStringAsync();
            int count = -1;
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                var root = doc.RootElement;
                if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
                    count = root.GetArrayLength();
                else if (root.TryGetProperty("items", out var items) && items.ValueKind == System.Text.Json.JsonValueKind.Array)
                    count = items.GetArrayLength();
            }
            catch { /* unexpected/non-JSON body — still a 2xx, treat as pass */ }

            Snackbar.Add(count >= 0
                ? $"Success — API Key authenticated. The API returned {count} item{(count == 1 ? "" : "s")}."
                : "Success — API Key authenticated and the API returned a valid response.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not reach the API: {ex.Message}", Severity.Error);
        }
    }

