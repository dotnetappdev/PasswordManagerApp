    async Task ForgetThisDevice()
    {
        AppSettings.Remove("SavedMasterPassword");
        AppSettings.Remove("DeviceToken");
        AppSettings.Save();
        Snackbar.Add("Device credentials cleared. Your master password will be required on next sign-in.", Severity.Success);
        await Task.CompletedTask;
    }

    // Maintenance – database management
    async Task ReseedSampleData()
    {
        _dbBusy = true;
        try
        {
            using var scope = Services.CreateScope();
            var ctx = scope.ServiceProvider.GetRequiredService<VaultGuard.DAL.VaultGuardDbContext>();
            // Seed the sample data under the CURRENT signed-in user (who has already entered their master
            // key), not the first user in the DB — otherwise the demo items belong to a seeded default
            // account and the app asks you to sign into that account instead.
            var userId = await CurrentUserIdAsync()
                         ?? ctx.Users.Select(u => u.Id).FirstOrDefault()
                         ?? VaultGuard.DAL.Seed.TestDataSeeder.TestUserId;
            VaultGuard.DAL.Seed.TestDataSeeder.SeedTestData(ctx, userId);
            Snackbar.Add("Sample data reseeded successfully.", Severity.Success);
        }
        catch (Exception ex) { await Notify.ShowErrorAsync("Could not reseed sample data.", ex); }
        finally { _dbBusy = false; }
    }

    async Task ResetPasswordData()
    {
        _dbBusy = true;
        try
        {
            using var scope = Services.CreateScope();
            var ctx = scope.ServiceProvider.GetRequiredService<VaultGuard.DAL.VaultGuardDbContext>();
            ctx.PasswordItems.RemoveRange(ctx.PasswordItems);
            ctx.Categories.RemoveRange(ctx.Categories);
            await ctx.SaveChangesAsync();
            Snackbar.Add("Password data reset — all items and categories removed.", Severity.Success);
        }
        catch (Exception ex) { await Notify.ShowErrorAsync("Could not reset password data.", ex); }
        finally { _dbBusy = false; }
