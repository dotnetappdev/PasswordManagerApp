    {
        if (_setup is null || string.IsNullOrWhiteSpace(_2faCode)) { Snackbar.Add("Enter the 6-digit code.", Severity.Warning); return; }
        _2faBusy = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(uid)) return;

            var ok = await TwoFactorService.VerifyAndCompleteTwoFactorSetupAsync(uid,
                new TwoFactorVerifySetupDto { Code = _2faCode.Trim(), SecretKey = _setup.SecretKey });

            if (ok)
            {
                Snackbar.Add("Authenticator app enabled.", Severity.Success);
                await LoadTwoFactorStatusAsync();
                CloseTwoFactor();
            }
            else
            {
                Snackbar.Add("That code didn't match. Try again.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _2faBusy = false; }
    }

    async Task DisableTwoFactor()
    {
