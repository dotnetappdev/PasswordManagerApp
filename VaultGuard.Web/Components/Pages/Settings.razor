@page "/settings"
@using VaultGuard.Services.Interfaces
@using VaultGuard.Models
@using VaultGuard.Models.DTOs.Auth
@inject IAuthService AuthService
@inject IUserProfileService UserProfileService
@inject IVaultService VaultService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ITwoFactorService TwoFactorService
@inject IQrCodeService QrCodeService
@inject IJSRuntime JS
@inject IAppSettingsService AppSettings
@inject IPlatformService PlatformService
@inject IHttpClientFactory HttpClientFactory
@inject VaultGuard.Components.Shared.Services.ThemeService ThemeService
@inject VaultGuard.Web.Services.AppNotificationService Notify
@inject IApiKeyService ApiKeyService
@inject IServiceProvider Services
@inject ILicenseClientService LicenseClient
@using Microsoft.Extensions.DependencyInjection
@using System.Linq
@using System.Collections.Generic
@using System.Net.Http.Json

<PageTitle>Settings - VaultGuard</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-5">
    <div style="width:40px; height:40px; border-radius:10px; background:linear-gradient(135deg,#6366F1,#8B5CF6); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Style="color:white; font-size:1.5rem;" />
    </div>
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:700; line-height:1.1;">Settings</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage your VaultGuard preferences and security</MudText>
    </div>
</MudStack>

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4" @bind-ActivePanelIndex="_activeTabIndex">
    <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Master Password</MudText>
                    <MudTextField @bind-Value="_currentPassword" Label="Current Password"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_newPassword" Label="New Password"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_confirmPassword" Label="Confirm New Password"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_passwordHint" Label="Password Hint (optional)"
                                  Variant="Variant.Outlined" Class="mb-3"
                                  Placeholder="A hint to help you remember" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@ChangePassword" Disabled="@isSavingPassword"
                               StartIcon="@Icons.Material.Filled.Lock">
                        @if (isSavingPassword)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Change Password
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Two-Factor Authentication</MudText>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                        2FA adds an extra layer of security to your account.
                    </MudAlert>
                    <MudStack Spacing="2">
                        <MudButton Href="/passkeys" StartIcon="@Icons.Material.Filled.Fingerprint"
                                   Variant="Variant.Outlined" Color="Color.Default" FullWidth="true">
                            Manage Passkeys
                        </MudButton>
                        @if (_twoFactorEnabled)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.VerifiedUser">
                                Authenticator app is enabled (@_backupCodesRemaining backup codes left).
                            </MudAlert>
                            <MudButton StartIcon="@Icons.Material.Filled.NoEncryption"
                                       Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                       OnClick="@OpenTwoFactorSetup">
                                Manage / Disable Authenticator
                            </MudButton>
                        }
                        else
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Smartphone"
                                       Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                                       OnClick="@OpenTwoFactorSetup">
                                Setup Authenticator App
                            </MudButton>
                        }
                    </MudStack>
                    <MudDivider Class="mt-3 mb-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">Require authenticator code for</MudText>
                    <MudSwitch T="bool" @bind-Value="_requireCodeOnVaultDelete"
                               Label="Deleting a vault" Color="Color.Warning" />
                    <MudSwitch T="bool" @bind-Value="_requireCodeOnItemDelete"
                               Label="Deleting a password item" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Class="mt-1 mud-text-secondary">
                        Only takes effect when an authenticator app is enabled.
                    </MudText>
                    <div class="mt-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@PersistStepUpSettings">
                            Save step-up settings
                        </MudButton>
                    </div>
                </MudPaper>

                <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">App Lock (Passkey / Biometric)</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Register a FIDO2 passkey (fingerprint, face, or hardware key) to unlock VaultGuard without
                        typing your master password on this browser.
                    </MudText>
                    <MudStack Spacing="2">
                        <MudSwitch T="bool" @bind-Value="_enablePasskeySignIn"
                                   Label="Enable Passkey Sign-In" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="_numberMatchApprovals"
                                   Label="Number-matching approvals" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            2FA-style number matching on important actions — editing, deleting or saving password
                            items and categories, and changing your master password. Approve by tapping the matching
                            number on your phone. Codes are valid for 60 seconds.
                        </MudText>
                        <MudButton Href="/passkeys" StartIcon="@Icons.Material.Filled.Fingerprint"
                                   Variant="Variant.Outlined" Color="Color.Default" FullWidth="true">
                            Manage App Passkeys (Biometric)
                        </MudButton>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Device Security</MudText>
                    <MudStack Spacing="2">
                        <MudButton StartIcon="@Icons.Material.Filled.PhonelinkErase"
                                   Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   OnClick="@ForgetThisDevice">
                            Forget This Device
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Clears any saved master password for this profile on this device.
                        </MudText>
                        <MudDivider />
                        <MudButton StartIcon="@Icons.Material.Filled.Devices"
                                   Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   Href="/linked-devices">
                            Linked Devices
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            View and revoke paired devices (phone QR sign-in).
                        </MudText>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Session &amp; Lock</MudText>
                    <MudSelect T="int" @bind-Value="_autoLockMinutes" Label="Auto-lock after"
                               Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="int" Value="5">5 minutes</MudSelectItem>
                        <MudSelectItem T="int" Value="15">15 minutes</MudSelectItem>
                        <MudSelectItem T="int" Value="30">30 minutes</MudSelectItem>
                        <MudSelectItem T="int" Value="60">1 hour</MudSelectItem>
                        <MudSelectItem T="int" Value="0">Never</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="_lockOnBrowserClose" Label="Lock when browser closes"
                               Color="Color.Primary" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                               OnClick="@SaveSecuritySettings"
                               StartIcon="@Icons.Material.Filled.Save">Save</MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Class="mr-1" Style="vertical-align:middle;" />
                    Database management, account deletion, and data wipe actions are in the <strong>Maintenance</strong> tab.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Appearance" Icon="@Icons.Material.Filled.Palette">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Theme</MudText>
                    <MudRadioGroup T="string" Value="@ThemeModeString" ValueChanged="@OnThemeModeChanged">
                        <MudRadio T="string" Value="@("dark")" Color="Color.Primary">Dark Mode</MudRadio>
                        <MudRadio T="string" Value="@("light")" Color="Color.Primary">Light Mode</MudRadio>
                        <MudRadio T="string" Value="@("highcontrast")" Color="Color.Primary">High Contrast</MudRadio>
                        <MudRadio T="string" Value="@("system")" Color="Color.Primary">System Default</MudRadio>
                    </MudRadioGroup>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1">UI Zoom — @ThemeService.UiScalePercent%</MudText>
                    <MudSlider T="int" Value="@ThemeService.UiScalePercent" ValueChanged="@OnUiScaleChanged"
                               Min="80" Max="160" Step="10" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Scales the whole interface (80–160%), like the WPF text-size setting.
                    </MudText>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Accent Color</MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        @foreach (var color in accentColors)
                        {
                            <MudTooltip Text="@color.Name">
                                <div @onclick="@(() => SetAccent(color.Hex))"
                                     style="@($"width:32px; height:32px; border-radius:50%; background:{color.Hex}; cursor:pointer; border: 3px solid {(string.Equals(ThemeService.AccentColor, color.Hex, StringComparison.OrdinalIgnoreCase) ? "white" : "transparent")}; box-shadow: 0 0 0 1px {color.Hex};")"
                                     title="@color.Name">
                                </div>
                            </MudTooltip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                        Theme and accent apply instantly and are shared with the VaultGuard desktop app on this machine.
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Display</MudText>
                    <MudSwitch T="bool" @bind-Value="_compactMode" Label="Compact mode" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="_showFavicons" Label="Show website favicons" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="_animationsEnabled" Label="Enable animations" Color="Color.Primary" />
                    <MudDivider Class="my-3" />
                    <MudSelect T="int" @bind-Value="_itemsPerPage" Label="Items per page"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="10">10</MudSelectItem>
                        <MudSelectItem T="int" Value="20">20</MudSelectItem>
                        <MudSelectItem T="int" Value="50">50</MudSelectItem>
                        <MudSelectItem T="int" Value="100">100</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                               OnClick="@SaveDisplaySettings"
                               StartIcon="@Icons.Material.Filled.Save">Save Display Settings</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Database" Icon="@Icons.Material.Filled.Storage">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Data Source</MudText>
                    <MudSelect T="string" @bind-Value="_authMode" Label="Data source" Variant="Variant.Outlined"
                               Class="mb-3">
                        <MudSelectItem T="string" Value="@("Local Database")">Local Database (SQLite)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("API Server")">API Server</MudSelectItem>
                    </MudSelect>

                    @if (_authMode == "API Server")
                    {
                        <MudTextField @bind-Value="_apiBaseUrl" Label="API URL" Variant="Variant.Outlined"
                                      Class="mb-3" Placeholder="https://vaultguardapi.dotnetappdevni.com"
                                      HelperText="Root URL of the VaultGuard API (a restart applies the change)." />
                        <MudTextField @bind-Value="_apiKey" Label="API Key" Variant="Variant.Outlined"
                                      Class="mb-3" InputType="InputType.Password"
                                      HelperText="Sent as the X-Api-Key header. Generate one from the server below, or paste an existing key." />

                        <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid rgba(255,255,255,0.08); border-radius:10px;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Generate a real key from this API</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2 mud-text-secondary">
                                A key only works against the API server that created it. Enter your account email and
                                master password to have <strong>@(FormatHost(_apiBaseUrl))</strong> issue a key into its own
                                database — that's the key that will pass the connection test. (A key made in "Local Database"
                                mode lives in this app's local DB and will be rejected by the remote API with 401/403.)
                            </MudText>
                            <MudTextField @bind-Value="_issueEmail" Label="Account email" Variant="Variant.Outlined"
                                          Class="mb-2" Placeholder="you@example.com" />
                            <MudTextField @bind-Value="_issueMasterPassword" Label="Master password" Variant="Variant.Outlined"
                                          Class="mb-2" InputType="InputType.Password"
                                          HelperText="Used once to authorize issuing the key; never stored." />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.VpnKey" OnClick="@IssueKeyFromServer"
                                       Disabled="@_issuingKey">
                                @if (_issuingKey) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                Generate key from server &amp; save
                            </MudButton>
                        </MudPaper>

                        <MudDivider Class="my-3" />
                        <MudSwitch T="bool" @bind-Value="_selfHostApi" Color="Color.Primary"
                                   Label="I'm self-hosting the API server" Class="mb-1" />
                        <MudText Typo="Typo.caption" Class="d-block mb-2 mud-text-secondary">
                            Leave this off to use VaultGuard's hosted database — nothing else to set up. Turn it
                            on only if you run your own API against your own SQL Server.
                        </MudText>

                        @if (_selfHostApi)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-1" Style="font-weight:600;">SQL Server (your API database)</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2 mud-text-secondary">
                                The database your self-hosted API uses. Test the connection and seed accounts / demo vault data.
                            </MudText>
                            <MudTextField @bind-Value="_dbServer" Label="Server" Variant="Variant.Outlined" Class="mb-3"
                                          Placeholder="sql.example.com" />
                            <MudTextField @bind-Value="_dbName" Label="Database" Variant="Variant.Outlined" Class="mb-3" />
                            <MudTextField @bind-Value="_dbUser" Label="User" Variant="Variant.Outlined" Class="mb-3" />
                            <MudTextField @bind-Value="_dbPassword" Label="Password" Variant="Variant.Outlined" Class="mb-3"
                                          InputType="InputType.Password" />
                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-2">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Link" OnClick="@TestSqlServer"
                                           Disabled="@_dbBusy">Test SQL Server</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@SeedUsers"
                                           Disabled="@_dbBusy">Seed Users</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Dataset" OnClick="@SeedTestData"
                                           Disabled="@_dbBusy">Seed Test Data</MudButton>
                            </MudStack>
                        }
                    }
                    else
                    {
                        <MudTextField @bind-Value="_sqliteDbPath" Label="SQLite database file"
                                      Variant="Variant.Outlined" Class="mb-2"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                      OnAdornmentClick="@CopyDbPath"
                                      HelperText="Full path to the .db file used by this app." />
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.DesktopWindows"
                                       OnClick="@UseDesktopDbLocation">
                                Use VaultGuard desktop location
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="@UseDefaultDbLocation">
                                Reset to default
                            </MudButton>
                        </MudStack>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                            The desktop app stores its vault at
                            <strong style="word-break:break-all;">@DesktopDbPath</strong>.
                            Point both apps at the same file to share one vault on this machine.
                        </MudAlert>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@SaveApiSettings">Save</MudButton>
                        @if (_authMode == "API Server")
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Wifi"
                                       OnClick="@TestApiConnection">Test API</MudButton>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                        Changes take effect the next time the app restarts.
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Backup</MudText>
                    <MudSwitch T="bool" @bind-Value="_autoBackup" Label="Enable automatic backups"
                               Color="Color.Primary" Class="mb-2" />
                    <MudSelect T="int" @bind-Value="_backupInterval" Label="Backup frequency"
                               Variant="Variant.Outlined" Class="mb-3" Disabled="!_autoBackup">
                        <MudSelectItem T="int" Value="1">Daily</MudSelectItem>
                        <MudSelectItem T="int" Value="7">Weekly</MudSelectItem>
                        <MudSelectItem T="int" Value="30">Monthly</MudSelectItem>
                    </MudSelect>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Backup">Backup Now</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Restore">Restore</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Sync" Icon="@Icons.Material.Filled.Sync">
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">API Connection</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        This app connects to a VaultGuard API server. Enter the API URL and your API Key.
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_apiBaseUrl" Label="API URL"
                                          Variant="Variant.Outlined" Placeholder="https://vaultguardapi.dotnetappdevni.com"
                                          HelperText="Root URL of the VaultGuard API (a restart applies the change)." />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_apiKey" Label="API Key" Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          HelperText="Create one under Settings → API Keys, then paste it here." />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="@SaveApiSettings">Save</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Wifi" OnClick="@TestApiConnection">Test API</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Sync Settings</MudText>
                    <MudSwitch T="bool" @bind-Value="_autoSync" Label="Enable Auto-Sync"
                               Color="Color.Primary" Class="mb-3" />
                    <MudSelect T="int" @bind-Value="_syncInterval" Label="Sync interval"
                               Variant="Variant.Outlined" Class="mb-3" Disabled="!_autoSync">
                        <MudSelectItem T="int" Value="5">Every 5 minutes</MudSelectItem>
                        <MudSelectItem T="int" Value="15">Every 15 minutes</MudSelectItem>
                        <MudSelectItem T="int" Value="30">Every 30 minutes</MudSelectItem>
                        <MudSelectItem T="int" Value="60">Every hour</MudSelectItem>
                    </MudSelect>
                    <MudStack Row="true" Spacing="2">
                        <MudButton StartIcon="@Icons.Material.Filled.Sync" Variant="Variant.Filled"
                                   Color="Color.Primary">Sync Now</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Outlined"
                                   Color="Color.Primary" OnClick="@SaveSyncSettings">Save</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Conflict Resolution</MudText>
                    <MudRadioGroup T="string" @bind-Value="_conflictResolution">
                        <MudRadio T="string" Value="@("server")" Color="Color.Primary">
                            Server wins (prefer server data)
                        </MudRadio>
                        <MudRadio T="string" Value="@("client")" Color="Color.Primary">
                            Client wins (prefer local data)
                        </MudRadio>
                        <MudRadio T="string" Value="@("newest")" Color="Color.Primary">
                            Newest wins (by timestamp)
                        </MudRadio>
                    </MudRadioGroup>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Notifications" Icon="@Icons.Material.Filled.Notifications">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Notification Preferences</MudText>
                    <MudSwitch T="bool" @bind-Value="_notifyPasswordExpiry" Label="Notify on password expiry"
                               Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="_notifyNewLogin" Label="Notify on new login"
                               Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="_notifyWeakPasswords" Label="Alert for weak passwords"
                               Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="_notifyDataBreach" Label="Data breach alerts"
                               Color="Color.Primary" />
                    <MudDivider Class="my-3" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@SaveNotificationSettings"
                               StartIcon="@Icons.Material.Filled.Save">Save Preferences</MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Password Health</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Configure thresholds for password health checks.
                    </MudText>
                    <MudSelect T="int" @bind-Value="_passwordExpiryDays" Label="Password expires after"
                               Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="int" Value="30">30 days</MudSelectItem>
                        <MudSelectItem T="int" Value="60">60 days</MudSelectItem>
                        <MudSelectItem T="int" Value="90">90 days</MudSelectItem>
                        <MudSelectItem T="int" Value="180">6 months</MudSelectItem>
                        <MudSelectItem T="int" Value="365">1 year</MudSelectItem>
                        <MudSelectItem T="int" Value="0">Never</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_minPasswordLength" Label="Minimum password length"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="8">8 characters</MudSelectItem>
                        <MudSelectItem T="int" Value="12">12 characters</MudSelectItem>
                        <MudSelectItem T="int" Value="16">16 characters</MudSelectItem>
                        <MudSelectItem T="int" Value="20">20 characters</MudSelectItem>
                    </MudSelect>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Vaults" Icon="@Icons.Material.Filled.Shield">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6" Style="font-weight:600;">Your Vaults</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                                   Color="Color.Primary" Size="Size.Small" Href="/vaults">
                            Manage Vaults
                        </MudButton>
                    </MudStack>
                    @if (_vaultsLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_vaults.Any())
                    {
                        <MudList T="VaultGuard.Models.Vault" Dense="true">
                            @foreach (var vault in _vaults)
                            {
                                <MudListItem T="VaultGuard.Models.Vault">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <div style="@($"width:12px; height:12px; border-radius:50%; background:{vault.Color ?? "#71717A"};")"></div>
                                            <MudText>@vault.Icon @vault.Name</MudText>
                                            @if (vault.IsDefault)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Default</MudChip>
                                            }
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@vault.ItemCount items</MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            No vaults yet.
                            <MudLink Href="/vaults">Create your first vault</MudLink> to organise your passwords.
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">About Vaults</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Vaults let you separate your passwords into distinct, named buckets — for example
                        <strong>Personal</strong>, <strong>Work</strong>, and <strong>Finance</strong>.
                        Each vault has its own colour and icon, and items can be freely moved between vaults.
                    </MudText>
                    <MudStack Spacing="2">
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> All vaults use the same encryption key
                        </MudAlert>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" /> Vaults can be shared with others (coming soon)
                        </MudAlert>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Generator" Icon="@Icons.Material.Filled.Key">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Password Generator</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Configure defaults for the built-in password generator.
                    </MudText>

                    <MudText Typo="Typo.subtitle2" Class="mb-1">Length: <strong>@_genLength</strong> characters</MudText>
                    <MudSlider T="int" @bind-Value="_genLength" Min="8" Max="64" Step="1"
                               Color="Color.Primary" Class="mb-4" />

                    <MudDivider Class="mb-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Character Sets</MudText>
                    <MudCheckBox T="bool" @bind-Value="_genUppercase"  Label="Uppercase (A-Z)"    Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_genLowercase"  Label="Lowercase (a-z)"    Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_genNumbers"    Label="Numbers (0-9)"       Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_genSymbols"    Label="@("Symbols (!@#$...)")"   Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_genAvoidAmbig" Label="Avoid ambiguous (0Ol1I)" Color="Color.Primary" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Preview</MudText>
                    <MudTextField T="string" Value="@_generatedPassword" ReadOnly="true"
                                  Variant="Variant.Outlined" Class="mb-3"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.CopyAll"
                                  OnAdornmentClick="@((_) => CopyGeneratedPassword())"
                                  Style="font-family: 'Consolas', monospace;" />
                    <MudStack Row="true" Spacing="2">
                        <MudButton OnClick="@GeneratePassword" Variant="Variant.Filled"
                                   Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                                   FullWidth="true">
                            Generate
                        </MudButton>
                    </MudStack>

                    @if (!string.IsNullOrEmpty(_generatedPassword))
                    {
                        var strength = GetPasswordStrength(_generatedPassword);
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Strength</MudText>
                        <MudProgressLinear Value="@strength.Score" Color="@strength.BarColor" Rounded="true" Size="Size.Medium" Class="mb-1" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@strength.Label</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Encryption" Icon="@Icons.Material.Filled.EnhancedEncryption">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Encryption Settings</MudText>
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                        Changing encryption settings requires re-encrypting all your data.
                    </MudAlert>
                    <MudSelect T="string" @bind-Value="_encryptionAlgorithm" Label="Encryption Algorithm"
                               Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="string" Value="@("AES-256-GCM")">AES-256-GCM (Recommended)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("AES-256-CBC")">AES-256-CBC</MudSelectItem>
                        <MudSelectItem T="string" Value="@("ChaCha20")">ChaCha20-Poly1305</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_pbkdf2Iterations" Label="PBKDF2 Iterations"
                               Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="int" Value="100000">100,000 (Fast)</MudSelectItem>
                        <MudSelectItem T="int" Value="300000">300,000 (Balanced)</MudSelectItem>
                        <MudSelectItem T="int" Value="600000">600,000 (Recommended)</MudSelectItem>
                        <MudSelectItem T="int" Value="1000000">1,000,000 (Slow/Secure)</MudSelectItem>
                    </MudSelect>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Key Derivation</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Current settings: PBKDF2-SHA256 with @_pbkdf2Iterations.ToString("N0") iterations
                    </MudText>
                    <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.VerifiedUser"
                             Text="End-to-End Encrypted" />
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Your master password never leaves your device. All encryption and decryption
                        happens locally.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Shortcuts" Icon="@Icons.Material.Filled.Keyboard">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Keyboard Shortcuts — General</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var sc in _generalShortcuts)
                        {
                            <MudListItem T="string">
                                <div class="d-flex align-center justify-space-between" style="width:100%;">
                                    <MudText Typo="Typo.body2">@sc.Action</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Text="@sc.Keys" />
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Keyboard Shortcuts — Selected Item</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var sc in _itemShortcuts)
                        {
                            <MudListItem T="string">
                                <div class="d-flex align-center justify-space-between" style="width:100%;">
                                    <MudText Typo="Typo.body2">@sc.Action</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Text="@sc.Keys" />
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">
                        These shortcuts are fully active in the VaultGuard desktop app. In the browser,
                        keys reserved by your browser (e.g. Ctrl+N, Ctrl+F) are handled by the browser itself.
                        Custom rebinding is coming soon.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Maintenance" Icon="@Icons.Material.Filled.Build">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight:600; color:#F59E0B;">Database Management</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Manage database data — seed samples, reset content. These actions target the currently configured data store.
                    </MudText>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.DatasetLinked"
                                   OnClick="@ReseedSampleData" Disabled="@_dbBusy">
                            Reseed Sample Data
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Adds demo categories, collections, and password items. Does not remove existing data.
                        </MudText>
                        <MudDivider />
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.LayersClear"
                                   OnClick="@ResetPasswordData" Disabled="@_dbBusy">
                            Reset Password Data
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Clears all password items, categories, and tags while preserving user accounts.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   OnClick="@DeleteSeedData" Disabled="@_dbBusy">
                            Delete Seed Data
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Removes built-in demo items and stops them being re-added on next launch.
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1"
                          Style="border: 1px solid rgba(239,68,68,0.4);">
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight:600; color:#EF4444;">Danger Zone</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        These actions are irreversible. Please be certain before proceeding.
                    </MudText>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.DeleteForever"
                                   OnClick="@DeleteAllPasswords" Disabled="@_dbBusy">
                            Delete All Passwords
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.GroupRemove"
                                   OnClick="@DeleteUserAccounts" Disabled="@_dbBusy">
                            Delete User Accounts (keep admins)
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.TableChart"
                                   OnClick="@ResetAllTables" Disabled="@_dbBusy">
                            Reset All Database Tables
                        </MudButton>
                        <MudDivider />
                        <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.RemoveCircle"
                                   OnClick="@SecureWipeDatabase" Disabled="@_dbBusy">
                            🔒 Secure Wipe Database
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Clears ALL tables including user accounts. This will log you out and reset to default state.
                        </MudText>
                        <MudDivider />
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.PersonRemove"
                                   Href="/profile">
                            Delete Account
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="License" Icon="@Icons.Material.Filled.WorkspacePremium">
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight:600;">Pro License</MudText>
                    @if (LicenseClient.IsProUnlocked)
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">
                            <strong>@LicenseClient.CurrentPlan</strong> plan active
                            @(LicenseClient.ExpiresAt.HasValue ? $" — renews/expires {LicenseClient.ExpiresAt:yyyy-MM-dd}" : " (perpetual license)")
                        </MudAlert>
                        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                            Unlocked features: @FeatureSummary()
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.RemoveCircle"
                                   OnClick="@DeactivateLicense">
                            Deactivate this device
                        </MudButton>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            You're on the Free plan. Enter a CD key to unlock Pro features like API access and cloud backup.
                        </MudAlert>
                        <MudTextField @bind-Value="_licenseKeyInput" Label="License Key"
                                      Variant="Variant.Outlined" Class="mb-3"
                                      Placeholder="VG-XXXXX-XXXXX-XXXXX-XXXXX" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.LockOpen"
                                   OnClick="@ActivateLicense" Disabled="@(_activatingLicense || string.IsNullOrWhiteSpace(_licenseKeyInput))">
                            @if (_activatingLicense)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Activate
                        </MudButton>
                    }
                    @if (!string.IsNullOrEmpty(_licenseStatusMessage))
                    {
                        <MudAlert Severity="@_licenseStatusSeverity" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                            @_licenseStatusMessage
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="About" Icon="@Icons.Material.Filled.Info">
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                        <div style="width:64px; height:64px; border-radius:16px; background:linear-gradient(135deg,#6366F1,#8B5CF6); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color:white; font-size:2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h5" Style="font-weight:700; line-height:1.1;">VaultGuard</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Version @_appVersion · Web (Blazor)</MudText>
                        </div>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        A modern, open-source password manager for Windows and the Web.
                    </MudText>
                    <MudDivider Class="my-3" />
                    <MudSimpleTable Dense="true" Hover="false" Class="mb-3">
                        <tbody>
                            <tr><td style="width:120px;"><strong>Platform</strong></td><td>Blazor · Web</td></tr>
                            <tr><td><strong>Runtime</strong></td><td>.NET @System.Environment.Version.Major</td></tr>
                            <tr><td><strong>Encryption</strong></td><td>AES-256-GCM</td></tr>
                            <tr><td><strong>Build</strong></td><td>@_buildDate</td></tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Update"
                                   OnClick="@CheckForUpdates" Disabled="@_checkingUpdates">
                            @if (_checkingUpdates)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Check for Updates
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.MenuBook"
                                   Href="https://github.com/dotnetappdev/PasswordManagerApp" Target="_blank">
                            Documentation
                        </MudButton>
                    </MudStack>
                    @if (!string.IsNullOrEmpty(_updateStatusMessage))
                    {
                        <MudAlert Severity="@_updateStatusSeverity" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                            @_updateStatusMessage
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight:600;">Product Updates</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Point to a JSON version manifest (app name, version, features, download link).
                    </MudText>
                    <MudTextField @bind-Value="_updateManifestUrl" Label="Update Manifest URL"
                                  Variant="Variant.Outlined" Class="mb-3"
                                  Placeholder="https://raw.githubusercontent.com/.../version.json"
                                  HelperText="Checked when 'Check for Updates' is clicked." />
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight:600;">Error Reporting (Sentry.io)</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Paste your Sentry DSN to enable automatic crash reporting. Leave blank to disable.
                        Stored locally and never shared.
                    </MudText>
                    <MudTextField @bind-Value="_sentryDsn" Label="Sentry DSN"
                                  Variant="Variant.Outlined" Class="mb-3"
                                  Placeholder="https://key@o123456.ingest.sentry.io/project-id" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="@SaveAboutSettings">
                        Save &amp; Apply
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

<MudDialog @bind-Visible="_2faDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Smartphone" Class="mr-2" Style="vertical-align:middle;" />
            Authenticator App (2FA)
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_twoFactorEnabled && _setup is null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Two-factor authentication is currently <b>enabled</b>.
            </MudAlert>
            <MudText Typo="Typo.body2" Class="mb-2">Confirm your master password and a current code to manage 2FA.</MudText>
            <MudTextField @bind-Value="_2faMasterPassword" Label="Master password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-2" />
            <MudTextField @bind-Value="_2faCode" Label="Current 6-digit code" Variant="Variant.Outlined" />

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Recovery (backup) codes</MudText>
            <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary">
                @_backupCodesRemaining codes remaining. Regenerating replaces all existing codes.
            </MudText>
            <MudSelect T="int" @bind-Value="_regenExpiryDays" Label="New codes expire" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                <MudSelectItem T="int" Value="0">Never</MudSelectItem>
                <MudSelectItem T="int" Value="30">After 30 days</MudSelectItem>
                <MudSelectItem T="int" Value="90">After 90 days</MudSelectItem>
                <MudSelectItem T="int" Value="180">After 180 days</MudSelectItem>
                <MudSelectItem T="int" Value="365">After 1 year</MudSelectItem>
            </MudSelect>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Autorenew" OnClick="@RegenerateBackupCodes" Disabled="@_2faBusy">
                Regenerate backup codes
            </MudButton>

            @if (_regeneratedCodes?.Any() == true)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3 mb-2" Icon="@Icons.Material.Filled.Key">
                    <b>New backup codes — save these now.</b> Your previous codes no longer work@(_regenExpiryDays > 0 ? $"; these expire in {_regenExpiryDays} days." : ".")
                </MudAlert>
                <MudPaper Outlined="true" Class="pa-3 mb-1">
                    <div style="font-family:monospace; columns:2; column-gap:24px; line-height:2;">
                        @foreach (var c in _regeneratedCodes)
                        {
                            <div>@c</div>
                        }
                    </div>
                </MudPaper>
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@CopyRegeneratedCodes">Copy codes</MudButton>
            }
        }
        else if (_setup is null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                Protect your vault with Google Authenticator, Microsoft Authenticator, or Authy.
                Enter your master password to begin.
            </MudText>
            <MudTextField @bind-Value="_2faMasterPassword" Label="Master password" InputType="InputType.Password" Variant="Variant.Outlined" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">1. Scan this QR code with your authenticator app:</MudText>
            <div class="d-flex justify-center mb-3">
                <img src="@_qrDataUrl" alt="Authenticator QR code"
                     style="width:208px; height:208px; border-radius:8px; background:#fff; padding:8px;" />
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Or enter this key manually:</MudText>
            <MudText Typo="Typo.body2" Style="font-family:monospace; word-break:break-all;" Class="mb-3">@_setup.SecretKey</MudText>
            <MudText Typo="Typo.body2" Class="mb-1">2. Enter the 6-digit code to confirm:</MudText>
            <MudTextField @bind-Value="_2faCode" Label="6-digit code" Variant="Variant.Outlined" Class="mb-2" />
            @if (_setup.BackupCodes?.Any() == true)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3 mb-2" Icon="@Icons.Material.Filled.Key">
                    <b>Save these backup codes now.</b> Each can be used once to sign in if you lose access
                    to your authenticator app — they're your way back in.
                </MudAlert>
                <MudPaper Outlined="true" Class="pa-3 mb-1">
                    <div style="font-family:monospace; columns:2; column-gap:24px; line-height:2;">
                        @foreach (var c in _setup.BackupCodes)
                        {
                            <div>@c</div>
                        }
                    </div>
                </MudPaper>
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@CopyBackupCodes">Copy codes</MudButton>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseTwoFactor">Cancel</MudButton>
        @if (_twoFactorEnabled && _setup is null)
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@DisableTwoFactor" Disabled="@_2faBusy">Disable 2FA</MudButton>
        }
        else if (_setup is null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@StartTwoFactor" Disabled="@_2faBusy">Continue</MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@VerifyTwoFactor" Disabled="@_2faBusy">Verify &amp; Enable</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    // ── Deep-linkable tabs ──────────────────────────────────────────────────────
    // The nav drawer lists each settings tab as its own menu item and links to
    // /settings?tab=<name>. Map that name to the panel index so the right tab opens.
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    int _activeTabIndex;

    // Order MUST match the MudTabPanel order in the markup above.
    static readonly string[] TabOrder =
    {
        "Security", "Appearance", "Database", "Sync", "Notifications", "Vaults",
        "Generator", "Encryption", "Shortcuts", "Maintenance", "About",
    };

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Tab))
        {
            var idx = Array.FindIndex(TabOrder, t => string.Equals(t, Tab, StringComparison.OrdinalIgnoreCase));
            if (idx >= 0) _activeTabIndex = idx;
        }
    }

    // ── Two-factor (authenticator app) ──
    bool _2faDialogOpen, _twoFactorEnabled, _2faBusy;
    int _backupCodesRemaining;
    string _2faMasterPassword = "", _2faCode = "";
    TwoFactorSetupResponseDto? _setup;
    string? _qrDataUrl;
    int _regenExpiryDays = 0;
    List<string>? _regeneratedCodes;

    async Task<string?> CurrentUserIdAsync()
        => AuthService.CurrentUser?.Id ?? await AuthService.GetCurrentUserIdAsync();

    async Task LoadTwoFactorStatusAsync()
    {
        var uid = await CurrentUserIdAsync();
        if (string.IsNullOrEmpty(uid)) return;
        var status = await TwoFactorService.GetTwoFactorStatusAsync(uid);
        _twoFactorEnabled = status.IsEnabled;
        _backupCodesRemaining = status.BackupCodesRemaining;
    }

    async Task OpenTwoFactorSetup()
    {
        _setup = null; _qrDataUrl = null; _2faMasterPassword = ""; _2faCode = "";
        await LoadTwoFactorStatusAsync();
        _2faDialogOpen = true;
    }

    void CloseTwoFactor()
    {
        _2faDialogOpen = false;
        _setup = null; _qrDataUrl = null; _2faMasterPassword = ""; _2faCode = "";
        _regeneratedCodes = null; _regenExpiryDays = 0;
    }

    async Task RegenerateBackupCodes()
    {
        if (string.IsNullOrWhiteSpace(_2faMasterPassword) || string.IsNullOrWhiteSpace(_2faCode))
        {
            Snackbar.Add("Enter your master password and a current 6-digit code.", Severity.Warning);
            return;
        }
        _2faBusy = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(uid)) return;

            var codes = await TwoFactorService.RegenerateBackupCodesAsync(uid, new RegenerateBackupCodesDto
            {
                MasterPassword = _2faMasterPassword,
                Code = _2faCode.Trim(),
                ExpiryDays = _regenExpiryDays > 0 ? _regenExpiryDays : null
            });

            if (codes is { Count: > 0 })
            {
                _regeneratedCodes = codes;
                await LoadTwoFactorStatusAsync();
                Snackbar.Add("New backup codes generated.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Couldn't regenerate — check your master password and current code.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _2faBusy = false; }
    }

    async Task CopyRegeneratedCodes()
    {
        if (_regeneratedCodes is null || _regeneratedCodes.Count == 0) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(Environment.NewLine, _regeneratedCodes));
            Snackbar.Add("Backup codes copied — store them somewhere safe.", Severity.Success);
        }
        catch { Snackbar.Add("Couldn't copy automatically — select and copy them manually.", Severity.Info); }
    }

    async Task CopyBackupCodes()
    {
        if (_setup?.BackupCodes is null || _setup.BackupCodes.Count == 0) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(Environment.NewLine, _setup.BackupCodes));
            Snackbar.Add("Backup codes copied — store them somewhere safe.", Severity.Success);
        }
        catch { Snackbar.Add("Couldn't copy automatically — select and copy them manually.", Severity.Info); }
    }

    async Task StartTwoFactor()
    {
        if (string.IsNullOrWhiteSpace(_2faMasterPassword)) { Snackbar.Add("Enter your master password.", Severity.Warning); return; }
        _2faBusy = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(uid)) { Snackbar.Add("Not signed in.", Severity.Error); return; }

            var result = await TwoFactorService.StartTwoFactorSetupAsync(uid, _2faMasterPassword);
            if (result is null) { Snackbar.Add("Could not start setup — check your master password.", Severity.Error); return; }

            _setup = result;
            _qrDataUrl = QrCodeService.GeneratePngDataUrl(result.QrCodeUri);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _2faBusy = false; }
    }

    async Task VerifyTwoFactor()
    {
        if (_setup is null || string.IsNullOrWhiteSpace(_2faCode)) { Snackbar.Add("Enter the 6-digit code.", Severity.Warning); return; }
        _2faBusy = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(uid)) return;

            var ok = await TwoFactorService.VerifyAndCompleteTwoFactorSetupAsync(uid,
                new TwoFactorVerifySetupDto { Code = _2faCode.Trim(), SecretKey = _setup.SecretKey });

            if (ok)
            {
                Snackbar.Add("Authenticator app enabled.", Severity.Success);
                await LoadTwoFactorStatusAsync();
                CloseTwoFactor();
            }
            else
            {
                Snackbar.Add("That code didn't match. Try again.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _2faBusy = false; }
    }

    async Task DisableTwoFactor()
    {
        _2faBusy = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            if (string.IsNullOrEmpty(uid)) return;

            var ok = await TwoFactorService.DisableTwoFactorAsync(uid,
                new TwoFactorDisableDto { MasterPassword = _2faMasterPassword, Code = _2faCode.Trim() });

            if (ok)
            {
                Snackbar.Add("Two-factor authentication disabled.", Severity.Success);
                await LoadTwoFactorStatusAsync();
                CloseTwoFactor();
            }
            else
            {
                Snackbar.Add("Could not disable — check your password and code.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _2faBusy = false; }
    }

    // Keyboard shortcuts (reference)
    private record Shortcut(string Action, string Keys);
    private readonly Shortcut[] _generalShortcuts =
    {
        new("New item", "Ctrl + N"),
        new("Focus / run search", "Ctrl + F · Enter"),
        new("Clear search", "Esc"),
        new("Open Settings", "Ctrl + ,"),
        new("Lock vault", "Ctrl + L"),
    };
    private readonly Shortcut[] _itemShortcuts =
    {
        new("Copy password", "Ctrl + C"),
