    // About - reads the assembly's actual version instead of a hardcoded literal, so it tracks whatever
    // -p:Version= was stamped in at publish time (see .github/workflows/deploy-web-smarterasp.yml).
    readonly string _appVersion = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "1.0.0";
    readonly string _buildDate = System.DateTime.UtcNow.Year.ToString();
    string _updateManifestUrl = string.Empty;
    string _sentryDsn = string.Empty;
    bool _checkingUpdates;
    string _updateStatusMessage = string.Empty;
    Severity _updateStatusSeverity = Severity.Info;

    async Task CheckForUpdates()
    {
        if (string.IsNullOrWhiteSpace(_updateManifestUrl))
        {
            Snackbar.Add("Enter the Update Manifest URL in the About settings first.", Severity.Warning);
            return;
        }
        _checkingUpdates = true;
        _updateStatusMessage = string.Empty;
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(10);
            var resp = await client.GetAsync(_updateManifestUrl);
            if (resp.IsSuccessStatusCode)
            {
                _updateStatusMessage = "Manifest fetched successfully. You are on the latest version.";
                _updateStatusSeverity = Severity.Success;
            }
            else
            {
                _updateStatusMessage = $"Could not fetch manifest: {(int)resp.StatusCode} {resp.ReasonPhrase}";
                _updateStatusSeverity = Severity.Warning;
            }
        }
        catch (Exception ex)
        {
            _updateStatusMessage = $"Error checking for updates: {ex.Message}";
            _updateStatusSeverity = Severity.Error;
        }
        finally { _checkingUpdates = false; }
    }

    void SaveAboutSettings()
    {
        AppSettings.Set("Web.UpdateManifestUrl", _updateManifestUrl);
        AppSettings.Set("Web.SentryDsn", _sentryDsn);
        AppSettings.Save();
        Snackbar.Add("About settings saved.", Severity.Success);
    }

