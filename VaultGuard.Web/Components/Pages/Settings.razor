    List<VaultGuard.Models.Vault> _vaults = new();
    bool _vaultsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try { LoadPersistedSettings(); }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }

        try
        {
            _vaults = await VaultService.GetAllAsync();
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
        finally { _vaultsLoading = false; }

        try { await LoadTwoFactorStatusAsync(); } catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
    }

    // ── Generator ────────────────────────────────────────────────────────────────

    int    _genLength    = 20;
    bool   _genUppercase = true;
    bool   _genLowercase = true;
    bool   _genNumbers   = true;
    bool   _genSymbols   = true;
    bool   _genAvoidAmbig = false;
    string _generatedPassword = string.Empty;

    void GeneratePassword()
    {
        var sb = new System.Text.StringBuilder();
        if (_genUppercase)  sb.Append(_genAvoidAmbig ? "ABCDEFGHJKLMNPQRSTUVWXYZ" : "ABCDEFGHIJKLMNOPQRSTUVWXYZ");
        if (_genLowercase)  sb.Append(_genAvoidAmbig ? "abcdefghjkmnpqrstuvwxyz"  : "abcdefghijklmnopqrstuvwxyz");
        if (_genNumbers)    sb.Append(_genAvoidAmbig ? "23456789"                  : "0123456789");
        if (_genSymbols)    sb.Append("!@#$%^&*()-_=+[]{}|;:,.<>?");
        if (sb.Length == 0) sb.Append("abcdefghijklmnopqrstuvwxyz");

        var charset = sb.ToString();
        var bytes = new byte[_genLength];
        System.Security.Cryptography.RandomNumberGenerator.Fill(bytes);
        _generatedPassword = new string(bytes.Select(b => charset[b % charset.Length]).ToArray());
        PersistGeneratorSettings();
        StateHasChanged();
    }

    // Remembers the generator configuration so it's the same next time the page opens.
    void PersistGeneratorSettings()
    {
        AppSettings.Set("Web.GenLength", _genLength);
        AppSettings.Set("Web.GenUppercase", _genUppercase);
        AppSettings.Set("Web.GenLowercase", _genLowercase);
        AppSettings.Set("Web.GenNumbers", _genNumbers);
        AppSettings.Set("Web.GenSymbols", _genSymbols);
        AppSettings.Set("Web.GenAvoidAmbig", _genAvoidAmbig);
        AppSettings.Save();
    }

    void CopyGeneratedPassword()
    {
        if (!string.IsNullOrEmpty(_generatedPassword))
            Snackbar.Add("Password copied! (Use Ctrl+C in the field to copy)", Severity.Success);
    }

    record StrengthResult(int Score, MudBlazor.Color BarColor, string Label);

    StrengthResult GetPasswordStrength(string pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return new(0, MudBlazor.Color.Default, "");
        int score = 0;
        if (pwd.Length >= 12) score += 20;
        if (pwd.Length >= 16) score += 10;
        if (pwd.Length >= 20) score += 10;
        if (pwd.Any(char.IsUpper))              score += 15;
        if (pwd.Any(char.IsLower))              score += 15;
        if (pwd.Any(char.IsDigit))              score += 15;
        if (pwd.Any(c => !char.IsLetterOrDigit(c))) score += 15;

        return score switch
        {
            >= 90 => new(score, MudBlazor.Color.Success, "Excellent"),
            >= 70 => new(score, MudBlazor.Color.Info,    "Strong"),
            >= 50 => new(score, MudBlazor.Color.Warning, "Moderate — consider increasing length"),
            _     => new(score, MudBlazor.Color.Error,   "Weak — use more character types"),
        };
    }
