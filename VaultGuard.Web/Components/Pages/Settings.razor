    void SaveDatabaseSettings()
    {
        AppSettings.Set("DatabaseProvider", _dbProvider);
        AppSettings.Set("DatabaseConnectionString", _connectionString);
        AppSettings.Set("SqliteDatabasePath", _sqliteDbPath);
        AppSettings.Save();
        Snackbar.Add("Database settings saved — restart the app to apply.", Severity.Success);
    }

    void TestDatabaseConnection()
    {
        if (_dbProvider == "SQLite")
        {
            var dir = System.IO.Path.GetDirectoryName(_sqliteDbPath);
            var ok = !string.IsNullOrWhiteSpace(_sqliteDbPath) &&
                     (System.IO.File.Exists(_sqliteDbPath) || (dir != null && System.IO.Directory.Exists(dir)));
            Snackbar.Add(ok ? "SQLite path looks valid." : "That folder doesn't exist yet — it will be created on save.",
                ok ? Severity.Success : Severity.Warning);
        }
        else
        {
            Snackbar.Add(string.IsNullOrWhiteSpace(_connectionString)
                ? "Enter a connection string first." : "Connection string captured.",
                string.IsNullOrWhiteSpace(_connectionString) ? Severity.Warning : Severity.Info);
        }
    }

    // Sync
    bool _autoSync = true;
    int _syncInterval = 30;
    string _conflictResolution = "newest";

    // Connection mode / API server (shared with WPF via "AuthMode" / "ApiBaseUrl")
    string _authMode = "API Server";   // Blazor is API-only (no local DB provider selection)
    string _apiBaseUrl = "https://vaultguardapi.dotnetappdevni.com";
    string _apiKey = string.Empty;      // sent as X-Api-Key header
    string _clientId = string.Empty;
    string _clientSecret = string.Empty;
    // SQL Server (the API's database) — same fields the Secret Manager composes (dbserver/dbusername/dbpassword)
    string _dbServer = string.Empty, _dbName = string.Empty, _dbUser = string.Empty, _dbPassword = string.Empty;
    bool _dbBusy;
    // When false (default) the app uses VaultGuard's hosted database; the SQL Server details below are only
    // relevant when the user runs their own API (self-hosting).
    bool _selfHostApi;

    void SaveApiSettings()
    {
        AppSettings.Set("AuthMode", _authMode);
        if (_authMode == "API Server")
        {
            AppSettings.Set("ApiBaseUrl", _apiBaseUrl);
            AppSettings.Set("ApiKey", _apiKey);
            AppSettings.Set("ApiClientId", _clientId);
            AppSettings.Set("ApiClientSecret", _clientSecret);
            AppSettings.Set("SelfHostApi", _selfHostApi.ToString());
            // Only persist SQL Server credentials when self-hosting — otherwise we use the hosted database.
            if (_selfHostApi)
            {
                AppSettings.Set("dbserver", _dbServer);
                AppSettings.Set("dbname", _dbName);
                AppSettings.Set("dbusername", _dbUser);
                AppSettings.Set("dbpassword", _dbPassword);
            }
        }
        else
        {
            // Local Database = SQLite for the Blazor web app.
            AppSettings.Set("DatabaseProvider", "SQLite");
            if (!string.IsNullOrWhiteSpace(_sqliteDbPath))
                AppSettings.Set("SqliteDatabasePath", _sqliteDbPath);
        }
        AppSettings.Save();
        Snackbar.Add("Connection settings saved — restart to apply.", Severity.Success);
    }

    // ── API credential generators ────────────────────────────────────────────────
    static string RandomToken(int bytes)
    {
        var buf = new byte[bytes];
        System.Security.Cryptography.RandomNumberGenerator.Fill(buf);
        // URL-safe base64 without padding.
        return Convert.ToBase64String(buf).Replace("+", "-").Replace("/", "_").TrimEnd('=');
    }

    // Fields for issuing a real key from the remote API (see IssueKeyFromServer).
    string _issueEmail = string.Empty;
    string _issueMasterPassword = string.Empty;
    bool _issuingKey;

    // Show just the host of an API URL in help text (e.g. "vaultguardapi.dotnetappdevni.com").
    static string FormatHost(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "the API server";
        return Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : url;
    }

    // Ask the CONFIGURED API server to issue a real key into ITS OWN database, authenticated by the
    // account's email + master password. This is the key that will pass the connection test — unlike a
    // key generated locally (which lives in this app's DB and is rejected by the remote API with 401/403).
    async Task IssueKeyFromServer()
    {
        if (string.IsNullOrWhiteSpace(_apiBaseUrl)) { Snackbar.Add("Enter the API URL first.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_issueEmail) || string.IsNullOrWhiteSpace(_issueMasterPassword))
        { Snackbar.Add("Enter your account email and master password.", Severity.Warning); return; }

        _issuingKey = true;
        try
        {
            var baseUri = _apiBaseUrl.TrimEnd('/');
            var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15);

            var payload = new { email = _issueEmail, masterPassword = _issueMasterPassword, name = $"Web app ({DateTime.Now:yyyy-MM-dd HH:mm})" };
            var resp = await client.PostAsJsonAsync($"{baseUri}/api/apikeys/issue", payload);

            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            { Snackbar.Add("The API rejected those credentials. Check the email and master password for THIS server's account.", Severity.Error); return; }
            if (!resp.IsSuccessStatusCode)
            { Snackbar.Add($"Couldn't issue a key: {(int)resp.StatusCode} {resp.ReasonPhrase}.", Severity.Error); return; }

            using var doc = System.Text.Json.JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var keyValue = doc.RootElement.TryGetProperty("keyValue", out var kv) ? kv.GetString() : null;
            if (string.IsNullOrWhiteSpace(keyValue))
            { Snackbar.Add("The server did not return a key value.", Severity.Error); return; }

            _apiKey = keyValue;
            AppSettings.Set("ApiKey", _apiKey);
            AppSettings.Save();
            _issueMasterPassword = string.Empty; // don't keep it around
            Snackbar.Add("Real API key issued by the server and saved. Use \"Test API\" to confirm it authenticates.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Notify.ShowErrorAsync("Couldn't reach the API to issue a key.", ex);
        }
        finally { _issuingKey = false; }
    }

