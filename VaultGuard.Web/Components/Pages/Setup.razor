@code {
    private string _tab = "general";
    private DatabaseProvider _provider = DatabaseProvider.Sqlite;

    private string _statusMessage = string.Empty;
    private bool _statusOk;
    private bool _busy;
    private string _busyAction = string.Empty;

    // SQLite
    private string _sqlitePath = string.Empty;

    // SQL Server
    private SqlServerConfig _ss = new SqlServerConfig();
    private string _ssPassword = string.Empty;

    // MySQL
    private MySqlConfig _my = new MySqlConfig();
    private string _myPassword = string.Empty;

    // PostgreSQL
    private PostgreSqlConfig _pg = new PostgreSqlConfig();
    private string _pgPassword = string.Empty;

    // Supabase
    private string _supaUrl = string.Empty;
    private string _supaKey = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await DatabaseConfigService.GetConfigurationAsync();
            if (existing != null && !existing.IsFirstRun)
            {
                _provider = existing.Provider;
                if (existing.Sqlite != null) _sqlitePath = existing.Sqlite.DatabasePath;
                if (existing.SqlServer != null) _ss = existing.SqlServer;
                if (existing.MySql != null) _my = existing.MySql;
                if (existing.PostgreSql != null) _pg = existing.PostgreSql;
                if (existing.Supabase != null) { _supaUrl = existing.Supabase.Url; _supaKey = existing.Supabase.ServiceKey; }
            }
        }
        catch { }
    }

    private void SelectProvider(DatabaseProvider provider)
    {
        _provider = provider;
        _tab = "general";
        _statusMessage = string.Empty;
    }

    private string GetProviderTitle() => _provider switch
    {
        DatabaseProvider.Sqlite => "SQLite",
        DatabaseProvider.SqlServer => "SQL Server",
        DatabaseProvider.MySql => "MySQL",
        DatabaseProvider.PostgreSql => "PostgreSQL",
        DatabaseProvider.Supabase => "Supabase",
        _ => "Database"
    };

    private string GetProviderDescription() => _provider switch
    {
        DatabaseProvider.Sqlite => "Use a local database file. Leave the path empty to use the default location.",
        DatabaseProvider.SqlServer => "Enter the SQL Server host and any authentication, encryption, or pooling options you need.",
        DatabaseProvider.MySql => "Configure the MySQL or MariaDB server details, credentials, and SSL options.",
        DatabaseProvider.PostgreSql => "Configure the PostgreSQL server details, credentials, and SSL or pooling options.",
        DatabaseProvider.Supabase => "Provide the hosted project URL and service role key for your Supabase database.",
        _ => "Update the connection settings for the selected provider."
    };

    private async Task TestConnection()
    {
        _busy = true;
        _busyAction = "test";
        _statusMessage = string.Empty;
        StateHasChanged();
        try
        {
            var cfg = await BuildConfig();
            var result = await DatabaseConfigService.TestConnectionAsync(cfg);
            _statusOk = result.Success;
            _statusMessage = result.Success
                ? "Connection successful!"
                : $"Connection failed: {result.ErrorMessage}";
        }
        catch (Exception ex)
        {
            _statusOk = false;
            _statusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        _busy = true;
        _busyAction = "save";
        _statusMessage = string.Empty;
        StateHasChanged();
        try
        {
            var cfg = await BuildConfig();
            await DatabaseConfigService.SaveConfigurationAsync(cfg);
            _statusOk = true;
            _statusMessage = "Configuration saved — redirecting...";
            StateHasChanged();
            await Task.Delay(1200);
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _statusOk = false;
            _statusMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task<DatabaseConfiguration> BuildConfig()
    {
        var cfg = new DatabaseConfiguration { Provider = _provider, IsFirstRun = false };
        switch (_provider)
        {
            case DatabaseProvider.Sqlite:
                cfg.Sqlite = new SqliteConfig { DatabasePath = string.IsNullOrWhiteSpace(_sqlitePath) ? "passwordmanager.db" : _sqlitePath };
                break;

            case DatabaseProvider.SqlServer:
                if (!string.IsNullOrEmpty(_ssPassword))
                    _ss.EncryptedPassword = await DatabaseConfigService.EncryptPasswordAsync(_ssPassword);
                cfg.SqlServer = _ss;
                break;

            case DatabaseProvider.MySql:
                if (!string.IsNullOrEmpty(_myPassword))
                    _my.EncryptedPassword = await DatabaseConfigService.EncryptPasswordAsync(_myPassword);
                cfg.MySql = _my;
                break;

            case DatabaseProvider.PostgreSql:
                if (!string.IsNullOrEmpty(_pgPassword))
                    _pg.EncryptedPassword = await DatabaseConfigService.EncryptPasswordAsync(_pgPassword);
                cfg.PostgreSql = _pg;
                break;

            case DatabaseProvider.Supabase:
                cfg.Supabase = new SupabaseConfig { Url = _supaUrl, ServiceKey = _supaKey };
                break;
        }
        return cfg;
    }
}
