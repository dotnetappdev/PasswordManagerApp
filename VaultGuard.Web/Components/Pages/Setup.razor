@page "/setup"
@using VaultGuard.Models.Configuration
@using VaultGuard.Services.Interfaces
@inject IDatabaseConfigurationService DatabaseConfigService
@inject NavigationManager NavigationManager

<PageTitle>Database Setup — Vault Guard</PageTitle>

<div class="setup-page">
    <div class="setup-shell">

        <!-- Header -->
        <div class="setup-header">
            <div class="setup-logo">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1>Vault Guard Setup</h1>
            <p>Choose your database type and edit the matching connection settings on one screen.</p>
        </div>

        <div class="setup-body setup-layout">
            <aside class="provider-panel">
                <div class="provider-panel-header">
                    <h2>Database Type</h2>
                    <p>Pick a provider to update the connection form.</p>
                </div>

                <div class="provider-list">
                    <button type="button" class="provider-option @(_provider == DatabaseProvider.Sqlite ? "selected local" : "local")"
                            @onclick="() => SelectProvider(DatabaseProvider.Sqlite)">
                        <span class="provider-option-icon"><i class="fas fa-laptop"></i></span>
                        <span class="provider-option-copy">
                            <strong>SQLite</strong>
                            <span>Local file — recommended</span>
                        </span>
                    </button>

                    <button type="button" class="provider-option @(_provider == DatabaseProvider.SqlServer ? "selected" : "")"
                            @onclick="() => SelectProvider(DatabaseProvider.SqlServer)">
                        <span class="provider-option-icon"><i class="fas fa-server"></i></span>
                        <span class="provider-option-copy">
                            <strong>SQL Server</strong>
                            <span>Microsoft SQL Server</span>
                        </span>
                    </button>

                    <button type="button" class="provider-option @(_provider == DatabaseProvider.MySql ? "selected" : "")"
                            @onclick="() => SelectProvider(DatabaseProvider.MySql)">
                        <span class="provider-option-icon"><i class="fas fa-database"></i></span>
                        <span class="provider-option-copy">
                            <strong>MySQL</strong>
                            <span>MySQL / MariaDB</span>
                        </span>
                    </button>

                    <button type="button" class="provider-option @(_provider == DatabaseProvider.PostgreSql ? "selected" : "")"
                            @onclick="() => SelectProvider(DatabaseProvider.PostgreSql)">
                        <span class="provider-option-icon"><i class="fas fa-elephant"></i></span>
                        <span class="provider-option-copy">
                            <strong>PostgreSQL</strong>
                            <span>PostgreSQL Server</span>
                        </span>
                    </button>

                    <button type="button" class="provider-option @(_provider == DatabaseProvider.Supabase ? "selected" : "")"
                            @onclick="() => SelectProvider(DatabaseProvider.Supabase)">
                        <span class="provider-option-icon"><i class="fas fa-cloud"></i></span>
                        <span class="provider-option-copy">
                            <strong>Supabase</strong>
                            <span>Hosted PostgreSQL</span>
                        </span>
                    </button>
                </div>
            </aside>

            <section class="config-panel">
                <div class="config-panel-header">
                    <span class="config-kicker">Connection Settings</span>
                    <h2>@GetProviderTitle()</h2>
                    <p>@GetProviderDescription()</p>
                </div>

                @if (_provider == DatabaseProvider.Sqlite)
                {
                    <div class="config-section">
                        <div class="fg">
                            <label>Database File Path</label>
                            <input class="fc" type="text" @bind="_sqlitePath" placeholder="passwordmanager.db" />
                            <small>Leave empty to use the default location</small>
                        </div>
                    </div>
                }

                <!-- SQL Server -->
                @if (_provider == DatabaseProvider.SqlServer)
                {
                    <div class="config-tabs">
                        <button class="ct @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>General</button>
                        <button class="ct @(_tab == "security" ? "active" : "")" @onclick='() => _tab = "security"'>Security</button>
                        <button class="ct @(_tab == "advanced" ? "active" : "")" @onclick='() => _tab = "advanced"'>Advanced</button>
                    </div>

                    @if (_tab == "general")
                    {
                        <div class="config-section">
                            <div class="form-row">
                                <div class="fg flex2">
                                    <label>Server <span class="req">*</span></label>
                                    <input class="fc" type="text" @bind="_ss.Host" placeholder="localhost or IP address" />
                                </div>
                                <div class="fg flex1">
                                    <label>Instance</label>
                                    <input class="fc" type="text" @bind="_ss.InstanceName" placeholder="optional" />
                                </div>
                                <div class="fg port-field">
                                    <label>Port</label>
                                    <input class="fc" type="number" @bind="_ss.Port" />
                                </div>
                            </div>
                            <div class="fg">
                                <label>Database <span class="req">*</span></label>
                                <input class="fc" type="text" @bind="_ss.Database" placeholder="VaultGuard" />
                            </div>
                            <div class="fg">
                                <label>Authentication</label>
                                <select class="fc" @bind="_ss.AuthMode">
                                    <option value="@SqlServerAuthMode.SqlServerAuthentication">SQL Server Authentication</option>
                                    <option value="@SqlServerAuthMode.WindowsAuthentication">Windows Authentication</option>
                                </select>
                            </div>
                            @if (_ss.AuthMode == SqlServerAuthMode.SqlServerAuthentication)
                            {
                                <div class="fg">
                                    <label>Username</label>
                                    <input class="fc" type="text" @bind="_ss.Username" />
                                </div>
                                <div class="fg">
                                    <label>Password</label>
                                    <input class="fc" type="password" @bind="_ssPassword" />
                                </div>
                            }
                        </div>
                    }
                    @if (_tab == "security")
                    {
                        <div class="config-section">
                            <div class="section-label">Encryption</div>
                            <div class="fg">
                                <label>Encrypt Connection</label>
                                <select class="fc" @bind="_ss.Encryption">
                                    <option value="@SqlServerEncryptionMode.None">None</option>
                                    <option value="@SqlServerEncryptionMode.Optional">Optional (default)</option>
                                    <option value="@SqlServerEncryptionMode.Mandatory">Mandatory (TLS)</option>
                                    <option value="@SqlServerEncryptionMode.Strict">Strict (TLS 1.3)</option>
                                </select>
                            </div>
                            <div class="fg">
                                <label class="check-label">
                                    <input type="checkbox" @bind="_ss.TrustServerCertificate" />
                                    Trust Server Certificate
                                </label>
                                <small>Enable when using self-signed certificates</small>
                            </div>
                            @if (_ss.Encryption == SqlServerEncryptionMode.Mandatory || _ss.Encryption == SqlServerEncryptionMode.Strict)
                            {
                                <div class="fg">
                                    <label>Server Certificate</label>
                                    <input class="fc" type="text" @bind="_ss.ServerCertificate" placeholder="Thumbprint or file path" />
                                    <small>Required for Mandatory / Strict — leave empty to use system trust store</small>
                                </div>
                            }
                        </div>
                    }
                    @if (_tab == "advanced")
                    {
                        <div class="config-section">
                            <div class="section-label">Connection</div>
                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Network Protocol</label>
                                    <select class="fc" @bind="_ss.NetworkProtocol">
                                        <option value="@SqlServerNetworkProtocol.Default">Default</option>
                                        <option value="@SqlServerNetworkProtocol.TcpIp">TCP/IP</option>
                                        <option value="@SqlServerNetworkProtocol.NamedPipes">Named Pipes</option>
                                        <option value="@SqlServerNetworkProtocol.SharedMemory">Shared Memory</option>
                                    </select>
                                </div>
                                <div class="fg flex1">
                                    <label>Packet Size</label>
                                    <input class="fc" type="number" @bind="_ss.PacketSize" min="512" max="32767" />
                                    <small>512 – 32767 bytes (default 4096)</small>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Connection Timeout (s)</label>
                                    <input class="fc" type="number" @bind="_ss.ConnectionTimeout" min="0" />
                                </div>
                                <div class="fg flex1">
                                    <label>Command Timeout (s)</label>
                                    <input class="fc" type="number" @bind="_ss.CommandTimeout" min="0" />
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Application Name</label>
                                    <input class="fc" type="text" @bind="_ss.ApplicationName" />
                                </div>
                                <div class="fg flex1">
                                    <label>Workstation ID</label>
                                    <input class="fc" type="text" @bind="_ss.WorkstationId" placeholder="optional" />
                                </div>
                            </div>

                            <hr class="section-sep" />
                            <div class="section-label">Behaviour &amp; Pooling</div>

                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Application Intent</label>
                                    <select class="fc" @bind="_ss.ApplicationIntent">
                                        <option value="@SqlServerApplicationIntent.ReadWrite">ReadWrite</option>
                                        <option value="@SqlServerApplicationIntent.ReadOnly">ReadOnly</option>
                                    </select>
                                </div>
                                <div class="fg flex1">
                                    <label>Failover Partner</label>
                                    <input class="fc" type="text" @bind="_ss.FailoverPartner" placeholder="optional" />
                                </div>
                            </div>
                            <div class="check-row">
                                <label class="check-label"><input type="checkbox" @bind="_ss.MultipleActiveResultSets" /> Multiple Active Result Sets (MARS)</label>
                                <label class="check-label"><input type="checkbox" @bind="_ss.MultiSubnetFailover" /> Multi-Subnet Failover</label>
                                <label class="check-label"><input type="checkbox" @bind="_ss.Pooling" /> Connection Pooling</label>
                            </div>
                            @if (_ss.Pooling)
                            {
                                <div class="form-row">
                                    <div class="fg flex1">
                                        <label>Min Pool Size</label>
                                        <input class="fc" type="number" @bind="_ss.MinPoolSize" min="0" />
                                    </div>
                                    <div class="fg flex1">
                                        <label>Max Pool Size</label>
                                        <input class="fc" type="number" @bind="_ss.MaxPoolSize" min="1" />
                                    </div>
                                </div>
                            }
                            <div class="fg">
                                <label>Additional Parameters</label>
                                <textarea class="fc" rows="3" @bind="_ss.AdditionalParameters" placeholder="key=value;key2=value2 — appended verbatim to the connection string"></textarea>
                            </div>
                        </div>
                    }
                }

                <!-- MySQL -->
                @if (_provider == DatabaseProvider.MySql)
                {
                    <div class="config-tabs">
                        <button class="ct @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>General</button>
                        <button class="ct @(_tab == "security" ? "active" : "")" @onclick='() => _tab = "security"'>SSL</button>
                        <button class="ct @(_tab == "advanced" ? "active" : "")" @onclick='() => _tab = "advanced"'>Advanced</button>
                    </div>

                    @if (_tab == "general")
                    {
                        <div class="config-section">
                            <div class="form-row">
                                <div class="fg flex2">
                                    <label>Server <span class="req">*</span></label>
                                    <input class="fc" type="text" @bind="_my.Host" placeholder="localhost" />
                                </div>
                                <div class="fg port-field">
                                    <label>Port</label>
                                    <input class="fc" type="number" @bind="_my.Port" />
                                </div>
                            </div>
                            <div class="fg">
                                <label>Database <span class="req">*</span></label>
                                <input class="fc" type="text" @bind="_my.Database" placeholder="VaultGuard" />
                            </div>
                            <div class="fg">
                                <label>Username <span class="req">*</span></label>
                                <input class="fc" type="text" @bind="_my.Username" />
                            </div>
                            <div class="fg">
                                <label>Password</label>
                                <input class="fc" type="password" @bind="_myPassword" />
                            </div>
                        </div>
                    }
                    @if (_tab == "security")
                    {
                        <div class="config-section">
                            <div class="fg">
                                <label>SSL Mode</label>
                                <select class="fc" @bind="_my.SslMode">
                                    <option value="@MySqlSslMode.None">None — no SSL</option>
                                    <option value="@MySqlSslMode.Preferred">Preferred (default)</option>
                                    <option value="@MySqlSslMode.Required">Required</option>
                                    <option value="@MySqlSslMode.VerifyCA">VerifyCA — validate CA</option>
                                    <option value="@MySqlSslMode.VerifyFull">VerifyFull — validate CA + hostname</option>
                                </select>
                            </div>
                            @if (_my.SslMode is MySqlSslMode.VerifyCA or MySqlSslMode.VerifyFull)
                            {
                                <div class="fg">
                                    <label>CA Certificate Path</label>
                                    <input class="fc" type="text" @bind="_my.SslCaPath" placeholder="/path/to/ca-cert.pem" />
                                </div>
                                <div class="fg">
                                    <label>Client Certificate Path</label>
                                    <input class="fc" type="text" @bind="_my.SslCertPath" placeholder="/path/to/client-cert.pem" />
                                </div>
                                <div class="fg">
                                    <label>Client Key Path</label>
                                    <input class="fc" type="text" @bind="_my.SslKeyPath" placeholder="/path/to/client-key.pem" />
                                </div>
                            }
                        </div>
                    }
                    @if (_tab == "advanced")
                    {
                        <div class="config-section">
                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Connection Timeout (s)</label>
                                    <input class="fc" type="number" @bind="_my.ConnectionTimeout" min="0" />
                                </div>
                                <div class="fg flex1">
                                    <label>Command Timeout (s)</label>
                                    <input class="fc" type="number" @bind="_my.CommandTimeout" min="0" />
                                </div>
                            </div>
                            <div class="fg">
                                <label>Character Set</label>
                                <input class="fc" type="text" @bind="_my.CharacterSet" placeholder="utf8mb4" />
                            </div>
                            <div class="check-row">
                                <label class="check-label"><input type="checkbox" @bind="_my.AllowZeroDateTime" /> Allow Zero DateTime</label>
                                <label class="check-label"><input type="checkbox" @bind="_my.AllowUserVariables" /> Allow User Variables</label>
                                <label class="check-label"><input type="checkbox" @bind="_my.Pooling" /> Connection Pooling</label>
                            </div>
                            @if (_my.Pooling)
                            {
                                <div class="form-row">
                                    <div class="fg flex1">
                                        <label>Min Pool Size</label>
                                        <input class="fc" type="number" @bind="_my.MinPoolSize" min="0" />
                                    </div>
                                    <div class="fg flex1">
                                        <label>Max Pool Size</label>
                                        <input class="fc" type="number" @bind="_my.MaxPoolSize" min="1" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <!-- PostgreSQL -->
                @if (_provider == DatabaseProvider.PostgreSql)
                {
                    <div class="config-tabs">
                        <button class="ct @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>General</button>
                        <button class="ct @(_tab == "security" ? "active" : "")" @onclick='() => _tab = "security"'>SSL</button>
                        <button class="ct @(_tab == "advanced" ? "active" : "")" @onclick='() => _tab = "advanced"'>Advanced</button>
                    </div>

                    @if (_tab == "general")
                    {
                        <div class="config-section">
                            <div class="form-row">
                                <div class="fg flex2">
                                    <label>Server <span class="req">*</span></label>
                                    <input class="fc" type="text" @bind="_pg.Host" placeholder="localhost" />
                                </div>
                                <div class="fg port-field">
                                    <label>Port</label>
                                    <input class="fc" type="number" @bind="_pg.Port" />
                                </div>
                            </div>
                            <div class="fg">
                                <label>Database <span class="req">*</span></label>
                                <input class="fc" type="text" @bind="_pg.Database" placeholder="VaultGuard" />
                            </div>
                            <div class="fg">
                                <label>Username <span class="req">*</span></label>
                                <input class="fc" type="text" @bind="_pg.Username" />
                            </div>
                            <div class="fg">
                                <label>Password</label>
                                <input class="fc" type="password" @bind="_pgPassword" />
                            </div>
                        </div>
                    }
                    @if (_tab == "security")
                    {
                        <div class="config-section">
                            <div class="fg">
                                <label>SSL Mode</label>
                                <select class="fc" @bind="_pg.SslMode">
                                    <option value="@PostgreSqlSslMode.Disable">Disable</option>
                                    <option value="@PostgreSqlSslMode.Allow">Allow</option>
                                    <option value="@PostgreSqlSslMode.Prefer">Prefer (default)</option>
                                    <option value="@PostgreSqlSslMode.Require">Require</option>
                                    <option value="@PostgreSqlSslMode.VerifyCA">VerifyCA</option>
                                    <option value="@PostgreSqlSslMode.VerifyFull">VerifyFull</option>
                                </select>
                            </div>
                            @if (_pg.SslMode is PostgreSqlSslMode.VerifyCA or PostgreSqlSslMode.VerifyFull)
                            {
                                <div class="fg">
                                    <label>SSL Certificate Path</label>
                                    <input class="fc" type="text" @bind="_pg.SslCertPath" placeholder="/path/to/client.crt" />
                                </div>
                                <div class="fg">
                                    <label>SSL Key Path</label>
                                    <input class="fc" type="text" @bind="_pg.SslKeyPath" placeholder="/path/to/client.key" />
                                </div>
                                <div class="fg">
                                    <label>Root Certificate Path</label>
                                    <input class="fc" type="text" @bind="_pg.SslRootCertPath" placeholder="/path/to/root.crt" />
                                </div>
                            }
                        </div>
                    }
                    @if (_tab == "advanced")
                    {
                        <div class="config-section">
                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Connection Timeout (s)</label>
                                    <input class="fc" type="number" @bind="_pg.ConnectionTimeout" min="0" />
                                </div>
                                <div class="fg flex1">
                                    <label>Command Timeout (s)</label>
                                    <input class="fc" type="number" @bind="_pg.CommandTimeout" min="0" />
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="fg flex1">
                                    <label>Application Name</label>
                                    <input class="fc" type="text" @bind="_pg.ApplicationName" />
                                </div>
                                <div class="fg flex1">
                                    <label>Search Path</label>
                                    <input class="fc" type="text" @bind="_pg.SearchPath" placeholder="public" />
                                </div>
                            </div>
                            <div class="check-row">
                                <label class="check-label"><input type="checkbox" @bind="_pg.Pooling" /> Connection Pooling</label>
                            </div>
                            @if (_pg.Pooling)
                            {
                                <div class="form-row">
                                    <div class="fg flex1">
                                        <label>Min Pool Size</label>
                                        <input class="fc" type="number" @bind="_pg.MinPoolSize" min="0" />
                                    </div>
                                    <div class="fg flex1">
                                        <label>Max Pool Size</label>
                                        <input class="fc" type="number" @bind="_pg.MaxPoolSize" min="1" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <!-- Supabase -->
                @if (_provider == DatabaseProvider.Supabase)
                {
                    <div class="config-section">
                        <h3>Supabase Configuration</h3>
                        <div class="fg">
                            <label>Project URL <span class="req">*</span></label>
                            <input class="fc" type="text" @bind="_supaUrl" placeholder="https://your-project.supabase.co" />
                        </div>
                        <div class="fg">
                            <label>Service Key <span class="req">*</span></label>
                            <input class="fc" type="password" @bind="_supaKey" />
                            <small>Use your service role key for full database access</small>
                        </div>
                    </div>
                }

                <!-- Status -->
                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="status-bar @(_statusOk ? "ok" : "err")">
                        <i class="fas @(_statusOk ? "fa-check-circle" : "fa-exclamation-circle")"></i>
                        @_statusMessage
                    </div>
                }

                <!-- Actions -->
                <div class="setup-actions">
                    <div class="right-actions">
                        <button class="btn-secondary" @onclick="TestConnection" disabled="@_busy">
                            @if (_busy && _busyAction == "test")
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                            }
                            else
                            {
                                <i class="fas fa-plug"></i>
                            }
                            Test Connection
                        </button>
                        <button class="btn-primary" @onclick="Save" disabled="@_busy">
                            @if (_busy && _busyAction == "save")
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                            }
                            Save Configuration
                        </button>
                    </div>
                </div>
            </section>
        </div>

    </div>
</div>

<style>
    .setup-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 40px 20px 60px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .setup-shell {
        background: #fff;
        border-radius: 16px;
        width: 100%;
        max-width: 720px;
        box-shadow: 0 32px 64px rgba(0,0,0,0.4);
        overflow: hidden;
    }
    .setup-header {
        background: #007acc;
        color: #fff;
        padding: 32px;
        text-align: center;
    }
    .setup-logo { font-size: 40px; margin-bottom: 12px; }
    .setup-header h1 { margin: 0 0 6px; font-size: 24px; font-weight: 600; }
    .setup-header p { margin: 0; opacity: .85; font-size: 14px; }

    .setup-body { padding: 32px; }
    .setup-layout { display: grid; grid-template-columns: minmax(220px, 250px) minmax(0, 1fr); gap: 24px; align-items: start; }

    .provider-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px;
    }
    .provider-panel-header h2 { margin: 0 0 6px; font-size: 16px; color: #1a202c; }
    .provider-panel-header p { margin: 0 0 16px; font-size: 13px; color: #718096; }
    .provider-list { display: flex; flex-direction: column; gap: 10px; }
    .provider-option {
        border: 1px solid #d7e0ea; border-radius: 10px; padding: 12px 14px;
        cursor: pointer; display: flex; align-items: center; gap: 12px;
        transition: all .2s; background: #fff; text-align: left;
        font-family: inherit;
    }
    .provider-option:hover { border-color: #007acc; box-shadow: 0 4px 12px rgba(0,122,204,.12); transform: translateY(-1px); }
    .provider-option.selected { border-color: #007acc; background: #f0f8ff; }
    .provider-option.local { border-width: 2px; }
    .provider-option.local.selected { border-color: #28a745; background: #f0fff4; }
    .provider-option.local:hover { border-color: #28a745; }
    .provider-option-icon { font-size: 20px; color: #007acc; width: 22px; text-align: center; flex-shrink: 0; }
    .provider-option.local .provider-option-icon { color: #28a745; }
    .provider-option-copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .provider-option-copy strong { display: block; font-size: 14px; color: #1a202c; }
    .provider-option-copy span { font-size: 12px; color: #718096; }

    .config-panel {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        min-width: 0;
    }
    .config-panel-header { margin-bottom: 18px; }
    .config-kicker {
        display: inline-block;
        margin-bottom: 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #718096;
    }
    .config-panel-header h2 { margin: 0 0 6px; font-size: 20px; color: #1a202c; }
    .config-panel-header p { margin: 0; font-size: 13px; color: #718096; }

    /* Tabs */
    .config-tabs { display: flex; border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; }
    .ct {
        padding: 10px 20px; border: none; background: none; cursor: pointer;
        font-size: 14px; font-weight: 500; color: #718096;
