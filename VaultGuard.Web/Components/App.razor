<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/VaultGuard.Components.Shared/css/auth.css" />
    <link rel="stylesheet" href="VaultGuard.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="qrcode.min.js"></script>
    <script src="qr-login.js"></script>
    <script src="jsQR.js"></script>
    <script src="qr-scanner.js"></script>
    <script src="passkey.js"></script>
    <script src="splitter.js"></script>
    <script>
        // Login-page helpers invoked by the shared Login component (defined here for the web host).
        window.focusPasswordField = function () {
            try {
                var el = document.querySelector('.auth-card input[type="password"]')
                      || document.querySelector('input[type="password"]');
                if (el) el.focus();
            } catch (e) { /* non-fatal */ }
        };
        window.animateLogo = function () { /* logo animation is CSS-driven; no-op on web */ };
    </script>
</body>

</html>
