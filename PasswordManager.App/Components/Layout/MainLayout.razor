@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <PasswordManager.App.Components.Layout.NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/blazor/" target="_blank" class="btn btn-link">About Blazor</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
