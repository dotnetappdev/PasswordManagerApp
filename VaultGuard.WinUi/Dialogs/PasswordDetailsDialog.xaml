<ContentDialog x:Class="VaultGuard.WinUi.Dialogs.PasswordDetailsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:VaultGuard.WinUi.Controls"
               xmlns:ui="using:Microsoft.UI.Xaml.Controls"
               Style="{StaticResource Modern1PasswordDialogStyle}">

        <!-- Title area with item title and action buttons -->
        <ContentDialog.Title>
                <Grid>
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="DialogTitleText"
                                   Text="Item Title"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <!-- Moderate message under title -->
                        <ui:InfoBar x:Name="ModerateInfoBar"
                                    IsOpen="True"
                                    Severity="Informational"
                                    Visibility="Visible"
                                    Message="Moderate: Deleting an item will remove it from your vault. You can restore from Recently Deleted."
                                    Margin="16,8,16,0"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                <Button x:Name="EditItemButton"
                                        Content="Edit"
                                        Style="{StaticResource ModernPrimaryButtonStyle}"
                                        Click="EditItemButton_Click"/>

                                <Button x:Name="DeleteItemButton"
                                        Content="Delete"
                                        Style="{StaticResource ModernDangerButtonStyle}"
                                        Click="DeleteItemButton_Click"
                                        Visibility="Collapsed"/>
                        </StackPanel>
                </Grid>
        </ContentDialog.Title>

        <ScrollViewer MaxHeight="600"
                      MaxWidth="500">
                <StackPanel Spacing="16"
                            Padding="16">

                        <!-- Basic Information -->
                        <StackPanel Spacing="8">
                                <TextBlock Text="📋 Basic Information"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Title:"
                                                   Margin="0,0,12,8"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   x:Name="TitleText"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Type:"
                                                   Margin="0,0,12,8"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   x:Name="TypeText"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Created:"
                                                   Margin="0,0,12,8"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   x:Name="CreatedText"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Modified:"
                                                   Margin="0,0,12,8"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   x:Name="ModifiedText"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Description:"
                                                   Margin="0,0,12,8"
                                                   FontWeight="SemiBold"
                                                   Visibility="Collapsed"/>
                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   x:Name="DescriptionText"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                </Grid>
                        </StackPanel>

                        <!-- Login Details -->
                        <StackPanel x:Name="LoginDetailsPanel"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                <TextBlock Text="🔐 Login Details"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <!-- Username -->
                                <StackPanel Style="{StaticResource FormFieldGroupStyle}">
                                        <TextBlock Text="Username/Email:"
                                                   Style="{StaticResource FormLabelStyle}"/>
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <controls:ReadOnlyField Grid.Column="0"
                                                                        x:Name="UsernameText"
                                                                        Visibility="Visible"/>

                                                <Button Grid.Column="1"
                                                        x:Name="CopyUsernameButton"
                                                        Content="📋"
                                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                                        Width="40"
                                                        Height="36"
                                                        Click="CopyUsernameButton_Click"
                                                        ToolTipService.ToolTip="Copy username"/>
                                        </Grid>
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel Style="{StaticResource FormFieldGroupStyle}">
                                        <TextBlock Text="Password:"
                                                   Style="{StaticResource FormLabelStyle}"/>
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <controls:ReadOnlyField Grid.Column="0"
                                                                        x:Name="PasswordText"
                                                                        Visibility="Visible"/>

                                                <Button Grid.Column="1"
                                                        x:Name="TogglePasswordButton"
                                                        Content="👁️"
                                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                                        Width="40"
                                                        Height="36"
                                                        Click="TogglePasswordButton_Click"
                                                        ToolTipService.ToolTip="Show/Hide password"
                                                        Margin="0,0,4,0"/>

                                                <Button Grid.Column="2"
                                                        x:Name="CopyPasswordButton"
                                                        Content="📋"
                                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                                        Width="40"
                                                        Height="36"
                                                        Click="CopyPasswordButton_Click"
                                                        ToolTipService.ToolTip="Copy password"/>
                                        </Grid>
                                </StackPanel>

                                <!-- URL -->
                                <StackPanel Style="{StaticResource FormFieldGroupStyle}">
                                        <TextBlock x:Name="UrlLabel"
                                                   Text="Website URL:"
                                                   Style="{StaticResource FormLabelStyle}"
                                                   Visibility="Collapsed"/>
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <controls:ReadOnlyField Grid.Column="0"
                                                                        x:Name="UrlText"
                                                                        Visibility="Collapsed"/>

                                                <Button Grid.Column="1"
                                                        x:Name="OpenUrlButton"
                                                        Content="🌐"
                                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                                        Width="40"
                                                        Height="36"
                                                        Click="OpenUrlButton_Click"
                                                        ToolTipService.ToolTip="Open website"/>
                                        </Grid>
                                </StackPanel>

                        </StackPanel>

                        <!-- Security Information -->
                        <StackPanel Spacing="8">
                                <TextBlock Text="🛡️ Security Information"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="• This password is encrypted using AES-256 encryption"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Text="• Password revealing requires authentication"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Text="• All clipboard copies are automatically cleared after 60 seconds"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                </StackPanel>
        </ScrollViewer>
        <!-- actions moved to dialog title for a cleaner header layout -->
</ContentDialog>