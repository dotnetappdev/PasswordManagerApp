<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Enhanced Light Theme Color Palette - Professional Style -->
    <Color x:Key="LightModernPrimaryColor">#7C3AED</Color>
    <Color x:Key="LightModernPrimaryLightColor">#A78BFA</Color>
    <Color x:Key="LightModernPrimaryDarkColor">#5B21B6</Color>
    <Color x:Key="LightModernAccentColor">#EC4899</Color>
    <Color x:Key="LightModernAccentLightColor">#F472B6</Color>
    <Color x:Key="LightModernSuccessColor">#10B981</Color>
    <Color x:Key="LightModernWarningColor">#F59E0B</Color>
    <Color x:Key="LightModernErrorColor">#EF4444</Color>

    <!-- Enhanced Light Background Colors - Professional Style -->
    <Color x:Key="LightModernBackgroundColor">#F8FAFC</Color>
    <Color x:Key="LightModernSurfaceColor">#FFFFFF</Color>
    <Color x:Key="LightModernCardColor">#FFFFFF</Color>
    <Color x:Key="LightModernElevatedSurfaceColor">#FFFFFF</Color>
    <Color x:Key="LightModernBorderColor">#E5E7EB</Color>
    <Color x:Key="LightModernFormBackgroundColor">#F6F8FA</Color>

    <!-- Sidebar specific colors -->
    <Color x:Key="LightModernSidebarBackgroundColor">#F8FAFC</Color>

        <!-- New item button color (match primary color) -->
        <Color x:Key="LightModernNewItemButtonColor">#7C3AED</Color>

    <!-- Enhanced Light Text Colors -->
    <Color x:Key="LightModernTextPrimaryColor">#1E293B</Color>
    <Color x:Key="LightModernTextSecondaryColor">#64748B</Color>
    <Color x:Key="LightModernTextTertiaryColor">#94A3B8</Color>

    <!-- Light Theme Brushes -->
    <SolidColorBrush x:Key="LightModernPrimaryBrush"
            Color="{StaticResource LightModernPrimaryColor}"/>
    <SolidColorBrush x:Key="LightModernPrimaryLightBrush"
            Color="{StaticResource LightModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="LightModernPrimaryDarkBrush"
            Color="{StaticResource LightModernPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="LightModernAccentBrush"
            Color="{StaticResource LightModernAccentColor}"/>
    <SolidColorBrush x:Key="LightModernAccentLightBrush"
            Color="{StaticResource LightModernAccentLightColor}"/>
    <SolidColorBrush x:Key="LightModernSuccessBrush"
            Color="{StaticResource LightModernSuccessColor}"/>
    <SolidColorBrush x:Key="LightModernWarningBrush"
            Color="{StaticResource LightModernWarningColor}"/>
    <SolidColorBrush x:Key="LightModernErrorBrush"
            Color="{StaticResource LightModernErrorColor}"/>

    <SolidColorBrush x:Key="LightModernBackgroundBrush"
            Color="{StaticResource LightModernBackgroundColor}"/>
    <SolidColorBrush x:Key="LightModernSurfaceBrush"
            Color="{StaticResource LightModernSurfaceColor}"/>
    <SolidColorBrush x:Key="LightModernCardBrush"
            Color="{StaticResource LightModernCardColor}"/>
    <SolidColorBrush x:Key="LightModernElevatedSurfaceBrush"
            Color="{StaticResource LightModernElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="LightModernBorderBrush"
            Color="{StaticResource LightModernBorderColor}"/>
    <SolidColorBrush x:Key="LightModernFormBackgroundBrush"
            Color="{StaticResource LightModernFormBackgroundColor}"/>

    <!-- New sidebar and button brushes -->
    <SolidColorBrush x:Key="LightModernSidebarBackgroundBrush"
            Color="{StaticResource LightModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="LightModernNewItemButtonBrush"
            Color="{StaticResource LightModernNewItemButtonColor}"/>

    <!-- Button state brushes (light theme) -->
    <SolidColorBrush x:Key="LightModernButtonPointerOverBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="LightModernButtonPressedBrush" Color="#DDD6FE" />

    <SolidColorBrush x:Key="LightModernTextPrimaryBrush"
            Color="{StaticResource LightModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="LightModernTextSecondaryBrush"
            Color="{StaticResource LightModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="LightModernTextTertiaryBrush"
            Color="{StaticResource LightModernTextTertiaryColor}"/>

    <!-- Missing ModernSecondaryBrush -->
    <SolidColorBrush x:Key="LightModernSecondaryBrush"
            Color="{StaticResource LightModernTextSecondaryColor}"/>

    <!-- NavigationView Pane Background Brushes (WinUI 3 theme resource overrides) -->
    <SolidColorBrush x:Key="LightNavigationViewDefaultPaneBackground"
            Color="{StaticResource LightModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="LightNavigationViewExpandedPaneBackground"
            Color="{StaticResource LightModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="LightNavigationViewTopPaneBackground"
            Color="{StaticResource LightModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="LightNavigationViewContentBackground"
            Color="{StaticResource LightModernBackgroundColor}"/>
    <SolidColorBrush x:Key="LightNavigationViewContentGridBackground"
            Color="{StaticResource LightModernBackgroundColor}"/>

    <!-- Light Theme Gradients -->
    <LinearGradientBrush x:Key="LightModernPrimaryGradientBrush"
            StartPoint="0,0"
            EndPoint="1,1">
        <GradientStop Color="{StaticResource LightModernPrimaryColor}"
                Offset="0"/>
        <GradientStop Color="{StaticResource LightModernPrimaryLightColor}"
                Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LightModernAccentGradientBrush"
            StartPoint="0,0"
            EndPoint="1,1">
        <GradientStop Color="{StaticResource LightModernAccentColor}"
                Offset="0"/>
        <GradientStop Color="{StaticResource LightModernAccentLightColor}"
                Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LightModernCardGradientBrush"
            StartPoint="0,0"
            EndPoint="0,1">
        <GradientStop Color="{StaticResource LightModernCardColor}"
                Offset="0"/>
        <GradientStop Color="{StaticResource LightModernSurfaceColor}"
                Offset="1"/>
    </LinearGradientBrush>

    <!-- Light Theme Default Styles -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LightModernPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource LightModernSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LightModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LightModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource LightModernSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LightModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LightModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource LightModernSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LightModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LightModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- Light Theme Navigation Styles -->
    <Style x:Key="LightModernNavigationViewStyle"
            TargetType="NavigationView">
        <Setter Property="Background"
                Value="{StaticResource LightModernSurfaceBrush}"/>
        <Setter Property="IsPaneToggleButtonVisible"
                Value="True"/>
        <Setter Property="IsBackButtonVisible"
                Value="Collapsed"/>
        <Setter Property="OpenPaneLength"
                Value="320"/>
        <Setter Property="CompactModeThresholdWidth"
                Value="640"/>
        <Setter Property="ExpandedModeThresholdWidth"
                Value="1028"/>
        <Setter Property="PaneDisplayMode"
                Value="LeftMinimal"/>
    </Style>

    <!-- Light Theme NavigationViewItem Style -->
    <Style x:Key="LightModernNavigationViewItemStyle"
           TargetType="NavigationViewItem">
        <Setter Property="Foreground" Value="{StaticResource LightModernTextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItem">
                    <Border x:Name="LayoutRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{TemplateBinding Margin}">
                        <Grid>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource LightModernPrimaryBrush}"
                                    CornerRadius="0,2,2,0"
                                    Opacity="0"/>
                            
                            <Grid x:Name="ContentGrid"
                                  Margin="16,8,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon -->
                                <ContentPresenter x:Name="Icon"
                                                Grid.Column="0"
                                                Content="{TemplateBinding Icon}"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"/>
                                
                                <!-- Content -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                Grid.Column="1"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"/>
                                
                                <!-- Expand/Collapse Chevron -->
                                <FontIcon x:Name="ExpandCollapseChevron"
                                        Grid.Column="2"
                                        FontSize="12"
                                        Glyph="&#xE76C;"
                                        Foreground="{StaticResource LightModernTextSecondaryBrush}"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="#F1F5F9"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="#E2E8F0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="#f5f3ff"/>
                                        <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource LightModernPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="#EDE9FE"/>
                                        <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource LightModernPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Light Theme Content Dialog Styles -->
    <Style TargetType="ContentDialog">
        <Setter Property="Background" Value="{StaticResource LightModernSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LightModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LightModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

</ResourceDictionary>
