<?xml version="1.0" encoding="utf-8"?>
<!--
  VaultGuard Vault Guard — WiX v4 MSI
  Build with:
    wix build setup.wxs -ext WixToolset.UI.wixext \
        -d Version=1.0.0 -d PublishDir=..\publish\wpf \
        -o output\VaultGuardSetup-1.0.0.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="VaultGuard Vault Guard"
           Manufacturer="VaultGuard"
           Version="$(var.Version)"
           UpgradeCode="7F2B3A4C-9E5D-4F6B-B8C1-3D0E2A5F7B90"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of VaultGuard is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- WixUI_Advanced adds the standard "Install for all users / Install just for me" page
         (InstallScopeDlg) ahead of the directory picker. Windows Installer elevates msiexec
         itself via UAC when the all-users (perMachine) option is chosen - no extra manifest
         work needed for that; MSI handles it natively. -->
    <ui:WixUI Id="WixUI_Advanced" />

    <Property Id="ApplicationFolderName" Value="Vault Guard" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />

    <!-- .NET runtime check: the app is published framework-dependent (not self-contained - see
         build-wpf.yml), so it needs a matching runtime already on the machine to run at all. This
         only confirms the .NET shared host (dotnet.exe) exists under Program Files, not that the
         specific Microsoft.WindowsDesktop.App 10.x shared framework is present - a precise version/
         component check would need a custom action or a Burn bootstrapper, which this bare MSI
         doesn't have. setup.iss (the EXE installer) does the precise check instead, via the
         dotnet CLI's list-runtimes command; this is a coarser fallback for whoever chooses the MSI. -->
    <Property Id="DOTNETSHAREDHOST" Secure="yes">
      <DirectorySearch Id="ProgramFilesDotnetDir" Path="[ProgramFiles64Folder]dotnet">
        <FileSearch Id="DotnetExeSearch" Name="dotnet.exe" />
      </DirectorySearch>
    </Property>
    <Launch Condition="Installed OR DOTNETSHAREDHOST"
            Message="Vault Guard requires the .NET 10 Desktop Runtime, which was not found on this computer. Download it from https://dotnet.microsoft.com/download/dotnet/10.0/runtime, install it, then run this setup again." />

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="APPLICATIONFOLDER" Name="Vault Guard" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Component Id="MainExecutable">
        <File Id="MainExe"
              Source="$(var.PublishDir)\VaultGuard.WPF.exe"
              KeyPath="yes">
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Vault Guard"
                    Advertise="no"
                    WorkingDirectory="APPLICATIONFOLDER" />
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Vault Guard"
                    Advertise="no"
                    WorkingDirectory="APPLICATIONFOLDER" />
        </File>
      </Component>
      <!-- WiX v4's built-in directory harvesting - was previously one hardcoded Component listing
           only VaultGuard.WPF.dll, so the self-contained publish output's several hundred other
           files (the entire bundled .NET runtime, every dependency DLL, resources) never made it
           into the MSI at all. That's why the MSI was ~684KB against the EXE installer's ~66MB for
           the exact same PublishDir - the app installed by the MSI was missing almost everything it
           needs to run. Excludes the exe above (already its own Component, carrying the shortcuts). -->
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\VaultGuard.WPF.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="VaultGuard" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

  </Package>
</Wix>
