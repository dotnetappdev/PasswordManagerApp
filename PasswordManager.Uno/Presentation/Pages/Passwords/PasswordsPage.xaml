<Page x:Class="PasswordManager.Mobile.Presentation.Pages.Passwords.PasswordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PasswordManager.Mobile.Presentation.Pages.Passwords"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,24,16,16" Background="{ThemeResource SystemControlAcrylicElementBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Passwords" 
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding PasswordItems.Count}"/>
                    <Run Text=" passwords"/>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertBoolConverter}}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Sync with server">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" FontSize="16"/>
                    <TextBlock Text="Sync"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" 
                Padding="16,8" 
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="Search passwords..."
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="{ThemeResource ControlFillColorDefaultBrush}"
                         CornerRadius="8">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextBoxBackgroundFocused" Color="{ThemeResource ControlFillColorSecondary}"/>
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Column="1"
                        Content="&#xE721;"
                        FontFamily="Segoe MDL2 Assets"
                        Command="{Binding SearchCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="40"
                        Width="40"
                        CornerRadius="20"/>
            </Grid>
        </Border>

        <!-- Status Message -->
        <Border Grid.Row="2"
                Background="{ThemeResource SystemControlAcrylicElementBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1"
                Padding="16,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Border>

        <!-- Password List -->
        <ListView Grid.Row="3"
                  ItemsSource="{Binding PasswordItems}"
                  SelectionMode="None"
                  Padding="8,8,8,80">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <SwipeControl>
                        <SwipeControl.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Delete"
                                           Background="Red"
                                           Foreground="White"
                                           Command="{Binding DataContext.DeleteItemCommand, ElementName=PasswordsPageRoot}"
                                           CommandParameter="{Binding}">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE74D;"/>
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeControl.RightItems>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="8,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                        Width="40" Height="40"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="20"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Title, Converter={StaticResource FirstCharConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Title and Website -->
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                    <TextBlock Text="{Binding Website}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Visibility="{Binding Website, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Favorite Button -->
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=PasswordsPageRoot}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8"
                                        VerticalAlignment="Top">
                                    <FontIcon Glyph="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                              FontSize="16"
                                              Foreground="{Binding IsFavorite, Converter={StaticResource BoolToStarColorConverter}}"/>
                                </Button>

                                <!-- Username -->
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Username}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Visibility="{Binding Username, Converter={StaticResource NullToVisibilityConverter}}"
                                           Margin="0,4,0,0"/>

                                <!-- Last Modified -->
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Margin="0,8,0,0">
                                    <Run Text="Modified:"/>
                                    <Run Text="{Binding LastModified, Converter={StaticResource DateTimeToRelativeConverter}}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </SwipeControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Floating Action Button -->
        <Button Grid.Row="3"
                Content="&#xE710;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="20"
                Style="{StaticResource AccentButtonStyle}"
                CornerRadius="28"
                Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                ToolTipService.ToolTip="Add new password">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
        </Button>

        <!-- Loading Overlay -->
        <Border Grid.Row="3"
                Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="True" 
                              Width="60" 
                              Height="60"/>
                <TextBlock Text="Loading passwords..."
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
