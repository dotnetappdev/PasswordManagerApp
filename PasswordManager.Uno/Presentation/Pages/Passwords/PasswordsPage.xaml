<Page x:Class="PasswordManager.Mobile.Presentation.Pages.Passwords.PasswordsPage"
      x:Name="PasswordsPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PasswordManager.Mobile.Presentation.Pages.Passwords"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header - 1Password style -->
        <Grid Grid.Row="0" Padding="20,32,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="All Items" 
                           FontSize="32"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBlock FontSize="15"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding PasswordItems.Count}"/>
                    <Run Text=" passwords •"/>
                    <Run Text=" Last synced "/>
                    <Run Text="{Binding LastSyncTime, Converter={StaticResource DateTimeToRelativeConverter}}"/>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertBoolConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="44"
                    Height="44"
                    Padding="0"
                    ToolTipService.ToolTip="Sync with server">
                <FontIcon Glyph="&#xE895;" FontSize="18"/>
            </Button>
        </Grid>

        <!-- Search Bar - 1Password style -->
        <Border Grid.Row="1" 
                Padding="20,0,20,16">
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE721;"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="16,0,12,0"
                          VerticalAlignment="Center"/>

                <TextBox Grid.Column="1"
                         PlaceholderText="Search passwords, websites, or usernames..."
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Center"
                         FontSize="15"/>

                <Button Grid.Column="2"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="44"
                        Height="44"
                        Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}}"
                        Command="{Binding ClearSearchCommand}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Status Message - 1Password style -->
        <Border Grid.Row="2"
                Background="#E6F2FF"
                BorderBrush="#0066FF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="20,0,20,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE946;"
                          FontSize="16"
                          Foreground="#0066FF"
                          Margin="0,0,12,0"
                          VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#004FCC"/>
            </Grid>
        </Border>

        <!-- Password List - 1Password card style -->
        <ListView Grid.Row="3"
                  ItemsSource="{Binding PasswordItems}"
                  SelectionMode="None"
                  Padding="20,0,20,100"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,12"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <SwipeControl>
                        <SwipeControl.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Delete"
                                           Background="#E85C5C"
                                           Foreground="White"
                                           Command="{Binding DataContext.DeleteItemCommand, ElementName=PasswordsPageRoot}"
                                           CommandParameter="{Binding}">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE74D;"/>
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeControl.RightItems>

                        <!-- Card with 1Password styling -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon - 1Password style -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                        Width="48" Height="48"
                                        Background="#E6F2FF"
                                        CornerRadius="12"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Title, Converter={StaticResource FirstCharConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#0066FF"/>
                                </Border>

                                <!-- Title and Website -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                    <TextBlock Text="{Binding Website}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Visibility="{Binding Website, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Favorite Button -->
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=PasswordsPageRoot}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        VerticalAlignment="Top">
                                    <FontIcon Glyph="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                              FontSize="18"
                                              Foreground="{Binding IsFavorite, Converter={StaticResource BoolToStarColorConverter}}"/>
                                </Button>

                                <!-- Username and timestamp -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                            Spacing="6"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Visibility="{Binding Username, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                        <Run Text="Modified "/>
                                        <Run Text="{Binding LastModified, Converter={StaticResource DateTimeToRelativeConverter}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </SwipeControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Floating Action Button - 1Password style -->
        <Button Grid.Row="3"
                Content="&#xE710;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="22"
                Background="#0066FF"
                Foreground="White"
                BorderThickness="0"
                CornerRadius="28"
                Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                ToolTipService.ToolTip="Add new password">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
        </Button>

        <!-- Loading Overlay - 1Password style -->
        <Border Grid.Row="3"
                Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">
                <Border Width="80" Height="80"
                        Background="#0066FF"
                        CornerRadius="20"
                        HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" 
                                  Width="40" 
                                  Height="40"
                                  Foreground="White"/>
                </Border>
                <TextBlock Text="Loading passwords..."
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Please wait while we fetch your data"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
