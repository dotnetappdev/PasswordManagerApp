<Page x:Class="PasswordManager.Mobile.Presentation.Pages.Login.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PasswordManager.Mobile.Presentation.Pages.Login"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" 
                        MaxWidth="400" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">

                <!-- Logo/Header -->
                <TextBlock Text="🔐" 
                           FontSize="72" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Password Manager"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Secure your digital life"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,32"/>

                <!-- Error Message -->
                <Border Background="{ThemeResource ErrorBackgroundColor}"
                        BorderBrush="{ThemeResource ErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{ThemeResource ErrorTextColor}"
                                   TextWrapping="Wrap"/>
                        <Button Grid.Column="1"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Command="{Binding ClearErrorCommand}"
                                Background="Transparent"
                                BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Email Field -->
                <TextBox PlaceholderText="Email"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         InputScope="EmailSmtpAddress"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                    <TextBox.Header>
                        <TextBlock Text="Email" FontWeight="SemiBold"/>
                    </TextBox.Header>
                </TextBox>

                <!-- Password Field -->
                <PasswordBox PlaceholderText="Password"
                             Password="{Binding Password, Mode=TwoWay}"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                    <PasswordBox.Header>
                        <TextBlock Text="Password" FontWeight="SemiBold"/>
                    </PasswordBox.Header>
                </PasswordBox>

                <!-- Biometric Login Option -->
                <CheckBox Content="{Binding BiometricType, StringFormat='Enable {} login'}"
                          IsChecked="{Binding EnableBiometricLogin, Mode=TwoWay}"
                          Visibility="{Binding ShowBiometricOption, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,8,0,0">
                    <CheckBox.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE1C0;" FontSize="16"/>
                                <TextBlock>
                                    <Run Text="Enable "/>
                                    <Run Text="{Binding BiometricType}"/>
                                    <Run Text=" login"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </CheckBox.ContentTemplate>
                </CheckBox>

                <!-- Biometric Quick Login Button -->
                <Button Command="{Binding TryBiometricLoginCommand}"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding ShowBiometricOption, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="48"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE1C0;" FontSize="20"/>
                        <TextBlock>
                            <Run Text="Sign in with "/>
                            <Run Text="{Binding BiometricType}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </PasswordBox>

                <!-- Login Button -->
                <Button Content="Sign In"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                        Height="48"
                        Margin="0,16,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <ContentPresenter />
                                        <ProgressRing Width="20" 
                                                      Height="20" 
                                                      IsActive="{Binding IsLoading}"
                                                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Additional Info -->
                <TextBlock Text="New to Password Manager?"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,4"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <HyperlinkButton Content="Create an account"
                                 HorizontalAlignment="Center"/>

                <HyperlinkButton Content="Forgot password?"
                                 HorizontalAlignment="Center"
                                 Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Grid.Row="0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="True" 
                              Width="60" 
                              Height="60"/>
                <TextBlock Text="Signing in..."
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
