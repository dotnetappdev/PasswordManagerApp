@page "/login"
@using System.Linq
@using System.Text.Json
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using VaultGuard.Crypto.Interfaces
@using VaultGuard.Services.Interfaces
@using VaultGuard.Models.DTOs.Auth
@using VaultGuard.Components.Shared.Services
@using VaultGuard.Services.Security
@using MudBlazor
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject IUserProfileService UserProfileService
@inject IVaultSessionService VaultSessionService
@inject IMasterKeyCacheService MasterKeyCache
@inject ISnackbar Snackbar
@inject IServiceProvider Services
@inject HttpClient Http

<div class="auth-container">
    <div class="auth-card @(!isFirstTime && !show2fa && _selectedProfile == null && _profiles.Count > 0 ? "auth-card--wide" : "")">
        <div class="auth-header">
            <div class="auth-logo">
                <span class="logo-icon">🔐</span>
                <h1>Vault Guard</h1>
            </div>
            <p class="auth-subtitle">@GetSubtitle()</p>
        </div>

        <div class="auth-form">
            @if (isFirstTime)
            {
                <!-- Setup Master Key -->
                <div class="form-section">
                    <h2>Create Master Key</h2>
                    <p class="form-description">Create a strong master key to protect your vault. This key cannot be recovered, so make sure to remember it.</p>
                    
                    <div class="form-group">
                        <label for="masterKey">Master Key</label>
                        <div class="password-input-group">
                            <input type="@(showPassword ? "text" : "password")" 
                                   id="masterKey" 
                                   @bind="masterKey" 
                                   @onkeyup="ValidatePassword"
                                   @oninput="OnMasterKeyInput"
                                   placeholder="Enter your master key"
                                   class="form-input @(masterKeyError ? "input-error" : "")" />
                            <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                                @(showPassword ? "👁️‍🗨️" : "👁️")
                            </button>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(masterKey))
                        {
                            <div class="password-strength">
                                <div class="strength-bar">
                                    <div class="strength-fill strength-@passwordStrength.ToLower()" style="width: @GetStrengthPercentage()%"></div>
                                </div>
                                <span class="strength-text">Password strength: @passwordStrength</span>
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <label for="confirmKey">Confirm Master Key</label>
                        <input type="@(showConfirmPassword ? "text" : "password")" 
                               id="confirmKey" 
                               @bind="confirmKey"
                               @oninput="OnConfirmKeyInput" 
                               placeholder="Confirm your master key"
                               class="form-input @(confirmKeyError ? "input-error" : "")" />
                        <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                            @(showConfirmPassword ? "👁️‍🗨️" : "👁️")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(confirmKey) && masterKey != confirmKey)
                    {
                        <div class="error-message">
                            Master keys do not match.
                        </div>
                    }

                    <div class="form-group">
                        <label for="hint">Master Key Hint (Optional)</label>
                        <input type="text" 
                               id="hint" 
                               @bind="masterKeyHint" 
                               placeholder="Enter a hint to help you remember"
                               class="form-input" />
                        <small class="form-help">This hint will be shown if you forget your master key.</small>
                    </div>

                    <button type="button" 
                            class="auth-button" 
                            @onclick="SetupMasterKey"
                            disabled="@(!CanSetupMasterKey())">
                        Create Master Key
                    </button>
                    <button type="button" class="auth-button auth-button-outline" @onclick="RegisterPasskey">
                        <span class="btn-emoji">🔑</span> Register Passkey (Biometric)
                    </button>
                </div>
            }
            else
            {
                <!-- Login with Master Key (or 2FA code once the master password is accepted) -->
                <div class="form-section">
                    @if (show2fa)
                    {
                        <h2>Two-factor authentication</h2>
                        <p class="form-description">Enter the 6-digit code from your authenticator app.</p>

                        <div class="form-group">
                            <label for="twoFactorCode">Authentication code</label>
                            <input type="text"
                                   id="twoFactorCode"
                                   @bind="twoFactorCode"
                                   @bind:event="oninput"
                                   @onkeypress="HandleTwoFactorKeyPress"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="8"
                                   placeholder="123456"
                                   class="form-input @(twoFactorError ? "input-error" : "")" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="error-message">@errorMessage</div>
                        }

                        <button type="button" class="auth-button" @onclick="VerifyTwoFactor"
                                disabled="@(string.IsNullOrWhiteSpace(twoFactorCode) || _verifying2fa)">
                            @if (_verifying2fa)
                            {
                                <span class="loading-spinner">⟳</span>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify</span>
                            }
                        </button>

                        <div class="auth-footer">
                            <button type="button" class="link-button" @onclick="CancelTwoFactor">Back to sign in</button>
                        </div>
                    }
                    else if (_selectedProfile == null && _profiles.Count > 0)
                    {
                        <!-- Account picker (mirrors the WPF desktop "Who's unlocking?" screen) -->
                        <h2>Who's unlocking?</h2>
                        <p class="form-description">Choose a profile to continue.</p>

                        <div class="profile-grid">
                            @foreach (var profile in _profiles)
                            {
                                var capturedProfile = profile;
                                <div class="profile-tile" @onclick="() => SelectProfile(capturedProfile)">
                                    <div class="profile-avatar" style="background:@GetAvatarColor(profile)">@GetInitials(profile)</div>
                                    <div class="profile-name">@GetDisplayName(profile)</div>
                                    <div class="profile-email">@profile.Email</div>
                                </div>
                            }
                        </div>

                        <div class="auth-footer">
                            <button type="button" class="link-button" @onclick="GenerateDefaultAccounts" disabled="@isSeeding">
                                @(isSeeding ? "Creating default accounts…" : "Create default accounts")
                            </button>
                        </div>
                    }
                    else
                    {
                        <h2>Sign in to Vault Guard</h2>
                        @if (_selectedProfile != null)
                        {
                            <div class="selected-profile-chip">
                                <div class="profile-avatar profile-avatar--small" style="background:@GetAvatarColor(_selectedProfile)">@GetInitials(_selectedProfile)</div>
                                <span>@GetDisplayName(_selectedProfile)</span>
                            </div>
                        }
                        <p class="form-description">Enter your master password to unlock your vault.</p>

                        <div class="form-group">
                            <label for="loginKey">Account password</label>
                            <div class="password-input-group">
                                <input type="@(showPassword ? "text" : "password")"
                                       id="loginKey"
                                       @bind="loginKey"
                                       @oninput="OnLoginKeyInput"
                                       @onkeypress="HandleKeyPress"
                                       placeholder="Enter your account password"
                                       class="form-input @(loginKeyError ? "input-error" : "")" />
                                <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                                    @(showPassword ? "👁️" : "👁️")
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(storedHint))
                        {
                            <div class="hint-section">
                                <details>
                                    <summary>Show hint</summary>
                                    <p class="hint-text">@storedHint</p>
                                </details>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="error-message">
                                @errorMessage
                            </div>
                        }

                        <button type="button"
                                class="auth-button"
                                @onclick="AuthenticateUser"
                                disabled="@(string.IsNullOrEmpty(loginKey) || isLoading)">
                            @if (isLoading)
                            {
                                <span class="loading-spinner">⟳</span>
                                <span>Unlocking...</span>
                            }
                            else
                            {
                                <span>Continue</span>
                            }
                        </button>
                        <button type="button" class="auth-button auth-button-outline" @onclick="LoginWithPasskey">
                            <span class="btn-emoji">🔑</span> Sign in with Passkey
                        </button>
                        <button type="button" class="auth-button auth-button-success" @onclick="ShowQrLogin">
                            <span class="btn-emoji">📱</span> Sign in with QR Code
                        </button>
                        <button type="button" class="auth-button auth-button-outline" @onclick="ShowQrScanner">
                            <span class="btn-emoji">📷</span> Scan to sign in
                        </button>

                        <div class="auth-footer">
                            @if (_profiles.Count > 0)
                            {
                                <button type="button" class="link-button" @onclick="SwitchAccount">
                                    ← Switch account
                                </button>
                            }
                            <button type="button" class="link-button" @onclick="ResetVault">
                                Forgot your password?
                            </button>
                            <button type="button" class="link-button" @onclick="GenerateDefaultAccounts" disabled="@isSeeding">
                                @(isSeeding ? "Creating default accounts…" : "Create default accounts")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- QR Login Modal -->
@if (showQrLogin)
{
    <div class="modal-overlay" @onclick="CloseQrLogin">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Sign in from your phone</h3>
                <button type="button" class="modal-close" @onclick="CloseQrLogin">×</button>
            </div>
            <div class="modal-body">
                <QrHandoffDisplay OnUnlock="OnQrHandoffUnlock" />
            </div>
        </div>
    </div>
}

<!-- Scan-to-sign-in Modal (camera; mirrors the WPF "Scan to sign in" flow) -->
@if (showQrScanner)
{
    <div class="modal-overlay" @onclick="CloseQrScanner">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Scan to sign in</h3>
                <button type="button" class="modal-close" @onclick="CloseQrScanner">×</button>
            </div>
            <div class="modal-body">
                <QrScanner OnScanned="OnQrScanned" OnError="OnQrScanError" />
            </div>
        </div>
    </div>
}

@code {
    private bool isFirstTime = false;
    private bool isSeeding = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool isLoading = false;
    private string masterKey = string.Empty;
    private string confirmKey = string.Empty;
    private string loginKey = string.Empty;
    private string masterKeyHint = string.Empty;
    private string storedHint = string.Empty;
    private string errorMessage = string.Empty;

    // ── Account picker (mirrors the WPF desktop "Who's unlocking?" screen) ──
    private List<UserDto> _profiles = new();
    private UserDto? _selectedProfile;

    // Fixed hash-based palette — same values WPF uses, so the same profile gets the same colour
    // in both apps.
    private static readonly string[] AvatarPalette =
    {
        "#7C3AED", "#EC4899", "#0284C7", "#059669",
        "#D97706", "#DC2626", "#0891B2", "#2563EB",
    };

    private async Task LoadProfilesAsync()
    {
        try
        {
            var users = await UserProfileService.GetAllUsersAsync();
            _profiles = users.Where(u => u.IsActive).ToList();
        }
        catch (System.Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Warning("Failed to load account profiles", ex);
            _profiles = new();
        }
    }

    private void SelectProfile(UserDto profile)
    {
        _selectedProfile = profile;
        loginKey = string.Empty;
        loginKeyError = false;
        errorMessage = string.Empty;
    }

    private void SwitchAccount()
    {
        _selectedProfile = null;
        loginKey = string.Empty;
        loginKeyError = false;
        errorMessage = string.Empty;
    }

    private static string GetDisplayName(UserDto profile)
    {
        var name = $"{profile.FirstName} {profile.LastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? profile.Email : name;
    }

    private static string GetInitials(UserDto profile)
    {
        var first = profile.FirstName;
        var last = profile.LastName;
        var a = !string.IsNullOrEmpty(first) ? first[0].ToString().ToUpperInvariant() : "";
        var b = !string.IsNullOrEmpty(last) ? last[0].ToString().ToUpperInvariant() : "";
        var initials = a + b;
        if (!string.IsNullOrEmpty(initials)) return initials;
        return !string.IsNullOrEmpty(profile.Email) ? profile.Email[0].ToString().ToUpperInvariant() : "?";
    }

    private static string GetAvatarColor(UserDto profile)
    {
        var key = !string.IsNullOrEmpty(profile.FirstName) ? profile.FirstName : profile.Email;
        var idx = !string.IsNullOrEmpty(key)
            ? Math.Abs(key.GetHashCode(StringComparison.Ordinal)) % AvatarPalette.Length
            : 0;
        return AvatarPalette[idx];
    }

    // Creates the standard default accounts (admin/parent/user/child) + "Personal" vault on demand,
    // the same across every database provider. Resolved optionally so hosts that don't register a
    // seeder (e.g. mobile) simply show a friendly message instead of failing.
    private async Task GenerateDefaultAccounts()
    {
        if (Services.GetService(typeof(IDefaultAccountSeeder)) is not IDefaultAccountSeeder seeder)
        {
            Snackbar.Add("Creating default accounts isn't available in this app.", Severity.Info);
            return;
        }
        isSeeding = true;
        try
        {
            var result = await seeder.SeedAsync();
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
            if (result.Success)
            {
                await LoadProfilesAsync();
            }
        }
        finally { isSeeding = false; }
    }
    private string passwordStrength = "Weak";
    private string passkeyId = string.Empty;
    private bool showQrLogin = false;
    
    // Error state tracking for visual feedback
    private bool masterKeyError = false;
    private bool confirmKeyError = false;
    private bool loginKeyError = false;

    protected override async Task OnInitializedAsync()
    {
        // Check if this is first time setup
        isFirstTime = await AuthService.IsFirstTimeSetupAsync();

        if (!isFirstTime)
        {
            storedHint = await AuthService.GetMasterPasswordHintAsync();
            await LoadProfilesAsync();
        }
    }

    private string GetSubtitle()
    {
        return isFirstTime 
            ? "Welcome! Let's set up your secure vault with a master key."
            : "Welcome back! Please enter your master key to continue.";
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private void ValidatePassword()
    {
        if (string.IsNullOrEmpty(masterKey))
        {
            passwordStrength = "Weak";
            return;
        }

        var score = CalculatePasswordStrength(masterKey);
        passwordStrength = score switch
        {
            >= 4 => "Very Strong",
            3 => "Strong",
            2 => "Medium",
            1 => "Weak",
            _ => "Very Weak"
        };
    }

    private int CalculatePasswordStrength(string password)
    {
        var score = 0;
        if (password.Length >= 8) score++;
        if (password.Any(char.IsUpper)) score++;
        if (password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit)) score++;
        if (password.Any(ch => !char.IsLetterOrDigit(ch))) score++;
        return score;
    }

    private int GetStrengthPercentage()
    {
        return passwordStrength switch
        {
            "Very Strong" => 100,
            "Strong" => 80,
            "Medium" => 60,
            "Weak" => 40,
            _ => 20
        };
    }

    private bool CanSetupMasterKey()
    {
        if (string.IsNullOrEmpty(masterKey) || string.IsNullOrEmpty(confirmKey))
            return false;
            
        if (masterKey != confirmKey)
            return false;
            
        if (masterKey.Length < 8)
            return false;

        // Check for required complexity
        if (!masterKey.Any(char.IsUpper) || !masterKey.Any(char.IsLower) || !masterKey.Any(char.IsDigit))
            return false;

        return true;
    }
    
    private void OnMasterKeyInput()
    {
        // Clear error state when user starts typing
        masterKeyError = false;
    }
    
    private void OnConfirmKeyInput()
    {
        // Clear error state when user starts typing
        confirmKeyError = false;
    }
    
    private void OnLoginKeyInput()
    {
        // Clear error state when user starts typing
        loginKeyError = false;
    }

    private async Task SetupMasterKey()
    {
        // Reset error states
        masterKeyError = false;
        confirmKeyError = false;
        
        if (!CanSetupMasterKey())
        {
            // Provide detailed error message with toast notification
            if (string.IsNullOrEmpty(masterKey))
            {
                errorMessage = "Please enter a master key.";
                masterKeyError = true;
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }
            if (masterKey.Length < 8)
            {
                errorMessage = "Master key must be at least 8 characters long.";
                masterKeyError = true;
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }
            if (!masterKey.Any(char.IsUpper))
            {
                errorMessage = "Master key must contain at least one uppercase letter.";
                masterKeyError = true;
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }
            if (!masterKey.Any(char.IsLower))
            {
                errorMessage = "Master key must contain at least one lowercase letter.";
                masterKeyError = true;
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }
            if (!masterKey.Any(char.IsDigit))
            {
                errorMessage = "Master key must contain at least one number.";
                masterKeyError = true;
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }
            if (masterKey != confirmKey)
            {
                errorMessage = "Master keys do not match.";
                masterKeyError = true;
                confirmKeyError = true;
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            
            // Setup master password using enhanced crypto service
            var success = await AuthService.SetupMasterPasswordAsync(masterKey, masterKeyHint);
            
            if (success)
            {
                Snackbar.Add("Master key created successfully!", Severity.Success);
                // Navigate to home page
                Navigation.NavigateTo("/home");
            }
            else
            {
                errorMessage = "Failed to setup master password. Please try again.";
                masterKeyError = true;
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to setup master password. Please try again.";
            masterKeyError = true;
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AuthenticateUser()
    {
        // Reset error state
        loginKeyError = false;
        
        if (string.IsNullOrEmpty(loginKey))
        {
            errorMessage = "Please enter your password.";
            loginKeyError = true;
            Snackbar.Add(errorMessage, Severity.Warning);
            return;
        }

        if (loginKey.Length < 2)
        {
            errorMessage = "Password must be at least 2 characters long.";
            loginKeyError = true;
            Snackbar.Add(errorMessage, Severity.Warning);
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            // When a profile was picked, authenticate as that specific account; otherwise fall back
            // to the original single-account flow (e.g. no profiles were found to pick from).
            var success = _selectedProfile != null
                ? await AuthService.LoginAsync(_selectedProfile.Email, loginKey)
                : await AuthService.AuthenticateAsync(loginKey);

            if (success)
            {
                // If this account has 2FA enabled, collect the authenticator code before completing login.
                // (TwoFactorEnabled is the flag TwoFactorService actually sets on setup — IsTwoFactorEnabled
                // is a separate, unrelated flag used only by the API's SMS-based 2FA controller.)
                if (AuthService.CurrentUser?.TwoFactorEnabled == true)
                {
                    show2fa = true;
                    twoFactorCode = string.Empty;
                    twoFactorError = false;
                    errorMessage = string.Empty;
                }
                else
                {
                    Snackbar.Add("Login successful!", Severity.Success);
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Incorrect master password. Please try again.";
                loginKey = string.Empty;
                loginKeyError = true;
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Authentication failed. Please try again.";
            loginKeyError = true;
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AuthenticateUser();
        }
    }

    // ── Two-factor prompt (shown after the master password is accepted for a 2FA-enabled account) ──
    private bool show2fa;
    private string twoFactorCode = string.Empty;
    private bool twoFactorError;
    private bool _verifying2fa;

    private async Task HandleTwoFactorKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await VerifyTwoFactor();
    }

    private async Task VerifyTwoFactor()
    {
        twoFactorError = false;
        var code = twoFactorCode?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(code))
        {
            twoFactorError = true;
            errorMessage = "Enter your authentication code.";
            return;
        }

        _verifying2fa = true;
        errorMessage = string.Empty;
        try
        {
            var userId = AuthService.CurrentUser?.Id;
            if (Services.GetService(typeof(ITwoFactorService)) is not ITwoFactorService twoFactor || userId is null)
            {
                errorMessage = "Two-factor verification is unavailable.";
                return;
            }

            // Accept a 6-digit authenticator code or an 8+ char backup code.
            var isBackup = code.Length > 6;
            var ok = await twoFactor.VerifyTwoFactorCodeAsync(userId, code, isBackup);
            if (ok)
            {
                Snackbar.Add("Login successful!", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                twoFactorError = true;
                twoFactorCode = string.Empty;
                errorMessage = "Invalid code. Please try again.";
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error("2FA verification failed", ex);
            errorMessage = "Couldn't verify the code. Please try again.";
        }
        finally
        {
            _verifying2fa = false;
        }
    }

    private async Task CancelTwoFactor()
    {
        // Abandon the half-finished sign-in and return to the password prompt.
        show2fa = false;
        twoFactorCode = string.Empty;
        errorMessage = string.Empty;
        loginKey = string.Empty;
        try { await AuthService.LogoutAsync(); } catch { /* best-effort */ }
    }

    private async Task ResetVault()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "Are you sure you want to reset your vault? This will delete all stored data and cannot be undone.");
        
        if (confirmed)
        {
            // Clear all storage
            await JSRuntime.InvokeVoidAsync("localStorage.clear");
            await JSRuntime.InvokeVoidAsync("sessionStorage.clear");
            
            // Reset component state
            isFirstTime = true;
            masterKey = string.Empty;
            confirmKey = string.Empty;
            loginKey = string.Empty;
            masterKeyHint = string.Empty;
            errorMessage = string.Empty;
            
            // Lock vault session
            var sessionId = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "sessionId");
            if (!string.IsNullOrEmpty(sessionId))
            {
                VaultSessionService.LockVault(sessionId);
            }
            
            StateHasChanged();
        }
    }

    // localStorage keys for the device-bound unlock passkey.
    private const string PasskeyCredKey = "vg.passkey.credId";
    private const string PasskeyUserKey = "vg.passkey.userId";

    // Enables passkey (biometric/PIN) unlock for this device. This requires the real master
    // key so the vault key can be cached behind the platform authenticator — a passkey alone
    // cannot decrypt a zero-knowledge vault. Enrolment therefore validates the master key
    // first, then binds a device credential and caches the key for later release.
    private async Task RegisterPasskey()
    {
        errorMessage = string.Empty;

        var keyToUse = !string.IsNullOrEmpty(loginKey) ? loginKey : masterKey;
        if (string.IsNullOrEmpty(keyToUse))
        {
            errorMessage = "Enter your master key first, then enable passkey unlock.";
            Snackbar.Add(errorMessage, Severity.Warning);
            return;
        }

        try
        {
            // Make sure WebAuthn/biometrics are actually available before we enrol.
            var available = await JSRuntime.InvokeAsync<bool>("passkey.isAvailable");
            if (!available)
            {
                errorMessage = "This device has no biometric/passkey authenticator available.";
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }

            // Validate the master key by actually unlocking the vault.
            var unlocked = await AuthService.AuthenticateAsync(keyToUse);
            if (!unlocked)
            {
                errorMessage = "Incorrect master key. Passkey unlock was not enabled.";
                loginKeyError = true;
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            var userId = await AuthService.GetCurrentUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "Could not determine the vault user. Passkey unlock was not enabled.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            // Enrol a platform credential bound to this device (prompts biometric/PIN).
            var credId = await JSRuntime.InvokeAsync<string>(
                "passkey.enroll", AuthService.CurrentUser?.Email ?? "vault-user", "Vault Guard");
            if (string.IsNullOrEmpty(credId))
            {
                errorMessage = "Passkey enrolment was cancelled.";
                return;
            }

            // Cache the master key behind the platform authenticator and remember the binding.
            await MasterKeyCache.CacheAsync(userId, keyToUse);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", PasskeyCredKey, credId);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", PasskeyUserKey, userId);

            Snackbar.Add("Passkey unlock enabled for this device.", Severity.Success);
            Navigation.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error("Passkey enrolment failed", ex);
            errorMessage = "Passkey registration failed. Please try again.";
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }

    // Unlocks the vault with the device passkey. This fails CLOSED: it grants access only when
    // a real platform assertion succeeds for the enrolled credential AND a cached master key is
    // present AND that key actually unlocks the vault. A passkey assertion alone never unlocks.
    private async Task LoginWithPasskey()
    {
        errorMessage = string.Empty;

        try
        {
            var credId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", PasskeyCredKey);
            var userId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", PasskeyUserKey);
            if (string.IsNullOrEmpty(credId) || string.IsNullOrEmpty(userId))
            {
                errorMessage = "No passkey set up on this device. Sign in with your master key, then enable passkey unlock.";
                Snackbar.Add(errorMessage, Severity.Info);
                return;
            }

            // Real platform assertion — triggers the biometric/PIN prompt. Throws if cancelled.
            string assertedId;
            try
            {
                assertedId = await JSRuntime.InvokeAsync<string>("passkey.assert", credId);
            }
            catch (Exception)
            {
                errorMessage = "Passkey verification was cancelled or failed.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            // The authenticator must have asserted the exact credential we enrolled.
            if (!string.Equals(assertedId, credId, StringComparison.Ordinal))
            {
                errorMessage = "Passkey verification failed.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            // Only now release the cached master key and unlock through the normal path.
            var cached = await MasterKeyCache.GetCachedAsync(userId);
            if (string.IsNullOrEmpty(cached))
            {
                errorMessage = "Passkey unlock has expired. Please sign in with your master key.";
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }

            var success = await AuthService.AuthenticateAsync(cached);
            if (success)
            {
                Snackbar.Add("Unlocked with passkey.", Severity.Success);
                Navigation.NavigateTo("/home");
            }
            else
            {
                // The cached key no longer works (master key changed) — drop it and force manual unlock.
                await MasterKeyCache.ForgetAsync(userId);
                errorMessage = "Passkey unlock failed. Please sign in with your master key.";
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error("Passkey unlock failed", ex);
            errorMessage = "Passkey login failed. Please sign in with your master key.";
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focus the password field and animate the logo. These JS helpers may not exist on every host
            // (e.g. the web app), so failures must not tear down the circuit — swallow and continue.
            try
            {
                await JSRuntime.InvokeVoidAsync("focusPasswordField");
                await JSRuntime.InvokeVoidAsync("animateLogo");
            }
            catch (Exception ex)
            {
                VaultGuard.Services.Logging.AppLogger.Warning("Login focus/animate JS unavailable", ex);
            }
        }
    }

    private void ShowQrLogin()
    {
        showQrLogin = true;
    }

    private void CloseQrLogin()
    {
        showQrLogin = false;
    }

    private async Task OnQrAuthenticationComplete(bool success)
    {
        if (success)
        {
            showQrLogin = false;
            // The QrLogin component will handle navigation
        }
    }

    // A phone scanned the QR this device showed and sent back the master password over the end-to-end
    // encrypted hand-off. Run our normal local sign-in with it (derives the master key locally and
    // unlocks this device's own vault) — this is what makes phone→desktop sign-in work in SQLite mode.
    private async Task OnQrHandoffUnlock((string Email, string Password) creds)
    {
        showQrLogin = false;

        if (string.IsNullOrWhiteSpace(creds.Email) || string.IsNullOrEmpty(creds.Password))
        {
            Snackbar.Add("Sign-in from phone failed (missing details).", Severity.Error);
            StateHasChanged();
            return;
        }

        var match = _profiles.FirstOrDefault(p => string.Equals(p.Email, creds.Email, StringComparison.OrdinalIgnoreCase));
        if (match != null) SelectProfile(match);
        loginKey = creds.Password;

        try
        {
            var success = await AuthService.LoginAsync(creds.Email, creds.Password);
            if (success)
            {
                if (AuthService.CurrentUser?.TwoFactorEnabled == true)
                {
                    show2fa = true;
                    twoFactorCode = string.Empty;
                    twoFactorError = false;
                    errorMessage = string.Empty;
                    Snackbar.Add("Enter your authenticator code to finish.", Severity.Info);
                }
                else
                {
                    Snackbar.Add("Signed in from your phone.", Severity.Success);
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                Snackbar.Add("Sign-in from phone failed. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error("QR hand-off unlock failed", ex);
            Snackbar.Add("Sign-in from phone failed.", Severity.Error);
        }

        StateHasChanged();
    }

    // Kept for the API-session variant (desktop runs against a reachable API). Unused by the default
    // hand-off flow above but harmless.
    private async Task OnQrDesktopAuthenticated(AuthResponseDto authData)
    {
        showQrLogin = false;
        var ok = await AuthService.CompleteQrSignInAsync(authData);
        if (ok)
        {
            Snackbar.Add("Signed in from your phone.", Severity.Success);
            Navigation.NavigateTo("/");
        }
        else
        {
            Snackbar.Add("Your phone approved the sign-in, but this device needs your master password to unlock its local vault.", Severity.Warning);
        }
        StateHasChanged();
    }

    private bool showQrScanner = false;

    private void ShowQrScanner()
    {
        showQrScanner = true;
    }

    private void CloseQrScanner()
    {
        showQrScanner = false;
    }

    // Called when the camera scanner decodes a QR. Two payloads are supported:
    //  1. The API cross-device payload ({ token, endpoint, expires }) shown by the WPF/Blazor desktop —
    //     this phone approves it by POSTing the account credentials to the embedded endpoint, which logs
    //     the desktop in (WhatsApp-Web style). The endpoint travels in the QR, so it works in SQLite mode
    //     (the desktop's own local API address is carried in the code).
    //  2. The WPF "VaultGuardQR" pairing payload ({ v, app, email, token }) — pre-select the matching
    //     local profile so the user only needs their master password.
    private async Task OnQrScanned(string text)
    {
        showQrScanner = false;

        // Preferred: end-to-end encrypted hand-off (works in local/SQLite mode; the desktop unlocks its
        // own vault, the server only relays ciphertext).
        if (TryParseHandoffQr(text, out var hToken, out var submitUrl, out var recipientPubKey))
        {
            await SubmitHandoffApprovalAsync(hToken, submitUrl, recipientPubKey);
            return;
        }

        if (TryParseApiQr(text, out var token, out var endpoint))
        {
            await ApproveDesktopLoginAsync(token, endpoint);
            return;
        }

        var email = TryParseVaultGuardQrEmail(text);
        if (!string.IsNullOrWhiteSpace(email))
        {
            var match = _profiles.FirstOrDefault(p =>
                string.Equals(p.Email, email, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                SelectProfile(match);
                Snackbar.Add($"Signing in as {GetDisplayName(match)} — enter your master password.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"No local profile matches {email}. Add the account first, then scan again.", Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add("That QR code isn't a VaultGuard sign-in code.", Severity.Warning);
        }

        StateHasChanged();
    }

    private static bool TryParseApiQr(string text, out string token, out string endpoint)
    {
        token = string.Empty;
        endpoint = string.Empty;
        if (string.IsNullOrWhiteSpace(text) || !text.TrimStart().StartsWith("{")) return false;
        try
        {
            using var doc = JsonDocument.Parse(text);
            var root = doc.RootElement;
            if (root.TryGetProperty("token", out var t) && root.TryGetProperty("endpoint", out var e))
            {
                token = t.GetString() ?? string.Empty;
                endpoint = e.GetString() ?? string.Empty;
                return !string.IsNullOrWhiteSpace(token) && !string.IsNullOrWhiteSpace(endpoint);
            }
        }
        catch (Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Scanned QR was not an API login payload", logEx); }
        return false;
    }

    private static bool TryParseHandoffQr(string text, out string token, out string submitUrl, out string recipientPublicKey)
    {
        token = string.Empty;
        submitUrl = string.Empty;
        recipientPublicKey = string.Empty;
        if (string.IsNullOrWhiteSpace(text) || !text.TrimStart().StartsWith("{")) return false;
        try
        {
            using var doc = JsonDocument.Parse(text);
            var root = doc.RootElement;
            if (!root.TryGetProperty("mode", out var mode) ||
                !string.Equals(mode.GetString(), "handoff", StringComparison.OrdinalIgnoreCase))
                return false;

            if (root.TryGetProperty("token", out var t) &&
                root.TryGetProperty("submit", out var s) &&
                root.TryGetProperty("pub", out var p))
            {
                token = t.GetString() ?? string.Empty;
                submitUrl = s.GetString() ?? string.Empty;
                recipientPublicKey = p.GetString() ?? string.Empty;
                return !string.IsNullOrWhiteSpace(token)
                    && !string.IsNullOrWhiteSpace(submitUrl)
                    && !string.IsNullOrWhiteSpace(recipientPublicKey);
            }
        }
        catch (Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Scanned QR was not a hand-off payload", logEx); }
        return false;
    }

    // Encrypt the account's master password to the desktop's public key (from the QR) and post the
    // ciphertext to the relay. The server never sees the plaintext; the desktop decrypts and unlocks.
    private async Task SubmitHandoffApprovalAsync(string token, string submitUrl, string recipientPublicKey)
    {
        var email = _selectedProfile?.Email ?? (_profiles.Count == 1 ? _profiles[0].Email : null);
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Choose your profile first, then scan to sign in the other device.", Severity.Warning);
            StateHasChanged();
            return;
        }

        if (_selectedProfile == null)
        {
            var m = _profiles.FirstOrDefault(p => string.Equals(p.Email, email, StringComparison.OrdinalIgnoreCase));
            if (m != null) SelectProfile(m);
        }

        if (string.IsNullOrEmpty(loginKey))
        {
            Snackbar.Add("Enter your account password, then scan again to sign in the other device.", Severity.Info);
            StateHasChanged();
            return;
        }

        try
        {
            var payload = QrHandoffCrypto.Encrypt(recipientPublicKey, loginKey);
            var request = new QrHandoffSubmitRequestDto
            {
                Token = token,
                EphemeralPublicKey = payload.EphemeralPublicKey,
                Nonce = payload.Nonce,
                Ciphertext = payload.Ciphertext,
                Email = email
            };

            var response = await Http.PostAsJsonAsync(submitUrl, request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Approved — the other device is unlocking.", Severity.Success);
            }
            else
            {
                VaultGuard.Services.Logging.AppLogger.Warning($"QR hand-off submit failed ({(int)response.StatusCode})");
                Snackbar.Add("Couldn't sign in the other device. The code may have expired — try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error("QR hand-off submit failed", ex);
            Snackbar.Add("Couldn't reach the other device's sign-in service.", Severity.Error);
        }

        StateHasChanged();
    }

    private static string? TryParseVaultGuardQrEmail(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || !text.TrimStart().StartsWith("{")) return null;
        try
        {
            using var doc = JsonDocument.Parse(text);
            var root = doc.RootElement;
            if (root.TryGetProperty("app", out var app) &&
                string.Equals(app.GetString(), "VaultGuardQR", StringComparison.OrdinalIgnoreCase) &&
                root.TryGetProperty("email", out var em))
            {
                return em.GetString();
            }
        }
        catch (Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Scanned QR was not a VaultGuard payload", logEx); }
        return null;
    }

    // Approve a desktop's pending QR login: POST our account credentials to the endpoint carried in the
    // QR. The desktop is polling qr/status and signs in once the server marks the token authenticated.
    private async Task ApproveDesktopLoginAsync(string token, string endpoint)
    {
        var email = _selectedProfile?.Email
            ?? (_profiles.Count == 1 ? _profiles[0].Email : null);

        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Choose your profile first, then scan to approve the other device.", Severity.Warning);
            StateHasChanged();
            return;
        }

        // Make sure the password field is visible for this profile, then require it.
        if (_selectedProfile == null)
        {
            var m = _profiles.FirstOrDefault(p => string.Equals(p.Email, email, StringComparison.OrdinalIgnoreCase));
            if (m != null) SelectProfile(m);
        }

        if (string.IsNullOrEmpty(loginKey))
        {
            Snackbar.Add("Enter your account password, then scan again to approve the sign-in.", Severity.Info);
            StateHasChanged();
            return;
        }

        try
        {
            var request = new QrLoginAuthenticateRequestDto
            {
                Token = token,
                Email = email,
                Password = loginKey,
                DeviceName = "VaultGuard Mobile",
                DeviceType = "Mobile",
                Platform = OperatingSystem.IsAndroid() ? "Android"
                    : OperatingSystem.IsIOS() ? "iOS"
                    : OperatingSystem.IsMacCatalyst() ? "macOS"
                    : "Mobile"
            };

            var response = await Http.PostAsJsonAsync(endpoint, request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Approved — the other device is signing in.", Severity.Success);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                VaultGuard.Services.Logging.AppLogger.Warning($"QR approval failed ({(int)response.StatusCode}): {body}");
                Snackbar.Add("Couldn't approve the sign-in. Check your password and that the code hasn't expired.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error("QR approval request failed", ex);
            Snackbar.Add("Couldn't reach the other device's sign-in service.", Severity.Error);
        }

        StateHasChanged();
    }

    private void OnQrScanError(string message)
    {
        Snackbar.Add(message, Severity.Error);
    }
}
