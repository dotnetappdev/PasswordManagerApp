@page "/password/{id:int}/edit"
@page "/password/new"
@attribute [Authorize]
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using VaultGuard.Services.Interfaces
@using VaultGuard.Services.Utilities
@using VaultGuard.Models
@inject IPasswordItemService PasswordItemService
@inject ICategoryInterface CategoryService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ITagService TagService

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Style="background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary);">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h4">@(IsNewPassword ? "Add New Password" : "Edit Password")</MudText>
            </MudStack>
        </MudPaper>

        <!-- Main Form -->
        <MudPaper Class="pa-4" Style="background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary);">
            <MudForm @ref="form" @bind-IsValid="@formIsValid">
                <MudStack Spacing="3">
                    <!-- Title Field -->
                    <MudTextField @bind-value="passwordItem.Title" Label="Title" Variant="Variant.Outlined"
                        Required="true" Error="titleError" ErrorText="Title is required"
                        Style="background-color: var(--mud-palette-surface);" For="@(() => passwordItem.Title)" />

                    <!-- Username Field -->
                    <MudTextField @bind-value="passwordItem.Username" Label="Username" Variant="Variant.Outlined"
                        Style="background-color: var(--mud-palette-surface);" For="@(() => passwordItem.Username)" />

                    <!-- Password Field with Generator -->
                    <MudStack Row AlignItems="AlignItems.End" Spacing="2">
                        <MudTextField @bind-value="passwordItem.Password" Label="Password" Variant="Variant.Outlined"
                            Required="true" Error="passwordError" ErrorText="Password is required"
                            InputType="@(isPasswordVisible? InputType.Text: InputType.Password)"
                            Style="background-color: var(--mud-palette-surface); flex: 1;" For="@(() => passwordItem.Password)"
                            Adornment="Adornment.End"
                            AdornmentIcon="@(isPasswordVisible? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                            OnAdornmentClick="TogglePasswordVisibility" />
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GeneratePassword"
                            StartIcon="@Icons.Material.Filled.AutoFixHigh">
                            Generate
                        </MudButton>
                    </MudStack>

                    <!-- Website URL Field -->
                    <MudTextField @bind-value="passwordItem.WebsiteUrl" Label="Website URL" Variant="Variant.Outlined"
                        Style="background-color: var(--mud-palette-surface);" For="@(() => passwordItem.WebsiteUrl)" />

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">Brand icon</MudText>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            @if (!string.IsNullOrWhiteSpace(GetBrandIconSource()))
                            {
                                <img src="@GetBrandIconSource()" alt="Brand icon preview"
                                     style="width:32px; height:32px; border-radius:8px; object-fit:contain; background:var(--mud-palette-surface); padding:4px;"
                                     onerror="this.style.display='none'; if(this.nextElementSibling){this.nextElementSibling.style.display='inline-flex';}" />
                                <span style="display:none; align-items:center; justify-content:center; width:32px; height:32px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Medium" />
                                </span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Medium" />
                            }
                            <MudText Typo="Typo.caption">We’ll try the company icon from the website automatically. Upload an image to override it.</MudText>
                        </MudStack>
                        <InputFile OnChange="OnBrandIconSelected" accept="image/*" />
                        @if (HasCustomBrandIcon())
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearBrandIcon">
                                Remove uploaded icon
                            </MudButton>
                        }
                    </MudStack>
 
                    <!-- Notes Field -->
                    <MudTextField @bind-value="passwordItem.Description" Label="Notes" Variant="Variant.Outlined"
                        Lines="3" Style="background-color: var(--mud-palette-surface);" For="@(() => passwordItem.Description)" />

                    <!-- Category Selection -->
                    <MudSelect T="int?" @bind-value="passwordItem.CategoryId" Label="Category"
                        Variant="Variant.Outlined" Style="background-color: var(--mud-palette-surface);">
                        <MudSelectItem Value="@((int?)null)">No Category</MudSelectItem>
                        @foreach (var category in categories)
                        {
                            <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <!-- Tags -->
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">Tags</MudText>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <MudTextField @bind-Value="newTagName" Placeholder="Add tag"
                                Style="flex:1; background-color:var(--mud-palette-surface);" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTag">Add</MudButton>
                        </div>
                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                            @foreach (var t in passwordItem.Tags ?? new List<Tag>())
                            {
                                <MudChip T="Tag" Value="@t" Color="Color.Primary" OnClose="@CreateOnCloseCallback(t)"
                                    CloseIcon="@(Icons.Material.Filled.Close)">
                                    @t.Name
                                </MudChip>
                            }
                        </div>
                    </MudStack>
                </MudStack>
            </MudForm>
        </MudPaper>

        <!-- Password Generator Options -->
        @if (showGeneratorOptions)
        {
            <MudPaper Class="pa-4" Style="background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary);">
                <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary); margin-bottom: 16px;">Password Generator Options</MudText>
                <MudStack Spacing="3">
                    <MudSlider @bind-value="passwordLength" Min="4" Max="64" Step="1" Text="@($"Length: {passwordLength}")"
                        Style="color: var(--mud-palette-text-primary);" />

                    <MudSwitch T="bool" @bind-value="includeUppercase" Color="Color.Primary"
                        Label="Include Uppercase Letters" />

                    <MudSwitch T="bool" @bind-value="includeLowercase" Color="Color.Primary"
                        Label="Include Lowercase Letters" />

                    <MudSwitch T="bool" @bind-value="includeNumbers" Color="Color.Primary" Label="Include Numbers" />

                    <MudSwitch T="bool" @bind-value="includeSymbols" Color="Color.Primary" Label="Include Symbols" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GeneratePassword" FullWidth="true"
                        StartIcon="@Icons.Material.Filled.AutoFixHigh">
                        Generate New Password
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => errorMessage = null)">
                @errorMessage
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => successMessage = null)">
                @successMessage
            </MudAlert>
        }

        <!-- Secondary actions (scroll with the form) -->
        <MudStack Row Spacing="2" Style="flex-wrap: wrap;">
            <MudButton Variant="Variant.Text" Color="Color.Info"
                OnClick="() => showGeneratorOptions = !showGeneratorOptions"
                StartIcon="@Icons.Material.Filled.Settings">
                @(showGeneratorOptions ? "Hide" : "Show") Generator Options
            </MudButton>
            @if (!IsNewPassword)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeletePassword"
                    StartIcon="@Icons.Material.Filled.Delete">
                    Delete
                </MudButton>
            }
        </MudStack>
    </MudStack>

    <!-- Sticky bottom action bar (1Password-style) — always reachable; content scrolls above it -->
    <div class="pw-edit-actionbar">
        <MudStack Row Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Style="flex-wrap: wrap;">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel"
                StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePassword" Disabled="isSaving"
                StartIcon="@Icons.Material.Filled.Save">
                @if (isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ml-2">Saving...</MudText>
                }
                else
                {
                    <MudText>@(IsNewPassword ? "Add Password" : "Save Changes")</MudText>
                }
            </MudButton>
        </MudStack>
    </div>
</MudContainer>

<style>
    /* Pinned action bar that respects the device safe-area (iOS notch / Android nav bar). */
    .pw-edit-actionbar {
        position: sticky;
        bottom: 0;
        z-index: 5;
        margin: 8px -16px 0;
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
        background: color-mix(in srgb, var(--mud-palette-surface) 92%, transparent);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--mud-palette-divider);
    }
</style>

@code {
    [Parameter] public int? Id { get; set; }

    private PasswordItem passwordItem = new();
    private List<Category> categories = new();
    private MudForm? form;
    private bool formIsValid = false;
    private bool isPasswordVisible = false;
    private bool isSaving = false;
    private bool showGeneratorOptions = false;

    // Validation fields
    private bool titleError = false;
    private bool passwordError = false;
    private string? errorMessage = null;
    private string? successMessage = null;

    // Password generator options
    private int passwordLength = 16;
    private bool includeUppercase = true;
    private bool includeLowercase = true;
    private bool includeNumbers = true;
    private bool includeSymbols = true;

    private bool IsNewPassword => Id == null || Id == 0;
    private List<Tag> allTags = new();
    private string? newTagName;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/masterpassword");
            return;
        }

        await LoadCategories();
        await LoadTags();

        if (!IsNewPassword)
        {
            await LoadPassword();
        }
        else
        {
            passwordItem = new PasswordItem
            {
                Type = ItemType.Login,
                LoginItem = new LoginItem(),
                CreatedAt = DateTime.UtcNow,
                LastModified = DateTime.UtcNow
            };
        }
    }

    private async Task LoadTags()
    {
        try
        {
            allTags = (await TagService.GetAllAsync()).ToList();
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading categories: {ex.Message}";
        }
    }

    private async Task LoadPassword()
    {
        try
        {
            if (Id.HasValue)
            {
                passwordItem = await PasswordItemService.GetByIdAsync(Id.Value) ?? new PasswordItem();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading password: {ex.Message}";
        }
    }

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    private void GeneratePassword()
    {
        var chars = "";
        if (includeUppercase) chars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        if (includeLowercase) chars += "abcdefghijklmnopqrstuvwxyz";
        if (includeNumbers) chars += "0123456789";
        if (includeSymbols) chars += "!@#$%^&*()_+-=[]{}|;:,.<>?";

        if (string.IsNullOrEmpty(chars))
        {
            chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        }

        var random = new Random();
        var password = new string(Enumerable.Repeat(chars, passwordLength)
        .Select(s => s[random.Next(s.Length)]).ToArray());

        passwordItem.Password = password;
    }

    private async Task SavePassword()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            // Basic validation
            titleError = string.IsNullOrEmpty(passwordItem.Title);
            passwordError = string.IsNullOrEmpty(passwordItem.Password);

            if (titleError || passwordError)
            {
                errorMessage = "Please fix the validation errors above.";
                return;
            }

            if (form != null)
            {
                await form.Validate();
                if (!formIsValid)
                {
                    return;
                }
            }

            passwordItem.LastModified = DateTime.UtcNow;
            passwordItem.Website = passwordItem.WebsiteUrl;

            if (IsNewPassword)
            {
                await PasswordItemService.CreateAsync(passwordItem);
                successMessage = "Password created successfully!";
            }
            else
            {
                await PasswordItemService.UpdateAsync(passwordItem);
                successMessage = "Password updated successfully!";
            }

            Navigation.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving password: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AddTag()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newTagName)) return;
            // find existing
            var existing = passwordItem.Tags?.FirstOrDefault(t => string.Equals(t.Name, newTagName,
            StringComparison.OrdinalIgnoreCase));
            if (existing == null)
            {
                Tag? tag = null;
                try { tag = await TagService.GetByNameAsync(newTagName!); } catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
                if (tag == null)
                {
                    tag = await TagService.CreateAsync(new Tag { Name = newTagName! });
                }

                passwordItem.Tags ??= new List<Tag>();
                passwordItem.Tags.Add(tag);
                newTagName = null;
            }
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
    }

    private void RemoveTag(Tag tag)
    {
        if (passwordItem.Tags != null && tag != null)
        {
            passwordItem.Tags.Remove(tag);
        }
    }

    private EventCallback<MudChip<Tag>> CreateOnCloseCallback(Tag tag)
    {
        return EventCallback.Factory.Create<MudChip<Tag>>(this, (MudChip<Tag> _) => RemoveTag(tag));
    }

    private string? GetBrandIconSource() => BrandIconHelper.GetBrandIconSource(passwordItem);

    private bool HasCustomBrandIcon() => BrandIconHelper.GetCustomBrandIconDataUrl(passwordItem) != null;

    private async Task OnBrandIconSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null)
            {
                return;
            }

            if (string.IsNullOrWhiteSpace(file.ContentType) || !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Please choose an image file for the brand icon.";
                return;
            }

            await using var stream = file.OpenReadStream(BrandIconHelper.MaxBrandIconBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";
            BrandIconHelper.SetCustomBrandIcon(passwordItem, dataUrl);
            errorMessage = null;
        }
        catch (IOException)
        {
            errorMessage = "Brand icons must be 1 MB or smaller.";
        }
    }

    private void ClearBrandIcon()
    {
        BrandIconHelper.SetCustomBrandIcon(passwordItem, null);
    }

    private void Cancel()
    {
        if (IsNewPassword)
        {
            Navigation.NavigateTo("/vault");
        }
        else
        {
            Navigation.NavigateTo($"/password/{Id}");
        }
    }

    private async Task DeletePassword()
    {
        try
        {
            if (Id.HasValue)
            {
                await PasswordItemService.DeleteAsync(Id.Value);
                Navigation.NavigateTo("/vault");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting password: {ex.Message}";
        }
    }
}