@page "/export"
@using PasswordManager.Models
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using PasswordManager.Services.Interfaces
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ICollectionService CollectionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Export Passwords</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h4" GutterBottom="true">Export Passwords</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Export your passwords to a CSV file for backup or migration purposes.
        </MudText>

        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <strong>Security Warning:</strong> Exported files contain your passwords in plain text. 
            Store them securely and delete them after use.
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="int?" @bind-Value="selectedCollectionId" Label="Collection (Optional)" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var collection in collections)
                    {
                        <MudSelectItem Value="@((int?)collection.Id)">@collection.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Class="mt-1">
                    Leave empty to export all passwords
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="exportFormat" Label="Export Format" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("standard")">Standard CSV</MudSelectItem>
                    <MudSelectItem Value="@("1password")">1Password CSV</MudSelectItem>
                    <MudSelectItem Value="@("bitwarden")">Bitwarden CSV</MudSelectItem>
                    <MudSelectItem Value="@("lastpass")">LastPass CSV</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <MudAlert Severity="@(isSuccess ? Severity.Success : Severity.Error)" Class="mt-4">
                @statusMessage
            </MudAlert>
        }

        <div class="d-flex justify-space-between mt-4">
            <MudButton Variant="Variant.Outlined" 
                       OnClick="@(() => Navigation.NavigateTo("/vault"))">
                Back to Vault
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="@PerformExport"
                       Disabled="@isExporting">
                @(isExporting ? "Exporting..." : "Export Passwords")
            </MudButton>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private List<Collection> collections = new();
    private int? selectedCollectionId = null;
    private string exportFormat = "standard";
    private bool isExporting = false;
    private string statusMessage = string.Empty;
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
    }

    private async Task LoadCollections()
    {
        try
        {
            collections = (await CollectionService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading collections: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task PerformExport()
    {
        try
        {
            isExporting = true;
            statusMessage = string.Empty;
            StateHasChanged();

            var request = new
            {
                CollectionId = selectedCollectionId,
                Format = exportFormat
            };

            var response = await Http.PostAsJsonAsync("/api/importexport/export", request);

            if (response.IsSuccessStatusCode)
            {
                // Download the file
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"passwords_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
                
                // Use JavaScript to download the file
                var base64 = Convert.ToBase64String(fileBytes);
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "text/csv");

                statusMessage = $"Successfully exported passwords to {fileName}";
                isSuccess = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                statusMessage = $"Export failed: {error}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error during export: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}

<script>
    window.downloadFile = function(filename, base64Content, contentType) {
        const byteCharacters = atob(base64Content);
        const byteNumbers = new Array(byteCharacters.length);
        for (let i = 0; i < byteCharacters.length; i++) {
            byteNumbers[i] = byteCharacters.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
    }
</script>
