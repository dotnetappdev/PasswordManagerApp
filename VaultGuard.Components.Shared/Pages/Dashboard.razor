@page "/dashboard"
@using VaultGuard.Services.Interfaces
@using VaultGuard.Models
@inject IPasswordItemService PasswordItemService
@inject IVaultService VaultService
@inject ICategoryInterface CategoryService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudText Typo="Typo.h4" Style="font-weight:700" Class="mb-1">Dashboard</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Your security overview</MudText>

    @if (isLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 4; i++) { <MudItem xs="12" sm="6" md="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" /></MudItem> }
        </MudGrid>
    }
    else
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left:4px solid #7C3AED;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color:#7C3AED;font-size:2rem;" />
                        <div><MudText Typo="Typo.h4" Style="font-weight:700">@totalItems</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Total Items</MudText></div>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left:4px solid #F59E0B;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Style="color:#F59E0B;font-size:2rem;" />
                        <div><MudText Typo="Typo.h4" Style="font-weight:700">@favorites</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Favorites</MudText></div>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left:4px solid #10B981;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color:#10B981;font-size:2rem;" />
                        <div><MudText Typo="Typo.h4" Style="font-weight:700">@vaultCount</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Vaults</MudText></div>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left:4px solid #EC4899;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Style="color:#EC4899;font-size:2rem;" />
                        <div><MudText Typo="Typo.h4" Style="font-weight:700">@categoryCount</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Categories</MudText></div>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600">Recent Items</MudText>
                    @if (recent?.Any() == true)
                    {
                        <MudList T="PasswordItem" Dense="true">
                            @foreach (var item in recent)
                            {
                                <MudListItem T="PasswordItem" OnClick="@(() => Navigation.NavigateTo($"/password/{item.Id}"))">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@GetIcon(item.Type)" Size="Size.Small" Style="@($"color:{GetColor(item.Type)}")" />
                                            <div>
                                                <MudText Typo="Typo.body1" Style="font-weight:500">@item.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.LastModified.ToString("MMM d")</MudText>
                                            </div>
                                        </MudStack>
                                        @if (item.IsFavorite) { <MudIcon Icon="@Icons.Material.Filled.Star" Style="color:#F59E0B;" Size="Size.Small" /> }
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                        <MudButton Href="/vault" Variant="Variant.Text" Color="Color.Primary">View All →</MudButton>
                    }
                    else { <MudText Color="Color.Secondary">No items yet. <MudLink Href="/password/new">Add your first.</MudLink></MudText> }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600">Quick Actions</MudText>
                    <MudStack Spacing="2">
                        <MudButton Href="/password/new" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Add Password</MudButton>
                        <MudButton Href="/import" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">Import</MudButton>
                        <MudButton Href="/vault" StartIcon="@Icons.Material.Filled.Lock" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true">All Items</MudButton>
                        <MudButton Href="/categories" StartIcon="@Icons.Material.Filled.Category" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true">Categories</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    int totalItems, favorites, vaultCount, categoryCount;
    bool isLoading = true;
    List<PasswordItem>? recent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = (await PasswordItemService.GetAllAsync())?.Where(x => !x.IsDeleted && !x.IsArchived).ToList() ?? new();
            totalItems = all.Count;
            favorites = all.Count(x => x.IsFavorite);
            recent = all.OrderByDescending(x => x.LastModified).Take(8).ToList();
            vaultCount = (await VaultService.GetAllAsync())?.Count ?? 0;
            categoryCount = (await CategoryService.GetAllAsync())?.Count ?? 0;
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
        finally { isLoading = false; }
    }

    string GetIcon(ItemType t) => t switch { ItemType.Login => Icons.Material.Filled.Language, ItemType.CreditCard => Icons.Material.Filled.CreditCard, ItemType.SecureNote => Icons.Material.Filled.Note, ItemType.WiFi => Icons.Material.Filled.Wifi, _ => Icons.Material.Filled.Lock };
    string GetColor(ItemType t) => t switch { ItemType.Login => "#7C3AED", ItemType.CreditCard => "#EC4899", ItemType.SecureNote => "#10B981", _ => "#6B7280" };
}
