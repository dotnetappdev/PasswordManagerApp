    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/masterpassword");
            return;
        }
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            allItems = (await PasswordItemService.GetAllAsync())
                .Where(i => !i.IsDeleted)
                .OrderBy(i => i.Title)
                .ToList();

            vaults = (await VaultService.GetAllAsync()) ?? new();

            collections = allItems
                .Where(i => i.CategoryId.HasValue && i.Category != null)
                .Select(i => i.Category!.Name)
                .Where(n => !string.IsNullOrEmpty(n))
                .Distinct()
                .OrderBy(c => c)
                .ToList();

            ApplyFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load items: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── Filter / selection ───────────────────────────────────────────────────

    private void SetFilter(ItemType? type, bool favorites)
    {
        selectedType = type;
        showFavorites = favorites;
        selectedCollection = "";
        selectedVaultId = null;
        searchQuery = "";
        SelectItem(null);
        ApplyFilter();
    }

    private void SetCollection(string col)
    {
        selectedCollection = col;
        selectedType = null;
        showFavorites = false;
        selectedVaultId = null;
        searchQuery = "";
        SelectItem(null);
        ApplyFilter();
    }

    // Scope the list to a single vault; the section header shows the vault name (never the id).
    private void SetVault(VaultModel vault)
    {
        selectedVaultId = vault.Id;
        selectedType = null;
        showFavorites = false;
        selectedCollection = "";
        searchQuery = "";
        SelectItem(null);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = searchQuery.Trim();

        filteredItems = allItems.Where(i =>
        {
            if (showFavorites && !i.IsFavorite) return false;
            if (selectedType.HasValue && i.Type != selectedType) return false;
            if (selectedVaultId.HasValue && i.Collection?.VaultId != selectedVaultId) return false;
            if (!string.IsNullOrEmpty(selectedCollection) &&
                (i.Category?.Name != selectedCollection)) return false;

            if (!string.IsNullOrEmpty(q))
            {
                return i.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                       (i.Username?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (i.WebsiteUrl?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (i.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
            }
            return true;
        }).ToList();
    }

    private void SelectItem(PasswordItem? item)
    {
        selectedItem = item;
        revealedFields.Clear();
        StartTotpTimer(item);
    }

    private void ToggleCustomFieldPicker() => _showFieldPicker = !_showFieldPicker;

    private async Task ReorderCustomField(int fromIdx, int toIdx)
    {
        if (selectedItem == null || fromIdx == toIdx || fromIdx < 0) return;
        var fields = selectedItem.CustomFields
            .Where(f => !string.Equals(f.Name, TotpHelper.TotpCustomFieldName, StringComparison.OrdinalIgnoreCase))
            .OrderBy(f => f.DisplayOrder).ToList();
        if (fromIdx >= fields.Count || toIdx >= fields.Count) return;
        var moved = fields[fromIdx];
        fields.RemoveAt(fromIdx);
        fields.Insert(toIdx, moved);
        for (int i = 0; i < fields.Count; i++) fields[i].DisplayOrder = i;
        try
        {
            await PasswordItemService.UpdateAsync(selectedItem);
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
        _dragSourceIdx = -1;
    }

    private async Task RemoveCustomField(CustomField field)
    {
        if (selectedItem == null) return;
        selectedItem.CustomFields?.Remove(field);
        try { await PasswordItemService.UpdateAsync(selectedItem); }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
    }

    private async Task SaveDetailChangesAsync()
    {
        if (selectedItem == null) return;
        try
        {
            await PasswordItemService.UpdateAsync(selectedItem);
            Snackbar.Add("Changes saved.", Severity.Success);
        }
        catch (System.Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception", logEx); }
    }

    // Roll the login's password back to a stored history entry. Only the encrypted blob is copied back;
    // UpdateAsync then snapshots the (now previous) current password, so the change is itself reversible.
    private async Task RestorePasswordVersion(PasswordHistoryHelper.Entry entry)
    {
        if (selectedItem?.LoginItem == null) return;
        try
        {
            selectedItem.LoginItem.EncryptedPassword = entry.Enc;
            selectedItem.LoginItem.PasswordNonce = entry.Nonce;
            selectedItem.LoginItem.PasswordAuthTag = entry.Tag;
            await PasswordItemService.UpdateAsync(selectedItem);
            await LoadItemsAsync();
            Snackbar.Add("Password restored from history.", Severity.Success);
        }
        catch (System.Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Warning("Restore password version failed", ex);
            Snackbar.Add("Couldn't restore that password.", Severity.Error);
        }
    }

    private async Task AddCustomField(CustomFieldType type)
    {
        if (selectedItem == null) return;
        _showFieldPicker = false;

        var name = type switch
        {
            CustomFieldType.Password => "Password",
            CustomFieldType.Email    => "Email",
            CustomFieldType.Url      => "URL",
            CustomFieldType.Phone    => "Phone",
            CustomFieldType.Number   => "Number",
            CustomFieldType.Date     => "Date",
            CustomFieldType.Toggle   => "Yes / No",
            _                        => "Text field",
        };

        selectedItem.CustomFields ??= new List<CustomField>();
        selectedItem.CustomFields.Add(new CustomField
        {
            Name = name,
            Value = "",
            Type = type,
            DisplayOrder = selectedItem.CustomFields.Count,
            PasswordItemId = selectedItem.Id,
            CreatedAt = DateTime.UtcNow,
            LastModified = DateTime.UtcNow,
        });

        try
        {
            await PasswordItemService.UpdateAsync(selectedItem);
            Snackbar.Add($"Custom field \"{name}\" added.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save field: {ex.Message}", Severity.Error);
        }
    }

    private void StartTotpTimer(PasswordItem? item)
    {
        _totpTimer?.Stop();
        _totpSecret = TotpHelper.GetSecret(item);
        if (string.IsNullOrEmpty(_totpSecret))
        {
            _totpCode = "------";
            _totpRemaining = 30;
            return;
        }
        UpdateTotpDisplay();
        _totpTimer ??= new System.Timers.Timer(1000);
        _totpTimer.Elapsed -= OnTotpTick;
        _totpTimer.Elapsed += OnTotpTick;
        _totpTimer.AutoReset = true;
        _totpTimer.Start();
    }

    private void OnTotpTick(object? _, System.Timers.ElapsedEventArgs __)
    {
        UpdateTotpDisplay();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTotpDisplay()
    {
        if (string.IsNullOrEmpty(_totpSecret)) return;
        try
        {
            _totpCode = TotpService.GenerateCode(_totpSecret) ?? "------";
            _totpRemaining = TotpService.GetRemainingSeconds(30);
        }
        catch { _totpCode = "------"; _totpRemaining = 30; }
    }

    public void Dispose()
    {
        _totpTimer?.Stop();
        _totpTimer?.Dispose();
    }

    // ── Navigation ───────────────────────────────────────────────────────────

    private void AddNewItem()    => Navigation.NavigateTo("/password/new");
    private void EditItem(PasswordItem item) => Navigation.NavigateTo($"/password/{item.Id}/edit");

    private async Task DeleteItem(PasswordItem item)
    {
        try
        {
            // Optional step-up: require an authenticator/recovery code when the user has enabled
            // "require code on item delete" and has 2FA configured.
            if (!await TwoFactorGate.RequireCodeForActionAsync(
                    DialogService, TwoFactorService, AuthService, JSRuntime,
                    TwoFactorGate.GateAction.ItemDelete))
            {
                return;
            }

            await PasswordItemService.DeleteAsync(item.Id);
            allItems.Remove(item);
            if (selectedItem?.Id == item.Id) SelectItem(null);
            ApplyFilter();
            Snackbar.Add("Item deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    // ── Clipboard ────────────────────────────────────────────────────────────

    private async Task CopyAsync(string? value, string label = "Copied")
    {
        if (string.IsNullOrEmpty(value)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add($"{label} copied to clipboard.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Copy failed — clipboard access may be blocked.", Severity.Warning);
        }
    }

