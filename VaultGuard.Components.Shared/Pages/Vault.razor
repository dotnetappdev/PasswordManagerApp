@page "/vault"
@page "/passwords"
@attribute [Authorize]
@using VaultGuard.Services.Interfaces
@using VaultGuard.Services.Utilities
@using VaultGuard.Models
@using VaultModel = VaultGuard.Models.Vault
@inject IPasswordItemService PasswordItemService
@inject IVaultService VaultService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ITotpService TotpService
@inject ITwoFactorService TwoFactorService
@inject IDialogService DialogService
@using VaultGuard.Components.Shared.Services
@implements IDisposable

<div style="display: flex; height: 100vh; overflow: hidden;">

    @* ── Column 1: Type / Collection Sidebar (240 px) ─────────────────────── *@
    <div style="width: 240px; min-width: 240px; border-right: 1px solid var(--mud-palette-divider); display: flex; flex-direction: column; overflow-y: auto; background: var(--mud-palette-surface);">

        <div style="padding: 16px 12px 8px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase;">
            Vault
        </div>

        <MudNavMenu>
            <MudNavLink Icon="@Icons.Material.Filled.ViewList"
                        IconColor="@(IsActive(null, false) ? Color.Primary : Color.Default)"
                        Style="@SidebarItemStyle(IsActive(null, false))"
                        OnClick="@(() => SetFilter(null, false))">
                All Items <MudBadge Content="@allItems.Count" Color="Color.Default" Class="ml-auto" Overlap="false" Visible="@(allItems.Count > 0)" />
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Star"
                        IconColor="@(showFavorites ? Color.Warning : Color.Default)"
                        Style="@SidebarItemStyle(showFavorites)"
                        OnClick="@(() => SetFilter(null, true))">
                Favorites
            </MudNavLink>
        </MudNavMenu>

        @if (vaults.Any())
        {
            <div style="padding: 12px 12px 4px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase; margin-top: 8px;">
                Vaults
            </div>
            <MudNavMenu>
                @foreach (var v in vaults)
                {
                    var active = selectedVaultId == v.Id;
                    var capturedVault = v;
                    <MudNavLink Style="@SidebarItemStyle(active)"
                                OnClick="@(() => SetVault(capturedVault))">
                        <span style="margin-right:8px;">@(string.IsNullOrWhiteSpace(v.Icon) ? "🔐" : v.Icon)</span>@v.Name
                    </MudNavLink>
                }
            </MudNavMenu>
        }

        <div style="padding: 12px 12px 4px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase; margin-top: 8px;">
            Categories
        </div>

        <MudNavMenu>
            @foreach (var (type, icon, label, color) in TypeDefinitions)
            {
                var count = allItems.Count(i => i.Type == type);
                var active = IsActive(type, false);
                <MudNavLink Icon="@icon"
                            IconColor="@(active ? color : Color.Default)"
                            Style="@SidebarItemStyle(active)"
                            OnClick="@(() => SetFilter(type, false))">
                    @label
                    @if (count > 0)
                    {
                        <MudText Typo="Typo.caption" Style="margin-left: auto; opacity: 0.6;">@count</MudText>
                    }
                </MudNavLink>
            }
        </MudNavMenu>

        @if (collections.Any())
        {
            <div style="padding: 12px 12px 4px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase; margin-top: 8px;">
                Collections
            </div>
            <MudNavMenu>
                @foreach (var col in collections)
                {
                    var active = selectedCollection == col;
                    <MudNavLink Icon="@Icons.Material.Filled.FolderOpen"
                                IconColor="@(active ? Color.Secondary : Color.Default)"
                                Style="@SidebarItemStyle(active)"
                                OnClick="@(() => SetCollection(col))">
                        @col
                    </MudNavLink>
                }
            </MudNavMenu>
        }
    </div>

    @* ── Column 2: Items List (300 px) ────────────────────────────────────── *@
    <div style="width: 300px; min-width: 300px; border-right: 1px solid var(--mud-palette-divider); display: flex; flex-direction: column;">

        @* List header *@
        <div style="padding: 12px; border-bottom: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface);">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
                <MudText Typo="Typo.subtitle2" Style="flex: 1; font-weight: 700;">@SectionTitle</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Title="New Item"
                               OnClick="AddNewItem" />
            </div>
            <MudTextField T="string"
                          Value="@searchQuery"
                          ValueChanged="@(v => { searchQuery = v ?? ""; ApplyFilter(); })"
                          Placeholder="Search..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          Style="font-size: 13px;" />
        </div>

        @* Scrollable items *@
        <div style="flex: 1; overflow-y: auto;">
            @if (isLoading)
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </MudStack>
            }
            else if (!filteredItems.Any())
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 200px; padding: 24px;">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" Style="opacity: 0.4;" />
                    <MudText Color="Color.Secondary" Align="MudBlazor.Align.Center" Style="opacity: 0.6;">No items found</MudText>
                </MudStack>
            }
            else
            {
                @foreach (var item in filteredItems)
                {
                    var isSelected = selectedItem?.Id == item.Id;
                    var capturedItem = item;
                    <div class="vault-list-item @(isSelected ? "vault-list-item--selected" : "")"
                         @onclick="@(() => SelectItem(capturedItem))"
                         style="display: flex; align-items: center; padding: 10px 14px; cursor: pointer; border-bottom: 1px solid var(--mud-palette-divider); background: @(isSelected ? "var(--mud-palette-primary-lighten)" : "transparent");">

                        @* Icon *@
                        <div style="@($"width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0; background: {GetItemColorHex(item)};")">
                            @if (!string.IsNullOrWhiteSpace(GetBrandIconSource(item)))
                            {
                                <img src="@GetBrandIconSource(item)"
                                     style="width: 22px; height: 22px; border-radius: 4px; object-fit: contain;"
                                     onerror="this.style.display='none'; this.nextSibling.style.display='flex';" />
                                <MudIcon Icon="@GetItemIcon(item.Type)" Style="color: white; font-size: 18px; display: none;" />
                            }
                            else
                            {
                                <MudIcon Icon="@GetItemIcon(item.Type)" Style="color: white; font-size: 18px;" />
                            }
                        </div>

                        @* Title + subtitle *@
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--mud-palette-text-primary);">
                                @item.Title
                                @if (item.IsFavorite)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" Style="font-size: 12px; margin-left: 4px; vertical-align: middle;" />
                                }
                            </div>
                            <div style="font-size: 12px; color: var(--mud-palette-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @GetItemSubtitle(item)
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ── Column 3: Item Detail Panel (fills remaining width) ──────────────── *@
    <div style="flex: 1; overflow-y: auto; background: var(--mud-palette-background);">
        @if (selectedItem == null)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100%; padding: 48px;">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="font-size: 80px; opacity: 0.15; color: var(--mud-palette-text-primary);" />
                <MudText Typo="Typo.h6" Style="opacity: 0.35; margin-top: 16px;">Select an item to view details</MudText>
            </MudStack>
        }
        else
        {
            <div style="padding: 32px; max-width: 680px;">

                @* ── Detail header ── *@
                <div style="display: flex; align-items: flex-start; margin-bottom: 28px; gap: 16px;">
                    <div style="@($"width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: {GetItemColorHex(selectedItem)};")">
                        @if (!string.IsNullOrWhiteSpace(GetBrandIconSource(selectedItem)))
                        {
                            <img src="@GetBrandIconSource(selectedItem)"
                                 style="width: 32px; height: 32px; border-radius: 6px; object-fit: contain;"
                                 onerror="this.style.display='none'; this.nextSibling.style.display='flex';" />
                            <MudIcon Icon="@GetItemIcon(selectedItem.Type)" Style="color: white; font-size: 28px; display: none;" />
                        }
                        else
                        {
                            <MudIcon Icon="@GetItemIcon(selectedItem.Type)" Style="color: white; font-size: 28px;" />
                        }
                    </div>

                    <div style="flex: 1; min-width: 0; padding-top: 4px;">
                        <MudText Typo="Typo.h5" Style="font-weight: 700; margin-bottom: 6px; word-break: break-word;">@selectedItem.Title</MudText>
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@GetTypeName(selectedItem.Type)</MudChip>
                            @if (selectedItem.IsFavorite)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Filled.Star">Favorite</MudChip>
                            }
                            @{var cat = selectedItem.CategoryId.HasValue ? selectedItem.Category : null;}
                            @if (cat != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">@cat.Name</MudChip>
                            }
                        </div>
                    </div>

                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Title="Edit" OnClick="@(() => EditItem(selectedItem))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Title="Delete" OnClick="@(() => DeleteItem(selectedItem))" />
                </div>

                @* ── Type-specific fields ── *@
                @if (selectedItem.Type is ItemType.Login or ItemType.Password)
                {
                    @DetailField("Username", selectedItem.Username, copyable: true)
                    @DetailPasswordField("Password", selectedItem.Password, "pw")
                    @if (!string.IsNullOrEmpty(selectedItem.WebsiteUrl))
                    {
                        @DetailLinkField("Website", selectedItem.WebsiteUrl)
                    }
                    @if (!string.IsNullOrEmpty(selectedItem.LoginItem?.Email))
                    {
                        @DetailField("Email", selectedItem.LoginItem!.Email, copyable: true)
                    }
                    @if (!string.IsNullOrEmpty(_totpSecret))
                    {
                        <div style="display: flex; align-items: flex-start; margin-bottom: 18px;">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Color="Color.Secondary"
                                     Style="cursor:grab; flex-shrink:0; margin-right:4px; margin-top:10px; opacity:0.6;" />
                            <div style="flex: 1; min-width: 0;">
                            <div style="font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase; margin-bottom: 8px;">Verification Code</div>
                            <div style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: color-mix(in srgb, var(--mud-palette-primary) 8%, transparent); border-radius: 10px; border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 20%, transparent);">
                                <div style="font-family: 'Consolas', monospace; font-size: 26px; font-weight: 700; color: var(--mud-palette-primary); letter-spacing: 4px; flex: 1;">
                                    @(_totpCode.Length == 6 ? _totpCode[..3] + " " + _totpCode[3..] : _totpCode)
                                </div>
                                <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
                                    <div style="font-size: 18px; font-weight: 700; color: @(_totpRemaining <= 5 ? "var(--mud-palette-error)" : "var(--mud-palette-text-secondary)"); font-variant-numeric: tabular-nums;">@_totpRemaining</div>
                                    <div style="font-size: 10px; color: var(--mud-palette-text-disabled);">SEC</div>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               Color="Color.Primary" Title="Copy code"
                                               OnClick="@(async () => await CopyAsync(_totpCode, "Verification code"))" />
                            </div>
                            </div>
                        </div>
                    }
                }
                else if (selectedItem.Type == ItemType.CreditCard)
                {
                    var card = selectedItem.CreditCardItem;
                    @DetailField("Cardholder Name", card?.CardholderName)
                    @DetailPasswordField("Card Number", card?.CardNumber, "cn")
                    @DetailField("Expiry", card?.ExpiryDate)
                    @DetailPasswordField("CVV", card?.CVV, "cvv")
                    @if (!string.IsNullOrEmpty(card?.PIN))
                    {
                        @DetailPasswordField("PIN", card!.PIN, "pin")
                    }
                    @DetailField("Card Type", card?.CardType.ToString())
                    @DetailField("Issuing Bank", card?.IssuingBank)
                    @DetailLinkField("Online Banking", card?.OnlineBankingUrl)
                    @DetailField("Notes", card?.Notes)
                }
                else if (selectedItem.Type == ItemType.SecureNote)
                {
                    @DetailNoteField("Notes", selectedItem.Description ?? selectedItem.SecureNoteItem?.Content)
                }
                else if (selectedItem.Type == ItemType.WiFi)
                {
                    var wifi = selectedItem.WiFiItem;
                    @DetailField("Network Name (SSID)", wifi?.NetworkName ?? selectedItem.Title)
                    @DetailPasswordField("Password", wifi?.Password, "wifi")
                    @DetailField("Security", wifi?.SecurityType.ToString())
                    @DetailField("Router IP", wifi?.RouterIP)
                    @DetailField("Router Username", wifi?.RouterUsername)
                    @if (!string.IsNullOrEmpty(wifi?.RouterPassword))
                    {
                        @DetailPasswordField("Router Password", wifi!.RouterPassword, "router")
                    }
                    @if (!string.IsNullOrEmpty(wifi?.GuestNetworkName))
                    {
                        @DetailField("Guest Network", wifi!.GuestNetworkName)
                        @DetailPasswordField("Guest Password", wifi!.GuestNetworkPassword, "guest")
                    }
                    @DetailField("Notes", wifi?.Notes)
                }
                else if (selectedItem.Type == ItemType.Passkey)
                {
                    var pk = selectedItem.PasskeyItem;
                    @DetailField("Username / Display Name", pk?.Username ?? pk?.DisplayName)
                    @DetailLinkField("Website", pk?.WebsiteUrl ?? pk?.Website)
                    @DetailField("Device", pk?.DeviceType)
                    @DetailField("Platform", pk?.PlatformName)
                    @DetailField("Backed Up", pk?.IsBackedUp == true ? "Yes" : "No")
                    @if (pk?.LastUsedAt != null)
                    {
                        @DetailField("Last Used", pk.LastUsedAt.Value.ToLocalTime().ToString("MMM d, yyyy HH:mm"))
                    }
                    @DetailField("Notes", pk?.Notes)
                }
                else if (selectedItem.Type == ItemType.Identity)
                {
                    @DetailField("Username", selectedItem.Username, copyable: true)
                    @DetailLinkField("Website", selectedItem.WebsiteUrl)
                    @DetailField("Notes", selectedItem.Description)
                }

                @* ── Shared: description / notes (non-SecureNote) ── *@
                @if (selectedItem.Type != ItemType.SecureNote && !string.IsNullOrEmpty(selectedItem.Description))
                {
                    @DetailNoteField("Notes", selectedItem.Description)
                }

                @* ── Tags ── *@
                @if (selectedItem.Tags.Any())
                {
                    <div style="margin-top: 20px;">
                        <div style="font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase; margin-bottom: 8px;">Tags</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                            @foreach (var tag in selectedItem.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag.Name</MudChip>
                            }
                        </div>
                    </div>
                }

                @* ── Custom fields ── *@
                <div style="margin-top: 20px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                        <div style="font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Custom Fields</div>
                        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                 Dense="true" PopoverClass="custom-field-menu">
                            <ActivatorContent>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ArrowDropDown">+ add another field</MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                @foreach (var ft in _fieldTypes)
                                {
                                    var captured = ft;
                                    <MudMenuItem Icon="@captured.Icon" OnClick="@(() => AddCustomField(captured.Type))">
                                        @captured.Label
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    </div>


                    @{
                        var visibleFields = selectedItem.CustomFields
                            .Where(f => !string.Equals(f.Name, TotpHelper.TotpCustomFieldName, StringComparison.OrdinalIgnoreCase)
                                     && !string.Equals(f.Name, PasswordHistoryHelper.HistoryFieldName, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                    }
                    @if (visibleFields.Count == 0)
                    {
                        <div style="font-size: 12px; color: var(--mud-palette-text-disabled); padding: 4px 0;">No custom fields yet.</div>
                    }
                    @foreach (var (field, idx) in visibleFields.Select((f,i)=>(f,i)))
                    {
                        var capturedField = field;
                        var capturedIdx   = idx;
                        <div draggable="true"
                             style="display:flex; align-items:flex-start; gap:8px; padding:8px 0; border-bottom:1px solid var(--mud-palette-divider);"
                             @ondragstart="@(() => _dragSourceIdx = capturedIdx)"
                             @ondragover:preventDefault="true"
                             @ondrop="@(() => ReorderCustomField(_dragSourceIdx, capturedIdx))">
                            <!-- drag handle -->
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                     Size="Size.Small" Color="Color.Secondary"
                                     Style="cursor:grab; margin-top:14px; flex-shrink:0;" />
                            <!-- label + value -->
                            <div style="flex:1; min-width:0;">
                                <div style="font-size:11px; font-weight:700; letter-spacing:.8px; color:var(--mud-palette-text-secondary); text-transform:uppercase; margin-bottom:2px;">
                                    @capturedField.Name
                                </div>
                                <div style="font-size:14px; word-break:break-all; color:var(--mud-palette-text-primary);">
                                    @capturedField.Value
                                </div>
                            </div>
                            <!-- copy + delete -->
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           Color="Color.Default" Style="flex-shrink:0;"
                                           OnClick="@(async () => await CopyAsync(capturedField.Value, capturedField.Name ?? "Field"))" />
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small"
                                           Color="Color.Error" Style="flex-shrink:0;"
                                           OnClick="@(() => RemoveCustomField(capturedField))" />
                        </div>
                    }
                </div>

                @{
                    var pwHistory = PasswordHistoryHelper.GetHistory(selectedItem);
                }
                @if (pwHistory.Count > 0)
                {
                    <MudExpansionPanels Elevation="0" Class="mt-2">
                        <MudExpansionPanel Text="@($"Password history ({pwHistory.Count})")" Icon="@Icons.Material.Filled.History">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2" Style="display:block;">
                                Previous passwords for this item. Restoring rolls back to an earlier one — the current
                                password is kept in history too, so you can always change your mind.
                            </MudText>
                            @foreach (var entry in pwHistory)
                            {
                                var capturedEntry = entry;
                                <div style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--mud-palette-divider);">
                                    <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Style="flex:1;">
                                        Changed @capturedEntry.At.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               OnClick="@(async () => await RestorePasswordVersion(capturedEntry))">Restore</MudButton>
                                </div>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                @* ── Save button (sticky at the foot of the detail pane) ── *@
                <div style="position: sticky; bottom: 0; z-index: 4; margin: 16px -32px 0; padding: 12px 32px calc(12px + env(safe-area-inset-bottom, 0px)); background: color-mix(in srgb, var(--mud-palette-background) 92%, transparent); backdrop-filter: blur(8px); border-top: 1px solid var(--mud-palette-divider);">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="@SaveDetailChangesAsync">Save changes</MudButton>
                </div>

                @* ── Timestamps ── *@
                <div style="margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--mud-palette-divider);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Modified @selectedItem.LastModified.ToLocalTime().ToString("MMM d, yyyy 'at' HH:mm")
                        &nbsp;·&nbsp;
                        Created @selectedItem.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                    </MudText>
                </div>

            </div>
        }
    </div>

</div>

@* ── Inline CSS ────────────────────────────────────────────────────────────── *@
<style>
    .vault-list-item:hover {
        background: var(--mud-palette-action-hover) !important;
    }
    .vault-list-item--selected {
        background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent) !important;
    }
</style>

@code {
    // ── Data ─────────────────────────────────────────────────────────────────

    private List<PasswordItem> allItems = new();
    private List<PasswordItem> filteredItems = new();
    private List<string> collections = new();
    private List<VaultModel> vaults = new();

    // ── Filter state ──────────────────────────────────────────────────────────

    private ItemType? selectedType;
    private bool showFavorites;
    private string selectedCollection = "";
    private int? selectedVaultId;
    private string searchQuery = "";

    // ── UI state ──────────────────────────────────────────────────────────────

    private bool isLoading = true;
    private PasswordItem? selectedItem;

    // ── Custom field add + reorder ────────────────────────────────────────────
    private bool _showFieldPicker;
    private int _dragSourceIdx = -1;

    private static readonly (string Label, string Icon, CustomFieldType Type)[] _fieldTypes =
    [
        ("Text",             Icons.Material.Filled.TextFields,     CustomFieldType.Text),
        ("URL",              Icons.Material.Filled.Link,            CustomFieldType.Url),
        ("Email",            Icons.Material.Filled.Email,           CustomFieldType.Email),
        ("Address",          Icons.Material.Filled.LocationOn,      CustomFieldType.Address),
        ("Date",             Icons.Material.Filled.CalendarToday,   CustomFieldType.Date),
        ("One-Time Password",Icons.Material.Filled.Key,             CustomFieldType.OneTimePassword),
        ("Password",         Icons.Material.Filled.Lock,            CustomFieldType.Password),
        ("Phone",            Icons.Material.Filled.Phone,           CustomFieldType.Phone),
        ("Number",           Icons.Material.Filled.Tag,             CustomFieldType.Number),
        ("Yes / No",         Icons.Material.Filled.ToggleOn,        CustomFieldType.Toggle),
        ("Multiline text",   Icons.Material.Filled.Notes,           CustomFieldType.TextArea),
        ("Sign in with",     Icons.Material.Filled.AccountCircle,   CustomFieldType.SignInWith),
    ];

    // ── TOTP live display ──────────────────────────────────────────────────────
