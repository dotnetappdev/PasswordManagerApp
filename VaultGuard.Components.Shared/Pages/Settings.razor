@page "/settings"
@attribute [Authorize]
@using VaultGuard.Services.Interfaces
@using VaultGuard.Components.Shared.Services
@using VaultGuard.Components.Shared.Components
@using Microsoft.Extensions.DependencyInjection
@using VaultGuard.Models
@using VaultGuard.Models.DTOs.Auth
@using VaultGuard.Models.Configuration
@inject IUserProfileService UserProfileService
@inject IApiKeyService ApiKeyService
@inject IDatabaseConfigurationService DatabaseConfigurationService
@inject IDatabaseResetService DatabaseResetService
@inject ThemeService ThemeService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IAppSettingsService AppSettings
@inject IHttpClientFactory HttpClientFactory
@inject IServiceProvider ServiceProvider
@inject ISnackbar Snackbar
@inject IAuthService AuthService
@inject ITwoFactorService TwoFactorService
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Medium" Style="padding: 20px;">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Style="vertical-align: middle; margin-right: 8px;" />
                Settings
            </MudText>
        </MudPaper>

        <!-- Appearance Section -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.Palette" Style="vertical-align: middle; margin-right: 8px;" />
                Appearance
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="AppThemeMode" @bind-Value="SelectedTheme" 
                              Label="Theme" 
                              Variant="Variant.Outlined"
                              AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@AppThemeMode.Light">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.LightMode" Size="Size.Small" />
                                <MudText>Light</MudText>
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value="@AppThemeMode.Dark">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small" />
                                <MudText>Dark</MudText>
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value="@AppThemeMode.System">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.SettingsBrightness" Size="Size.Small" />
                                <MudText>System</MudText>
                            </MudStack>
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Accessibility Section -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.Accessibility" Style="vertical-align: middle; margin-right: 8px;" />
                Accessibility
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">UI zoom: @($"{(int)Math.Round(A11yZoom * 100)}%")</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Make everything larger or smaller, like the zoom in 1Password.</MudText>
                    <MudSlider T="double" Min="@AccessibilityState.MinZoom" Max="@AccessibilityState.MaxZoom" Step="0.05"
                               Value="A11yZoom" ValueChanged="OnZoomChanged" Class="mt-2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Text &amp; menu size: @($"{(int)Math.Round(A11yFont)} px")</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Set the base font size used across menus and text.</MudText>
                    <MudSlider T="double" Min="@AccessibilityState.MinFont" Max="@AccessibilityState.MaxFont" Step="1"
                               Value="A11yFont" ValueChanged="OnFontChanged" Class="mt-2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch T="bool" Value="A11yReduceMotion" ValueChanged="OnReduceMotionChanged"
                               Color="Color.Primary" Label="Reduce motion" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Minimise animations and transitions.</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch T="bool" Value="A11yHighContrast" ValueChanged="OnHighContrastChanged"
                               Color="Color.Primary" Label="High contrast" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Boost contrast for better readability.</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetAccessibility">Reset to defaults</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Profile Section -->
        <MudPaper Class="pa-4" >
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">Profile</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-value="userProfile.FirstName" 
                                 Label="First Name" 
                                 Variant="Variant.Outlined"
                                 />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-value="userProfile.Email" 
                                 Label="Email" 
                                 Variant="Variant.Outlined"
                                 />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- API Key Management -->
        <MudPaper Class="pa-4" >
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">API Key Management</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-value="newApiKeyName" 
                                 Label="API Key Name" 
                                 Variant="Variant.Outlined"
                                
                                 HelperText="Enter a descriptive name for your API key" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-value="selectedProviderForApiKey" 
                              Label="Database Provider (Optional)" 
                              Variant="Variant.Outlined"
                             
                              HelperText="Select provider to use existing config">
                        <MudSelectItem Value="@("")">General (No Provider)</MudSelectItem>
                        <MudSelectItem Value="@("Sqlite")">SQLite</MudSelectItem>
                        <MudSelectItem Value="@("SqlServer")">SQL Server</MudSelectItem>
                        <MudSelectItem Value="@("MySql")">MySQL</MudSelectItem>
                        <MudSelectItem Value="@("PostgreSql")">PostgreSQL</MudSelectItem>
                        <MudSelectItem Value="@("Supabase")">Supabase</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary" 
                              OnClick="GenerateApiKey"
                              Disabled="string.IsNullOrEmpty(newApiKeyName) || isGenerating"
                              FullWidth="true">
                        @if (isGenerating)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ml-2">Generating...</MudText>
                        }
                        else
                        {
                            <MudText>Generate API Key</MudText>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(generatedApiKey))
            {
                <MudAlert Severity="Severity.Success" Style="background-color: #1a4a1a; color: white; margin-top: 16px;">
                    <MudText Style="color: white;">API Key Generated Successfully!</MudText>
                    <MudTextField T="string" Value="@generatedApiKey" 
                                 Label="Your API Key" 
                                 Variant="Variant.Outlined"
                                 Style="margin-top: 8px;"
                                 ReadOnly="true"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                 OnAdornmentClick="CopyApiKey" />
                    @if (!string.IsNullOrEmpty(generatedApiUrl))
                    {
                        <MudTextField T="string" Value="@generatedApiUrl" 
                                     Label="Associated API URL" 
                                     Variant="Variant.Outlined"
                                     Style="margin-top: 8px;"
                                     ReadOnly="true" />
                    }
                    <MudText Typo="Typo.caption" Style="color: #cccccc; margin-top: 8px;">
                        ⚠️ Store this API key securely. It will not be shown again.
                    </MudText>
                </MudAlert>
            }

            <!-- Existing API Keys -->
            <MudText Typo="Typo.subtitle1" Style="color: white; margin-top: 24px; margin-bottom: 16px;">
                Your API Keys
            </MudText>

            @if (apiKeys.Any())
            {
                <MudTable Items="@apiKeys" 
                         Dense="true" 
                         Style="background-color: #2a2a2a; color: white;">
                    <HeaderContent>
                        <MudTh Style="color: white;">Name</MudTh>
                        <MudTh Style="color: white;">Provider</MudTh>
                        <MudTh Style="color: white;">Created</MudTh>
                        <MudTh Style="color: white;">Last Used</MudTh>
                        <MudTh Style="color: white;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Provider">
                            @if (context.Provider.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                    @GetProviderDisplayName(context.Provider)
                                </MudChip>
                            }
                            else
                            {
                                <MudText Style="color: #cccccc;">General</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Created">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                        <MudTd DataLabel="Last Used">
                            @(context.LastUsedAt?.ToString("MMM dd, yyyy") ?? "Never")
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Size="Size.Small" 
                                      Color="Color.Error" 
                                      OnClick="() => DeleteApiKey(context.Id)">
                                Delete
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Style="color: #cccccc;">No API keys found. Generate one to get started.</MudText>
            }
        </MudPaper>

        <!-- API Configuration -->
        <MudPaper Class="pa-4" >
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">API Configuration</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-value="apiUrl" 
                                 Label="API URL" 
                                 Variant="Variant.Outlined"
                                
                                 HelperText="URL of the Vault Guard API for sync operations" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-value="apiKey" 
                                 Label="API Key" 
                                 Variant="Variant.Outlined"
                                 InputType="InputType.Password"
                                 
                                 HelperText="API key for authentication with the sync API" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-value="clientId"
                                 Label="Client ID"
                                 Variant="Variant.Outlined"
                                 HelperText="Optional client identifier stored with the shared app settings" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-value="clientSecret"
                                 Label="Client Secret"
                                 Variant="Variant.Outlined"
                                 InputType="InputType.Password"
                                 HelperText="Optional client secret stored with the shared app settings" />
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Wifi"
                           OnClick="TestApiConnectionAsync"
                           Disabled="isConnectionBusy">
                    Test API Connection
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopyConfiguredApiKey">
                    Copy API Key
                </MudButton>
            </MudStack>
            @if (authenticationMode == "ApiEndpoint")
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">SQL Server (API database)</MudText>
                <MudText Typo="Typo.caption" Class="d-block mb-2 mud-text-secondary">
                    Reused by the API host when shared-machine database settings are enabled.
                </MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-value="dbServer"
                                    Label="Server"
                                    Variant="Variant.Outlined"
                                    Placeholder="sql.example.com" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-value="dbName"
                                    Label="Database"
                                    Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-value="dbUser"
                                    Label="User"
                                    Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-value="dbPassword"
                                    Label="Password"
                                    Variant="Variant.Outlined"
                                    InputType="InputType.Password" />
                    </MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Link"
                           OnClick="TestSqlServerConnectionAsync"
                           Disabled="isConnectionBusy">
                    Test SQL Server
                </MudButton>
            }
        </MudPaper>

        <!-- Authentication Mode Selection -->
        <MudPaper Class="pa-4" >
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">Authentication Mode</MudText>
            
            <MudRadioGroup T="string" @bind-value="authenticationMode" Row="false">
                <MudRadio T="string" Value="@("LocalDatabase")" Style="color: white;">
                    <MudText Style="color: white;">Local Database</MudText>
                    <MudText Typo="Typo.caption" Style="color: #cccccc;">Authenticate using the local database only</MudText>
                </MudRadio>
                <MudRadio T="string" Value="@("ApiEndpoint")" Style="color: white; margin-top: 8px;">
                    <MudText Style="color: white;">API Endpoint</MudText>
                    <MudText Typo="Typo.caption" Style="color: #cccccc;">Authenticate using the API server with .NET Identity endpoints</MudText>
                </MudRadio>
            </MudRadioGroup>
        </MudPaper>

        <!-- Database Settings -->
        <MudPaper Class="pa-4" >
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">Database Settings</MudText>
            
            <MudSelect T="string" @bind-value="databaseProvider" 
                      Label="Database Provider" 
                      Variant="Variant.Outlined"
                     >
                <MudSelectItem Value="@("Sqlite")">SQLite</MudSelectItem>
                <MudSelectItem Value="@("SqlServer")">SQL Server</MudSelectItem>
                <MudSelectItem Value="@("MySql")">MySQL</MudSelectItem>
                <MudSelectItem Value="@("PostgreSql")">PostgreSQL</MudSelectItem>
                <MudSelectItem Value="@("Supabase")">Supabase</MudSelectItem>
            </MudSelect>

            @if (databaseProvider == "Sqlite")
            {
                <MudGrid Style="margin-top: 16px;">
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-value="sqliteDatabasePath" 
                                     Label="SQLite Database Path" 
                                     Variant="Variant.Outlined"
                                     HelperText="Path to the SQLite database file (absolute or relative)"
                                     />
                    </MudItem>
                </MudGrid>
            }

            @if (databaseProvider == "Supabase")
            {
                <MudGrid Style="margin-top: 16px;">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-value="supabaseUrl" 
                                     Label="Supabase URL" 
                                     Variant="Variant.Outlined"
                                     />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-value="supabaseApiKey" 
                                     Label="Supabase API Key" 
                                     Variant="Variant.Outlined"
                                     InputType="InputType.Password"
                                     />
                    </MudItem>
                </MudGrid>
            }

            @if (databaseProvider == "SqlServer" && authenticationMode != "ApiEndpoint")
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                    SQL Server fields are configured in the API Configuration card when API Endpoint mode is selected.
                </MudAlert>
            }
        </MudPaper>

        <!-- Database Management -->
        <MudPaper Class="pa-4" Style="border: 2px solid orange;">
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Medium" Style="vertical-align: middle; margin-right: 8px;" />
                Database Management
            </MudText>

            <MudStack Spacing="3">
                <!-- Reset Password Data -->
                <MudPaper Class="pa-3" Style="background-color: #2a2a2a; border: 1px solid #f59e0b;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1" Style="color: #fbbf24; font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                            Reset Password Data
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #d1d5db;">
                            Clears all password items, collections, categories, and tags while preserving your user account and login credentials.
                        </MudText>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Warning"
                                  OnClick="ShowResetDataDialog"
                                  StartIcon="@Icons.Material.Filled.RestartAlt"
                                  Size="Size.Small"
                                  Style="margin-top: 8px; width: fit-content;">
                            Reset Password Data
                        </MudButton>
                    </MudStack>
                </MudPaper>

                <!-- Reset All Data -->
                <MudPaper Class="pa-3" Style="background-color: #2a2a2a; border: 1px solid #ef4444;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1" Style="color: #f87171; font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                            Reset All Database Tables
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #f87171; font-weight: 600;">
                            ⚠️ DANGER: Clears ALL database tables including user accounts. This will log you out and reset the database to default state.
                        </MudText>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Error"
                                  OnClick="ShowResetAllDialog"
                                  StartIcon="@Icons.Material.Filled.DeleteForever"
                                  Size="Size.Small"
                                  Style="margin-top: 8px; width: fit-content;">
                            Reset All Tables
                        </MudButton>
                    </MudStack>
                </MudPaper>

                <!-- Secure Wipe Database -->
                <MudPaper Class="pa-3" Style="background-color: #2a2a2a; border: 2px solid #dc2626;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1" Style="color: #dc2626; font-weight: 700;">
                            <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                            Secure Wipe Database
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #dc2626; font-weight: 700;">
                            🔒 SECURE DELETE: Clears all tables and securely deletes the database file (SQLite only). For SQL Server, clears all tables. Cannot be undone!
                        </MudText>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Error"
                                  OnClick="ShowSecureWipeDialog"
                                  StartIcon="@Icons.Material.Filled.DeleteSweep"
                                  Size="Size.Small"
                                  Style="margin-top: 8px; width: fit-content; background-color: #dc2626;">
                            Secure Wipe
                        </MudButton>
                    </MudStack>
                </MudPaper>

                <!-- Reseed Sample Data -->
                <MudPaper Class="pa-3" Style="background-color: #2a2a2a; border: 1px solid var(--mud-palette-primary);">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1" Style="color: var(--mud-palette-text-primary); font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                            Reseed Sample Data
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #d1d5db;">
                            Adds sample categories, collections, and password items to help you get started. Does not delete existing data.
                        </MudText>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Info"
                                  OnClick="ShowReseedSampleDataDialog"
                                  StartIcon="@Icons.Material.Filled.CloudUpload"
                                  Size="Size.Small"
                                  Style="margin-top: 8px; width: fit-content;">
                            Reseed Sample Data
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudPaper>

        <!-- Security -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Medium" Style="vertical-align: middle; margin-right: 8px;" />
                Security
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #cccccc; margin-bottom: 16px; display: block;">
                Step-up verification only takes effect when two-factor authentication is enabled for your account.
                When on, the matching action first asks for a current authenticator or recovery code.
            </MudText>
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">Require authenticator code for</MudText>
                <MudSwitch T="bool" Value="requireCodeOnVaultDelete" Color="Color.Primary"
                           Label="Deleting a vault"
                           ValueChanged="@(async (bool v) => { requireCodeOnVaultDelete = v; await TwoFactorGate.SetToggleAsync(JSRuntime, TwoFactorGate.GateAction.VaultDelete, v); })" />
                <MudSwitch T="bool" Value="requireCodeOnItemDelete" Color="Color.Primary"
                           Label="Deleting a password item"
                           ValueChanged="@(async (bool v) => { requireCodeOnItemDelete = v; await TwoFactorGate.SetToggleAsync(JSRuntime, TwoFactorGate.GateAction.ItemDelete, v); })" />

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">This device</MudText>
                <MudText Typo="Typo.caption" Style="color:#cccccc;">
                    When 2FA is on, this device is remembered so you can sign in with just your authenticator code.
                    Forget it to require your master password again on the next sign-in.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.PhonelinkErase"
                           Style="align-self:flex-start;"
                           OnClick="ForgetThisDevice">
                    Forget this device
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- App Lock (Passcode / Passkey) -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Medium" Style="vertical-align: middle; margin-right: 8px;" />
                App Lock
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #cccccc; margin-bottom: 16px; display: block;">
                Protect access to Vault Guard with a PIN passcode.
                The app lock is checked on every launch, before your vault is unlocked.
            </MudText>
            <MudStack Row="false" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Pin"
                           Style="align-self:flex-start;"
                           Href="/passcode-settings">
                    Manage App Passcode (PIN)
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Cloud Backup -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Medium" Style="vertical-align: middle; margin-right: 8px;" />
                Cloud Backup
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #cccccc; margin-bottom: 16px; display: block;">
                Backups are AES-256-GCM encrypted with your master password before upload. Your master password never leaves this device.
            </MudText>

            <MudStack Spacing="3">
                <MudSwitch @bind-Value="enableCloudBackup" Color="Color.Primary" Label="Enable automatic cloud backup" />

                @if (enableCloudBackup)
                {
                    <MudSelect T="string" @bind-Value="selectedCloudProvider"
                              Label="Cloud Provider"
                              Variant="Variant.Outlined">
                        <MudSelectItem Value="@("OneDrive")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" />
                                <MudText>OneDrive (Windows built-in)</MudText>
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value="@("GoogleDrive")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.CloudCircle" Size="Size.Small" />
                                <MudText>Google Drive</MudText>
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value="@("iCloud")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.PhoneIphone" Size="Size.Small" />
                                <MudText>iCloud (Apple platforms)</MudText>
                            </MudStack>
                        </MudSelectItem>
                    </MudSelect>

                    @if (selectedCloudProvider == "GoogleDrive")
                    {
                        <MudAlert Severity="Severity.Info">
                            Create OAuth 2.0 credentials (Desktop app type) at console.cloud.google.com and paste them below.
                        </MudAlert>
                        <MudTextField T="string" @bind-Value="googleDriveClientId"
                                     Label="Google Drive Client ID"
                                     Variant="Variant.Outlined" />
                        <MudTextField T="string" @bind-Value="googleDriveClientSecret"
                                     Label="Google Drive Client Secret"
                                     Variant="Variant.Outlined"
                                     InputType="InputType.Password" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                  OnClick="ConnectGoogleDrive"
                                  Disabled="string.IsNullOrWhiteSpace(googleDriveClientId) || isConnectingGDrive">
                            @if (isConnectingGDrive)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ml-2">Connecting...</MudText>
                            }
                            else if (googleDriveConnected)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-2" />
                                <MudText>Reconnect Google Drive</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Class="mr-2" />
                                <MudText>Connect Google Drive</MudText>
                            }
                        </MudButton>
                        @if (googleDriveConnected)
                        {
                            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">@googleDriveStatus</MudChip>
                        }
                    }

                    <MudSelect T="string" @bind-Value="backupSchedule"
                              Label="Backup Schedule"
                              Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Hourly")">Every hour</MudSelectItem>
                        <MudSelectItem Value="@("Daily")">Once a day</MudSelectItem>
                        <MudSelectItem Value="@("Weekly")">Once a week</MudSelectItem>
                    </MudSelect>

                    <!-- Back Up Now / Refresh row -->
                    <MudStack Row="true" Spacing="2" Style="margin-top: 8px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                  OnClick="CreateBackupNow" Disabled="isCreatingBackup">
                            @if (isCreatingBackup)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ml-2">Backing up...</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Backup" Size="Size.Small" Class="mr-2" />
                                <MudText>Back Up Now</MudText>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="RefreshBackups" Disabled="isLoadingBackups">
                            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-2" />
                            Refresh
                        </MudButton>
                    </MudStack>

                    <!-- iPhone-style save points -->
                    <MudText Typo="Typo.overline" Style="margin-top: 20px; letter-spacing: 1px; color: #888;">SAVE POINTS</MudText>
                    @if (isLoadingBackups)
                    {
                        <MudProgressLinear Indeterminate="true" Class="mt-2" />
                    }
                    else if (!cloudBackups.Any())
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">No backups yet. Use "Back Up Now" to create your first save point.</MudAlert>
                    }
                    else
                    {
                        @foreach (var backup in cloudBackups)
                        {
                            <MudPaper Elevation="0" Class="mb-3 pa-0"
                                     Style="border-radius:14px; border:1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Spacing="3">
                                    <!-- Cloud icon -->
                                    <MudAvatar Style="background:#52525B; width:44px; height:44px; border-radius:12px;">
                                        <MudIcon Icon="@Icons.Material.Filled.CloudDone" Size="Size.Medium" Style="color:white;"/>
                                    </MudAvatar>
                                    <!-- Date / meta -->
                                    <MudStack Spacing="0" Style="flex:1;">
                                        <MudText Style="font-size:15px; font-weight:600;">@backup.CreatedAtFormatted</MudText>
                                        <MudText Typo="Typo.caption" Style="color:#888;">@backup.ServiceName · @backup.SizeFormatted</MudText>
                                    </MudStack>
                                    <!-- Actions -->
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                  OnClick="() => BrowseBackup(backup)"
                                                  StartIcon="@Icons.Material.Filled.ManageSearch">Browse</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                  OnClick="() => RestoreBackup(backup)"
                                                  StartIcon="@Icons.Material.Filled.RestoreFromTrash">Restore All</MudButton>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                      Size="Size.Small" OnClick="() => DeleteBackup(backup)"
                                                      Title="Delete this backup" />
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                }
            </MudStack>
        </MudPaper>

        <!-- Browse Backup drawer (selective restore) -->
        @if (browseContents != null)
        {
            <MudPaper Elevation="4" Style="border-radius:16px; border:1px solid rgba(255,255,255,0.12); padding:20px; margin-top:16px;">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">Browse Backup</MudText>
                            <MudText Typo="Typo.caption" Style="color:#888;">@browseContents.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy  h:mm tt") · @browseContents.TotalCount items</MudText>
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => browseContents = null"/>
                    </MudStack>

                    <!-- Filter + select all row -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField @bind-Value="browseFilter" Placeholder="Filter items…"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                     Immediate="true" Style="max-width:220px;" />
                        <MudCheckBox Value="browseSelectAll" Color="Color.Primary"
                                    Label="Select all" Dense="true"
                                    ValueChanged="@((bool v) => BrowseToggleAll(v))" />
                        <MudText Typo="Typo.caption" Style="color:#aaa;">@browseSelectedCount selected</MudText>
                    </MudStack>

                    <!-- Item groups -->
                    @if (BrowseVisible(browseContents.LoginItems) is { Count: > 0 } logins)
                    {
                        <MudText Typo="Typo.overline" Style="color:#9D9D9D; letter-spacing:1px;">LOGINS (@logins.Count)</MudText>
                        @foreach (var item in logins) { <BrowseItemRow Item="item" OnChanged="BrowseCountChanged" /> }
                    }
                    @if (BrowseVisible(browseContents.SecureNotes) is { Count: > 0 } notes)
                    {
                        <MudText Typo="Typo.overline" Style="color:#A78BFA; letter-spacing:1px;">SECURE NOTES (@notes.Count)</MudText>
                        @foreach (var item in notes) { <BrowseItemRow Item="item" OnChanged="BrowseCountChanged" /> }
                    }
                    @if (BrowseVisible(browseContents.CreditCards) is { Count: > 0 } cards)
                    {
                        <MudText Typo="Typo.overline" Style="color:#34D399; letter-spacing:1px;">CREDIT CARDS (@cards.Count)</MudText>
                        @foreach (var item in cards) { <BrowseItemRow Item="item" OnChanged="BrowseCountChanged" /> }
                    }
                    @if (BrowseVisible(browseContents.WifiItems) is { Count: > 0 } wifi)
                    {
                        <MudText Typo="Typo.overline" Style="color:#FBBF24; letter-spacing:1px;">WI-FI (@wifi.Count)</MudText>
                        @foreach (var item in wifi) { <BrowseItemRow Item="item" OnChanged="BrowseCountChanged" /> }
                    }

                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Outlined" OnClick="() => browseContents = null">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="browseSelectedCount == 0"
                                  OnClick="ImportSelected">
                            Import @browseSelectedCount Item(s)
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <!-- Save Button -->
        <MudPaper Class="pa-4" >
            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      OnClick="SaveSettings"
                      Size="Size.Large"
                      Disabled="isSaving">
                @if (isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ml-2">Saving...</MudText>
                }
                else
                {
                    <MudText>Save Settings</MudText>
                }
            </MudButton>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private UserDto userProfile = new();
    private List<ApiKey> apiKeys = new();
    private string newApiKeyName = "";
    private string selectedProviderForApiKey = "";
    private string generatedApiKey = "";
    private string generatedApiUrl = "";
    private string databaseProvider = "SqlServer";
    private string sqliteDatabasePath = "";
    private string authenticationMode = "LocalDatabase";
    private string supabaseUrl = "";
    private string supabaseApiKey = "";
    private string apiUrl = "";
    private string apiKey = "";
    private string clientId = "";
    private string clientSecret = "";
    private string dbServer = "";
    private string dbName = "";
    private string dbUser = "";
    private string dbPassword = "";
    private bool isGenerating = false;
    private bool isSaving = false;
    private bool isConnectionBusy = false;

    private AppThemeMode selectedTheme = AppThemeMode.Dark;

    // Accessibility
    private double A11yZoom = AccessibilityState.DefaultZoom;
    private double A11yFont = AccessibilityState.DefaultFont;
    private bool A11yReduceMotion = false;
    private bool A11yHighContrast = false;

    private async Task OnZoomChanged(double value) { A11yZoom = value; await SaveAndApplyAccessibilityAsync(); }
    private async Task OnFontChanged(double value) { A11yFont = value; await SaveAndApplyAccessibilityAsync(); }
    private async Task OnReduceMotionChanged(bool value) { A11yReduceMotion = value; await SaveAndApplyAccessibilityAsync(); }
    private async Task OnHighContrastChanged(bool value) { A11yHighContrast = value; await SaveAndApplyAccessibilityAsync(); }

    private async Task ResetAccessibility()
    {
        A11yZoom = AccessibilityState.DefaultZoom;
        A11yFont = AccessibilityState.DefaultFont;
        A11yReduceMotion = false;
        A11yHighContrast = false;
        await SaveAndApplyAccessibilityAsync();
    }

    private async Task SaveAndApplyAccessibilityAsync()
    {
        var prefs = new AccessibilityState.Prefs(A11yZoom, A11yFont, A11yReduceMotion, A11yHighContrast);
        await AccessibilityState.SaveAsync(JSRuntime, prefs);
        await AccessibilityState.ApplyAsync(JSRuntime, prefs);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Reflect the saved accessibility prefs in the controls (the values are already applied
        // to the document app-wide by the main layout).
        var prefs = await AccessibilityState.LoadAsync(JSRuntime);
        A11yZoom = prefs.Zoom;
        A11yFont = prefs.FontPx;
        A11yReduceMotion = prefs.ReduceMotion;
        A11yHighContrast = prefs.HighContrast;
        StateHasChanged();
    }

    // Cloud backup
    private bool enableCloudBackup = false;
    private string selectedCloudProvider = "OneDrive";
    private string backupSchedule = "Daily";
    private string googleDriveClientId = "";
    private string googleDriveClientSecret = "";
    private bool googleDriveConnected = false;
    private string googleDriveStatus = "";
    private bool isConnectingGDrive = false;
    private bool isCreatingBackup = false;
    private bool isLoadingBackups = false;
    private List<VaultGuard.Models.DTOs.CloudBackupInfo> cloudBackups = new();

    // Browse / selective restore state
    private VaultGuard.Models.DTOs.BackupContentsDto? browseContents = null;
    private string browseFilter = string.Empty;
    private bool browseSelectAll = true;
    private int browseSelectedCount = 0;

    private List<VaultGuard.Models.DTOs.BackupItemDto> BrowseVisible(List<VaultGuard.Models.DTOs.BackupItemDto> src)
        => string.IsNullOrWhiteSpace(browseFilter)
            ? src
            : src.Where(i => i.Title.Contains(browseFilter, StringComparison.OrdinalIgnoreCase)
                           || (i.Subtitle?.Contains(browseFilter, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private void BrowseCountChanged()
    {
        if (browseContents == null) return;
        browseSelectedCount = browseContents.LoginItems.Concat(browseContents.SecureNotes)
            .Concat(browseContents.CreditCards).Concat(browseContents.WifiItems)
            .Count(x => x.IsSelected);
        StateHasChanged();
    }

    private void BrowseToggleAll(bool value)
    {
        if (browseContents == null) return;
        foreach (var item in browseContents.LoginItems.Concat(browseContents.SecureNotes)
                                           .Concat(browseContents.CreditCards).Concat(browseContents.WifiItems))
            item.IsSelected = value;
        BrowseCountChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        selectedTheme = ThemeService.CurrentThemeMode;
        await LoadUserProfile();
        await LoadApiKeys();
        await LoadDatabaseConfiguration();
        requireCodeOnVaultDelete = await TwoFactorGate.GetToggleAsync(JSRuntime, TwoFactorGate.GateAction.VaultDelete);
        requireCodeOnItemDelete = await TwoFactorGate.GetToggleAsync(JSRuntime, TwoFactorGate.GateAction.ItemDelete);
    }

    private bool requireCodeOnVaultDelete = false;
    private bool requireCodeOnItemDelete = false;

    private async Task ForgetThisDevice()
    {
        try
        {
            var authService = ServiceProvider.GetService(typeof(IAuthService)) as IAuthService;
            var cache = ServiceProvider.GetService(typeof(IMasterKeyCacheService)) as IMasterKeyCacheService;
            var userId = authService is null ? null : await authService.GetCurrentUserIdAsync();
            if (cache is not null && !string.IsNullOrEmpty(userId))
            {
                await cache.ForgetAsync(userId);
                Snackbar.Add("This device has been forgotten. You'll need your master password next time.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't forget this device: {ex.Message}", Severity.Error);
        }
    }

    private AppThemeMode SelectedTheme
    {
        get => selectedTheme;
        set
        {
            if (selectedTheme != value)
            {
                selectedTheme = value;
                ThemeService.SetTheme(value);
                _ = ThemeService.DetectAndApplySystemThemeAsync(JSRuntime);
            }
        }
    }

    private async Task LoadUserProfile()
    {
        try
        {
            userProfile = await UserProfileService.GetCurrentUserAsync() ?? new UserDto();
        }
        catch (Exception ex)
        {
            // Handle error
            VaultGuard.Services.Logging.AppLogger.Error($"Error loading user profile", ex);
        }
    }

    private async Task LoadApiKeys()
    {
        try
        {
            if (!string.IsNullOrEmpty(userProfile.Id))
            {
                apiKeys = await ApiKeyService.GetUserApiKeysAsync(userProfile.Id);
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error loading API keys", ex);
        }
    }

    private async Task LoadDatabaseConfiguration()
    {
        try
        {
            var dbConfig = await DatabaseConfigurationService.GetConfigurationAsync();
            databaseProvider = dbConfig.Provider.ToString();
            authenticationMode = dbConfig.AuthenticationMode.ToString();
            apiUrl = dbConfig.ApiUrl ?? "";
            apiKey = dbConfig.ApiKey ?? "";
            clientId = AppSettings.Get("ApiClientId", "");
            clientSecret = AppSettings.Get("ApiClientSecret", "");
            dbServer = AppSettings.Get("dbserver", "");
            dbName = AppSettings.Get("dbname", "");
            dbUser = AppSettings.Get("dbusername", "");
            dbPassword = AppSettings.Get("dbpassword", "");
            
            // Load provider-specific settings
            switch (dbConfig.Provider)
            {
                case DatabaseProvider.Sqlite when dbConfig.Sqlite != null:
                    sqliteDatabasePath = dbConfig.Sqlite.DatabasePath;
                    break;
                case DatabaseProvider.SqlServer when dbConfig.SqlServer != null:
                    dbServer = string.IsNullOrWhiteSpace(dbServer) ? dbConfig.SqlServer.Host : dbServer;
                    dbName = string.IsNullOrWhiteSpace(dbName) ? dbConfig.SqlServer.Database : dbName;
                    dbUser = string.IsNullOrWhiteSpace(dbUser) ? dbConfig.SqlServer.Username ?? "" : dbUser;
                    dbPassword = string.IsNullOrWhiteSpace(dbPassword)
                        ? await DatabaseConfigurationService.DecryptPasswordAsync(dbConfig.SqlServer.EncryptedPassword ?? "")
                        : dbPassword;
                    break;
                case DatabaseProvider.Supabase when dbConfig.Supabase != null:
                    supabaseUrl = dbConfig.Supabase.Url;
                    supabaseApiKey = dbConfig.Supabase.ServiceKey;
                    break;
            }
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error loading database configuration", ex);
        }
    }

    private async Task GenerateApiKey()
    {
        try
        {
            isGenerating = true;
            generatedApiKey = "";
            generatedApiUrl = "";
            
            // Check if a provider is selected for provider-specific API key
            if (!string.IsNullOrEmpty(selectedProviderForApiKey))
            {
                // Create provider-specific API key
                if (Enum.TryParse<DatabaseProvider>(selectedProviderForApiKey, out var provider))
                {
                    var request = new VaultGuard.Models.DTOs.ApiKeyRequestDto
                    {
                        Name = newApiKeyName,
                        Provider = provider,
                        UseExistingConfig = true
                    };
                    
                    var response = await ApiKeyService.CreateProviderApiKeyAsync(request, userProfile.Id);
                    generatedApiKey = response.ApiKey;
                    generatedApiUrl = response.ApiUrl ?? "";
                }
            }
            else
            {
                // Create general API key
                var apiKeyResult = await ApiKeyService.CreateApiKeyAsync(newApiKeyName, userProfile.Id);
                generatedApiKey = apiKeyResult.KeyHash; // This contains the unhashed value temporarily
            }
            
            // Refresh the list
            await LoadApiKeys();
            
            // Clear the inputs
            newApiKeyName = "";
            selectedProviderForApiKey = "";
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error generating API key", ex);
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task CopyApiKey()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", generatedApiKey);
            // Show success notification
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error copying API key", ex);
        }
    }

    private async Task CopyConfiguredApiKey()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", apiKey);
            Snackbar.Add("API key copied.", Severity.Success);
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error copying configured API key", ex);
            Snackbar.Add("Couldn't copy the API key.", Severity.Error);
        }
    }

    private async Task DeleteApiKey(Guid keyId)
    {
        try
        {
            await ApiKeyService.DeleteApiKeyAsync(keyId, userProfile.Id);
            await LoadApiKeys();
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error deleting API key", ex);
        }
    }

    private string GetProviderDisplayName(DatabaseProvider? provider)
    {
        return provider switch
        {
            DatabaseProvider.SqlServer => "SQL Server",
            DatabaseProvider.MySql => "MySQL",
            DatabaseProvider.PostgreSql => "PostgreSQL",
            DatabaseProvider.Supabase => "Supabase",
            DatabaseProvider.Sqlite => "SQLite",
            _ => "General"
        };
    }

    private async Task SaveSettings()
    {
        try
        {
            isSaving = true;
            
            // Save user profile
            var updateDto = new UpdateUserProfileDto
            {
                Email = userProfile.Email,
                FirstName = userProfile.FirstName,
                LastName = userProfile.LastName
            };
            await UserProfileService.UpdateUserProfileAsync(updateDto);
            
            // Save database configuration
            var config = new DatabaseConfiguration
            {
                Provider = databaseProvider switch
                {
                    "Sqlite" => DatabaseProvider.Sqlite,
                    "SqlServer" => DatabaseProvider.SqlServer,
                    "MySql" => DatabaseProvider.MySql,
                    "PostgreSql" => DatabaseProvider.PostgreSql,
                    "Supabase" => DatabaseProvider.Supabase,
                    _ => DatabaseProvider.Sqlite
                },
                AuthenticationMode = authenticationMode == "ApiEndpoint"
                    ? VaultGuard.Models.Configuration.AuthenticationMode.ApiEndpoint
                    : VaultGuard.Models.Configuration.AuthenticationMode.LocalDatabase,
                ApiUrl = string.IsNullOrWhiteSpace(apiUrl) ? null : apiUrl,
                ApiKey = string.IsNullOrWhiteSpace(apiKey) ? null : apiKey
            };

            // Set SQLite configuration if selected
            if (databaseProvider == "Sqlite")
            {
                config.Sqlite = new SqliteConfig
                {
                    DatabasePath = string.IsNullOrWhiteSpace(sqliteDatabasePath)
                        ? "passwordmanager.db"
                        : sqliteDatabasePath,
                    ApiUrl = config.ApiUrl,
                    ApiKey = config.ApiKey
                };
            }

            if (databaseProvider == "SqlServer")
            {
                config.SqlServer = new SqlServerConfig
                {
                    Host = dbServer,
                    Database = string.IsNullOrWhiteSpace(dbName) ? "VaultGuard" : dbName,
                    Username = string.IsNullOrWhiteSpace(dbUser) ? null : dbUser,
                    EncryptedPassword = string.IsNullOrWhiteSpace(dbPassword)
                        ? null
                        : await DatabaseConfigurationService.EncryptPasswordAsync(dbPassword),
                    AuthMode = string.IsNullOrWhiteSpace(dbUser)
                        ? SqlServerAuthMode.WindowsAuthentication
                        : SqlServerAuthMode.SqlServerAuthentication,
                    ApiUrl = config.ApiUrl,
                    ApiKey = config.ApiKey
                };
            }

            // Set Supabase configuration if selected
            if (databaseProvider == "Supabase")
            {
                config.Supabase = new SupabaseConfig
                {
                    Url = supabaseUrl,
                    ServiceKey = supabaseApiKey,
                    ApiUrl = config.ApiUrl,
                    ApiKey = config.ApiKey
                };
            }
            
            await DatabaseConfigurationService.SaveConfigurationAsync(config);

            AppSettings.Set("AuthMode", authenticationMode == "ApiEndpoint" ? "API Server" : "Local Database");
            AppSettings.Set("ApiBaseUrl", apiUrl);
            AppSettings.Set("ApiKey", apiKey);
            AppSettings.Set("ApiClientId", clientId);
            AppSettings.Set("ApiClientSecret", clientSecret);
            AppSettings.Set("dbserver", dbServer);
            AppSettings.Set("dbname", dbName);
            AppSettings.Set("dbusername", dbUser);
            AppSettings.Set("dbpassword", dbPassword);
            AppSettings.Set("DatabaseProvider", databaseProvider);
            if (databaseProvider == "Sqlite")
                AppSettings.Set("SqliteDatabasePath", string.IsNullOrWhiteSpace(sqliteDatabasePath) ? "passwordmanager.db" : sqliteDatabasePath);
            AppSettings.Save();

            Snackbar.Add("Settings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            VaultGuard.Services.Logging.AppLogger.Error($"Error saving settings", ex);
            Snackbar.Add($"Couldn't save settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TestApiConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(apiUrl))
        {
            Snackbar.Add("Enter the API URL first.", Severity.Warning);
            return;
        }

        isConnectionBusy = true;
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(8);
            if (!string.IsNullOrWhiteSpace(apiKey))
                client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
            if (!string.IsNullOrWhiteSpace(clientId))
                client.DefaultRequestHeaders.Add("X-Client-Id", clientId);

            var response = await client.GetAsync($"{apiUrl.TrimEnd('/')}/health");
            Snackbar.Add(
                response.IsSuccessStatusCode
                    ? "API reachable — health check passed."
                    : $"API responded with {(int)response.StatusCode} {response.ReasonPhrase}.",
                response.IsSuccessStatusCode ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not reach the API: {ex.Message}", Severity.Error);
        }
        finally
        {
            isConnectionBusy = false;
        }
    }

    private async Task TestSqlServerConnectionAsync()
    {
        isConnectionBusy = true;
        try
        {
            var config = new DatabaseConfiguration
            {
                Provider = DatabaseProvider.SqlServer,
                SqlServer = new SqlServerConfig
                {
                    Host = dbServer,
                    Database = string.IsNullOrWhiteSpace(dbName) ? "VaultGuard" : dbName,
                    Username = string.IsNullOrWhiteSpace(dbUser) ? null : dbUser,
                    EncryptedPassword = string.IsNullOrWhiteSpace(dbPassword)
                        ? null
                        : await DatabaseConfigurationService.EncryptPasswordAsync(dbPassword),
                    AuthMode = string.IsNullOrWhiteSpace(dbUser)
                        ? SqlServerAuthMode.WindowsAuthentication
                        : SqlServerAuthMode.SqlServerAuthentication
                }
            };

            var result = await DatabaseConfigurationService.TestConnectionAsync(config);
            Snackbar.Add(result.Success ? "SQL Server connection succeeded." : result.ErrorMessage,
                result.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't connect to SQL Server: {ex.Message}", Severity.Error);
        }
        finally
        {
            isConnectionBusy = false;
        }
    }

