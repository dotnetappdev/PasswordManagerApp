    private async Task PerformDatabaseReset(bool preserveUsers, bool reseedData = false)
    {
        try
        {
            DatabaseResetResult result;

            if (preserveUsers)
            {
                result = await DatabaseResetService.ResetDataTablesAsync();
            }
            else
            {
                result = await DatabaseResetService.ResetAllTablesAsync(reseedData);
            }

            // Show result
            var resultMessage = result.Success 
                ? $"✓ Reset Complete\n\n{result.Message}\n\nTables cleared: {result.TablesCleared}\nRecords deleted: {result.RecordsDeleted}"
                : $"❌ Reset Failed\n\n{result.Message}";

            if (result.Errors.Any())
            {
                resultMessage += $"\n\nWarnings:\n{string.Join("\n", result.Errors.Take(5))}";
            }

            await JSRuntime.InvokeVoidAsync("alert", resultMessage);

            if (result.Success && !preserveUsers)
            {
                // Navigate to login page
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"❌ Reset Failed\n\nAn error occurred: {ex.Message}");
        }
    }

