    private async Task RestoreBackup(VaultGuard.Models.DTOs.CloudBackupInfo backup)
    {
        // Two-step warning — first confirm destructive action, then ask for password
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"⚠️ RESTORE BACKUP\n\nThis will permanently remove ALL your current passwords, notes, credit cards, and Wi-Fi entries and replace them with the backup from:\n\n{backup.CreatedAtFormatted}\n\nThis cannot be undone. Continue?");
        if (!confirmed) return;

        var password = await JSRuntime.InvokeAsync<string>("prompt",
            "Enter your master password to decrypt and restore the backup:");
        if (string.IsNullOrEmpty(password)) return;

        try
        {
            var backupSvc = ServiceProvider.GetService<VaultGuard.Services.Interfaces.IDatabaseBackupService>();
            var cloudMgr = ServiceProvider.GetService<VaultGuard.Services.Services.CloudBackupManager>();
            if (backupSvc == null || cloudMgr == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Restore service unavailable.");
                return;
            }
            var rawData = await cloudMgr.DownloadBackupDataAsync(backup);
            if (rawData == null) { await JSRuntime.InvokeVoidAsync("alert", "Could not download backup."); return; }
            var ok = await backupSvc.RestoreFullAsync(rawData, password);
            await JSRuntime.InvokeVoidAsync("alert", ok
                ? "✅ Backup restored. Please refresh the page."
                : "❌ Restore failed — check your master password.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Restore error: {ex.Message}");
        }
    }

    private async Task BrowseBackup(VaultGuard.Models.DTOs.CloudBackupInfo backup)
    {
        var password = await JSRuntime.InvokeAsync<string>("prompt",
            $"Enter master password to browse backup from {backup.CreatedAtFormatted}:");
        if (string.IsNullOrEmpty(password)) return;

        try
        {
            var backupSvc = ServiceProvider.GetService<VaultGuard.Services.Interfaces.IDatabaseBackupService>();
            var cloudMgr = ServiceProvider.GetService<VaultGuard.Services.Services.CloudBackupManager>();
            if (backupSvc == null || cloudMgr == null) return;
            var rawData = await cloudMgr.DownloadBackupDataAsync(backup);
            if (rawData == null) { await JSRuntime.InvokeVoidAsync("alert", "Could not download backup."); return; }
            var contents = await backupSvc.BrowseBackupAsync(rawData, password);
            if (contents == null || contents.TotalCount == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Could not read backup — check your master password.");
                return;
            }
            browseContents = contents;
            browseContents.BackupId = backup.Id;
            BrowseCountChanged();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Browse error: {ex.Message}");
        }
    }

    private async Task ImportSelected()
    {
        if (browseContents == null) return;
        var selectedIds = browseContents.LoginItems.Concat(browseContents.SecureNotes)
            .Concat(browseContents.CreditCards).Concat(browseContents.WifiItems)
            .Where(x => x.IsSelected).Select(x => x.Id).ToList();
        if (!selectedIds.Any()) return;

        try
        {
            var backupSvc = ServiceProvider.GetService<VaultGuard.Services.Interfaces.IDatabaseBackupService>();
            if (backupSvc == null) return;
            var imported = await backupSvc.ImportSelectedItemsAsync(browseContents, selectedIds);
            browseContents = null;
            await JSRuntime.InvokeVoidAsync("alert", $"✅ {imported} item(s) added to your vault.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Import error: {ex.Message}");
        }
    }

    private async Task DeleteBackup(VaultGuard.Models.DTOs.CloudBackupInfo backup)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Delete backup from {backup.CreatedAtFormatted}? This cannot be undone.");
        if (!confirmed) return;

        if (!await TwoFactorGate.RequireCodeForActionAsync(
                DialogService, TwoFactorService, AuthService, JSRuntime,
                TwoFactorGate.GateAction.CloudBackupDelete))
        {
            return;
        }

        try
        {
            var cloudMgr = ServiceProvider.GetService<VaultGuard.Services.Services.CloudBackupManager>();
            if (cloudMgr != null) await cloudMgr.DeleteBackupAsync(backup.Provider, backup.Id);
            cloudBackups.Remove(backup);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Delete error: {ex.Message}");
        }
    }
