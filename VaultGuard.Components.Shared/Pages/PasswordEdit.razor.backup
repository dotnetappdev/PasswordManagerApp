@page "/password/{id:guid}/edit"
@page "/password/new"
@attribute [Authorize]
@using PasswordManager.Services.Interfaces
@using PasswordManager.Models
@inject IPasswordItemService PasswordItemService
@inject ICategoryInterface CategoryService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="modern-content">
    <div class="modern-flex-column">
        <!-- Header -->
        <div class="modern-card">
            <h1 style="margin: 0; display: flex; align-items: center; gap: 12px;">
                <span>🔑</span>
                @(IsNewPassword ? "Add New Password" : "Edit Password")
            </h1>
        </div>

        <!-- Password Form -->
        <div class="modern-card">
            <form class="modern-form" @onsubmit="SavePassword" @onsubmit:preventDefault="true">
                <div class="modern-form-group">
                    <label class="modern-form-label">Title *</label>
                    <input type="text" @bind="passwordItem.Title" class="modern-textbox @(titleError ? "validation-error" : "")" 
                           placeholder="Enter title" required />
                    @if (titleError)
                    {
                        <div class="validation-message">Title is required</div>
                    }
                </div>
                
                <div class="modern-form-group">
                    <label class="modern-form-label">Username</label>
                    <input type="text" @bind="passwordItem.Username" class="modern-textbox" 
                           placeholder="Enter username" />
                </div>
                
                <div class="modern-form-group">
                    <label class="modern-form-label">Password *</label>
                    <div class="modern-form-row">
                        <input type="@(isPasswordVisible ? "text" : "password")" @bind="passwordItem.Password" 
                               class="modern-textbox @(passwordError ? "validation-error" : "")" 
                               placeholder="Enter password" required />
                        <button type="button" class="modern-icon-button" @onclick="TogglePasswordVisibility" title="Toggle password visibility">
                            @(isPasswordVisible ? "🙈" : "👁️")
                        </button>
                        <button type="button" class="modern-button-secondary" @onclick="GeneratePassword">
                            🔄 Generate
                        </button>
                    </div>
                    @if (passwordError)
                    {
                        <div class="validation-message">Password is required</div>
                    }
                </div>
                
                <div class="modern-form-group">
                    <label class="modern-form-label">Website URL</label>
                    <input type="url" @bind="passwordItem.WebsiteUrl" class="modern-textbox" 
                           placeholder="https://example.com" />
                </div>
                
                <div class="modern-form-group">
                    <label class="modern-form-label">Notes</label>
                    <textarea @bind="passwordItem.Description" class="modern-textbox" rows="3" 
                              placeholder="Additional notes..."></textarea>
                </div>
                
                <div class="modern-form-group">
                    <label class="modern-form-label">Category</label>
                    <select @bind="selectedCategoryId" class="modern-textbox">
                        <option value="">Select a category</option>
                        @if (categories != null)
                        {
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                </div>

                @if (isSaving)
                {
                    <div class="modern-loading">
                        <div class="modern-spinner"></div>
                        <span>Saving password...</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="inline-notification error">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="inline-notification success">
                        @successMessage
                    </div>
                }

                <!-- Form Actions -->
                <div class="modern-flex" style="gap: 12px; margin-top: 24px;">
                    <button type="submit" class="modern-button" disabled="@isSaving">
                        💾 @(IsNewPassword ? "Save Password" : "Update Password")
                    </button>
                    <button type="button" class="modern-button-secondary" @onclick="Cancel">
                        ❌ Cancel
                    </button>
                    @if (!IsNewPassword)
                    {
                        <button type="button" class="modern-button-error" @onclick="DeletePassword">
                            🗑️ Delete
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudButton Variant="Variant.Filled" 
                                      Color="Color.Secondary" 
                                      OnClick="GeneratePassword"
                                      FullWidth="true">
                                Generate
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    
                    <MudTextField @bind-value="passwordItem.WebsiteUrl" 
                                 Label="Website URL" 
                                 Variant="Variant.Outlined"
                                 Style="background-color: #2a2a2a;"
                                 For="@(() => passwordItem.WebsiteUrl)" />
                    
                    <MudTextField @bind-value="passwordItem.Description" 
                                 Label="Notes" 
                                 Variant="Variant.Outlined"
                                 Lines="3"
                                 Style="background-color: #2a2a2a;"
                                 For="@(() => passwordItem.Description)" />
                    
                    <MudSelect T="int?" @bind-value="passwordItem.CategoryId" 
                              Label="Category" 
                              Variant="Variant.Outlined"
                              Style="background-color: #2a2a2a;">
                        @foreach (var category in categories)
                        {
                            <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </MudForm>
        </MudPaper>

        <!-- Password Generator Options -->
        @if (showGeneratorOptions)
        {
            <MudPaper Class="pa-4" Style="background-color: #1e1e1e; color: white;">
                <MudText Typo="Typo.h6" Style="color: white; margin-bottom: 16px;">Password Generator Options</MudText>
                <MudStack Spacing="3">
                    <MudSlider @bind-value="passwordLength" 
                              Min="8" 
                              Max="128" 
                              Step="1" 
                              Color="Color.Primary"
                              Text="@($"Length: {passwordLength}")" />
                    
                    <MudSwitch T="bool" @bind-value="includeUppercase" 
                              Label="Include Uppercase Letters" 
                              Color="Color.Primary" />
                    
                    <MudSwitch T="bool" @bind-value="includeLowercase" 
                              Label="Include Lowercase Letters" 
                              Color="Color.Primary" />
                    
                    <MudSwitch T="bool" @bind-value="includeNumbers" 
                              Label="Include Numbers" 
                              Color="Color.Primary" />
                    
                    <MudSwitch T="bool" @bind-value="includeSymbols" 
                              Label="Include Symbols" 
                              Color="Color.Primary" />
                    
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Secondary" 
                              OnClick="GeneratePassword">
                        Generate New Password
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <!-- Actions -->
        <MudPaper Class="pa-4" Style="background-color: #1e1e1e; color: white;">
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          OnClick="SavePassword"
                          Disabled="isSaving">
                    @if (isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ml-2">Saving...</MudText>
                    }
                    else
                    {
                        <MudText>@(IsNewPassword ? "Add Password" : "Save Changes")</MudText>
                    }
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                          Color="Color.Secondary" 
                          OnClick="Cancel">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Text" 
                          Color="Color.Info" 
                          OnClick="() => showGeneratorOptions = !showGeneratorOptions">
                    @(showGeneratorOptions ? "Hide" : "Show") Generator Options
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [Parameter] public int? Id { get; set; }
    
    private PasswordItem passwordItem = new();
    private List<Category> categories = new();
    private MudForm? form;
    private bool isPasswordVisible = false;
    private bool isSaving = false;
    private bool showGeneratorOptions = false;
    
    // Password generator options
    private int passwordLength = 16;
    private bool includeUppercase = true;
    private bool includeLowercase = true;
    private bool includeNumbers = true;
    private bool includeSymbols = true;

    // Validation fields
    private bool titleError = false;
    private bool passwordError = false;
    private string? errorMessage = null;
    private string? successMessage = null;
    private int? selectedCategoryId = null;

    private bool IsNewPassword => Id == null || Id == 0;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/masterpassword");
            return;
        }

        await LoadCategories();
        
        if (!IsNewPassword)
        {
            await LoadPassword();
        }
        else
        {
            passwordItem = new PasswordItem
            {
                Type = ItemType.Login,
                CreatedAt = DateTime.UtcNow,
                LastModified = DateTime.UtcNow
            };
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading categories: {ex.Message}");
        }
    }

    private async Task LoadPassword()
    {
        try
        {
            if (Id.HasValue)
            {
                passwordItem = await PasswordItemService.GetByIdAsync(Id.Value) ?? new PasswordItem();
                selectedCategoryId = passwordItem.CategoryId;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading password: {ex.Message}";
            Console.WriteLine($"Error loading password: {ex.Message}");
        }
    }

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    private void GeneratePassword()
    {
        var chars = "";
        if (includeUppercase) chars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        if (includeLowercase) chars += "abcdefghijklmnopqrstuvwxyz";
        if (includeNumbers) chars += "0123456789";
        if (includeSymbols) chars += "!@#$%^&*()_+-=[]{}|;:,.<>?";

        if (string.IsNullOrEmpty(chars))
        {
            chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        }

        var random = new Random();
        var password = new string(Enumerable.Repeat(chars, passwordLength)
            .Select(s => s[random.Next(s.Length)]).ToArray());

        passwordItem.Password = password;
    }

    private async Task SavePassword()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;
            
            // Basic validation
            titleError = string.IsNullOrEmpty(passwordItem.Title);
            passwordError = string.IsNullOrEmpty(passwordItem.Password);
            
            if (titleError || passwordError)
            {
                errorMessage = "Please fix the validation errors above.";
                return;
            }
            
            if (form != null)
            {
                await form.Validate();
                if (!form.IsValid)
                {
                    return;
                }
            }

            passwordItem.LastModified = DateTime.UtcNow;
            
            // Set category if selected
            if (selectedCategoryId.HasValue)
            {
                passwordItem.CategoryId = selectedCategoryId.Value;
            }

            if (IsNewPassword)
            {
                await PasswordItemService.CreateAsync(passwordItem);
                successMessage = "Password created successfully!";
            }
            else
            {
                await PasswordItemService.UpdateAsync(passwordItem);
                successMessage = "Password updated successfully!";
            }

            Navigation.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving password: {ex.Message}";
            Console.WriteLine($"Error saving password: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        if (IsNewPassword)
        {
            Navigation.NavigateTo("/vault");
        }
        else
        {
            Navigation.NavigateTo($"/password/{Id}");
        }
    }

    private IEnumerable<string> ValidateModel(object model)
    {
        var item = model as PasswordItem;
        if (item == null) yield break;

        if (string.IsNullOrEmpty(item.Title))
            yield return "Title is required";

        if (string.IsNullOrEmpty(item.Password))
            yield return "Password is required";
    }

    private async Task DeletePassword()
    {
        try
        {
            if (Id.HasValue)
            {
                await PasswordItemService.DeleteAsync(Id.Value);
                Navigation.NavigateTo("/vault");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting password: {ex.Message}";
        }
    }
}
