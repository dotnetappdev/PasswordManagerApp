@using VaultGuard.Models.Configuration
@using VaultGuard.Services.Interfaces
@using VaultGuard.Services.DTOs
@inject IDatabaseConfigurationService DatabaseConfigService
@inject IDatabaseMigrationService MigrationService
@inject IJSRuntime JSRuntime

<div class="database-selection-overlay @(IsVisible ? "visible" : "")">
    <div class="database-selection-dialog">
        <div class="dialog-header">
            <h2 class="dialog-title">
                <i class="fas fa-database"></i>
                Database Configuration
            </h2>
            <p class="dialog-subtitle">@GetWizardSubtitle()</p>
            <p class="dialog-subtitle" style="font-size: 0.85rem; margin-top: 0.5rem;">
                Step @(CurrentStep == SetupWizardStep.ProviderSelection ? 1 : 2) of 2
            </p>
        </div>

        <div class="dialog-content">

                @if (CurrentStep == SetupWizardStep.ProviderSelection)
                {
                    <!-- Step 1: provider selection — no EditForm, plain buttons -->
                    <div class="provider-selection">
                        <h3>Select Database Provider</h3>
                        <div class="provider-grid">
                            <button type="button"
                                    class="provider-card local-provider @(Configuration.Provider == DatabaseProvider.Sqlite ? "selected" : "")"
                                    @onclick="() => SelectProvider(DatabaseProvider.Sqlite)">
                                <div class="provider-icon">
                                    <i class="fas fa-laptop"></i>
                                </div>
                                <div class="provider-info">
                                    <h4>Local (SQLite)</h4>
                                    <p>Local file database - no server required</p>
                                    <span class="provider-badge recommended">Recommended</span>
                                </div>
                            </button>

                            <button type="button"
                                    class="provider-card @(Configuration.Provider == DatabaseProvider.SqlServer ? "selected" : "")"
                                    @onclick="() => SelectProvider(DatabaseProvider.SqlServer)">
                                <div class="provider-icon">
                                    <i class="fas fa-server"></i>
                                </div>
                                <div class="provider-info">
                                    <h4>MS SQL Server</h4>
                                    <p>Microsoft SQL Server</p>
                                </div>
                            </button>

                            <button type="button"
                                    class="provider-card @(Configuration.Provider == DatabaseProvider.MySql ? "selected" : "")"
                                    @onclick="() => SelectProvider(DatabaseProvider.MySql)">
                                <div class="provider-icon">
                                    <i class="fas fa-database"></i>
                                </div>
                                <div class="provider-info">
                                    <h4>MySQL</h4>
                                    <p>MySQL/MariaDB Server</p>
                                </div>
                            </button>

                            <button type="button"
                                    class="provider-card @(Configuration.Provider == DatabaseProvider.PostgreSql ? "selected" : "")"
                                    @onclick="() => SelectProvider(DatabaseProvider.PostgreSql)">
                                <div class="provider-icon">
                                    <i class="fas fa-elephant"></i>
                                </div>
                                <div class="provider-info">
                                    <h4>PostgreSQL</h4>
                                    <p>PostgreSQL Server</p>
                                </div>
                            </button>
                        </div>
                    </div>

                    <div class="dialog-actions">
                        <button type="button"
                                class="btn btn-primary"
                                @onclick="GoToConfigurationStep">
                            Continue
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                }
                else
                {
                <!-- Step 2: configuration — EditForm only wraps this step -->
                <EditForm Model="Configuration" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                    <!-- Step 2: Configuration Forms -->
                    <div class="configuration-section">

                        @if (Configuration.Provider == DatabaseProvider.Sqlite)
                        {
                            <!-- SQLite: no tabs needed -->
                            <div class="config-form">
                                <h3>SQLite Configuration</h3>
                                <div class="form-group">
                                    <label for="sqlitePath">Database File Path</label>
                                    <input type="text"
                                           @bind="Configuration.Sqlite!.DatabasePath"
                                           id="sqlitePath"
                                           class="form-control"
                                           placeholder="Enter database file path" />
                                    <small class="form-text">Leave empty to use the default location</small>
                                </div>
                            </div>
                        }
                        else if (Configuration.Provider == DatabaseProvider.SqlServer)
                        {
                            <!-- SQL Server: tabbed configuration -->
                            <div class="config-form">
                                <h3>SQL Server Configuration</h3>
                                <div class="config-tabs">
                                    <button type="button"
                                            class="config-tab @(_activeTab == "general" ? "active" : "")"
                                            @onclick='() => SetActiveTab("general")'>
                                        General
                                    </button>
                                    <button type="button"
                                            class="config-tab @(_activeTab == "security" ? "active" : "")"
                                            @onclick='() => SetActiveTab("security")'>
                                        Security
                                    </button>
                                    <button type="button"
                                            class="config-tab @(_activeTab == "advanced" ? "active" : "")"
                                            @onclick='() => SetActiveTab("advanced")'>
                                        Advanced
                                    </button>
                                </div>

                                <div class="config-tab-content">

                                    @if (_activeTab == "general")
                                    {
                                        <div class="form-row">
                                            <div class="form-group col-md-8">
                                                <label for="sqlServerHost">Server</label>
                                                <InputText @bind-Value="Configuration.SqlServer!.Host"
                                                           id="sqlServerHost"
                                                           class="form-control"
                                                           placeholder="localhost or server name" />
                                                <ValidationMessage For="() => Configuration.SqlServer.Host" />
                                            </div>
                                            <div class="form-group col-md-4">
                                                <label for="sqlServerPort">Port</label>
                                                <InputNumber @bind-Value="Configuration.SqlServer!.Port"
                                                             id="sqlServerPort"
                                                             class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="sqlServerInstance">Instance Name</label>
                                            <InputText @bind-Value="Configuration.SqlServer!.InstanceName"
                                                       id="sqlServerInstance"
                                                       class="form-control"
                                                       placeholder="optional named instance" />
                                        </div>
                                        <div class="form-group">
                                            <label for="sqlServerDatabase">Database</label>
                                            <InputText @bind-Value="Configuration.SqlServer!.Database"
                                                       id="sqlServerDatabase"
                                                       class="form-control"
                                                       placeholder="Database name" />
                                            <ValidationMessage For="() => Configuration.SqlServer.Database" />
                                        </div>
                                        <div class="form-group">
                                            <label for="sqlServerAuthMode">Authentication</label>
                                            <select @bind="Configuration.SqlServer!.AuthMode"
                                                    id="sqlServerAuthMode"
                                                    class="form-control">
                                                <option value="@SqlServerAuthMode.WindowsAuthentication">Windows Authentication</option>
                                                <option value="@SqlServerAuthMode.SqlServerAuthentication">SQL Server Authentication</option>
                                            </select>
                                        </div>
                                        @if (Configuration.SqlServer!.AuthMode == SqlServerAuthMode.SqlServerAuthentication)
                                        {
                                            <div class="form-group">
                                                <label for="sqlServerUser">Username</label>
                                                <InputText @bind-Value="Configuration.SqlServer!.Username"
                                                           id="sqlServerUser"
                                                           class="form-control"
                                                           placeholder="Username" />
                                            </div>
                                            <div class="form-group">
                                                <label for="sqlServerPass">Password</label>
                                                <input type="password"
                                                       @bind="SqlServerPassword"
                                                       id="sqlServerPass"
                                                       class="form-control"
                                                       placeholder="Password" />
                                            </div>
                                        }
                                    }

                                    @if (_activeTab == "security")
                                    {
                                        <div class="form-group">
                                            <label for="sqlServerEncryption">Encryption</label>
                                            <select @bind="Configuration.SqlServer!.Encryption"
                                                    id="sqlServerEncryption"
                                                    class="form-control">
                                                <option value="@SqlServerEncryptionMode.None">None</option>
                                                <option value="@SqlServerEncryptionMode.Optional">Optional</option>
                                                <option value="@SqlServerEncryptionMode.Mandatory">Mandatory</option>
                                                <option value="@SqlServerEncryptionMode.Strict">Strict</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.SqlServer!.TrustServerCertificate"
                                                               id="trustCert"
                                                               class="form-check-input" />
                                                <label for="trustCert" class="form-check-label">Trust Server Certificate</label>
                                            </div>
                                        </div>
                                        @if (Configuration.SqlServer!.Encryption == SqlServerEncryptionMode.Mandatory ||
                                             Configuration.SqlServer!.Encryption == SqlServerEncryptionMode.Strict)
                                        {
                                            <div class="form-group">
                                                <label for="sqlServerCert">Certificate thumbprint or path</label>
                                                <InputText @bind-Value="Configuration.SqlServer!.ServerCertificate"
                                                           id="sqlServerCert"
                                                           class="form-control"
                                                           placeholder="optional" />
                                            </div>
                                        }
                                    }

                                    @if (_activeTab == "advanced")
                                    {
                                        <!-- Connection sub-section -->
                                        <div class="form-group">
                                            <label for="sqlNetworkProtocol">Network Protocol</label>
                                            <select @bind="Configuration.SqlServer!.NetworkProtocol"
                                                    id="sqlNetworkProtocol"
                                                    class="form-control">
                                                <option value="@SqlServerNetworkProtocol.Default">Default</option>
                                                <option value="@SqlServerNetworkProtocol.TcpIp">TCP/IP</option>
                                                <option value="@SqlServerNetworkProtocol.NamedPipes">Named Pipes</option>
                                                <option value="@SqlServerNetworkProtocol.SharedMemory">Shared Memory</option>
                                            </select>
                                        </div>
                                        <div class="form-row">
                                            <div class="form-group col-md-6">
                                                <label for="sqlPacketSize">Packet Size</label>
                                                <InputNumber @bind-Value="Configuration.SqlServer!.PacketSize"
                                                             id="sqlPacketSize"
                                                             class="form-control"
                                                             min="512"
                                                             max="32767" />
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label for="sqlConnTimeout">Connection Timeout (seconds)</label>
                                                <InputNumber @bind-Value="Configuration.SqlServer!.ConnectionTimeout"
                                                             id="sqlConnTimeout"
                                                             class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-row">
                                            <div class="form-group col-md-6">
                                                <label for="sqlCmdTimeout">Command Timeout (seconds)</label>
                                                <InputNumber @bind-Value="Configuration.SqlServer!.CommandTimeout"
                                                             id="sqlCmdTimeout"
                                                             class="form-control" />
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label for="sqlAppName">Application Name</label>
                                                <InputText @bind-Value="Configuration.SqlServer!.ApplicationName"
                                                           id="sqlAppName"
                                                           class="form-control"
                                                           placeholder="VaultGuard" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="sqlWorkstationId">Workstation ID</label>
                                            <InputText @bind-Value="Configuration.SqlServer!.WorkstationId"
                                                       id="sqlWorkstationId"
                                                       class="form-control"
                                                       placeholder="optional" />
                                        </div>

                                        <hr class="section-divider" />

                                        <!-- Pooling & Behavior sub-section -->
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.SqlServer!.MultipleActiveResultSets"
                                                               id="sqlMars"
                                                               class="form-check-input" />
                                                <label for="sqlMars" class="form-check-label">Multiple Active Result Sets (MARS)</label>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="sqlAppIntent">Application Intent</label>
                                            <select @bind="Configuration.SqlServer!.ApplicationIntent"
                                                    id="sqlAppIntent"
                                                    class="form-control">
                                                <option value="@SqlServerApplicationIntent.ReadWrite">ReadWrite</option>
                                                <option value="@SqlServerApplicationIntent.ReadOnly">ReadOnly</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.SqlServer!.MultiSubnetFailover"
                                                               id="sqlMultiSubnet"
                                                               class="form-check-input" />
                                                <label for="sqlMultiSubnet" class="form-check-label">Multi-Subnet Failover</label>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="sqlFailoverPartner">Failover Partner</label>
                                            <InputText @bind-Value="Configuration.SqlServer!.FailoverPartner"
                                                       id="sqlFailoverPartner"
                                                       class="form-control"
                                                       placeholder="optional" />
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.SqlServer!.Pooling"
                                                               id="sqlPooling"
                                                               class="form-check-input" />
                                                <label for="sqlPooling" class="form-check-label">Connection Pooling</label>
                                            </div>
                                        </div>
                                        @if (Configuration.SqlServer!.Pooling)
                                        {
                                            <div class="form-row">
                                                <div class="form-group col-md-6">
                                                    <label for="sqlMinPool">Min Pool Size</label>
                                                    <InputNumber @bind-Value="Configuration.SqlServer!.MinPoolSize"
                                                                 id="sqlMinPool"
                                                                 class="form-control" />
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label for="sqlMaxPool">Max Pool Size</label>
                                                    <InputNumber @bind-Value="Configuration.SqlServer!.MaxPoolSize"
                                                                 id="sqlMaxPool"
                                                                 class="form-control" />
                                                </div>
                                            </div>
                                        }
                                        <div class="form-group">
                                            <label for="sqlAdditionalParams">Additional Parameters</label>
                                            <textarea @bind="Configuration.SqlServer!.AdditionalParameters"
                                                      id="sqlAdditionalParams"
                                                      class="form-control"
                                                      rows="3"
                                                      placeholder="key=value;key2=value2 — appended verbatim"></textarea>
                                        </div>
                                    }

                                </div>
                            </div>
                        }
                        else if (Configuration.Provider == DatabaseProvider.MySql)
                        {
                            <!-- MySQL: tabbed configuration -->
                            <div class="config-form">
                                <h3>MySQL Configuration</h3>
                                <div class="config-tabs">
                                    <button type="button"
                                            class="config-tab @(_activeTab == "general" ? "active" : "")"
                                            @onclick='() => SetActiveTab("general")'>
                                        General
                                    </button>
                                    <button type="button"
                                            class="config-tab @(_activeTab == "security" ? "active" : "")"
                                            @onclick='() => SetActiveTab("security")'>
                                        Security
                                    </button>
                                    <button type="button"
                                            class="config-tab @(_activeTab == "advanced" ? "active" : "")"
                                            @onclick='() => SetActiveTab("advanced")'>
                                        Advanced
                                    </button>
                                </div>

                                <div class="config-tab-content">

                                    @if (_activeTab == "general")
                                    {
                                        <div class="form-row">
                                            <div class="form-group col-md-8">
                                                <label for="mysqlHost">Server</label>
                                                <InputText @bind-Value="Configuration.MySql!.Host"
                                                           id="mysqlHost"
                                                           class="form-control"
                                                           placeholder="localhost or server name" />
                                                <ValidationMessage For="() => Configuration.MySql.Host" />
                                            </div>
                                            <div class="form-group col-md-4">
                                                <label for="mysqlPort">Port</label>
                                                <InputNumber @bind-Value="Configuration.MySql!.Port"
                                                             id="mysqlPort"
                                                             class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="mysqlDatabase">Database</label>
                                            <InputText @bind-Value="Configuration.MySql!.Database"
                                                       id="mysqlDatabase"
                                                       class="form-control"
                                                       placeholder="Database name" />
                                            <ValidationMessage For="() => Configuration.MySql.Database" />
                                        </div>
                                        <div class="form-group">
                                            <label for="mysqlUser">Username</label>
                                            <InputText @bind-Value="Configuration.MySql!.Username"
                                                       id="mysqlUser"
                                                       class="form-control"
                                                       placeholder="Username" />
                                            <ValidationMessage For="() => Configuration.MySql.Username" />
                                        </div>
                                        <div class="form-group">
                                            <label for="mysqlPass">Password</label>
                                            <input type="password"
                                                   @bind="MySqlPassword"
                                                   id="mysqlPass"
                                                   class="form-control"
                                                   placeholder="Password" />
                                        </div>
                                    }

                                    @if (_activeTab == "security")
                                    {
                                        <div class="form-group">
                                            <label for="mysqlSslMode">SSL Mode</label>
                                            <select @bind="Configuration.MySql!.SslMode"
                                                    id="mysqlSslMode"
                                                    class="form-control">
                                                <option value="@MySqlSslMode.None">None</option>
                                                <option value="@MySqlSslMode.Preferred">Preferred</option>
                                                <option value="@MySqlSslMode.Required">Required</option>
                                                <option value="@MySqlSslMode.VerifyCA">VerifyCA</option>
                                                <option value="@MySqlSslMode.VerifyFull">VerifyFull</option>
                                            </select>
                                        </div>
                                        @if (Configuration.MySql!.SslMode == MySqlSslMode.VerifyCA ||
                                             Configuration.MySql!.SslMode == MySqlSslMode.VerifyFull)
                                        {
                                            <div class="form-group">
                                                <label for="mysqlSslCa">CA Certificate Path</label>
                                                <InputText @bind-Value="Configuration.MySql!.SslCaPath"
                                                           id="mysqlSslCa"
                                                           class="form-control"
                                                           placeholder="/path/to/ca-cert.pem" />
                                            </div>
                                            <div class="form-group">
                                                <label for="mysqlSslCert">Client Certificate Path</label>
                                                <InputText @bind-Value="Configuration.MySql!.SslCertPath"
                                                           id="mysqlSslCert"
                                                           class="form-control"
                                                           placeholder="/path/to/client-cert.pem" />
                                            </div>
                                            <div class="form-group">
                                                <label for="mysqlSslKey">Client Key Path</label>
                                                <InputText @bind-Value="Configuration.MySql!.SslKeyPath"
                                                           id="mysqlSslKey"
                                                           class="form-control"
                                                           placeholder="/path/to/client-key.pem" />
                                            </div>
                                        }
                                    }

                                    @if (_activeTab == "advanced")
                                    {
                                        <div class="form-row">
                                            <div class="form-group col-md-6">
                                                <label for="mysqlConnTimeout">Connection Timeout (seconds)</label>
                                                <InputNumber @bind-Value="Configuration.MySql!.ConnectionTimeout"
                                                             id="mysqlConnTimeout"
                                                             class="form-control" />
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label for="mysqlCmdTimeout">Command Timeout (seconds)</label>
                                                <InputNumber @bind-Value="Configuration.MySql!.CommandTimeout"
                                                             id="mysqlCmdTimeout"
                                                             class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="mysqlCharSet">Character Set</label>
                                            <InputText @bind-Value="Configuration.MySql!.CharacterSet"
                                                       id="mysqlCharSet"
                                                       class="form-control"
                                                       placeholder="utf8mb4" />
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.MySql!.AllowZeroDateTime"
                                                               id="mysqlZeroDateTime"
                                                               class="form-check-input" />
                                                <label for="mysqlZeroDateTime" class="form-check-label">Allow Zero DateTime</label>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.MySql!.AllowUserVariables"
                                                               id="mysqlUserVars"
                                                               class="form-check-input" />
                                                <label for="mysqlUserVars" class="form-check-label">Allow User Variables</label>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.MySql!.Pooling"
                                                               id="mysqlPooling"
                                                               class="form-check-input" />
                                                <label for="mysqlPooling" class="form-check-label">Connection Pooling</label>
                                            </div>
                                        </div>
                                        @if (Configuration.MySql!.Pooling)
                                        {
                                            <div class="form-row">
                                                <div class="form-group col-md-6">
                                                    <label for="mysqlMinPool">Min Pool Size</label>
                                                    <InputNumber @bind-Value="Configuration.MySql!.MinPoolSize"
                                                                 id="mysqlMinPool"
                                                                 class="form-control" />
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label for="mysqlMaxPool">Max Pool Size</label>
                                                    <InputNumber @bind-Value="Configuration.MySql!.MaxPoolSize"
                                                                 id="mysqlMaxPool"
                                                                 class="form-control" />
                                                </div>
                                            </div>
                                        }
                                    }

                                </div>
                            </div>
                        }
                        else if (Configuration.Provider == DatabaseProvider.PostgreSql)
                        {
                            <!-- PostgreSQL: tabbed configuration -->
                            <div class="config-form">
                                <h3>PostgreSQL Configuration</h3>
                                <div class="config-tabs">
                                    <button type="button"
                                            class="config-tab @(_activeTab == "general" ? "active" : "")"
                                            @onclick='() => SetActiveTab("general")'>
                                        General
                                    </button>
                                    <button type="button"
                                            class="config-tab @(_activeTab == "security" ? "active" : "")"
                                            @onclick='() => SetActiveTab("security")'>
                                        Security
                                    </button>
                                    <button type="button"
                                            class="config-tab @(_activeTab == "advanced" ? "active" : "")"
                                            @onclick='() => SetActiveTab("advanced")'>
                                        Advanced
                                    </button>
                                </div>

                                <div class="config-tab-content">

                                    @if (_activeTab == "general")
                                    {
                                        <div class="form-row">
                                            <div class="form-group col-md-8">
                                                <label for="pgHost">Server</label>
                                                <InputText @bind-Value="Configuration.PostgreSql!.Host"
                                                           id="pgHost"
                                                           class="form-control"
                                                           placeholder="localhost or server name" />
                                                <ValidationMessage For="() => Configuration.PostgreSql.Host" />
                                            </div>
                                            <div class="form-group col-md-4">
                                                <label for="pgPort">Port</label>
                                                <InputNumber @bind-Value="Configuration.PostgreSql!.Port"
                                                             id="pgPort"
                                                             class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="pgDatabase">Database</label>
                                            <InputText @bind-Value="Configuration.PostgreSql!.Database"
                                                       id="pgDatabase"
                                                       class="form-control"
                                                       placeholder="Database name" />
                                            <ValidationMessage For="() => Configuration.PostgreSql.Database" />
                                        </div>
                                        <div class="form-group">
                                            <label for="pgUser">Username</label>
                                            <InputText @bind-Value="Configuration.PostgreSql!.Username"
                                                       id="pgUser"
                                                       class="form-control"
                                                       placeholder="Username" />
                                            <ValidationMessage For="() => Configuration.PostgreSql.Username" />
                                        </div>
                                        <div class="form-group">
                                            <label for="pgPass">Password</label>
                                            <input type="password"
                                                   @bind="PostgreSqlPassword"
                                                   id="pgPass"
                                                   class="form-control"
                                                   placeholder="Password" />
                                        </div>
                                    }

                                    @if (_activeTab == "security")
                                    {
                                        <div class="form-group">
                                            <label for="pgSslMode">SSL Mode</label>
                                            <select @bind="Configuration.PostgreSql!.SslMode"
                                                    id="pgSslMode"
                                                    class="form-control">
                                                <option value="@PostgreSqlSslMode.Disable">Disable</option>
                                                <option value="@PostgreSqlSslMode.Allow">Allow</option>
                                                <option value="@PostgreSqlSslMode.Prefer">Prefer</option>
                                                <option value="@PostgreSqlSslMode.Require">Require</option>
                                                <option value="@PostgreSqlSslMode.VerifyCA">VerifyCA</option>
                                                <option value="@PostgreSqlSslMode.VerifyFull">VerifyFull</option>
                                            </select>
                                        </div>
                                        @if (Configuration.PostgreSql!.SslMode == PostgreSqlSslMode.VerifyCA ||
                                             Configuration.PostgreSql!.SslMode == PostgreSqlSslMode.VerifyFull)
                                        {
                                            <div class="form-group">
                                                <label for="pgSslCert">SSL Certificate Path</label>
                                                <InputText @bind-Value="Configuration.PostgreSql!.SslCertPath"
                                                           id="pgSslCert"
                                                           class="form-control"
                                                           placeholder="/path/to/client.crt" />
                                            </div>
                                            <div class="form-group">
                                                <label for="pgSslKey">SSL Key Path</label>
                                                <InputText @bind-Value="Configuration.PostgreSql!.SslKeyPath"
                                                           id="pgSslKey"
                                                           class="form-control"
                                                           placeholder="/path/to/client.key" />
                                            </div>
                                            <div class="form-group">
                                                <label for="pgSslRoot">Root Certificate Path</label>
                                                <InputText @bind-Value="Configuration.PostgreSql!.SslRootCertPath"
                                                           id="pgSslRoot"
                                                           class="form-control"
                                                           placeholder="/path/to/root.crt" />
                                            </div>
                                        }
                                    }

                                    @if (_activeTab == "advanced")
                                    {
                                        <div class="form-row">
                                            <div class="form-group col-md-6">
                                                <label for="pgConnTimeout">Connection Timeout (seconds)</label>
                                                <InputNumber @bind-Value="Configuration.PostgreSql!.ConnectionTimeout"
                                                             id="pgConnTimeout"
                                                             class="form-control" />
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label for="pgCmdTimeout">Command Timeout (seconds)</label>
                                                <InputNumber @bind-Value="Configuration.PostgreSql!.CommandTimeout"
                                                             id="pgCmdTimeout"
                                                             class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="pgAppName">Application Name</label>
                                            <InputText @bind-Value="Configuration.PostgreSql!.ApplicationName"
                                                       id="pgAppName"
                                                       class="form-control"
                                                       placeholder="VaultGuard" />
                                        </div>
                                        <div class="form-group">
                                            <label for="pgSearchPath">Search Path</label>
                                            <InputText @bind-Value="Configuration.PostgreSql!.SearchPath"
                                                       id="pgSearchPath"
                                                       class="form-control"
                                                       placeholder="public" />
                                        </div>
                                        <div class="form-group">
                                            <div class="form-check">
                                                <InputCheckbox @bind-Value="Configuration.PostgreSql!.Pooling"
                                                               id="pgPooling"
                                                               class="form-check-input" />
                                                <label for="pgPooling" class="form-check-label">Connection Pooling</label>
                                            </div>
                                        </div>
                                        @if (Configuration.PostgreSql!.Pooling)
                                        {
                                            <div class="form-row">
                                                <div class="form-group col-md-6">
                                                    <label for="pgMinPool">Min Pool Size</label>
                                                    <InputNumber @bind-Value="Configuration.PostgreSql!.MinPoolSize"
                                                                 id="pgMinPool"
                                                                 class="form-control" />
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label for="pgMaxPool">Max Pool Size</label>
                                                    <InputNumber @bind-Value="Configuration.PostgreSql!.MaxPoolSize"
                                                                 id="pgMaxPool"
                                                                 class="form-control" />
                                                </div>
                                            </div>
                                        }
                                    }

                                </div>
                            </div>
                        }

                    </div>

                    <!-- Migration Status -->
                    @if (MigrationStatus != null && MigrationStatus.HasPendingMigrations)
                    {
                        <div class="migration-status warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <div class="migration-info">
                                <strong>Pending Migrations Detected</strong>
                                <p>There are @MigrationStatus.PendingMigrations.Count() pending database migrations that need to be applied before you can use the app.</p>
                                @if (ShowMigrationDetails)
                                {
                                    <ul class="migration-list">
                                        @foreach (var migration in MigrationStatus.PendingMigrations)
                                        {
                                            <li>@migration</li>
                                        }
                                    </ul>
                                }
                                <button type="button" class="btn btn-link btn-sm" @onclick="ToggleMigrationDetails">
                                    @if (ShowMigrationDetails)
                                    {
                                        <span><i class="fas fa-chevron-up"></i> Hide Details</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-chevron-down"></i> Show Details</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Connection Status -->
                    @if (!string.IsNullOrEmpty(ConnectionStatus))
                    {
                        <div class="connection-status @(IsConnectionSuccessful ? "success" : "error")">
                            <i class="fas @(IsConnectionSuccessful ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
                            @ConnectionStatus
                        </div>
                    }

                    <!-- Dialog Actions (Step 2) -->
                    <div class="dialog-actions">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="GoToProviderStep"
                                disabled="@IsProcessing">
                            <i class="fas fa-arrow-left"></i>
                            Back
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="TestConnection"
                                disabled="@IsProcessing">
                            @if (IsProcessing && CurrentAction == "testing")
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                            }
                            else
                            {
                                <i class="fas fa-plug"></i>
                            }
                            Test Connection
                        </button>

                        @if (IsConnectionSuccessful && Configuration.Provider != DatabaseProvider.Sqlite)
                        {
                            <button type="button"
                                    class="btn btn-success"
                                    @onclick="CreateDatabase"
                                    disabled="@IsProcessing">
                                @if (IsProcessing && CurrentAction == "creating")
                                {
                                    <i class="fas fa-spinner fa-spin"></i>
                                }
                                else
                                {
                                    <i class="fas fa-plus-circle"></i>
                                }
                                Create Database
                            </button>
                        }

                        @if (MigrationStatus != null && MigrationStatus.HasPendingMigrations && IsConnectionSuccessful)
                        {
                            <button type="button"
                                    class="btn btn-warning"
                                    @onclick="ApplyMigrations"
                                    disabled="@IsProcessing">
                                @if (IsProcessing && CurrentAction == "migrating")
                                {
                                    <i class="fas fa-spinner fa-spin"></i>
                                }
                                else
                                {
                                    <i class="fas fa-database"></i>
                                }
                                Apply Migrations
                            </button>
                        }

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@IsProcessing">
                            @if (IsProcessing && CurrentAction == "saving")
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                            }
                            else if (MigrationStatus != null && MigrationStatus.HasPendingMigrations)
                            {
                                <i class="fas fa-plus"></i>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                            }
                            @if (Configuration.Provider == DatabaseProvider.Sqlite)
                            {
                                <span>Setup Local Database</span>
                            }
                            else if (MigrationStatus != null && MigrationStatus.HasPendingMigrations)
                            {
                                <span>Setup & Continue</span>
                            }
                            else
                            {
                                <span>Save & Continue</span>
                            }
                        </button>
                    </div>
                }

                </EditForm>
                }

        </div>
    </div>
</div>

@code {
    private enum SetupWizardStep
    {
        ProviderSelection,
        Configuration
    }

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnConfigurationSaved { get; set; }

    private DatabaseConfiguration Configuration { get; set; } = new();
    private MigrationStatusDto? MigrationStatus { get; set; }
    private bool IsProcessing { get; set; }
    private bool ShowMigrationDetails { get; set; }
    private string ConnectionStatus { get; set; } = string.Empty;
    private bool IsConnectionSuccessful { get; set; }
    private string CurrentAction { get; set; } = string.Empty;
    private SetupWizardStep CurrentStep { get; set; } = SetupWizardStep.ProviderSelection;

    // Tab state — shared across all providers; reset when entering Step 2
    private string _activeTab = "general";

    // Password fields (not bound to model for security; encrypted before saving)
    private string SqlServerPassword { get; set; } = string.Empty;
    private string MySqlPassword { get; set; } = string.Empty;
    private string PostgreSqlPassword { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Configuration = DatabaseConfigService.GetDefaultConfiguration();
        EnsureProviderConfig();
    }

    private void SelectProvider(DatabaseProvider provider)
    {
        Configuration.Provider = provider;
        EnsureProviderConfig();
        ConnectionStatus = string.Empty;
        MigrationStatus = null;
        IsConnectionSuccessful = false;
        StateHasChanged();
    }

    private string GetWizardSubtitle()
    {
        return CurrentStep == SetupWizardStep.ProviderSelection
            ? "Step 1: Choose your database provider"
            : "Step 2: Configure your connection settings";
    }

    private void GoToConfigurationStep()
    {
        CurrentStep = SetupWizardStep.Configuration;
        _activeTab = "general";
        ConnectionStatus = string.Empty;
        MigrationStatus = null;
        IsConnectionSuccessful = false;
        StateHasChanged();
    }

    private void GoToProviderStep()
    {
        CurrentStep = SetupWizardStep.ProviderSelection;
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
        ConnectionStatus = string.Empty;
        IsConnectionSuccessful = false;
    }

    private void ToggleMigrationDetails()
    {
        ShowMigrationDetails = !ShowMigrationDetails;
    }

    private void EnsureProviderConfig()
    {
        Configuration.Sqlite ??= new SqliteConfig();
        Configuration.SqlServer ??= new SqlServerConfig();
        Configuration.MySql ??= new MySqlConfig();
        Configuration.PostgreSql ??= new PostgreSqlConfig();
    }

    private async Task TestConnection()
    {
        IsProcessing = true;
        CurrentAction = "testing";
        ConnectionStatus = string.Empty;
        StateHasChanged();

        try
        {
            await SetEncryptedPasswords();

            var result = await DatabaseConfigService.TestConnectionAsync(Configuration);
            IsConnectionSuccessful = result.Success;
            ConnectionStatus = result.Success
                ? "Connection successful!"
                : $"Connection failed: {result.ErrorMessage}";

            if (result.Success)
            {
                await CheckMigrationStatus();
            }
        }
        catch (Exception ex)
        {
            IsConnectionSuccessful = false;
            ConnectionStatus = $"Error testing connection: {ex.Message}";
            MigrationStatus = null;
        }
        finally
        {
            IsProcessing = false;
            CurrentAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task CreateDatabase()
    {
        if (Configuration.Provider == DatabaseProvider.Sqlite)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to create the database '{GetDatabaseName()}'? This will create a new database on the server.");

        if (!confirmed) return;

        IsProcessing = true;
        CurrentAction = "creating";
        ConnectionStatus = string.Empty;
        StateHasChanged();

        try
        {
            var result = await MigrationService.CreateDatabaseAsync();

            if (result.Success)
            {
                ConnectionStatus = $"Database created successfully: {result.Message}";
                IsConnectionSuccessful = true;
                await CheckMigrationStatus();
            }
            else
            {
                ConnectionStatus = $"Database creation failed: {result.Message}";
                IsConnectionSuccessful = false;
            }
        }
        catch (Exception ex)
        {
            IsConnectionSuccessful = false;
            ConnectionStatus = $"Error creating database: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
            CurrentAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task CheckMigrationStatus()
    {
        try
        {
            MigrationStatus = await MigrationService.GetMigrationStatusAsync();
        }
        catch (Exception ex)
        {
            MigrationStatus = null;
            System.Diagnostics.Debug.WriteLine($"Migration status check failed: {ex.Message}");
        }
    }

    private async Task ApplyMigrations()
    {
        if (MigrationStatus?.HasPendingMigrations != true) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to apply {MigrationStatus.PendingMigrations.Count()} pending migrations? This operation cannot be undone.");

        if (!confirmed) return;

        IsProcessing = true;
        CurrentAction = "migrating";
        ConnectionStatus = string.Empty;
        StateHasChanged();

        try
        {
            var result = await MigrationService.ApplyPendingMigrationsAsync();

            if (result.Success)
            {
                ConnectionStatus = $"{result.Message}";
                IsConnectionSuccessful = true;
                await CheckMigrationStatus();
            }
            else
            {
                ConnectionStatus = $"Migration failed: {result.Message}";
                IsConnectionSuccessful = false;
            }
        }
        catch (Exception ex)
        {
            IsConnectionSuccessful = false;
            ConnectionStatus = $"Error applying migrations: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
            CurrentAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        IsProcessing = true;
        CurrentAction = "saving";
        StateHasChanged();

        try
        {
            await SetEncryptedPasswords();
            await DatabaseConfigService.SaveConfigurationAsync(Configuration);
            await OnConfigurationSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ConnectionStatus = $"Error saving configuration: {ex.Message}";
            IsConnectionSuccessful = false;
        }
        finally
        {
            IsProcessing = false;
            CurrentAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task SetEncryptedPasswords()
    {
        switch (Configuration.Provider)
        {
            case DatabaseProvider.SqlServer:
                if (!string.IsNullOrEmpty(SqlServerPassword))
                {
                    Configuration.SqlServer!.EncryptedPassword = await DatabaseConfigService.EncryptPasswordAsync(SqlServerPassword);
                }
                break;
            case DatabaseProvider.MySql:
                if (!string.IsNullOrEmpty(MySqlPassword))
                {
                    Configuration.MySql!.EncryptedPassword = await DatabaseConfigService.EncryptPasswordAsync(MySqlPassword);
                }
                break;
            case DatabaseProvider.PostgreSql:
                if (!string.IsNullOrEmpty(PostgreSqlPassword))
                {
                    Configuration.PostgreSql!.EncryptedPassword = await DatabaseConfigService.EncryptPasswordAsync(PostgreSqlPassword);
                }
                break;
        }
    }

    private string GetDatabaseName()
    {
        return Configuration.Provider switch
        {
            DatabaseProvider.SqlServer => Configuration.SqlServer?.Database ?? "VaultGuard",
            DatabaseProvider.MySql => Configuration.MySql?.Database ?? "VaultGuard",
            DatabaseProvider.PostgreSql => Configuration.PostgreSql?.Database ?? "VaultGuard",
            _ => "VaultGuard"
        };
    }
}
