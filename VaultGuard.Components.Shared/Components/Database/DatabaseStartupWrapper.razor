@using VaultGuard.Services.Interfaces
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inject IDatabaseConfigurationService DatabaseConfigService
@inject NavigationManager Navigation
@inject ILogger<DatabaseStartupWrapper> Logger

@if (_showContent)
{
    @ChildContent
}
else
{
    <div class="startup-loading">
        <div class="startup-loading-card">
            <div class="startup-spinner"></div>
            <p>Loading setup…</p>
        </div>
    </div>
}

<style>
    .startup-loading {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
    }

    .startup-loading-card {
        min-width: 220px;
        padding: 24px 28px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
        text-align: center;
    }

    .startup-loading-card p {
        margin: 12px 0 0;
        color: #2d3748;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .startup-spinner {
        width: 32px;
        height: 32px;
        margin: 0 auto;
        border-radius: 50%;
        border: 3px solid #d4d4d8;
        border-top-color: #5B5B63;
        animation: startup-spin 0.8s linear infinite;
    }

    @@keyframes startup-spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfigurationComplete { get; set; }
    private bool _showContent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bool shouldShow = false;
            bool isFirstRun = false;

            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                shouldShow = DatabaseConfigService.ShouldShowDatabaseSelection();
                isFirstRun = await DatabaseConfigService.IsFirstRunAsync().WaitAsync(cts.Token);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Startup check timed out or failed — skipping setup");
            }

            if (shouldShow && isFirstRun)
            {
                if (!IsOnSetupRoute())
                {
                    Navigation.NavigateTo("/setup", replace: true);
                    await Task.Yield();
                }
            }
            else
            {
                await OnConfigurationComplete.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Startup wrapper failed");
            await OnConfigurationComplete.InvokeAsync();
        }
        finally
        {
            _showContent = true;
        }
    }

    private bool IsOnSetupRoute()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        return currentPath == "setup";
    }
}
