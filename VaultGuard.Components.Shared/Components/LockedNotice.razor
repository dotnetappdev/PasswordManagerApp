@* Shown on the sign-in / unlock page after an automatic lock (…?locked=idle). *@
@inject NavigationManager Navigation

@if (_show)
{
    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3" Style="width:100%;"
              Icon="@Icons.Material.Filled.Lock" data-testid="locked-notice">
        @_text
    </MudAlert>
}

@code {
    private bool _show;
    private string _text = "";

    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("locked=idle", StringComparison.OrdinalIgnoreCase))
            (_show, _text) = (true, "Vault Guard locked after a period of inactivity. Unlock to continue.");
        else if (query.Contains("locked=device", StringComparison.OrdinalIgnoreCase))
            (_show, _text) = (true, "Vault Guard locked because this device was locked. Unlock to continue.");
    }
}
