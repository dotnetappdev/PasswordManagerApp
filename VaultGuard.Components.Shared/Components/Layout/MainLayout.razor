@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor
@using VaultGuard.Components.Shared.Services
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="background: var(--mud-palette-appbar-background); border-bottom: 1px solid var(--mud-palette-divider);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight:700; color: var(--mud-palette-text-primary);">🔐 Vault Guard</MudText>
        <MudSpacer />
        <MudMenu>
            <ActivatorContent>
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="NavigateToProfile">
                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                    Profile
                </MudMenuItem>
                <MudMenuItem OnClick="NavigateToSettings">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" />
                    Settings
                </MudMenuItem>
                <MudMenuItem OnClick="NavigateToDatabaseSetup">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" />
                    Configure Database
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="Logout">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" />
                    Logout
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Style="background: var(--mud-palette-drawer-background);">
        <MudNavMenu>
            <!-- Quick Access (mirrors the Blazor Web navigation) -->
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/passwords" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Lock">All Items</MudNavLink>
            <MudNavLink Href="/passwords?fav=true" Icon="@Icons.Material.Filled.Star">Favourites</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:var(--mud-palette-text-secondary); font-weight:600; letter-spacing:0.5px;">CATEGORIES</MudText>
            <MudNavLink Href="/passwords?type=Login" Icon="@Icons.Material.Filled.Login">Logins</MudNavLink>
            <MudNavLink Href="/passwords?type=CreditCard" Icon="@Icons.Material.Filled.CreditCard">Credit Cards</MudNavLink>
            <MudNavLink Href="/passwords?type=SecureNote" Icon="@Icons.Material.Filled.StickyNote2">Secure Notes</MudNavLink>
            <MudNavLink Href="/passwords?type=WiFi" Icon="@Icons.Material.Filled.Wifi">Wi-Fi Networks</MudNavLink>
            <MudNavLink Href="/passwords?type=Identity" Icon="@Icons.Material.Filled.Badge">Identities</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:var(--mud-palette-text-secondary); font-weight:600; letter-spacing:0.5px;">MANAGE</MudText>
            <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
            <MudNavLink Href="/collections" Icon="@Icons.Material.Filled.FolderSpecial">Collections</MudNavLink>
            <MudNavLink Href="/tags" Icon="@Icons.Material.Filled.Tag">Tags</MudNavLink>
            <MudNavLink Href="/import" Icon="@Icons.Material.Filled.ImportExport">Import / Export</MudNavLink>

            <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="color:var(--mud-palette-text-secondary); font-weight:600; letter-spacing:0.5px;">MORE</MudText>
            <MudNavLink Href="/setup" Icon="@Icons.Material.Filled.Storage">Configure Database</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Style="background-color: var(--mud-palette-background); min-height: 100vh; padding-top: 64px;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    // Uses the same ThemeService.BuildTheme as Blazor Web (VaultGuard.Web/Components/Layout/MainLayout.razor)
    // so a theme fix or accent/high-contrast change made once applies to both hosts instead of drifting
    // between two copies.
    private MudTheme _theme = ThemeService.BuildTheme(ThemeService.DefaultAccent, false);

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        _theme = ThemeService.BuildTheme(ThemeService.AccentColor, ThemeService.IsHighContrast);
        ThemeService.ThemeChanged += OnThemeChanged;
        ThemeService.ThemeSettingsChanged += OnThemeSettingsChanged;
        await ThemeService.DetectAndApplySystemThemeAsync(JSRuntime);
    }

    private void OnThemeChanged(object? sender, bool isDarkMode)
    {
        _isDarkMode = isDarkMode;
        InvokeAsync(StateHasChanged);
    }

    private void OnThemeSettingsChanged()
    {
        _theme = ThemeService.BuildTheme(ThemeService.AccentColor, ThemeService.IsHighContrast);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
        ThemeService.ThemeSettingsChanged -= OnThemeSettingsChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo("/settings");
    }

    private void NavigateToDatabaseSetup()
    {
        Navigation.NavigateTo("/setup");
    }

    private async Task Logout()
    {
        Navigation.NavigateTo("/masterpassword");
    }
}
