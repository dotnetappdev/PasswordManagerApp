@* Settings → Email aliases (MAUI): connect a SimpleLogin or addy.io account so the browser extension (and the app)
   can create a unique forwarding address for each site. *@
@using MudBlazor
@using VaultGuard.Services.Aliases
@using VaultGuard.Services.Interfaces
@inject IAppSettingsService AppSettings
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" Style="margin-bottom: 8px;">Email aliases</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Give every site its own email address that forwards to your inbox, so a leak or spam can be traced and switched
        off. Connect your SimpleLogin or addy.io account (both have free plans); on sign-up forms the browser extension
        then offers "Use a new email alias".
    </MudText>
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="EmailAliasProvider" @bind-Value="_provider" Label="Service" Variant="Variant.Outlined">
                <MudSelectItem Value="EmailAliasProvider.None">Off</MudSelectItem>
                <MudSelectItem Value="EmailAliasProvider.SimpleLogin">SimpleLogin</MudSelectItem>
                <MudSelectItem Value="EmailAliasProvider.Addy">addy.io</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (_provider != EmailAliasProvider.None)
        {
            <MudItem xs="12" md="8">
                <MudTextField T="string" @bind-Value="_token" Label="API key" InputType="InputType.Password" Variant="Variant.Outlined"
                              HelperText="@(_provider == EmailAliasProvider.SimpleLogin ? "SimpleLogin → Settings → API Keys" : "addy.io → Settings → API Keys")" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_server" Label="Server (only if you host it yourself)" Variant="Variant.Outlined"
                              Placeholder="@EmailAliasService.DefaultServer(_provider)" />
            </MudItem>
        }
        <MudItem xs="12" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            @if (_provider != EmailAliasProvider.None)
            {
                <MudButton Variant="Variant.Outlined" OnClick="TestAsync" Disabled="_testing">@(_testing ? "Creating…" : "Create a test alias")</MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private EmailAliasProvider _provider;
    private string? _token, _server;
    private bool _testing;

    protected override void OnInitialized()
    {
        _provider = new EmailAliasService(AppSettings).Provider;
        _token = AppSettings.Get("EmailAliasToken");
        _server = AppSettings.Get("EmailAlias:ServerUrl");
    }

    private void Save()
    {
        AppSettings.Set("EmailAlias:Provider", _provider.ToString());
        AppSettings.Set("EmailAliasToken", _provider == EmailAliasProvider.None ? "" : _token ?? "");
        AppSettings.Set("EmailAlias:ServerUrl", _server ?? "");
        Snackbar.Add(_provider == EmailAliasProvider.None ? "Email aliases turned off." : "Email aliases saved.", Severity.Success);
    }

    private async Task TestAsync()
    {
        Save();
        _testing = true;
        var r = await new EmailAliasService(AppSettings).CreateAsync("vault-guard-test");
        _testing = false;
        Snackbar.Add(r.Success ? $"Created {r.Email}. You can delete it in {EmailAliasService.Name(_provider)}." : r.Error!, r.Success ? Severity.Success : Severity.Error);
    }
}
