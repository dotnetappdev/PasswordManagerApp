@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@* Camera-based QR scanner. Works in the Blazor Web browser and the MAUI WebView via getUserMedia + jsQR.
   Raises OnScanned with the decoded text, or OnError with a human-readable message. *@

<div class="qr-scanner">
    <div class="qr-scanner-viewport">
        <video @ref="_video" class="qr-scanner-video" muted autoplay playsinline></video>
        <canvas @ref="_canvas" class="qr-scanner-canvas" hidden></canvas>
        <div class="qr-scanner-frame"></div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="qr-scanner-error">@_error</p>
        <button type="button" class="qr-scanner-retry" @onclick="StartAsync">Try again</button>
    }
    else
    {
        <p class="qr-scanner-hint">Point your camera at the QR code shown on your other device.</p>
    }
</div>

<style>
    .qr-scanner { display: flex; flex-direction: column; align-items: center; gap: 12px; }
    .qr-scanner-viewport {
        position: relative; width: 280px; max-width: 80vw; aspect-ratio: 1 / 1;
        border-radius: 12px; overflow: hidden; background: #000;
        border: 1px solid var(--mud-palette-lines-default, #3A3A3A);
    }
    .qr-scanner-video { width: 100%; height: 100%; object-fit: cover; }
    .qr-scanner-frame {
        position: absolute; inset: 14%;
        border: 2px solid var(--mud-palette-secondary, #71717A);
        border-radius: 10px; box-shadow: 0 0 0 2000px rgba(0,0,0,0.25);
        pointer-events: none;
    }
    .qr-scanner-hint { font-size: 0.9rem; color: var(--mud-palette-text-secondary, #9D9D9D); text-align: center; margin: 0; }
    .qr-scanner-error { font-size: 0.9rem; color: var(--mud-palette-error, #FCA5A5); text-align: center; margin: 0; }
    .qr-scanner-retry {
        background: var(--mud-palette-primary, #5B5B63); color: var(--mud-palette-primary-text, #fff);
        border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 0.9rem;
    }
</style>

@code {
    /// <summary>Raised with the decoded QR text when a code is recognised.</summary>
    [Parameter] public EventCallback<string> OnScanned { get; set; }

    /// <summary>Raised with a human-readable message when the camera can't start / permission denied.</summary>
    [Parameter] public EventCallback<string> OnError { get; set; }

    private ElementReference _video;
    private ElementReference _canvas;
    private DotNetObjectReference<QrScanner>? _selfRef;
    private string? _error;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StartAsync();
        }
    }

    private async Task StartAsync()
    {
        _error = null;
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JSRuntime.InvokeAsync<bool>("vgQrScanner.start", _video, _canvas, _selfRef);
            _started = true;
        }
        catch (Exception ex)
        {
            _error = "Unable to start the camera.";
            VaultGuard.Services.Logging.AppLogger.Warning("QR scanner failed to start", ex);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnCodeDetected(string text)
    {
        _started = false;
        await OnScanned.InvokeAsync(text);
    }

    [JSInvokable]
    public async Task OnScanError(string message)
    {
        _error = message;
        StateHasChanged();
        await OnError.InvokeAsync(message);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_started)
            {
                await JSRuntime.InvokeVoidAsync("vgQrScanner.stop");
            }
        }
        catch (Exception logEx) { VaultGuard.Services.Logging.AppLogger.Warning("Suppressed exception stopping QR scanner", logEx); }
        _selfRef?.Dispose();
    }
}
