<Page x:Class="PasswordManager.Mobile.Presentation.Pages.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PasswordManager.Mobile.Presentation.Pages.Settings"
      xmlns:theme="using:PasswordManager.Uno.Services.Theme"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header - 1Password style -->
        <Grid Grid.Row="0" Padding="20,32,20,20">
            <TextBlock Text="Settings" 
                       FontSize="32"
                       FontWeight="Bold"/>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Padding="0,0,0,80">
            <StackPanel Spacing="12" Padding="20,0">

                <!-- Status Message - 1Password style -->
                <Border Background="#E6F2FF"
                        BorderBrush="#0066FF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,8"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="16"
                                  Foreground="#0066FF"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#004FCC"/>
                    </Grid>
                </Border>

                <!-- Appearance Section -->
                <TextBlock Text="Appearance" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,16,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="20">
                        
                        <!-- Theme Selection -->
                        <StackPanel>
                            <TextBlock Text="Theme" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <RadioButtons ItemsSource="{x:Bind ThemeOptions}" 
                                          SelectedIndex="{x:Bind ThemeSelectedIndex, Mode=TwoWay}">
                                <RadioButtons.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <RadioButton Content="{x:Bind}" GroupName="Theme" FontSize="14"/>
                                    </DataTemplate>
                                </RadioButtons.ItemTemplate>
                            </RadioButtons>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Security Section -->
                <TextBlock Text="Security" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,16,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="20">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Biometric Login" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Use Face ID or fingerprint to sign in" 
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding BiometricEnabled, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          Command="{Binding ToggleBiometricCommand}"/>
                        </Grid>

                        <!-- AutoFill Password Manager -->
                        <Grid Visibility="{Binding IsAutoFillAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="AutoFill Password Manager" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Fill passwords in other apps and websites" 
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1"
                                    Content="Enable"
                                    Command="{Binding EnableAutoFillCommand}"
                                    Background="#0066FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    Padding="16,8"
                                    Visibility="{Binding AutoFillEnabled, Converter={StaticResource InvertBoolToVisibilityConverter}}"/>
                            
                            <FontIcon Grid.Column="1"
                                      Glyph="&#xE73E;"
                                      FontSize="20"
                                      Foreground="#0066FF"
                                      Visibility="{Binding AutoFillEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- API & Database Settings -->
                <TextBlock Text="API & Database" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,16,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="20">
                        
                        <!-- API Base URL -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="API Base URL" FontSize="15" FontWeight="SemiBold"/>
                            <TextBox PlaceholderText="https://api.example.com"
                                     Text="{Binding ApiBaseUrl, Mode=TwoWay}"
                                     InputScope="Url"
                                     Height="48"
                                     CornerRadius="8"
                                     FontSize="14"
                                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <!-- Local Database Toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Use Local Database" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Store passwords locally on device" 
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding UseLocalDatabase, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""/>
                        </Grid>

                        <!-- Save Button -->
                        <Button Content="Save API Settings"
                                Command="{Binding SaveApiSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                Height="48"
                                CornerRadius="10"
                                Background="#0066FF"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                    </StackPanel>
                </Border>

                <!-- Import/Export Section -->
                <TextBlock Text="Import/Export" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,16,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="20">
                        
                        <!-- Import Button -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Import Passwords" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Import passwords from other password managers" 
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Import Passwords"
                                    Command="{Binding NavigateToImportCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="#0066FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                                    <TextBlock Text="Import" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Export Button -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Export Passwords" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Export passwords to a secure file" 
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Export Passwords"
                                    Command="{Binding ExportPasswordsCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    BorderBrush="#0066FF"
                                    BorderThickness="1"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8C5;" FontSize="16"/>
                                    <TextBlock Text="Export" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- About Section -->
                <TextBlock Text="About" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,16,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="56" Height="56"
                                    Background="#0066FF"
                                    CornerRadius="14"
                                    Margin="0,0,16,0">
                                <TextBlock Text="🔐" 
                                           FontSize="28" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Password Manager Mobile" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Version 1.0.0" 
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay - 1Password style -->
        <Border Grid.Row="1"
                Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">
                <Border Width="80" Height="80"
                        Background="#0066FF"
                        CornerRadius="20"
                        HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" 
                                  Width="40" 
                                  Height="40"
                                  Foreground="White"/>
                </Border>
                <TextBlock Text="Processing..."
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Please wait"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
