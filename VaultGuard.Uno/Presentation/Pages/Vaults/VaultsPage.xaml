<Page x:Class="VaultGuard.Mobile.Presentation.Pages.Vaults.VaultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VaultGuard.Mobile.Presentation.Pages.Vaults"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,32,20,20">
            <StackPanel>
                <TextBlock Text="Vaults" 
                           FontSize="32"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBlock FontSize="15"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Manage your password vaults"/>
            </StackPanel>
        </Grid>

        <!-- Vaults List -->
        <ScrollViewer Grid.Row="1" Padding="20,0,20,24">
            <StackPanel Spacing="12">
                <TextBlock Text="Coming Soon"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Margin="0,20,0,10"/>
                <TextBlock Text="Vault management is being implemented for mobile platforms."
                          TextWrapping="Wrap"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
