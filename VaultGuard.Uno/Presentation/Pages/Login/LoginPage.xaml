<Page x:Class="VaultGuard.Mobile.Presentation.Pages.Login.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VaultGuard.Mobile.Presentation.Pages.Login"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,48" 
                        MaxWidth="440" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20">

                <!-- Logo/Header with 1Password-style branding -->
                <Border Width="80" Height="80"
                        Background="#0066FF"
                        CornerRadius="20"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                    <TextBlock Text="🔐" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Vault Guard"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Secure your digital life with enterprise-grade encryption"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           Margin="0,0,0,40"/>

                <!-- Error Message - 1Password style -->
                <Border Background="#FEF0F0"
                        BorderBrush="#E85C5C"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE814;"
                                  FontSize="16"
                                  Foreground="#E85C5C"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="#C53030"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Command="{Binding ClearErrorCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                Foreground="#E85C5C"/>
                    </Grid>
                </Border>

                <!-- Email Field - 1Password style -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Email Address" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBox PlaceholderText="Enter your email"
                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             InputScope="EmailSmtpAddress"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                             Height="48"
                             CornerRadius="8"
                             FontSize="15"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Password Field - 1Password style -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Master Password" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <PasswordBox PlaceholderText="Enter your master password"
                                 Password="{Binding Password, Mode=TwoWay}"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                                 Height="48"
                                 CornerRadius="8"
                                 FontSize="15"
                                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                 BorderThickness="1"/>
                </StackPanel>

                <!-- Biometric Login Option - 1Password style -->
                <CheckBox IsChecked="{Binding EnableBiometricLogin, Mode=TwoWay}"
                          Visibility="{Binding ShowBiometricOption, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,4,0,0">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE1C0;" FontSize="16"/>
                            <TextBlock FontSize="14">
                                <Run Text="Enable "/>
                                <Run Text="{Binding BiometricType}"/>
                                <Run Text=" login for quick access"/>
                            </TextBlock>
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>

                <!-- Login Button - 1Password style primary button -->
                <Button Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                        Height="52"
                        CornerRadius="12"
                        Background="#0066FF"
                        BorderThickness="0"
                        Margin="0,24,0,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <TextBlock Text="Sign In" 
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <ProgressRing Width="20" 
                                          Height="20" 
                                          Foreground="White"
                                          IsActive="{Binding IsLoading}"
                                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Biometric Quick Login Button - Secondary style -->
                <Button Command="{Binding TryBiometricLoginCommand}"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowBiometricOption, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="52"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE1C0;" FontSize="20"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold">
                            <Run Text="Sign in with "/>
                            <Run Text="{Binding BiometricType}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Divider -->
                <Grid Margin="0,32,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" 
                            Height="1" 
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" 
                               Text="OR" 
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="16,0"/>
                    <Border Grid.Column="2" 
                            Height="1" 
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Additional Options -->
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <HyperlinkButton Content="Create an account"
                                     FontSize="15"
                                     Foreground="#0066FF"/>
                    <HyperlinkButton Content="Forgot your password?"
                                     FontSize="15"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay - 1Password style -->
        <Border Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Grid.Row="0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">
                <Border Width="80" Height="80"
                        Background="#0066FF"
                        CornerRadius="20"
                        HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" 
                                  Width="40" 
                                  Height="40"
                                  Foreground="White"/>
                </Border>
                <TextBlock Text="Signing you in..."
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Verifying your credentials"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
