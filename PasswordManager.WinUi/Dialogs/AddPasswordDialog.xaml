<ContentDialog x:Class="PasswordManager.WinUi.Dialogs.AddPasswordDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           Title="New Item"
                           PrimaryButtonText="Save"
                           SecondaryButtonText="Cancel"
                           PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
                           Style="{StaticResource Modern1PasswordDialogStyle}"
                           PrimaryButtonStyle="{StaticResource ContentDialogPrimaryButtonStyle}"
                           SecondaryButtonStyle="{StaticResource ContentDialogSecondaryButtonStyle}">

    <Grid Background="{StaticResource ModernFormBackgroundBrush}" MaxWidth="520" MaxHeight="700">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" Margin="32">
            
                <!-- Error Message -->
                <Border x:Name="ErrorMessageBorder"
                        Background="{StaticResource ModernErrorBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText"
                              Text=""
                              Foreground="White"
                              FontSize="14"
                              FontWeight="Medium"
                              TextWrapping="Wrap"/>
                </Border>
                
                <!-- Success Message -->
                <Border x:Name="SuccessMessageBorder"
                        Background="{StaticResource ModernSuccessBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SuccessMessageText"
                              Text=""
                              Foreground="White"
                              FontSize="14"
                              FontWeight="Medium"
                              TextWrapping="Wrap"/>
                </Border>
                
                <!-- Category Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Category" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="CategoryComboBox"
                                 PlaceholderText="Choose category"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            
                <!-- Title Field -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Title" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <TextBox x:Name="TitleTextBox"
                                PlaceholderText="Enter title"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="16,12"
                                FontSize="14"/>
                    </Border>
                    <TextBlock x:Name="TitleValidationMessage" 
                              FontSize="12"
                              Foreground="{StaticResource ModernErrorBrush}"
                              Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Description Field -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Description" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <TextBox x:Name="DescriptionTextBox"
                                PlaceholderText="Add description (optional)"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="16,12"
                                FontSize="14"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MaxHeight="80"/>
                    </Border>
                </StackPanel>
                
                <!-- Type Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Type" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="TypeComboBox"
                                 PlaceholderText="Choose type"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 HorizontalAlignment="Stretch"
                                 SelectionChanged="TypeComboBox_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE192;" FontSize="18" Foreground="#3b82f6"/>
                                    <TextBlock Text="Login" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="18" Foreground="#10b981"/>
                                    <TextBlock Text="Credit Card" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE70F;" FontSize="18" Foreground="#f59e0b"/>
                                    <TextBlock Text="Secure Note" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="#8b5cf6"/>
                                    <TextBlock Text="WiFi" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE1F5;" FontSize="18" Foreground="#ef4444"/>
                                    <TextBlock Text="Password" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="#ec4899"/>
                                    <TextBlock Text="Passkey" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                    <TextBlock x:Name="TypeValidationMessage" 
                              FontSize="12"
                              Foreground="{StaticResource ModernErrorBrush}"
                              Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Favorite Toggle -->
                <Border Background="{StaticResource ModernSurfaceBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource ModernBorderBrush}"
                        BorderThickness="1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" 
                                 Glyph="&#xE734;" 
                                 FontSize="18" 
                                 Foreground="{StaticResource ModernTextSecondaryBrush}"
                                 Margin="0,0,12,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Add to favorites" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Mark this item as a favorite" 
                                      FontSize="12" 
                                      Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                        </StackPanel>
                        
                        <ToggleSwitch x:Name="IsFavoriteCheckBox"
                                     Grid.Column="2"
                                     VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- Type-specific fields would be dynamically added here based on selection -->
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
