<ContentDialog x:Class="PasswordManager.WinUi.Dialogs.AddPasswordDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           Title="New Item"
                           PrimaryButtonText="Save"
                           SecondaryButtonText="Cancel"
                           PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
                           Style="{StaticResource Modern1PasswordDialogStyle}"
                           PrimaryButtonStyle="{StaticResource ContentDialogPrimaryButtonStyle}"
                           SecondaryButtonStyle="{StaticResource ContentDialogSecondaryButtonStyle}">

    <Grid Background="{StaticResource ModernFormBackgroundBrush}" MaxWidth="520" MaxHeight="700">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" Margin="32">
            
                <!-- Error Message -->
                <Border x:Name="ErrorMessageBorder"
                        Background="{StaticResource ModernErrorBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText"
                              Text=""
                              Foreground="White"
                              FontSize="14"
                              FontWeight="Medium"
                              TextWrapping="Wrap"/>
                </Border>
                
                <!-- Success Message -->
                <Border x:Name="SuccessMessageBorder"
                        Background="{StaticResource ModernSuccessBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SuccessMessageText"
                              Text=""
                              Foreground="White"
                              FontSize="14"
                              FontWeight="Medium"
                              TextWrapping="Wrap"/>
                </Border>
                
                <!-- Category Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Category" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="CategoryComboBox"
                                 PlaceholderText="Choose category"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            
                <!-- Title Field -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Title" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <TextBox x:Name="TitleTextBox"
                                PlaceholderText="Enter title"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="16,12"
                                FontSize="14"/>
                    </Border>
                    <TextBlock x:Name="TitleValidationMessage" 
                              FontSize="12"
                              Foreground="{StaticResource ModernErrorBrush}"
                              Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Description Field -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Description" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <TextBox x:Name="DescriptionTextBox"
                                PlaceholderText="Add description (optional)"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="16,12"
                                FontSize="14"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MaxHeight="80"/>
                    </Border>
                </StackPanel>
                
                <!-- Type Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Type" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="TypeComboBox"
                                 PlaceholderText="Choose type"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 HorizontalAlignment="Stretch"
                                 SelectionChanged="TypeComboBox_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE192;" FontSize="18" Foreground="#3b82f6"/>
                                    <TextBlock Text="Login" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="18" Foreground="#10b981"/>
                                    <TextBlock Text="Credit Card" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE70F;" FontSize="18" Foreground="#f59e0b"/>
                                    <TextBlock Text="Secure Note" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="#8b5cf6"/>
                                    <TextBlock Text="WiFi" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE1F5;" FontSize="18" Foreground="#ef4444"/>
                                    <TextBlock Text="Password" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="#ec4899"/>
                                    <TextBlock Text="Passkey" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                    <TextBlock x:Name="TypeValidationMessage" 
                              FontSize="12"
                              Foreground="{StaticResource ModernErrorBrush}"
                              Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Favorite Toggle -->
                <Border Background="{StaticResource ModernSurfaceBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource ModernBorderBrush}"
                        BorderThickness="1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" 
                                 Glyph="&#xE734;" 
                                 FontSize="18" 
                                 Foreground="{StaticResource ModernTextSecondaryBrush}"
                                 Margin="0,0,12,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Add to favorites" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Mark this item as a favorite" 
                                      FontSize="12" 
                                      Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                        </StackPanel>
                        
                        <ToggleSwitch x:Name="IsFavoriteCheckBox"
                                     Grid.Column="2"
                                     VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- Collection Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Collection" 
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="CollectionComboBox"
                                 PlaceholderText="Choose collection (optional)"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>

                <!-- Login Fields Panel -->
                <StackPanel x:Name="LoginFieldsPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Login Details" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    
                    <!-- Username -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Username" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="UsernameTextBox"
                                    PlaceholderText="Enter username"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Password -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordTextBox"
                                           PlaceholderText="Enter password"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Padding="16,12"
                                           FontSize="14"
                                           RightTapped="PasswordTextBox_RightTapped"/>
                                <TextBox x:Name="PasswordDisplayTextBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="16,12"
                                        FontSize="14"
                                        Visibility="Collapsed"/>
                                <Button x:Name="TogglePasswordVisibilityButton"
                                       Grid.Column="1"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="8"
                                       Click="TogglePasswordVisibility_Click">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                                </Button>
                                <Button Grid.Column="2"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="8"
                                       Click="GeneratePasswordButton_Click">
                                    <FontIcon Glyph="&#xE895;" FontSize="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    
                    <!-- URL -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Website URL" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="UrlTextBox"
                                    PlaceholderText="https://example.com"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Credit Card Fields Panel -->
                <StackPanel x:Name="CreditCardFieldsPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Credit Card Details" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- Credit card fields would go here -->
                </StackPanel>

                <!-- Secure Note Fields Panel -->
                <StackPanel x:Name="SecureNoteFieldsPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Secure Note" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- Secure note fields would go here -->
                </StackPanel>

                <!-- WiFi Fields Panel -->
                <StackPanel x:Name="WiFiFieldsPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="WiFi Details" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- WiFi fields would go here -->
                </StackPanel>

                <!-- Passkey Fields Panel -->
                <StackPanel x:Name="PasskeyFieldsPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Passkey Details" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    
                    <!-- Passkey Website -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Website" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyWebsiteTextBox"
                                    PlaceholderText="Website name"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Passkey URL -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="URL" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyUrlTextBox"
                                    PlaceholderText="https://example.com"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Passkey Username -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Username" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyUsernameTextBox"
                                    PlaceholderText="Enter username"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Passkey Display Name -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Display Name" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyDisplayNameTextBox"
                                    PlaceholderText="Display name"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Passkey Device Type -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Device Type" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyDeviceTypeTextBox"
                                    PlaceholderText="Device type"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Passkey Verification Required -->
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Requires Verification" FontSize="14" FontWeight="Medium"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      VerticalAlignment="Center"/>
                            <CheckBox x:Name="PasskeyRequiresVerificationCheckBox"
                                     Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Passkey Is Backed Up -->
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Is Backed Up" FontSize="14" FontWeight="Medium"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      VerticalAlignment="Center"/>
                            <CheckBox x:Name="PasskeyIsBackedUpCheckBox"
                                     Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Passkey Notes -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Notes" FontSize="14" FontWeight="SemiBold"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyNotesTextBox"
                                    PlaceholderText="Additional notes"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="16,12"
                                    FontSize="14"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MaxHeight="80"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Item Selection Panel (for dialog mode switching) -->
                <StackPanel x:Name="ItemSelectionPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Select Item Type" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- Item type buttons would go here -->
                </StackPanel>

                <!-- Login Detail Panel (alternative view) -->
                <StackPanel x:Name="LoginDetailPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Login Item Details" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- Alternative login view would go here -->
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>

        <!-- Password Generator Popup -->
        <Border x:Name="PasswordGeneratorPopup"
                Background="{StaticResource ModernSurfaceBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource ModernBorderBrush}"
                BorderThickness="1"
                Padding="24"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16" MinWidth="300">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password Generator" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <Button Grid.Column="1" 
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="8"
                           Click="ClosePasswordGenerator_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                    </Button>
                </Grid>
                
                <!-- Generated Password Display -->
                <Border Background="{StaticResource ModernFormBackgroundBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                        BorderThickness="1" Padding="12">
                    <TextBlock x:Name="GeneratedPasswordText"
                              Text="Generated password will appear here"
                              FontFamily="Consolas"
                              FontSize="14"
                              Foreground="{StaticResource ModernTextPrimaryBrush}"
                              TextWrapping="Wrap"/>
                </Border>
                
                <!-- Password Length -->
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Length" FontSize="14" FontWeight="Medium"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <TextBlock x:Name="PasswordLengthText" Grid.Column="1"
                                  Text="12" FontSize="14" FontWeight="Medium"
                                  Foreground="{StaticResource ModernAccentBrush}"/>
                    </Grid>
                    <Slider x:Name="PasswordLengthSlider"
                           Minimum="8" Maximum="64" Value="12"
                           ValueChanged="PasswordLengthSlider_ValueChanged"/>
                </StackPanel>
                
                <!-- Options -->
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="NumbersToggle"
                                 Header="Include Numbers"
                                 IsOn="True"/>
                    <ToggleSwitch x:Name="SymbolsToggle"
                                 Header="Include Symbols"
                                 IsOn="False"/>
                </StackPanel>
                
                <!-- Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Refresh"
                           Click="RefreshPassword_Click"
                           Background="{StaticResource ModernSecondaryBrush}"/>
                    <Button Grid.Column="1" Content="Cancel"
                           Margin="8,0,0,0"
                           Background="{StaticResource ModernSurfaceBrush}"
                           Click="CancelPasswordGenerator_Click"/>
                    <Button Grid.Column="2" Content="Use Password"
                           Margin="8,0,0,0"
                           Background="{StaticResource ModernAccentBrush}"
                           Click="UseGeneratedPassword_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
