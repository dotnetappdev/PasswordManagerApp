    <!-- Enhanced NavigationViewItem Style -->
    <Style x:Key="ModernNavigationViewItemStyle"
           TargetType="NavigationViewItem">
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="Margin"
                Value="8,4"/>
        <Setter Property="CornerRadius"
                Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItem">
                    <Border x:Name="LayoutRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{TemplateBinding Margin}">
                        <Grid>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource ModernPrimaryBrush}"
                                    CornerRadius="0,2,2,0"
                                    Opacity="0"/>

                            <Grid x:Name="ContentGrid"
                                  Margin="20,12,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <ContentPresenter x:Name="Icon"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"/>

                                <!-- Content -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>

                                <!-- Expand/Collapse Chevron -->
                                <FontIcon x:Name="ExpandCollapseChevron"
                                          Grid.Column="2"
                                          FontSize="12"
                                          Glyph="&#xE76C;"
                                          Foreground="{StaticResource ModernTextSecondaryBrush}"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background"
                                                Value="#F5F8FF"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background"
                                                Value="#EBF3FF"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background"
                                                Value="#E6F2FF"/>
                                        <Setter Target="SelectionIndicator.Opacity"
                                                Value="1"/>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource ModernPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background"
                                                Value="#D6EAFF"/>
                                        <Setter Target="SelectionIndicator.Opacity"
                                                Value="1"/>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource ModernPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

