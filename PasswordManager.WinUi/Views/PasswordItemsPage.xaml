<Page x:Class="PasswordManager.WinUi.Views.PasswordItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PasswordManager.WinUi.Controls"
      Background="{StaticResource ModernBackgroundBrush}">

    <!-- Single Content Area - No additional sidebar since MainWindow provides navigation -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource ModernSurfaceBrush}"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         PlaceholderText="🔍 Search passwords..."
                         TextChanged="SearchTextBox_TextChanged"
                         Style="{StaticResource ModernTextBoxStyle}"
                         CornerRadius="8"
                         Height="36"
                         AutomationProperties.Name="Search passwords"
                         AutomationProperties.HelpText="Type to search through your passwords and items"
                         ToolTipService.ToolTip="Search through all your password items"/>

                <!-- Filter Button -->
                <Button x:Name="FilterButton"
                        Grid.Column="1"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Click="FilterButton_Click"
                        ToolTipService.ToolTip="Filters">
                    <FontIcon Glyph="&#xE71C;"
                              FontSize="16"/>
                    <Button.Flyout>
                        <Flyout x:Name="FilterFlyout"
                                Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="280"
                                        Spacing="16">
                                <TextBlock Text="Filters"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <!-- Filter by Type -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Item Type"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                    <CheckBox Content="🔐 Logins"
                                              IsChecked="True"/>
                                    <CheckBox Content="💳 Credit Cards"
                                              IsChecked="True"/>
                                    <CheckBox Content="📝 Secure Notes"
                                              IsChecked="True"/>
                                    <CheckBox Content="📶 WiFi Passwords"
                                              IsChecked="True"/>
                                    <CheckBox Content="🔑 Passkeys"
                                              IsChecked="True"/>
                                </StackPanel>

                                <!-- Filter by Category -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Category"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                    <AutoSuggestBox x:Name="CategoryFilterBox"
                                                    PlaceholderText="Type to filter categories..."
                                                    QueryIcon="Filter"
                                                    Style="{StaticResource ModernAutoSuggestBoxStyle}"
                                                    TextChanged="CategoryFilterBox_TextChanged"
                                                    SuggestionChosen="CategoryFilterBox_SuggestionChosen"/>
                                </StackPanel>

                                <!-- Filter by Status -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Security Status"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                    <CheckBox Content="💡 Strong passwords"
                                              IsChecked="True"/>
                                    <CheckBox Content="⚠️ Weak passwords"
                                              IsChecked="True"/>
                                    <CheckBox Content="🔄 Reused passwords"
                                              IsChecked="True"/>
                                    <CheckBox Content="⏰ Old passwords"
                                              IsChecked="True"/>
                                </StackPanel>

                                <!-- Filter by Modified Date -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Last Modified"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                    <ComboBox PlaceholderText="Any time"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Last 7 days"/>
                                        <ComboBoxItem Content="Last 30 days"/>
                                        <ComboBoxItem Content="Last 90 days"/>
                                        <ComboBoxItem Content="Last year"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Filter Actions -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Clear All"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,4,0"
                                            Click="ClearFilters_Click"/>
                                    <Button Grid.Column="1"
                                            Content="Apply"
                                            Style="{StaticResource ModernPrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="4,0,0,0"
                                            Click="ApplyFilters_Click"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Title and Count -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="24,0"
                            Spacing="2">
                    <TextBlock x:Name="ContentTitle"
                               Text="All Items"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <TextBlock x:Name="ContentSubtitle"
                               Text="Showing all password items"
                               FontSize="12"
                               Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Add Button - 1Password Style -->
                <Button x:Name="AddButton"
                        Grid.Column="3"
                        Style="{StaticResource NewItemButtonStyle}"
                        Click="AddButton_Click"
                        Height="40"
                        AutomationProperties.Name="Create new password item"
                        AutomationProperties.HelpText="Opens dialog to create a new password, credit card, or secure note"
                        ToolTipService.ToolTip="Create new password item">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE109;"
                                  FontSize="16"
                                  Foreground="White"/>
                        <TextBlock Text="New Item"
                                   Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Items List -->
                <ColumnDefinition Width="340"/>
                <!-- Detail Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Items List with Category Dropdown -->
            <Border Grid.Column="0"
                    Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <!-- Category Header -->
                    <Border Background="{StaticResource ModernCardBrush}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="All Items"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="AddCategoryButton"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    Click="AddCategoryButton_Click"
                                    ToolTipService.ToolTip="Add Category">
                                <FontIcon Glyph="&#xE109;"
                                          FontSize="16"
                                          Foreground="{StaticResource ModernPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="ItemsList"
                                  ItemsSource="{Binding PasswordItems}"
                                  SelectionMode="Single"
                                  SelectionChanged="ItemsList_SelectionChanged"
                                  DoubleTapped="ItemsList_DoubleTapped">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4"
                                          Height="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Item Icon -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource ModernPrimaryGradientBrush}"
                                                CornerRadius="8"
                                                Width="40"
                                                Height="40"
                                                Margin="16,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                       FontSize="18"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Item Info -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                                       Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Column 2 removed (card view) - detail panel now occupies second column -->

            <!-- Column 2: Detail Panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource ModernSurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel"
                                Spacing="12"
                                Margin="16"
                                Visibility="Collapsed">

                        <!-- Detail Header -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Spacing="4">
                                <TextBlock x:Name="DetailTitle"
                                           Text="Item Details"
                                           Style="{StaticResource ModernHeading3Style}"/>
                                <TextBlock x:Name="DetailSubtitle"
                                           Text="View and manage item details"
                                           Style="{StaticResource ModernCaptionStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button x:Name="ViewDetailButton"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="ViewDetailButton_Click">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE8F4;"
                                                  FontSize="14"/>
                                        <TextBlock Text="View"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="EditDetailButton"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Click="EditDetailButton_Click">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon x:Name="EditDetailIcon"
                                                  Glyph="&#xE70F;"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="EditDetailText"
                                                   Text="Edit"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Detail Content -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel Spacing="16">
                                <!-- Item Icon and Title -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource ModernPrimaryGradientBrush}"
                                            CornerRadius="12"
                                            Width="48"
                                            Height="48"
                                            Margin="0,0,16,0">
                                        <TextBlock x:Name="DetailIcon"
                                                   Text="{Binding SelectedItem.Type, ElementName=ItemsList, Converter={StaticResource TypeToIconConverter}}"
                                                   FontSize="24"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                        <TextBlock x:Name="DetailItemTitle"
                                                   Text="Select an item to view details"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailItemSubtitle"
                                                   Text=""
                                                   FontSize="13"
                                                   Foreground="{StaticResource ModernTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailCategory"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detail Fields -->
                                <StackPanel x:Name="DetailFields"
                                            Spacing="16">

                                    <!-- Title Field - Edit Mode -->
                                    <StackPanel x:Name="EditTitleField" Spacing="8" Visibility="Collapsed">
                                        <TextBlock Text="Title *"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <TextBox x:Name="EditTitleTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 PlaceholderText="Enter title"/>
                                    </StackPanel>

                                    <!-- Username -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Username"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <Grid Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode -->
                                            <controls:ReadOnlyField x:Name="DetailUsername"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <TextBox x:Name="EditUsernameTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     PlaceholderText="Enter username"
                                                     Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    x:Name="CopyUsernameButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy username"
                                                    Click="CopyUsernameButton_Click">
                                                <FontIcon Glyph="&#xE8C8;"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernPrimaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Password -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Password"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <Grid Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode - Masked display -->
                                            <controls:ReadOnlyField x:Name="DetailPassword"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <PasswordBox x:Name="EditPasswordBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource ModernPasswordBoxStyle}"
                                                         PlaceholderText="Enter password"
                                                         Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Show/hide password"
                                                    x:Name="RevealPasswordButton"
                                                    Click="RevealPasswordButton_Click">
                                                <FontIcon Glyph="&#xE7B3;"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    x:Name="GeneratePasswordButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Generate password"
                                                    Click="GeneratePasswordButton_Click"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE895;"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernAccentBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy password"
                                                    x:Name="CopyPasswordButton"
                                                    Click="CopyPasswordButton_Click">
                                                <FontIcon Glyph="&#xE8C8;"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernPrimaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Website URL -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Website"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <Grid Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode -->
                                            <controls:ReadOnlyField x:Name="DetailWebsite"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <TextBox x:Name="EditWebsiteTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     PlaceholderText="https://example.com"
                                                     Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Open website"
                                                    x:Name="OpenWebsiteButton"
                                                    Click="OpenWebsiteButton_Click">
                                                <FontIcon Glyph="&#xE774;"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernPrimaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Description/Notes Field - Edit Mode -->
                                    <StackPanel x:Name="EditDescriptionField" Spacing="8" Visibility="Collapsed">
                                        <TextBlock Text="Notes"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <TextBox x:Name="EditDescriptionTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 PlaceholderText="Additional notes..."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="80"/>
                                    </StackPanel>

                                    <!-- Category Field - Edit Mode -->
                                    <StackPanel x:Name="EditCategoryField" Spacing="8" Visibility="Collapsed">
                                        <TextBlock Text="Category"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <ComboBox x:Name="EditCategoryComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  PlaceholderText="Choose category"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Custom Fields - Edit Mode -->
                                    <StackPanel x:Name="EditCustomFieldsSection" Spacing="16" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Custom Fields"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                            <Button x:Name="AddCustomFieldButton"
                                                    Grid.Column="1"
                                                    Content="+ Add Field"
                                                    Style="{StaticResource ModernSecondaryButtonStyle}"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    Click="AddCustomFieldButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="CustomFieldsContainer" Spacing="12"/>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick Actions"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                                <StackPanel Spacing="8">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <FontIcon Glyph="&#xE1CE;"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernWarningBrush}"/>
                                            <TextBlock Text="Add to Favorites"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <FontIcon Glyph="&#xE8FD;"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernPrimaryBrush}"/>
                                            <TextBlock Text="Organize"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <FontIcon Glyph="&#xE72D;"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernAccentBrush}"/>
                                            <TextBlock Text="Share"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            CornerRadius="8"
                                            Click="DeleteMenuItem_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <FontIcon Glyph="&#xE74D;"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernErrorBrush}"/>
                                            <TextBlock Text="Delete"
                                                       FontSize="14"
                                                       Foreground="{StaticResource ModernErrorBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>