<Page x:Class="PasswordManager.WinUi.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Spacing="24" Margin="0,0,0,24">
            
            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernTextSecondaryBrush}"
                               CornerRadius="12"
                               Width="32"
                               Height="32">
                            <FontIcon Glyph="&#xE713;" 
                                     FontSize="16"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Settings" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Configure your password manager preferences and security"
                              Style="{StaticResource ModernCaptionStyle}"/>
                </StackPanel>
            </Border>
            
            <!-- Security Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernErrorBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE1A3;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Security" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="TwoFactorToggle"
                                     Header="Enable Two-Factor Authentication" 
                                     IsOn="{Binding EnableTwoFactor, Mode=TwoWay}"
                                     Toggled="TwoFactorToggle_Toggled"/>
                        
                        <ToggleSwitch x:Name="PasscodeToggle"
                                     Header="Require Passcode on Startup" 
                                     IsOn="{Binding RequirePasscode, Mode=TwoWay}"
                                     Toggled="PasscodeToggle_Toggled"/>
                        
                        <Button x:Name="ChangePasswordButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Click="ChangePasswordButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE192;" FontSize="14"/>
                                <TextBlock Text="Change Master Password"/>
                            </StackPanel>
                        </Button>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="Session Timeout" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="SessionTimeoutComboBox"
                                     ItemsSource="{Binding TimeoutOptions}"
                                     SelectedItem="{Binding SessionTimeoutMinutes, Mode=TwoWay}"
                                     SelectionChanged="SessionTimeoutComboBox_SelectionChanged"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="200"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Database Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernWarningBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE8F7;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Authentication and Storage" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Authentication Mode" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="AuthModeComboBox"
                                     ItemsSource="{Binding AuthenticationModes}"
                                     SelectedItem="{Binding AuthenticationMode, Mode=TwoWay}"
                                     SelectionChanged="AuthModeComboBox_SelectionChanged"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="240"/>
                        </StackPanel>
                        
                        <Border x:Name="ApiSettingsPanel"
                               Style="{StaticResource ModernCardStyle}"
                               BorderBrush="{StaticResource ModernPrimaryBrush}"
                               Visibility="{Binding AuthenticationMode, Converter={StaticResource ApiModeToVisibilityConverter}}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="API Configuration" 
                                          Style="{StaticResource ModernBodyStyle}"
                                          FontWeight="SemiBold"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="API Base URL" 
                                              Style="{StaticResource ModernCaptionStyle}"
                                              FontWeight="SemiBold"/>
                                    <TextBox x:Name="ApiUrlTextBox"
                                            Text="{Binding ApiBaseUrl, Mode=TwoWay}"
                                            PlaceholderText="https://localhost:7001/api"
                                            Style="{StaticResource ModernTextBoxStyle}"
                                            MinWidth="360"/>
                                    <TextBlock Text="Configure the base URL for the Password Manager API server." 
                                              Style="{StaticResource ModernCaptionStyle}"
                                              TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Database Provider (Local Mode Only)" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox IsEnabled="{Binding AuthenticationMode, Converter={StaticResource LocalModeToEnabledConverter}}"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="240">
                                <ComboBoxItem Content="SQLite" IsSelected="True"/>
                                <ComboBoxItem Content="SQL Server"/>
                                <ComboBoxItem Content="MySQL"/>
                                <ComboBoxItem Content="PostgreSQL"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               IsEnabled="{Binding AuthenticationMode, Converter={StaticResource LocalModeToEnabledConverter}}"
                               Click="ConfigureDatabaseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F7;" FontSize="14"/>
                                <TextBlock Text="Configure Database Connection"/>
                            </StackPanel>
                        </Button>
                        
                        <ToggleSwitch x:Name="SyncToggle"
                                     Header="Enable Cloud Sync" 
                                     IsOn="{Binding EnableSync, Mode=TwoWay}"
                                     Toggled="SyncToggle_Toggled"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Cloud Backup Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernPrimaryBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE753;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Cloud Backup" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="16">
                        <ToggleSwitch x:Name="CloudBackupToggle"
                                     Header="Enable Cloud Backup" 
                                     IsOn="{Binding EnableCloudBackup, Mode=TwoWay}"
                                     Toggled="CloudBackupToggle_Toggled"/>
                        
                        <StackPanel Spacing="8" Visibility="{Binding EnableCloudBackup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Cloud Provider" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <ComboBox x:Name="CloudProviderComboBox"
                                     ItemsSource="{Binding AvailableCloudProviders}"
                                     SelectedValue="{Binding SelectedCloudProvider, Mode=TwoWay}"
                                     SelectedValuePath="Provider"
                                     DisplayMemberPath="DisplayName"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     SelectionChanged="CloudProviderComboBox_SelectionChanged"
                                     MinWidth="200"/>
                        </StackPanel>

                        <!-- Network Location Configuration -->
                        <StackPanel Spacing="8" x:Name="NetworkLocationPanel" Visibility="Collapsed">
                            <TextBlock Text="Network Location Settings" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox x:Name="NetworkPathTextBox"
                                        Text="{Binding NetworkPath, Mode=TwoWay}"
                                        PlaceholderText="\\server\share\folder or Z:\backups"
                                        Header="Network Path"
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        MinWidth="300"/>
                                        
                                <Button x:Name="ChooseNetworkLocationButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="ChooseNetworkLocationButton_Click"
                                       VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                        <TextBlock Text="Browse"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Backup Schedule Settings -->
                        <StackPanel Spacing="12" Visibility="{Binding EnableCloudBackup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Backup Schedule" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            
                            <ComboBox Header="Schedule Frequency"
                                     ItemsSource="{Binding ScheduleIntervalOptions}"
                                     SelectedValue="{Binding BackupScheduleInterval, Mode=TwoWay}"
                                     SelectedValuePath="Interval"
                                     DisplayMemberPath="DisplayName"
                                     Style="{StaticResource ModernComboBoxStyle}"
                                     MinWidth="200"/>
                            
                            <!-- Time Picker for preferred backup time -->
                            <StackPanel Spacing="8" Visibility="{Binding AutoBackupEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Preferred Backup Time"
                                          Style="{StaticResource ModernCaptionStyle}"/>
                                <TimePicker x:Name="BackupTimePicker"
                                           Time="{Binding PreferredBackupTime, Mode=TwoWay}"
                                           ClockIdentifier="24HourClock"
                                           Style="{StaticResource DefaultTimePickerStyle}"/>
                                           
                                <TextBlock Text="{Binding NextScheduledBackup, StringFormat='Next backup: {0:yyyy-MM-dd HH:mm} UTC'}"
                                          Style="{StaticResource ModernCaptionStyle}"
                                          Foreground="{ThemeResource SystemAccentColor}"
                                          Visibility="{Binding NextScheduledBackup, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="12" Visibility="{Binding EnableCloudBackup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Backup Management" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="CreateBackupButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="CreateBackupButton_Click"
                                       IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE753;" FontSize="14"/>
                                        <TextBlock Text="Create Backup"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="RefreshBackupsButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="RefreshBackupsButton_Click"
                                       IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button x:Name="RestoreFromFileButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="RestoreFromFileButton_Click"
                                       IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                                        <TextBlock Text="Restore from File"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            
                            <ListView x:Name="BackupsListView"
                                     ItemsSource="{Binding AvailableBackups}"
                                     MaxHeight="200"
                                     ScrollViewer.HorizontalScrollMode="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:MMM dd, yyyy HH:mm}'}" 
                                                          Style="{StaticResource ModernCaptionStyle}"/>
                                                <TextBlock Text="{Binding ServiceName}" 
                                                          Style="{StaticResource ModernCaptionStyle}"
                                                          Foreground="{StaticResource ModernPrimaryBrush}"/>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="1" 
                                                   Content="Restore" 
                                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                                   Margin="8,0"
                                                   Click="RestoreBackupButton_Click"
                                                   Tag="{Binding}"/>
                                            
                                            <Button Grid.Column="2" 
                                                   Content="Delete" 
                                                   Background="{StaticResource ModernErrorBrush}"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   CornerRadius="4"
                                                   Padding="8,4"
                                                   Click="DeleteBackupButton_Click"
                                                   Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Browser Export Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernWarningBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE774;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Browser Export" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="Export passwords to browser password managers" 
                                  Style="{StaticResource ModernCaptionStyle}"
                                  TextWrapping="Wrap"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ExportToChromeButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="ExportToBrowserButton_Click"
                                   Tag="Chrome">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                    <TextBlock Text="Export to Chrome"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="ExportToEdgeButton"
                                   Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="ExportToBrowserButton_Click"
                                   Tag="Edge">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                    <TextBlock Text="Export to Edge"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Import/Export Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernSuccessBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE8B5;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Local Import/Export" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Export Path" 
                                      Style="{StaticResource ModernCaptionStyle}"
                                      FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                        Text="{Binding ExportPath, Mode=TwoWay}" 
                                        IsReadOnly="True" 
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="1" 
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="ChooseExportFolderButton_Click">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ExportButton"
                    Style="{StaticResource ModernSecondaryButtonStyle}"
                    Click="ExportButton_Click"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C5;" FontSize="14"/>
                                    <TextBlock Text="Export All Passwords"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource ModernSecondaryButtonStyle}"
                                   Click="ImportButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                                    <TextBlock Text="Go to Import Page"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Appearance Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernPrimaryBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE790;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Appearance" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Theme" 
                                  Style="{StaticResource ModernCaptionStyle}"
                                  FontWeight="SemiBold"/>
                        <ComboBox x:Name="ThemeComboBox"
                                 ItemsSource="{Binding AvailableThemes}"
                                 SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                 SelectionChanged="ThemeComboBox_SelectionChanged"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 MinWidth="200"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Data Management -->
            <Border Style="{StaticResource ModernCardStyle}" 
                   BorderBrush="{StaticResource ModernErrorBrush}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource ModernErrorBrush}"
                               CornerRadius="10"
                               Width="24"
                               Height="24">
                            <FontIcon Glyph="&#xE74D;" 
                                     FontSize="12"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Data Management" 
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="⚠️ Danger Zone" 
                                  Foreground="{StaticResource ModernErrorBrush}"
                                  FontWeight="SemiBold"
                                  FontSize="16"/>
                        <TextBlock Text="This will permanently delete all your stored passwords and settings. This action cannot be undone." 
                                  Style="{StaticResource ModernCaptionStyle}"
                                  Foreground="{StaticResource ModernErrorBrush}"
                                  TextWrapping="Wrap"/>
                        
                        <Button x:Name="ClearDataButton"
                               Background="{StaticResource ModernErrorBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               CornerRadius="8"
                               Padding="16,12"
                               HorizontalAlignment="Left"
                               Click="ClearDataButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                <TextBlock Text="Clear All Data"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Loading Indicator -->
            <Border Style="{StaticResource ModernCardStyle}"
                   HorizontalAlignment="Center" 
                   Padding="32"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="32" Height="32"/>
                    <TextBlock Text="Saving settings..." 
                              Style="{StaticResource ModernBodyStyle}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</Page>