<Page x:Class="PasswordManager.WPF.Views.VaultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32">

            <!-- ═══ Page Header ════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vaults"
                                       FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Separate spaces for your credentials"
                                       FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click"
                            Margin="0,0,10,0" Height="36" Padding="14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                        Padding="14,0" Height="36"
                                        Background="{DynamicResource ModernSurfaceBrush}"
                                        BorderBrush="{DynamicResource ModernBorderBrush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="Refresh" Foreground="{DynamicResource ModernTextSecondaryBrush}" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ModernElevatedSurfaceBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="AddVaultButton" Click="AddVaultButton_Click" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="14,0" Height="36">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                        <TextBlock Text="New Vault" Foreground="White"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ Stats Row ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Vaults -->
                <Border Grid.Column="0" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" Background="#1E3A5F">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ViewModel.Vaults.Count}" FontSize="24"
                                       FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Total Vaults" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total Items -->
                <Border Grid.Column="2" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" Background="#14532D">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TotalItemsText" Text="—" FontSize="24"
                                       FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Stored Items" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Encryption status -->
                <Border Grid.Column="4" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" Background="#1A1A3E">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AES-256" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="End-to-End Encrypted" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Empty State ════════════════════════════════════════════════════ -->
            <Border x:Name="EmptyState"
                    Visibility="{Binding ViewModel.HasNoVaults, Converter={StaticResource BoolToVisibilityConverter}}"
                    CornerRadius="16" Padding="48" Margin="0,0,0,24"
                    Background="{DynamicResource ModernFormBackgroundBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="No vaults yet" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Create a vault to organise your passwords into separate, named spaces."
                               FontSize="14" Foreground="{DynamicResource ModernTextTertiaryBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,24" MaxWidth="380"/>
                    <Button Click="AddVaultButton_Click" HorizontalAlignment="Center"
                            Height="40" Padding="20,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Padding="20,0" Height="40">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#7C3AED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="Create Your First Vault" Foreground="White"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ Vault Cards Grid ═══════════════════════════════════════════════ -->
            <ItemsControl x:Name="VaultsGrid"
                          ItemsSource="{Binding ViewModel.Vaults}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Vault Card -->
                        <Border x:Name="VaultCard"
                                Width="288" Margin="0,0,16,16"
                                CornerRadius="14"
                                Background="{DynamicResource ModernCardBrush}"
                                BorderBrush="{DynamicResource ModernBorderBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="12"
                                                  Color="#000000" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="6"/>    <!-- Color accent strip -->
                                    <RowDefinition Height="*"/>    <!-- Content -->
                                    <RowDefinition Height="Auto"/> <!-- Footer actions -->
                                </Grid.RowDefinitions>

                                <!-- Color accent strip -->
                                <Border Grid.Row="0" CornerRadius="14,14,0,0"
                                        Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"/>

                                <!-- Card body -->
                                <StackPanel Grid.Row="1" Margin="20,16,20,12">

                                    <!-- Icon + Name + Default badge -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="48" Height="48"
                                                CornerRadius="12" Margin="0,0,14,0"
                                                Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                Opacity="0.18"/>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                   FontSize="26" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Width="48"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Default badge -->
                                        <Border Grid.Column="2"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibleConverter}}"
                                                Background="#14532D" CornerRadius="6" Padding="8,3"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="Default" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#4ADE80"/>
                                        </Border>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource ModernCardBrush}" Margin="0,0,0,12"/>

                                    <!-- Stats -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ItemCount}"
                                                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                            <TextBlock Text="Items" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM yyyy}}"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            <TextBlock Text="Created" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Footer action bar -->
                                <Border Grid.Row="2" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,14,14" Background="{DynamicResource ModernFormBackgroundBrush}">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Set as Default (only for non-default vaults) -->
                                        <Button Grid.Column="0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToHiddenConverter}}"
                                                Click="SetDefaultButton_Click" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Left" Padding="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE1CE;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,5,0"/>
                                                <TextBlock Text="Set Default" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Edit + Delete -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Click="EditVaultButton_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Width="32" Height="32"
                                                    ToolTipService.ToolTip="Edit vault">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                            </Button>
                                            <Button Click="DeleteVaultButton_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Width="32" Height="32"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToHiddenConverter}}"
                                                    ToolTipService.ToolTip="Delete vault">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ModernTextTertiaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Info Banner ════════════════════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,8,0,0"
                    Background="{DynamicResource ModernFormBackgroundBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="20" Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="About Vaults" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Vaults are independent spaces for your credentials. Use them to keep Work, Personal, and Finance passwords separate. All vaults share the same master password and AES-256-GCM encryption."/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
