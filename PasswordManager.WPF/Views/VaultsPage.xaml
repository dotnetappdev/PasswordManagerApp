<Page x:Class="PasswordManager.WPF.Views.VaultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">
            
            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Border Background="{StaticResource ModernPrimaryBrush}"
                                  
                                   Width="32"
                                   Height="32">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" 
                                         FontSize="16"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Vaults" 
                                      Style="{StaticResource ModernHeading3Style}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Manage your password vaults"
                                  Style="{StaticResource ModernCaptionStyle}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12">
                        <Button x:Name="RefreshButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="AddVaultButton"
                               Style="{StaticResource ModernPrimaryButtonStyle}"
                               Click="AddVaultButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="Add Vault"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Vaults List -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="16">
                    <TextBlock Text="Your Vaults"
                              Style="{StaticResource ModernHeading4Style}"/>
                    
                    <ListView x:Name="VaultsListView"
                             ItemsSource="{Binding ViewModel.Vaults}"
                             SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernCardStyle}"
                                       Margin="0,4,0,4"
                                       Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Vault Icon -->
                                        <Border Grid.Column="0"
                                               Background="{StaticResource ModernPrimaryBrush}"
                                              
                                               Width="40"
                                               Height="40"
                                               Margin="0,0,16,0">
                                            <TextBlock Text="🔐"
                                                      FontSize="20"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Vault Info -->
                                        <StackPanel Grid.Column="1" Margin="4">
                                            <StackPanel Orientation="Horizontal" Margin="8">
                                                <TextBlock Text="{Binding Name}"
                                                          Style="{StaticResource ModernBodyStrongStyle}"/>
                                                <Border Background="{StaticResource ModernSuccessBrush}"
                                                      
                                                       Padding="6,2"
                                                       Visibility="{Binding IsDefault}">
                                                    <TextBlock Text="Default"
                                                              FontSize="11"
                                                              Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                      Style="{StaticResource ModernCaptionStyle}"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>
                                        
                                        <!-- Item Count -->
                                        <StackPanel Grid.Column="2" 
                                                   Margin="16,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PasswordItemsCount}"
                                                      Style="{StaticResource ModernHeading4Style}"
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Text="items"
                                                      Style="{StaticResource ModernCaptionStyle}"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" 
                                                   Orientation="Horizontal"
                                                   Margin="8"
                                                   VerticalAlignment="Center">
                                            <Button Style="{StaticResource ModernIconButtonStyle}"
                                                   Click="EditVaultButton_Click"
                                                   Tag="{Binding}"
                                                   ToolTipService.ToolTip="Edit Vault">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                            </Button>
                                            <Button Style="{StaticResource ModernIconButtonStyle}"
                                                   Click="DeleteVaultButton_Click"
                                                   Tag="{Binding}"
                                                   ToolTipService.ToolTip="Delete Vault">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
