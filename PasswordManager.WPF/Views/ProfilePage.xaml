<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PasswordManager.WPF.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:PasswordManager.WPF.Converters"
      Background="#2D2D2D">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Picture -->
                <Border Grid.Column="0"
                        Width="80"
                        Height="80"
                       
                        Background="{StaticResource ModernPrimaryGradientBrush}"
                        Margin="0,0,20,0">
                    <TextBlock x:Name="ProfileInitials"
                               Text="👤"
                               FontSize="40"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Profile Info -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8">
                    <TextBlock Text="{Binding CurrentUserDisplayName, FallbackValue='Current User'}"
                               Style="{StaticResource ModernHeading2Style}"/>
                    <TextBlock Text="Personal Vault"
                               Style="{StaticResource ModernCaptionStyle}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="12"
                            VerticalAlignment="Center">
                    <Button Content="Switch Profile"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SwitchProfileButton_Click"/>
                    <Button x:Name="EditProfileButton"
                            Content="Edit Profile"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Click="EditProfileButton_Click"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button x:Name="SaveProfileButton"
                            Content="Save"
                            Style="{StaticResource ModernPrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SaveProfileButton_Click"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button x:Name="CancelEditButton"
                            Content="Cancel"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Click="CancelEditButton_Click"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- Error Message -->
            <Border Background="#5D2A2A"
                    BorderBrush="#DC2626"
                    BorderThickness="1"
                   
                    Padding="16,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal"
                            Margin="8">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Foreground="#DC2626"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Profile Management Dialog -->
            <Border x:Name="ProfileManagementDialog"
                    Background="#1A1A1A"
                    BorderBrush="#4A4A4A"
                    BorderThickness="1"
                   
                    Padding="24"
                    Visibility="{Binding ShowProfileManagement, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Switch Profile"
                                   Style="{StaticResource ModernHeading3Style}"/>

                        <Button Grid.Column="1"
                                Content="✕"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#B0B0B0"
                                Click="CloseProfileManagementButton_Click"/>
                    </Grid>

                    <!-- Profile List (horizontal switcher) -->
                    <ScrollViewer MaxHeight="300"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0">
                        <ItemsControl ItemsSource="{Binding AllProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="#2D2D2D"
                                            BorderBrush="#4A4A4A"
                                            BorderThickness="1"
                                           
                                            HorizontalAlignment="Left"
                                            Padding="12,10"
                                            MinWidth="180"
                                            Height="72"
                                            Margin="0,0,8,0"
                                            Click="ProfileSwitchButton_Click">
                                        <Button.Tag>
                                            <Binding/>
                                        </Button.Tag>

                                        <!-- Compact horizontal content: Name + Admin badge -->
                                        <StackPanel Orientation="Horizontal" Margin="12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FirstName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding Email}"
                                                           FontSize="12"
                                                           Foreground="#B0B0B0"/>
                                            </StackPanel>

                                            <!-- Admin badge (visible when IsAdmin == true) -->
                                            <Border Background="#FFB020"
                                                   
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Admin"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="Black"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add New Profile Button -->
                    <Button Content="+ Create New Profile"
                            Background="#4A90E2"
                            Foreground="White"
                            BorderThickness="0"
                           
                            HorizontalAlignment="Stretch"
                            MinHeight="48"
                            FontSize="16"
                            Click="CreateNewProfileButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Account Information -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="16">
                    <TextBlock Text="Account Information"
                               Style="{StaticResource ModernHeading3Style}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- First Name -->
                        <TextBlock Grid.Row="0"
                                Grid.Column="0"
                                   Text="First Name:"
                                   Style="{StaticResource ModernCaptionStyle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0"
                                Grid.Column="1"
                                   Text="{Binding FirstName}"
                                   Style="{StaticResource ModernBodyStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBox Grid.Row="0"
                                Grid.Column="1"
                                 Text="{Binding FirstName, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Last Name -->
                        <TextBlock Grid.Row="1"
                                Grid.Column="0"
                                   Text="Last Name:"
                                   Style="{StaticResource ModernCaptionStyle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1"
                                Grid.Column="1"
                                   Text="{Binding LastName}"
                                   Style="{StaticResource ModernBodyStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBox Grid.Row="1"
                                Grid.Column="1"
                                 Text="{Binding LastName, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="2"
                                Grid.Column="0"
                                   Text="Email:"
                                   Style="{StaticResource ModernCaptionStyle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2"
                                Grid.Column="1"
                                   Text="{Binding Email}"
                                   Style="{StaticResource ModernBodyStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBox Grid.Row="2"
                                Grid.Column="1"
                                 Text="{Binding Email, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Security Settings -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="16">
                    <TextBlock Text="Security"
                               Style="{StaticResource ModernHeading3Style}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Master Password -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="18" VerticalAlignment="Center"
                                      Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="Master Password"
                                           Style="{StaticResource ModernBodyStyle}"/>
                                <TextBlock Text="Last changed 30 days ago"
                                           Style="{StaticResource ModernCaptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Change"
                                    Style="{StaticResource ModernSecondaryButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Two-Factor Authentication -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="18" VerticalAlignment="Center"
                                      Foreground="{StaticResource ModernSuccessBrush}"/>
                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="Two-Factor Authentication"
                                           Style="{StaticResource ModernBodyStyle}"/>
                                <TextBlock Text="Enabled"
                                           Style="{StaticResource ModernCaptionStyle}"
                                           Foreground="{StaticResource ModernSuccessBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Manage"
                                    Style="{StaticResource ModernSecondaryButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Biometric Authentication -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="18" VerticalAlignment="Center"
                                      Foreground="{StaticResource ModernSuccessBrush}"/>
                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="Biometric Authentication"
                                           Style="{StaticResource ModernBodyStyle}"/>
                                <TextBlock Text="Windows Hello enabled"
                                           Style="{StaticResource ModernCaptionStyle}"
                                           Foreground="{StaticResource ModernSuccessBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Vault Statistics -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="16">
                    <TextBlock Text="Vault Statistics"
                               Style="{StaticResource ModernHeading3Style}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                Margin="4">
                            <TextBlock Text="47"
                                       Style="{StaticResource ModernHeading2Style}"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Items"
                                       Style="{StaticResource ModernCaptionStyle}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                Margin="4">
                            <TextBlock Text="32"
                                       Style="{StaticResource ModernHeading2Style}"
                                       Foreground="{StaticResource ModernSuccessBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Logins"
                                       Style="{StaticResource ModernCaptionStyle}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                Margin="4">
                            <TextBlock Text="5"
                                       Style="{StaticResource ModernHeading2Style}"
                                       Foreground="{StaticResource ModernWarningBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Weak Passwords"
                                       Style="{StaticResource ModernCaptionStyle}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                Margin="4">
                            <TextBlock Text="8"
                                       Style="{StaticResource ModernHeading2Style}"
                                       Foreground="{StaticResource ModernAccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Favorites"
                                       Style="{StaticResource ModernCaptionStyle}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
