<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PasswordManager.WPF.Views.ManageItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">
            
            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Border Background="{StaticResource ModernAccentBrush}"
                                  
                                   Width="32"
                                   Height="32">
                                <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets" 
                                         FontSize="16"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Manage Collections, Types &amp; Tags" 
                                      Style="{StaticResource ModernHeading3Style}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Organize your password items with custom collections, types, and tags"
                                  Style="{StaticResource ModernCaptionStyle}"/>
                    </StackPanel>
                    
                    <Button x:Name="RefreshAllButton"
                           Grid.Column="1"
                           Style="{StaticResource ModernSecondaryButtonStyle}"
                           Click="RefreshAllButton_Click">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            <TextBlock Text="Refresh All"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Collections Section -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="4">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                        Background="{StaticResource ModernSuccessBrush}"
                                        Margin="0,1,10,1" VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="1" Text="Collections"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                            </Grid>
                            <TextBlock Text="Categories to organize your password items"
                                      Style="{StaticResource ModernCaptionStyle}" Margin="13,0,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="AddCollectionButton"
                               Grid.Column="1"
                               Style="{StaticResource ModernPrimaryButtonStyle}"
                               Click="AddCollectionButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="Add Collection"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <!-- Collections List -->
                    <ListView x:Name="CollectionsListView"
                             MaxHeight="200"
                             SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                           Background="{StaticResource ModernSuccessBrush}"
                                          
                                           Width="24"
                                           Height="24"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" 
                                                 FontSize="12"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" 
                                               VerticalAlignment="Center" 
                                               Margin="2">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" 
                                                  FontSize="12"
                                                  Foreground="{StaticResource ModernTextSecondaryBrush}"
                                                  Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" 
                                               Orientation="Horizontal" 
                                               Margin="8"
                                               VerticalAlignment="Center">
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="8"
                                              
                                               Click="EditCollectionButton_Click">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                        </Button>
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="8"
                                              
                                               Click="DeleteCollectionButton_Click">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ModernErrorBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Types Section -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="4">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                        Background="{StaticResource ModernPrimaryBrush}"
                                        Margin="0,1,10,1" VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="1" Text="Types"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                            </Grid>
                            <TextBlock Text="Item types like Login, Credit Card, Secure Note, etc."
                                      Style="{StaticResource ModernCaptionStyle}" Margin="13,0,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="AddTypeButton"
                               Grid.Column="1"
                               Style="{StaticResource ModernPrimaryButtonStyle}"
                               Click="AddTypeButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="Add Type"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <!-- Types List -->
                    <ListView x:Name="TypesListView"
                             MaxHeight="200"
                             SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                           Background="#2D2D2D"
                                          
                                           Width="24"
                                           Height="24"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center">
                                        <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" 
                                                 FontSize="12"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" 
                                               VerticalAlignment="Center" 
                                               Margin="2">
                                        <TextBlock Text="{Binding}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" 
                                               Orientation="Horizontal" 
                                               Margin="8"
                                               VerticalAlignment="Center">
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="8"
                                              
                                               Click="EditTypeButton_Click">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                        </Button>
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="8"
                                              
                                               Click="DeleteTypeButton_Click">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ModernErrorBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Tags Section -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="4">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                        Background="{StaticResource ModernWarningBrush}"
                                        Margin="0,1,10,1" VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="1" Text="Tags"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                            </Grid>
                            <TextBlock Text="Labels to organize items like Work, Personal, Finance, etc."
                                      Style="{StaticResource ModernCaptionStyle}" Margin="13,0,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="AddTagButton"
                               Grid.Column="1"
                               Style="{StaticResource ModernPrimaryButtonStyle}"
                               Click="AddTagButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="Add Tag"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <!-- Tags List -->
                    <ListView x:Name="TagsListView"
                             MaxHeight="200"
                             SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                           Background="{StaticResource ModernWarningBrush}"
                                          
                                           Width="24"
                                           Height="24"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center">
                                        <TextBlock Text="&#xE1CB;" FontFamily="Segoe MDL2 Assets" 
                                                 FontSize="12"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" 
                                               VerticalAlignment="Center" 
                                               Margin="2">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" 
                                                  FontSize="12"
                                                  Foreground="{StaticResource ModernTextSecondaryBrush}"
                                                  Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" 
                                               Orientation="Horizontal" 
                                               Margin="8"
                                               VerticalAlignment="Center">
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="8"
                                              
                                               Click="EditTagButton_Click">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                        </Button>
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="8"
                                              
                                               Click="DeleteTagButton_Click">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ModernErrorBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
