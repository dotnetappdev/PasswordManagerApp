<Page x:Class="PasswordManager.WinUi.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:PasswordManager.WPF.Converters"
      Background="#2D2D2D"
      Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <!-- Full window dark background -->
    <Grid HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch"
          Background="#2D2D2D">

        <!-- Split Layout: Left side for branding, Right side for login -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: App Branding -->
            <Grid Grid.Column="0" 
                  Background="#2D2D2D">
                <StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="32">
                    
                    <!-- Large App Icon -->
                    <Border Background="#4A90E2"
                            CornerRadius="32"
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE192;"
                                  FontSize="60"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- App Title -->
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Password Manager"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Secure your digital life"
                                   FontSize="16"
                                   Foreground="#B0B0B0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Right Side: Login Form -->
            <Border Grid.Column="1"
                    Background="#404040"
                    Padding="0">
                
                <Grid>
                    <!-- Profile Selection View -->
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="320"
                               Spacing="32"
                               Visibility="{Binding ShowProfileSelection, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Profile Selection Header -->
                        <StackPanel HorizontalAlignment="Center"
                                   Spacing="16">
                            <TextBlock Text="Choose Your Profile"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- User Profiles Grid -->
                        <ScrollViewer MaxHeight="300" 
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="UserProfilesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="#2D2D2D"
                                               BorderBrush="#4A4A4A"
                                               BorderThickness="1"
                                               CornerRadius="8"
                                               HorizontalAlignment="Stretch"
                                               Padding="16,12"
                                               MinHeight="64"
                                               Click="ProfileButton_Click">
                                            <Button.Tag>
                                                <Binding />
                                            </Button.Tag>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Profile Avatar -->
                                                <Border Grid.Column="0"
                                                       Background="#8B7355"
                                                       CornerRadius="24"
                                                       Width="48"
                                                       Height="48"
                                                       Margin="0,0,12,0">
                                                    <TextBlock x:Name="ProfileInitials"
                                                              Text="👤"
                                                              FontSize="20"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <!-- Profile Info -->
                                                <StackPanel Grid.Column="1"
                                                           VerticalAlignment="Center">
                                                    <TextBlock x:Name="ProfileName"
                                                              Text="{Binding FirstName, FallbackValue='User'}"
                                                              FontSize="16"
                                                              FontWeight="SemiBold"
                                                              Foreground="White"/>
                                                    <TextBlock x:Name="ProfileEmail"
                                                              Text="{Binding Email, FallbackValue='No email'}"
                                                              FontSize="13"
                                                              Foreground="#B0B0B0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Add New Profile Button -->
                        <Button Content="+ Create New Profile"
                               Background="#4A90E2"
                               Foreground="White"
                               BorderThickness="0"
                               CornerRadius="8"
                               HorizontalAlignment="Stretch"
                               MinHeight="48"
                               FontSize="16"
                               Click="CreateProfileButton_Click"/>
                    </StackPanel>

                    <!-- Password Entry View -->
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="320"
                               Spacing="32"
                               Visibility="{Binding ShowPasswordEntry, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- App Logo and Current User -->
                        <StackPanel HorizontalAlignment="Center"
                                   Spacing="24">
                            
                            <!-- App Logo (similar to 1Password) -->
                            <Border Background="#4A90E2"
                                    CornerRadius="20"
                                    Width="80"
                                    Height="80"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE192;"
                                          FontSize="40"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <!-- Current User Profile Display -->
                            <StackPanel HorizontalAlignment="Center"
                                       Spacing="12">
                                <!-- User Avatar and Name -->
                                <StackPanel Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           Spacing="12">
                                    <Border Background="#8B7355"
                                            CornerRadius="20"
                                            Width="40"
                                            Height="40">
                                        <TextBlock Text="👤"
                                                  FontSize="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedUser.FirstName, FallbackValue='User'}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding SelectedUser.Email, FallbackValue='user@example.com'}"
                                                   FontSize="12"
                                                   Foreground="#B0B0B0"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Discreet Switch Account Button -->
                                <Button Content="Switch Account"
                                       Background="Transparent"
                                       Foreground="#B0B0B0"
                                       BorderThickness="0"
                                       FontSize="12"
                                       Padding="8,4"
                                       Click="BackToProfilesButton_Click"
                                       HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Master Password Form -->
                        <StackPanel Spacing="20" 
                                   HorizontalAlignment="Stretch">

                            <!-- Password Input -->
                            <StackPanel Spacing="12">
                                <Border Background="#3A3A3A"
                                       CornerRadius="8"
                                       BorderBrush="#4A4A4A"
                                       BorderThickness="1"
                                       Padding="16,12"
                                       MinHeight="48">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <PasswordBox x:Name="MasterPasswordBox"
                                                    x:FieldModifier="private"
                                                    Grid.Column="0"
                                                    PlaceholderText="Enter your password"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="White"
                                                    FontSize="16"
                                                    KeyDown="MasterPasswordBox_KeyDown"/>
                                        
                                        <!-- Eye icon for password visibility (like in reference image) -->
                                        <Button Grid.Column="1"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Width="32"
                                               Height="32"
                                               Padding="0">
                                            <FontIcon Glyph="&#xE7B3;"
                                                      FontSize="16"
                                                      Foreground="#B0B0B0"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <!-- Lock Status Text (like "1Password was locked manually.") -->
                                <TextBlock Text="Password Manager was locked manually."
                                          FontSize="13"
                                          Foreground="#B0B0B0"
                                          HorizontalAlignment="Center"
                                          Visibility="{Binding ShowLockMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Confirm Password Input (First-time setup only) -->
                            <StackPanel Spacing="8"
                                       Visibility="{Binding ShowConfirmPassword, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Background="#3A3A3A"
                                       CornerRadius="8"
                                       BorderBrush="#4A4A4A"
                                       BorderThickness="1"
                                       Padding="16,12"
                                       MinHeight="48">
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                x:FieldModifier="private"
                                                PlaceholderText="Confirm your master password"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="White"
                                                FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Password Hint Input (First-time setup only) -->
                            <StackPanel Spacing="8"
                                       Visibility="{Binding ShowPasswordHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Background="#3A3A3A"
                                       CornerRadius="8"
                                       BorderBrush="#4A4A4A"
                                       BorderThickness="1"
                                       Padding="16,12"
                                       MinHeight="48">
                                    <TextBox x:Name="PasswordHintBox"
                                            x:FieldModifier="private"
                                            PlaceholderText="Enter a hint to help remember your password"
                                            Text="{Binding PasswordHint, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="White"
                                            FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Error Message -->
                            <Border Background="#5D2A2A"
                                    BorderBrush="#DC2626"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE783;"
                                              FontSize="16"
                                              Foreground="#DC2626"/>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="#FCA5A5"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Button with Smiley Face -->
                            <StackPanel Spacing="16">
                                <!-- Smiley face (like in reference image) -->
                                <TextBlock Text="😊"
                                          FontSize="24"
                                          HorizontalAlignment="Center"
                                          Visibility="{Binding ShowLockMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                
                                <Button x:Name="PrimaryActionButton"
                                        x:FieldModifier="private"
                                        Content="{Binding PrimaryButtonText, FallbackValue='Unlock'}"
                                        Style="{StaticResource ModernPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="48"
                                        FontSize="16"
                                        IsEnabled="{Binding IsButtonEnabled}"
                                        Click="PrimaryActionButton_Click"/>
                            </StackPanel>

                            <!-- Progress Ring -->
                            <ui:ProgressRing x:Name="Authui:ProgressRing"
                                         x:FieldModifier="private"
                                         IsActive="{Binding IsLoading}"
                                         HorizontalAlignment="Center"
                                         Width="32"
                                         Height="32"
                                         Foreground="#4A90E2"/>

                            <!-- Additional Options -->
                            <StackPanel Spacing="12"
                                       HorizontalAlignment="Center">
                                
                                <!-- Password Hint Display -->
                                <Button Content="Show password hint"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Visibility="{Binding ShowHintButton, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Create Account Button -->
                                <Border x:Name="CreateAccountSection"
                                        BorderBrush="#4A4A4A"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,16,0,0"
                                        Margin="0,16,0,0"
                                        Visibility="{Binding ShowCreateAccountButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Don't have an account?"
                                                   FontSize="13"
                                                   Foreground="#B0B0B0"
                                                   HorizontalAlignment="Center"/>
                                        <Button x:Name="CreateAccountButton"
                                                Content="Create New Account"
                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Click="CreateAccountButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
