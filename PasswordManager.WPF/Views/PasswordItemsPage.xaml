<Page
    x:Class="PasswordManager.WPF.Views.PasswordItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:PasswordManager.WPF.Controls"
      Background="{StaticResource ModernBackgroundBrush}">

    <!-- Single Content Area - No additional sidebar since MainWindow provides navigation -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
            Background="{StaticResource ModernSurfaceBrush}"
            BorderBrush="{StaticResource ModernBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         ui:ControlHelper.PlaceholderText="🔍 Search passwords..."
                         TextChanged="SearchTextBox_TextChanged"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="36"
                         AutomationProperties.Name="Search passwords"
                         AutomationProperties.HelpText="Type to search through your passwords and items"
                         ToolTipService.ToolTip="Search through all your password items"/>

                <!-- Filter Button -->
                <Button x:Name="FilterButton"
                        Grid.Column="1"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Click="FilterButton_Click"
                        ToolTipService.ToolTip="Filters">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                              FontSize="16"/>
                    <!-- Button.Flyout not supported in WPF, functionality moved to Click event -->
                </Button>

                <!-- Title and Count -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="24,0">
                    <TextBlock x:Name="ContentTitle"
                               Text="All Items"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <TextBlock x:Name="ContentSubtitle"
                               Text="Showing all password items"
                               FontSize="12"
                               Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Add Button - 1Password Style -->
                <Button x:Name="AddButton"
                        Grid.Column="3"
                        Style="{StaticResource NewItemButtonStyle}"
                        Click="AddButton_Click"
                        Height="40"
                        AutomationProperties.Name="Create new password item"
                        AutomationProperties.HelpText="Opens dialog to create a new password, credit card, or secure note"
                        ToolTipService.ToolTip="Create new password item">
                    <StackPanel Orientation="Horizontal"
                                Margin="8">
                        <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="White"/>
                        <TextBlock Text="New Item"
                                   Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Items List -->
                <ColumnDefinition Width="340"/>
                <!-- Detail Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Items List -->
            <Border Grid.Column="0"
                    Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="{StaticResource ModernBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource ModernCardBrush}"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="All Items"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       CharacterSpacing="80"/>

                            <Button x:Name="AddCategoryButton"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="28"
                                    Height="28"
                                    Click="AddCategoryButton_Click"
                                    ToolTipService.ToolTip="Manage Categories">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{StaticResource ModernPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Items List - 1Password style rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="ItemsList"
                                  ItemsSource="{Binding PasswordItems}"
                                  SelectionMode="Single"
                                  SelectionChanged="ItemsList_SelectionChanged"
                                  MouseDoubleClick="ItemsList_DoubleTapped"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- 1Password-style list row: colored icon + title + subtitle + optional star -->
                                    <Grid Height="64" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 40px rounded icon square with type-tinted background -->
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="10"
                                                Background="{StaticResource ModernIconBgDefaultBrush}"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title + Username/Email -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- Favorite star indicator -->
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE1CE;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="#F59E0B"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="3,0,0,0"
                                                        BorderBrush="Transparent"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#0F7C3AED"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E7C3AED"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7C3AED"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column 2: Detail Panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource ModernBackgroundBrush}">
                <Grid>
                    <!-- Empty State - shown when no item is selected -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Visible">
                        <Border Width="72" Height="72"
                                CornerRadius="36"
                                Background="#1E7C3AED"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="#7C3AED"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No item selected"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Select an item from the list to view its details"
                                   FontSize="13"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="260"/>
                    </StackPanel>

                    <!-- Detail Content - shown when an item is selected -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel"
                                    Margin="32,24,32,24"
                                    Visibility="Collapsed">

                            <!-- Detail Header: icon + title + action buttons -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Large icon -->
                                <Border Grid.Column="0"
                                        Width="56"
                                        Height="56"
                                        CornerRadius="14"
                                        Background="#1E7C3AED"
                                        Margin="0,0,16,0">
                                    <TextBlock x:Name="DetailIcon"
                                               Text="{Binding SelectedItem.Type, ElementName=ItemsList, Converter={StaticResource TypeToIconConverter}}"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title + subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailItemTitle"
                                               Text="Select an item to view details"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailCategory"
                                               Text=""
                                               FontSize="12"
                                               Foreground="{StaticResource ModernTextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ViewDetailButton"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="ViewDetailButton_Click"
                                            Margin="0,0,8,0"
                                            Padding="12,8"
                                            MinWidth="0" MinHeight="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="View" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EditDetailButton"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Click="EditDetailButton_Click"
                                            Padding="12,8"
                                            MinWidth="0" MinHeight="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="EditDetailIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="EditDetailText" Text="Edit" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource ModernBorderBrush}" Margin="0,0,0,24"/>

                            <!-- 1Password-style field: LABEL (purple, uppercase, 11px) then value + copy button -->

                            <!-- Username Field -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="USERNAME"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernPrimaryBrush}"
                                           Margin="0,0,0,5"
                                           CharacterSpacing="120"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="DetailUsername"
                                                            Grid.Column="0"
                                                            Text=""
                                                            CopyText=""/>
                                    <Button Grid.Column="1"
                                            x:Name="CopyUsernameButton"
                                            Style="{StaticResource ModernIconButtonStyle}"
                                            Padding="8,4"
                                            ToolTipService.ToolTip="Copy username"
                                            Click="CopyUsernameButton_Click">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource ModernPrimaryBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Password Field -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="PASSWORD"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernPrimaryBrush}"
                                           Margin="0,0,0,5"
                                           CharacterSpacing="120"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="DetailPassword"
                                                            Grid.Column="0"
                                                            Text=""
                                                            CopyText=""/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ModernIconButtonStyle}"
                                            Padding="8,4"
                                            ToolTipService.ToolTip="Show/hide password"
                                            x:Name="RevealPasswordButton"
                                            Click="RevealPasswordButton_Click">
                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ModernIconButtonStyle}"
                                            Padding="8,4"
                                            ToolTipService.ToolTip="Copy password"
                                            x:Name="CopyPasswordButton"
                                            Click="CopyPasswordButton_Click">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource ModernPrimaryBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Website Field -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="WEBSITE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernPrimaryBrush}"
                                           Margin="0,0,0,5"
                                           CharacterSpacing="120"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:ReadOnlyField x:Name="DetailWebsite"
                                                            Grid.Column="0"
                                                            Text=""
                                                            CopyText=""/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ModernIconButtonStyle}"
                                            Padding="8,4"
                                            ToolTipService.ToolTip="Open website"
                                            x:Name="OpenWebsiteButton"
                                            Click="OpenWebsiteButton_Click">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource ModernPrimaryBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Tags Field -->
                            <StackPanel x:Name="DetailTagsSection" Margin="0,0,0,20">
                                <TextBlock Text="TAGS"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernPrimaryBrush}"
                                           Margin="0,0,0,5"
                                           CharacterSpacing="120"/>
                                <ItemsControl x:Name="DetailTagsPanel" ItemsSource="{Binding SelectedItem.Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3" Margin="0,0,6,4"
                                                    Background="#1E7C3AED"
                                                    CornerRadius="10">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource ModernPrimaryBrush}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Divider before actions -->
                            <Border Height="1" Background="{StaticResource ModernBorderBrush}" Margin="0,4,0,16"/>

                            <!-- Quick Actions - 1Password style row buttons -->
                            <TextBlock Text="ACTIONS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernPrimaryBrush}"
                                       CharacterSpacing="120"
                                       Margin="0,0,0,12"/>
                            <StackPanel>
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,8"
                                        MinWidth="0" MinHeight="0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="#1EF59E0B" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE1CE;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="#F59E0B"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Add to Favorites"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,8"
                                        MinWidth="0" MinHeight="0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="#1E7C3AED" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{StaticResource ModernPrimaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Organize"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,8"
                                        MinWidth="0" MinHeight="0"
                                        Cursor="Hand"
                                        Click="DeleteMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="#1EEF4444" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{StaticResource ModernErrorBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Delete"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernErrorBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Hidden edit fields (used internally for edit mode) -->
                            <StackPanel x:Name="EditTitleField" Visibility="Collapsed">
                                <TextBox x:Name="EditTitleTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="Enter title"/>
                            </StackPanel>

                            <StackPanel x:Name="EditUsernameField" Visibility="Collapsed">
                                <TextBox x:Name="EditUsernameTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="Enter username"/>
                            </StackPanel>

                            <PasswordBox x:Name="EditPasswordBox"
                                         Style="{StaticResource ModernPasswordBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="Enter password"
                                         Visibility="Collapsed"/>

                            <Button x:Name="GeneratePasswordButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="Collapsed"
                                    Click="GeneratePasswordButton_Click">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource ModernAccentBrush}"/>
                            </Button>

                            <StackPanel x:Name="EditWebsiteField" Visibility="Collapsed">
                                <TextBox x:Name="EditWebsiteTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="https://example.com"/>
                            </StackPanel>

                            <StackPanel x:Name="EditDescriptionField" Visibility="Collapsed">
                                <TextBox x:Name="EditDescriptionTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ui:ControlHelper.PlaceholderText="Additional notes..."
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="80"/>
                            </StackPanel>

                            <StackPanel x:Name="EditCategoryField" Visibility="Collapsed">
                                <ComboBox x:Name="EditCategoryComboBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          ui:ControlHelper.PlaceholderText="Choose category"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Edit tags section (hidden) -->
                            <StackPanel x:Name="EditTagsSection" Visibility="Collapsed">
                                <ui:AutoSuggestBox x:Name="TagSuggestBox"
                                                ui:ControlHelper.PlaceholderText="Add tags..."
                                                QueryIcon="Add"
                                                TextChanged="TagSuggestBox_TextChanged"
                                                SuggestionChosen="TagSuggestBox_SuggestionChosen"
                                                QuerySubmitted="TagSuggestBox_QuerySubmitted"
                                                Style="{StaticResource Modernui:AutoSuggestBoxStyle}"/>
                                <ItemsControl x:Name="EditTagsPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6">
                                                <Border Padding="6,2" Margin="0,0,6,0" Background="#EEE">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                </Border>
                                                <Button Content="✕" Click="RemoveTagButton_Click" Tag="{Binding Id}" Style="{StaticResource ModernIconButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Custom Fields section (hidden) -->
                            <StackPanel x:Name="EditCustomFieldsSection" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Custom Fields"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                    <Button x:Name="AddCustomFieldButton"
                                            Grid.Column="1"
                                            Content="+ Add Field"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            FontSize="12"
                                            Padding="8,4"
                                            Click="AddCustomFieldButton_Click"/>
                                </Grid>
                                <StackPanel x:Name="CustomFieldsContainer" Margin="12"/>
                            </StackPanel>

                            <!-- Hidden items needed by code-behind lookups -->
                            <TextBlock x:Name="DetailTitle" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailSubtitle" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailItemSubtitle" Visibility="Collapsed"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
