<Page
    x:Class="PasswordManager.WPF.Views.PasswordItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:PasswordManager.WPF.Controls"
      Background="{DynamicResource ModernBackgroundBrush}">

    <!-- Single Content Area - No additional sidebar since MainWindow provides navigation -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
            Background="{DynamicResource ModernSurfaceBrush}"
            BorderBrush="{DynamicResource ModernBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         ui:ControlHelper.PlaceholderText="🔍 Search passwords..."
                         TextChanged="SearchTextBox_TextChanged"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="36"
                         AutomationProperties.Name="Search passwords"
                         AutomationProperties.HelpText="Type to search through your passwords and items"
                         ToolTipService.ToolTip="Search through all your password items"/>

                <!-- Filter Button -->
                <Button x:Name="FilterButton"
                        Grid.Column="1"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Click="FilterButton_Click"
                        ToolTipService.ToolTip="Filters">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                              FontSize="16"/>
                    <!-- Button.Flyout not supported in WPF, functionality moved to Click event -->
                </Button>

                <!-- Title and Count -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="24,0">
                    <TextBlock x:Name="ContentTitle"
                               Text="All Items"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                    <TextBlock x:Name="ContentSubtitle"
                               Text="Showing all password items"
                               FontSize="12"
                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Action Buttons (Seed + New Item) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Seed Data Button -->
                <Button x:Name="SeedDataButton"
                        Click="SeedDataButton_Click"
                        Height="34"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Seed demo data"
                        ToolTipService.ToolTip="Seed ~100 demo password items">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SeedBd"
                                    CornerRadius="6" Padding="12,6"
                                    BorderThickness="0"
                                    Background="{DynamicResource ModernPrimaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="White" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Seed Data" Foreground="White"
                                               FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SeedBd" Property="Background" Value="{DynamicResource ModernPrimaryDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SeedBd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Add Button - Windows 11 dark mode -->
                <Button x:Name="AddButton"
                        Click="AddButton_Click"
                        Height="34"
                        AutomationProperties.Name="Create new password item"
                        ToolTipService.ToolTip="Create new password item">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="6" Padding="12,6"
                                    BorderThickness="0"
                                    Background="{DynamicResource ModernPrimaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="White" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="New Item" Foreground="White"
                                               FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ModernPrimaryDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Items List -->
                <ColumnDefinition Width="340" MinWidth="220" MaxWidth="560"/>
                <!-- Splitter -->
                <ColumnDefinition Width="5"/>
                <!-- Detail Panel -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Items List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ModernSurfaceBrush}"
                    BorderBrush="{DynamicResource ModernBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="*"/>      <!-- list fills remaining height -->
                    </Grid.RowDefinitions>

                    <!-- Category Header + inline search and category filter -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource ModernCardBrush}"
                            BorderBrush="{DynamicResource ModernBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="All Items"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="AddCategoryButton"
                                        Grid.Column="1"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32"
                                        Click="AddCategoryButton_Click"
                                        ToolTipService.ToolTip="Add Category">
                                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Global search bar (VS Code style): click the magnifier or press Enter
                                 to search across all items; the X clears it. -->
                            <Border Background="{DynamicResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                                    Height="38" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="RunSearchButton" Grid.Column="0"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="10,0" Cursor="Hand"
                                            Click="RunSearchButton_Click"
                                            ToolTipService.ToolTip="Search all items">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    </Button>

                                    <Grid Grid.Column="1">
                                        <TextBlock x:Name="SearchPlaceholder"
                                                   Text="Search all items..."
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" Margin="2,0,0,0"/>
                                        <TextBox x:Name="GlobalSearchTextBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource ModernTextPrimaryBrush}"
                                                 FontSize="14" VerticalContentAlignment="Center"
                                                 TextChanged="GlobalSearch_TextChanged"
                                                 KeyDown="GlobalSearch_KeyDown"/>
                                    </Grid>

                                    <Button x:Name="ClearSearchButton" Grid.Column="2"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="10,0" Cursor="Hand" Visibility="Collapsed"
                                            Click="ClearSearchButton_Click"
                                            ToolTipService.ToolTip="Clear search">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Category filter dropdown (populated from the database) -->
                            <ComboBox x:Name="CategoryDropdown"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ui:ControlHelper.PlaceholderText="All Categories"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="CategoryDropdown_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state — overlaid on Row 1, only visible when list is empty -->
                    <Border Grid.Row="1"
                            x:Name="EmptyStateBorder"
                            Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="No items yet"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click + New Item to add your first password"
                                       FontSize="13"
                                       Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Items List — ListView has its own ScrollViewer; Grid row constrains it -->
                    <ListView Grid.Row="1"
                              x:Name="ItemsList"
                              ItemsSource="{Binding PasswordItems}"
                              SelectionMode="Single"
                              SelectionChanged="ItemsList_SelectionChanged"
                              MouseDoubleClick="ItemsList_DoubleTapped"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4"
                                          Height="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Item Icon: colourful per-brand badge + emoji, with the
                                             website favicon / custom uploaded icon layered on top. -->
                                        <Grid Grid.Column="0"
                                              Width="40" Height="40"
                                              Margin="16,0,12,0"
                                              VerticalAlignment="Center">
                                            <Border CornerRadius="10"
                                                    Background="{Binding Converter={StaticResource ItemToBrandBrushConverter}}">
                                                <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                           FontSize="18"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="10" ClipToBounds="True">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Converter={StaticResource ItemToBrandImageConverter}}"
                                                                Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <!-- Item Info -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                       Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <!-- Tags: show chips under username -->
                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="6,2" Margin="0,0,6,0" Background="{DynamicResource ModernElevatedSurfaceBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                </Grid>
            </Border>

            <!-- Splitter between list and detail -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ModernBorderBrush}"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Column 2: Detail Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ModernSurfaceBrush}">
                <ScrollViewer x:Name="DetailScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="DetailScrollViewer_PreviewMouseWheel">
                    <StackPanel x:Name="DetailPanel"
                                Margin="16"
                                Visibility="Collapsed">

                        <!-- Detail Header -->
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4,0">
                                <TextBlock x:Name="DetailTitle"
                                           Text="Item Details"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                <TextBlock x:Name="DetailSubtitle"
                                           Text="View and manage item details"
                                           FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                <Button x:Name="ViewDetailButton" Click="ViewDetailButton_Click"
                                        Height="32" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,0"
                                                    Height="32" BorderThickness="1">
                                                <Border.Background><SolidColorBrush Color="#2A2A2A"/></Border.Background>
                                                <Border.BorderBrush><SolidColorBrush Color="#3A3A3A"/></Border.BorderBrush>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="View" Foreground="{DynamicResource ModernTextSecondaryBrush}" FontSize="13"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"><Setter.Value><SolidColorBrush Color="#323232"/></Setter.Value></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="EditDetailButton" Click="EditDetailButton_Click"
                                        Height="32">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd2" CornerRadius="6" Padding="10,0"
                                                    Height="32">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#2563EB" Offset="0"/>
                                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="EditDetailIcon" FontFamily="Segoe MDL2 Assets"
                                                               Text="&#xE70F;" FontSize="13"
                                                               Foreground="White" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="EditDetailText" Text="Edit"
                                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd2" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Detail Content -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel Margin="16">
                                <!-- Item Icon and Title -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource ModernPrimaryGradientBrush}"

                                            Width="48"
                                            Height="48"
                                            Margin="0,0,16,0">
                                        <TextBlock x:Name="DetailIcon"
                                                   Text="{Binding SelectedItem.Type, ElementName=ItemsList, Converter={StaticResource TypeToIconConverter}}"
                                                   FontSize="24"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="4">
                                        <TextBlock x:Name="DetailItemTitle"
                                                   Text="Select an item to view details"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailItemSubtitle"
                                                   Text=""
                                                   FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailCategory"
                                                   Text=""
                                                   FontSize="11" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detail Fields -->
                                <StackPanel x:Name="DetailFields"
                                            Margin="16">

                                    <!-- Title Field - Edit Mode -->
                                    <StackPanel x:Name="EditTitleField" Margin="8" Visibility="Collapsed">
                                        <TextBlock Text="Title *"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <TextBox x:Name="EditTitleTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 ui:ControlHelper.PlaceholderText="Enter title"/>
                                    </StackPanel>

                                    <!-- Username / Card Number / Network Name -->
                                    <Grid x:Name="DetailUsernameSection" Margin="8" AllowDrop="True"
                                          Tag="StaticFieldRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder" Tag="DragHandle"/>
                                        <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="UsernameLabel" Text="USERNAME"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode -->
                                            <controls:ReadOnlyField x:Name="DetailUsername"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <TextBox x:Name="EditUsernameTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     ui:ControlHelper.PlaceholderText="Enter username"
                                                     Visibility="Collapsed"/>

                                            <!-- Reveal button — only shown for credit card number -->
                                            <Button Grid.Column="1"
                                                    x:Name="RevealCardNumberButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    Visibility="Collapsed"
                                                    ToolTipService.ToolTip="Show/hide card number"
                                                    Click="RevealCardNumberButton_Click">
                                                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    x:Name="CopyUsernameButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy"
                                                    Click="CopyUsernameButton_Click">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Password / CVV -->
                                    <Grid x:Name="DetailPasswordSection" Margin="8" AllowDrop="True"
                                          Tag="StaticFieldRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder" Tag="DragHandle"/>
                                        <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="PasswordLabel" Text="PASSWORD"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode - Masked display -->
                                            <controls:ReadOnlyField x:Name="DetailPassword"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <PasswordBox x:Name="EditPasswordBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource ModernPasswordBoxStyle}"
                                                         ui:ControlHelper.PlaceholderText="Enter password"
                                                         Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Show/hide password"
                                                    x:Name="RevealPasswordButton"
                                                    Click="RevealPasswordButton_Click">
                                                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    x:Name="GeneratePasswordButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Generate password"
                                                    Click="GeneratePasswordButton_Click"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernAccentBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy password"
                                                    x:Name="CopyPasswordButton"
                                                    Click="CopyPasswordButton_Click">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Verification code (TOTP) - live -->
                                    <Grid x:Name="DetailTotpSection" Margin="8" Visibility="Collapsed"
                                          AllowDrop="True" Tag="StaticFieldRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder" Tag="DragHandle"/>
                                        <StackPanel Grid.Column="1">
                                        <TextBlock Text="VERIFICATION CODE (TOTP)"
                                                   FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DetailTotpCode" Grid.Column="0"
                                                       Text="——— ———"
                                                       FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ModernAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="34" Height="34" Margin="8,0"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Ellipse Stroke="#2A2A2A" StrokeThickness="3"/>
                                                    <TextBlock x:Name="DetailTotpCountdown" Text="30"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="2" x:Name="CopyTotpButton"
                                                    Background="Transparent" BorderThickness="0" Padding="8"
                                                    ToolTipService.ToolTip="Copy verification code"
                                                    Click="CopyTotpButton_Click">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Website / Cardholder -->
                                    <Grid x:Name="DetailWebsiteSection" Margin="8" AllowDrop="True"
                                          Tag="StaticFieldRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder" Tag="DragHandle"/>
                                        <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="WebsiteLabel" Text="WEBSITE"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode -->
                                            <controls:ReadOnlyField x:Name="DetailWebsite"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <TextBox x:Name="EditWebsiteTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     ui:ControlHelper.PlaceholderText="https://example.com"
                                                     Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy website"
                                                    Click="CopyWebsiteButton_Click">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Open website"
                                                    x:Name="OpenWebsiteButton"
                                                    Click="OpenWebsiteButton_Click">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>

                                        <!-- Open & Fill — lives here so it's clearly tied to the URL -->
                                        <Button x:Name="OpenAndFillButton" Click="OpenAndFillButton_Click"
                                                Height="32" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="Open the website in your default browser and copy credentials to clipboard">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BdF" CornerRadius="6" Padding="12,0"
                                                            Height="32" BorderThickness="1">
                                                        <Border.Background><SolidColorBrush Color="#16331F"/></Border.Background>
                                                        <Border.BorderBrush><SolidColorBrush Color="#225233"/></Border.BorderBrush>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13" Foreground="#5BD17F" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Open &amp; Fill" Foreground="#8FE3A8" FontSize="13" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BdF" Property="Background"><Setter.Value><SolidColorBrush Color="#1C4228"/></Setter.Value></Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Credit Card extra fields - View Mode only -->
                                    <Grid x:Name="DetailCreditCardSection" Margin="8,0,8,0" Visibility="Collapsed"
                                          AllowDrop="True" Tag="StaticFieldRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder" Tag="DragHandle"/>
                                        <StackPanel Grid.Column="1">
                                        <!-- Expiry + CVV row -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="EXPIRES" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                                <Border Background="{DynamicResource ModernCardBrush}" CornerRadius="6" Padding="10,8"
                                                        BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                                                    <TextBlock x:Name="DetailCardExpiry" Text="—"
                                                               FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="CVV" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                                <Border Background="{DynamicResource ModernCardBrush}" CornerRadius="6" Padding="10,2"
                                                        BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="DetailCardCvv" Grid.Column="0" Text="—"
                                                                   FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" x:Name="RevealCvvButton"
                                                                Background="Transparent" BorderThickness="0" Padding="6"
                                                                ToolTipService.ToolTip="Show/hide CVV"
                                                                Click="RevealCvvButton_Click">
                                                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Background="Transparent" BorderThickness="0" Padding="6"
                                                                ToolTipService.ToolTip="Copy CVV"
                                                                Click="CopyCvvButton_Click">
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Card type + Bank row -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CARD TYPE" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                                <Border Background="{DynamicResource ModernCardBrush}" CornerRadius="6" Padding="10,8"
                                                        BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                                                    <TextBlock x:Name="DetailCardType" Text="—"
                                                               FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="ISSUING BANK" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,2"/>
                                                <Border Background="{DynamicResource ModernCardBrush}" CornerRadius="6" Padding="10,8"
                                                        BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                                                    <TextBlock x:Name="DetailCardBank" Text="—"
                                                               FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description/Notes Field - Edit Mode -->
                                    <StackPanel x:Name="EditDescriptionField" Margin="8" Visibility="Collapsed">
                                        <TextBlock Text="Notes"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <TextBox x:Name="EditDescriptionTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 ui:ControlHelper.PlaceholderText="Additional notes..."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="80"/>
                                    </StackPanel>

                                    <!-- Category Field - Edit Mode -->
                                    <StackPanel x:Name="EditCategoryField" Margin="8" Visibility="Collapsed">
                                        <TextBlock Text="Category"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        <ComboBox x:Name="EditCategoryComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ui:ControlHelper.PlaceholderText="Choose category"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Notes - View Mode -->
                                    <Grid x:Name="DetailNotesSection" Margin="0,0,0,12" AllowDrop="True"
                                          Tag="StaticFieldRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder" Tag="DragHandle"/>
                                        <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Notes" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ModernTextTertiaryBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" x:Name="RevealNotesButton" Visibility="Collapsed"
                                                    Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                    Click="RevealNotesButton_Click"
                                                    ToolTipService.ToolTip="This note is protected — click to reveal">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="RevealNotesIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" Foreground="{StaticResource ModernAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="RevealNotesLabel" Text="Reveal" FontSize="12" FontWeight="Medium"
                                                               Foreground="{StaticResource ModernAccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border x:Name="DetailNotesBorder"
                                                Background="{DynamicResource ModernFormBackgroundBrush}" CornerRadius="6"
                                                Padding="12,10" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                                                MinHeight="64">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                                          PreviewMouseWheel="DetailScrollViewer_PreviewMouseWheel">
                                                <TextBlock x:Name="DetailNotesText"
                                                           Text="No notes"
                                                           FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="20"/>
                                            </ScrollViewer>
                                        </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom Fields - View + Add Mode -->
                                    <StackPanel x:Name="DetailCustomFieldsView" Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CUSTOM FIELDS" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="SaveDetailButton" Grid.Column="1"
                                                    Content="Save"
                                                    Style="{StaticResource ModernSecondaryButtonStyle}"
                                                    FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                                    Click="SaveDetailButton_Click"/>
                                            <Button x:Name="AddCustomFieldButton" Grid.Column="2"
                                                    Content="+ Add field"
                                                    Style="{StaticResource ModernSecondaryButtonStyle}"
                                                    FontSize="11" Padding="8,3"
                                                    Click="AddCustomFieldButton_Click"/>
                                        </Grid>


                                        <!-- Empty state -->
                                        <TextBlock x:Name="NoCustomFieldsText" Text="No custom fields yet."
                                                   FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"
                                                   Margin="0,4,0,4"/>

                                        <!-- Rows built dynamically in code-behind using CustomFieldHelper -->
                                        <StackPanel x:Name="DetailCustomFieldsList" AllowDrop="True"/>
                                    </StackPanel>

                                    <!-- Tags Field - Edit Mode / View Mode -->
                                    <StackPanel x:Name="DetailTagsSection" Margin="0,0,0,8">
                                        <TextBlock Text="Tags" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,6"
                                                   />
                                        <!-- Read-only tags display -->
                                        <ItemsControl x:Name="DetailTagsPanel">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,3" Margin="0,0,6,6"
                                                            Background="#1E3A5F" CornerRadius="4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11" FontWeight="Medium"
                                                                   Foreground="#60A5FA"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Edit area: ui:AutoSuggestBox + selected tags chips -->
                                        <StackPanel x:Name="EditTagsSection" Margin="8" Visibility="Collapsed">
                                            <ui:AutoSuggestBox x:Name="TagSuggestBox"
                                                            ui:ControlHelper.PlaceholderText="Add tags..."
                                                            QueryIcon="Add"
                                                            TextChanged="TagSuggestBox_TextChanged"
                                                            SuggestionChosen="TagSuggestBox_SuggestionChosen"
                                                            QuerySubmitted="TagSuggestBox_QuerySubmitted"
                                                            Style="{StaticResource ModernAutoSuggestBoxStyle}"/>

                                            <ItemsControl x:Name="EditTagsPanel">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="6">
                                                            <Border Padding="8,3" Margin="0,0,6,0" Background="#1E3A5F" CornerRadius="4">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#60A5FA"/>
                                                            </Border>
                                                            <Button Content="✕" Click="RemoveTagButton_Click" Tag="{Binding Id}" Style="{StaticResource ModernIconButtonStyle}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>


                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel Margin="12">
                                <TextBlock Text="Quick Actions"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource ModernTextPrimaryBrush}"/>

                                <StackPanel Margin="8">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           >
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE1CE;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Margin="0,0,10,0"
                                                      Foreground="{StaticResource ModernWarningBrush}"/>
                                            <TextBlock Text="Add to Favorites"
                                                       FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           >
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Margin="0,0,10,0"
                                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                            <TextBlock Text="Organize"
                                                       FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           >
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Margin="0,0,10,0"
                                                      Foreground="{StaticResource ModernAccentBrush}"/>
                                            <TextBlock Text="Share"
                                                       FontSize="14" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"

                                            Click="DeleteMenuItem_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Margin="0,0,10,0"
                                                      Foreground="{StaticResource ModernErrorBrush}"/>
                                            <TextBlock Text="Delete"
                                                       FontSize="14"
                                                       Foreground="{StaticResource ModernErrorBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
