<Page
    x:Class="PasswordManager.WPF.Views.PasswordItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:PasswordManager.WPF.Controls"
      Background="{StaticResource ModernBackgroundBrush}">

    <!-- Single Content Area - No additional sidebar since MainWindow provides navigation -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
            Background="{StaticResource ModernSurfaceBrush}"
            BorderBrush="{StaticResource ModernBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         ui:ControlHelper.PlaceholderText="🔍 Search passwords..."
                         TextChanged="SearchTextBox_TextChanged"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="36"
                         AutomationProperties.Name="Search passwords"
                         AutomationProperties.HelpText="Type to search through your passwords and items"
                         ToolTipService.ToolTip="Search through all your password items"/>

                <!-- Filter Button -->
                <Button x:Name="FilterButton"
                        Grid.Column="1"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Click="FilterButton_Click"
                        ToolTipService.ToolTip="Filters">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                              FontSize="16"/>
                    <!-- Button.Flyout not supported in WPF, functionality moved to Click event -->
                </Button>

                <!-- Title and Count -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="24,0">
                    <TextBlock x:Name="ContentTitle"
                               Text="All Items"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <TextBlock x:Name="ContentSubtitle"
                               Text="Showing all password items"
                               FontSize="12"
                               Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Action Buttons (Seed + New Item) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Seed Data Button -->
                <Button x:Name="SeedDataButton"
                        Click="SeedDataButton_Click"
                        Height="34"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Seed demo data"
                        ToolTipService.ToolTip="Seed ~100 demo password items">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SeedBd"
                                    CornerRadius="6" Padding="12,6"
                                    BorderThickness="1">
                                <Border.Background><SolidColorBrush Color="#1A3A2A"/></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#2A5A3A"/></Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#60C060" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Seed Data" Foreground="#90D090"
                                               FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SeedBd" Property="Background">
                                        <Setter.Value><SolidColorBrush Color="#224A32"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SeedBd" Property="Background">
                                        <Setter.Value><SolidColorBrush Color="#152A1E"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Add Button - Windows 11 dark mode -->
                <Button x:Name="AddButton"
                        Click="AddButton_Click"
                        Height="34"
                        AutomationProperties.Name="Create new password item"
                        ToolTipService.ToolTip="Create new password item">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="6" Padding="12,6"
                                    BorderThickness="1">
                                <Border.Background><SolidColorBrush Color="#2D2D2D"/></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#454545"/></Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#B0B0B0" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="New Item" Foreground="#E5E5E5"
                                               FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value><SolidColorBrush Color="#3A3A3A"/></Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Bd" Property="BorderBrush">
                                        <Setter.Value><SolidColorBrush Color="#555555"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value><SolidColorBrush Color="#272727"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Items List -->
                <ColumnDefinition Width="340" MinWidth="220" MaxWidth="560"/>
                <!-- Splitter -->
                <ColumnDefinition Width="5"/>
                <!-- Detail Panel -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Items List -->
            <Border Grid.Column="0"
                    Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="*"/>      <!-- list fills remaining height -->
                    </Grid.RowDefinitions>

                    <!-- Category Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource ModernCardBrush}"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="All Items"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="AddCategoryButton"
                                    Grid.Column="1"
                                    Background="Transparent" BorderThickness="0"
                                    Width="32" Height="32"
                                    Click="AddCategoryButton_Click"
                                    ToolTipService.ToolTip="Add Category">
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Empty state — overlaid on Row 1, only visible when list is empty -->
                    <Border Grid.Row="1"
                            x:Name="EmptyStateBorder"
                            Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="No items yet"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click + New Item to add your first password"
                                       FontSize="13"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Items List — ListView has its own ScrollViewer; Grid row constrains it -->
                    <ListView Grid.Row="1"
                              x:Name="ItemsList"
                              ItemsSource="{Binding PasswordItems}"
                              SelectionMode="Single"
                              SelectionChanged="ItemsList_SelectionChanged"
                              MouseDoubleClick="ItemsList_DoubleTapped"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4"
                                          Height="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Item Icon -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource ModernPrimaryGradientBrush}"
                                               
                                                Width="40"
                                                Height="40"
                                                Margin="16,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                       FontSize="18"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Item Info -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                                       Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <!-- Tags: show chips under username -->
                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="6,2" Margin="0,0,6,0" Background="#383838" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                </Grid>
            </Border>

            <!-- Splitter between list and detail -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FF3A3A3A"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Column 2: Detail Panel -->
            <Border Grid.Column="2"
                    Background="{StaticResource ModernSurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel"
                                Margin="16"
                                Visibility="Collapsed">

                        <!-- Detail Header -->
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4,0">
                                <TextBlock x:Name="DetailTitle"
                                           Text="Item Details"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#E5E5E5"/>
                                <TextBlock x:Name="DetailSubtitle"
                                           Text="View and manage item details"
                                           FontSize="12" Foreground="#6A6A6A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                <Button x:Name="ViewDetailButton" Click="ViewDetailButton_Click"
                                        Height="32" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,0"
                                                    Height="32" BorderThickness="1">
                                                <Border.Background><SolidColorBrush Color="#2A2A2A"/></Border.Background>
                                                <Border.BorderBrush><SolidColorBrush Color="#3A3A3A"/></Border.BorderBrush>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" Foreground="#9D9D9D" Margin="0,0,6,0"/>
                                                    <TextBlock Text="View" Foreground="#C8C8C8" FontSize="13"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"><Setter.Value><SolidColorBrush Color="#323232"/></Setter.Value></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="EditDetailButton" Click="EditDetailButton_Click"
                                        Height="32">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd2" CornerRadius="6" Padding="10,0"
                                                    Height="32">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#2563EB" Offset="0"/>
                                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="EditDetailIcon" FontFamily="Segoe MDL2 Assets"
                                                               Text="&#xE70F;" FontSize="13"
                                                               Foreground="White" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="EditDetailText" Text="Edit"
                                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd2" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Detail Content -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel Margin="16">
                                <!-- Item Icon and Title -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource ModernPrimaryGradientBrush}"
                                           
                                            Width="48"
                                            Height="48"
                                            Margin="0,0,16,0">
                                        <TextBlock x:Name="DetailIcon"
                                                   Text="{Binding SelectedItem.Type, ElementName=ItemsList, Converter={StaticResource TypeToIconConverter}}"
                                                   FontSize="24"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="4">
                                        <TextBlock x:Name="DetailItemTitle"
                                                   Text="Select an item to view details"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#E5E5E5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailItemSubtitle"
                                                   Text=""
                                                   FontSize="13" Foreground="#9D9D9D"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailCategory"
                                                   Text=""
                                                   FontSize="11" Foreground="#6A6A6A"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detail Fields -->
                                <StackPanel x:Name="DetailFields"
                                            Margin="16">

                                    <!-- Title Field - Edit Mode -->
                                    <StackPanel x:Name="EditTitleField" Margin="8" Visibility="Collapsed">
                                        <TextBlock Text="Title *"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <TextBox x:Name="EditTitleTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 ui:ControlHelper.PlaceholderText="Enter title"/>
                                    </StackPanel>

                                    <!-- Username -->
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Username"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode -->
                                            <controls:ReadOnlyField x:Name="DetailUsername"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <TextBox x:Name="EditUsernameTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     ui:ControlHelper.PlaceholderText="Enter username"
                                                     Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    x:Name="CopyUsernameButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy username"
                                                    Click="CopyUsernameButton_Click">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Password -->
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Password"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode - Masked display -->
                                            <controls:ReadOnlyField x:Name="DetailPassword"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <PasswordBox x:Name="EditPasswordBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource ModernPasswordBoxStyle}"
                                                         ui:ControlHelper.PlaceholderText="Enter password"
                                                         Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Show/hide password"
                                                    x:Name="RevealPasswordButton"
                                                    Click="RevealPasswordButton_Click">
                                                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    x:Name="GeneratePasswordButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Generate password"
                                                    Click="GeneratePasswordButton_Click"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernAccentBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Copy password"
                                                    x:Name="CopyPasswordButton"
                                                    Click="CopyPasswordButton_Click">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Website URL -->
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Website"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- View Mode -->
                                            <controls:ReadOnlyField x:Name="DetailWebsite"
                                                                    Grid.Column="0"
                                                                    Text=""
                                                                    CopyText=""/>

                                            <!-- Edit Mode -->
                                            <TextBox x:Name="EditWebsiteTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     ui:ControlHelper.PlaceholderText="https://example.com"
                                                     Visibility="Collapsed"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    ToolTipService.ToolTip="Open website"
                                                    x:Name="OpenWebsiteButton"
                                                    Click="OpenWebsiteButton_Click">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14"
                                                          Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Description/Notes Field - Edit Mode -->
                                    <StackPanel x:Name="EditDescriptionField" Margin="8" Visibility="Collapsed">
                                        <TextBlock Text="Notes"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <TextBox x:Name="EditDescriptionTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 ui:ControlHelper.PlaceholderText="Additional notes..."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="80"/>
                                    </StackPanel>

                                    <!-- Category Field - Edit Mode -->
                                    <StackPanel x:Name="EditCategoryField" Margin="8" Visibility="Collapsed">
                                        <TextBlock Text="Category"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                        <ComboBox x:Name="EditCategoryComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ui:ControlHelper.PlaceholderText="Choose category"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Notes - View Mode -->
                                    <StackPanel x:Name="DetailNotesSection" Margin="0,0,0,12">
                                        <TextBlock Text="Notes" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#6A6A6A" Margin="0,0,0,4"
                                                   />
                                        <Border Background="#141414" CornerRadius="6"
                                                Padding="12,10" BorderBrush="#2A2A2A" BorderThickness="1">
                                            <TextBlock x:Name="DetailNotesText"
                                                       Text="No notes"
                                                       FontSize="13" Foreground="#9D9D9D"
                                                       TextWrapping="Wrap"
                                                       LineHeight="20"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Custom Fields - View Mode -->
                                    <StackPanel x:Name="DetailCustomFieldsView" Margin="0,0,0,12"
                                                Visibility="Collapsed">
                                        <TextBlock Text="Custom Fields" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#6A6A6A" Margin="0,0,0,4"
                                                   />
                                        <ItemsControl x:Name="DetailCustomFieldsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#141414" CornerRadius="6"
                                                            Padding="12,8" Margin="0,0,0,4"
                                                            BorderBrush="#2A2A2A" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#6A6A6A"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                       FontSize="13" Foreground="#E5E5E5"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Tags Field - Edit Mode / View Mode -->
                                    <StackPanel x:Name="DetailTagsSection" Margin="0,0,0,8">
                                        <TextBlock Text="Tags" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#6A6A6A" Margin="0,0,0,6"
                                                   />
                                        <!-- Read-only tags display -->
                                        <ItemsControl x:Name="DetailTagsPanel">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,3" Margin="0,0,6,6"
                                                            Background="#1E3A5F" CornerRadius="4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11" FontWeight="Medium"
                                                                   Foreground="#60A5FA"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Edit area: ui:AutoSuggestBox + selected tags chips -->
                                        <StackPanel x:Name="EditTagsSection" Margin="8" Visibility="Collapsed">
                                            <ui:AutoSuggestBox x:Name="TagSuggestBox"
                                                            ui:ControlHelper.PlaceholderText="Add tags..."
                                                            QueryIcon="Add"
                                                            TextChanged="TagSuggestBox_TextChanged"
                                                            SuggestionChosen="TagSuggestBox_SuggestionChosen"
                                                            QuerySubmitted="TagSuggestBox_QuerySubmitted"
                                                            Style="{StaticResource ModernAutoSuggestBoxStyle}"/>

                                            <ItemsControl x:Name="EditTagsPanel">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="6">
                                                            <Border Padding="6,2" Margin="0,0,6,0" Background="#383838">
                                                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                            </Border>
                                                            <Button Content="✕" Click="RemoveTagButton_Click" Tag="{Binding Id}" Style="{StaticResource ModernIconButtonStyle}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Custom Fields - Edit Mode -->
                                    <StackPanel x:Name="EditCustomFieldsSection" Margin="16" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Custom Fields"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                            <Button x:Name="AddCustomFieldButton"
                                                    Grid.Column="1"
                                                    Content="+ Add Field"
                                                    Style="{StaticResource ModernSecondaryButtonStyle}"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    Click="AddCustomFieldButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="CustomFieldsContainer" Margin="12"/>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel Margin="12">
                                <TextBlock Text="Quick Actions"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                                <StackPanel Margin="8">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           >
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE1CE;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernWarningBrush}"/>
                                            <TextBlock Text="Add to Favorites"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           >
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                            <TextBlock Text="Organize"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           >
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernAccentBrush}"/>
                                            <TextBlock Text="Share"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,8"
                                           
                                            Click="DeleteMenuItem_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="12">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16"
                                                      Foreground="{StaticResource ModernErrorBrush}"/>
                                            <TextBlock Text="Delete"
                                                       FontSize="14"
                                                       Foreground="{StaticResource ModernErrorBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
