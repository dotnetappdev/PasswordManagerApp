<Page
    x:Class="PasswordManager.WPF.Views.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">
            
            <!-- Page Header -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource ModernPrimaryBrush}"
                                CornerRadius="8"
                                Width="36"
                                Height="36"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                     FontSize="16"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Import Passwords"
                                  Style="{StaticResource ModernHeading3Style}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Import passwords from 1Password, Bitwarden, Chrome, LastPass and more."
                              Style="{StaticResource ModernCaptionStyle}"
                              Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Import Configuration -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="20">
                    <TextBlock Text="Configuration"
                              Style="{StaticResource ModernHeading3Style}"
                              Margin="0,0,0,16"/>

                    <!-- Import Source -->
                    <TextBlock Text="Import Source"
                              Style="{StaticResource ModernCaptionStyle}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,4"/>
                    <ComboBox x:Name="ImportTypeComboBox"
                             ItemsSource="{Binding AvailableImportTypes}"
                             SelectedItem="{Binding SelectedImportType, Mode=TwoWay}"
                             Style="{StaticResource ModernComboBoxStyle}"
                             MinWidth="280"
                             HorizontalAlignment="Left"
                             SelectionChanged="ImportTypeComboBox_SelectionChanged"
                             Margin="0,0,0,14"/>

                    <!-- File Selection -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Select File"
                                  Style="{StaticResource ModernCaptionStyle}"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedFileFormat}"
                                  Style="{StaticResource ModernCaptionStyle}"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource ModernPrimaryBrush}"
                                  Margin="8,0,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding SelectedFilePath, Mode=TwoWay}"
                                ui:ControlHelper.PlaceholderText="Choose a file to import..."
                                IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                               x:Name="BrowseFileButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               Click="BrowseFileButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ImportButton"
                               Style="{StaticResource ModernPrimaryButtonStyle}"
                               IsEnabled="{Binding CanImport}"
                               MinWidth="140"
                               Height="40"
                               Click="ImportButton_Click"
                               Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Start Import" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton"
                               Style="{StaticResource ModernSecondaryButtonStyle}"
                               MinWidth="100"
                               Height="40"
                               Click="CancelButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Maintenance / Danger Zone -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Margin="20">
                    <TextBlock Text="Maintenance"
                              Style="{StaticResource ModernHeading3Style}"/>
                    <TextBlock Text="Reset the vault before importing a fresh export. These actions cannot be undone."
                              Style="{StaticResource ModernCaptionStyle}"
                              Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ClearDataButton"
                               Style="{StaticResource ModernDangerButtonStyle}"
                               MinWidth="160"
                               Height="40"
                               Click="ClearDataButton_Click">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Clear Vault Data" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="To delete user accounts, use Settings → Maintenance → Delete User Accounts."
                              Style="{StaticResource ModernCaptionStyle}"
                              Opacity="0.7"
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Import Results -->
            <Grid MinHeight="400">
                
                <!-- Loading State -->
                <Border Style="{StaticResource ModernCardStyle}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Padding="32,28"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Header row: spinner + title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:ProgressRing IsActive="True" Width="28" Height="28" Margin="0,0,12,0"/>
                            <TextBlock Text="Importing…"
                                      Style="{StaticResource ModernHeading3Style}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Determinate progress bar -->
                        <ProgressBar x:Name="ImportProgressBar"
                                     Value="{Binding ImportProgress}"
                                     Minimum="0" Maximum="100"
                                     Height="8"
                                     Margin="0,0,0,10"
                                     Foreground="{DynamicResource ModernPrimaryBrush}"
                                     Background="{DynamicResource ModernSurfaceBrush}"/>

                        <!-- Status text + percentage -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                      Text="{Binding ImportStatus}"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                      TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                      Text="{Binding ImportProgressText}"
                                      Style="{StaticResource ModernCaptionStyle}"
                                      Foreground="{DynamicResource ModernPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Import Results Panel -->
                <StackPanel Visibility="{Binding HasImportCompleted, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Completion banner -->
                    <Border CornerRadius="10" Margin="0,0,0,12"
                            Background="{Binding CompletionBannerColor}"
                            Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                      Text="{Binding CompletionIcon}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="20" Foreground="White"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompletionTitle}"
                                          Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding CompletionSubtitle}"
                                          Foreground="White" Opacity="0.85" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                   x:Name="NewImportButton"
                                   Click="NewImportButton_Click"
                                   Background="Transparent"
                                   BorderThickness="1"
                                   BorderBrush="White"
                                   Foreground="White"
                                   Padding="14,6"
                                   VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="New Import" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Summary Cards -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel Margin="16">
                            <TextBlock Text="Import Summary"
                                      Style="{StaticResource ModernHeading3Style}"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0"
                                       Background="{StaticResource ModernSuccessBrush}"
                                       CornerRadius="8"
                                       Padding="16,14"
                                       Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ImportedItemsCount}"
                                                  Foreground="White"
                                                  FontWeight="Bold"
                                                  FontSize="28"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="Imported"
                                                  Foreground="White"
                                                  FontSize="12"
                                                  Opacity="0.85"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                       Background="{StaticResource ModernWarningBrush}"
                                       CornerRadius="8"
                                       Padding="16,14"
                                       Margin="6,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SkippedItemsCount}"
                                                  Foreground="White"
                                                  FontWeight="Bold"
                                                  FontSize="28"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="Skipped"
                                                  Foreground="White"
                                                  FontSize="12"
                                                  Opacity="0.85"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                       Background="{StaticResource ModernErrorBrush}"
                                       CornerRadius="8"
                                       Padding="16,14"
                                       Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ErrorItemsCount}"
                                                  Foreground="White"
                                                  FontWeight="Bold"
                                                  FontSize="28"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="Errors"
                                                  Foreground="White"
                                                  FontSize="12"
                                                  Opacity="0.85"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Detailed Results -->
                    <Border Style="{StaticResource ModernCardStyle}"
                           Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="Import Details"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernHeading3Style}"/>
                                <Button Grid.Column="1"
                                       x:Name="ClearResultsButton"
                                       Style="{StaticResource ModernSecondaryButtonStyle}"
                                       Click="ClearResultsButton_Click"
                                       ToolTip="Clear the import results below">
                                    <StackPanel Orientation="Horizontal" Margin="8,4">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Clear Results" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ImportResults}" Background="Transparent">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Status dot -->
                                                <Border Grid.Column="0"
                                                       Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                       CornerRadius="4"
                                                       Width="28" Height="28"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                                              FontSize="13"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Title + message -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                              Style="{StaticResource ModernBodyStyle}"
                                                              FontWeight="SemiBold"
                                                              TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Message}"
                                                              Style="{StaticResource ModernCaptionStyle}"
                                                              Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                              TextTrimming="CharacterEllipsis"
                                                              Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <!-- Type pill -->
                                                <Border Grid.Column="2"
                                                       Background="{DynamicResource ModernSurfaceBrush}"
                                                       CornerRadius="4"
                                                       Padding="6,3"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemType}"
                                                              FontSize="11"
                                                              Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                                              FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Status badge -->
                                                <Border Grid.Column="3"
                                                       Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                       CornerRadius="4"
                                                       Padding="8,3"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}"
                                                              FontSize="11"
                                                              Foreground="White"
                                                              FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
                
                <!-- Empty State removed per UX request -->
                
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
