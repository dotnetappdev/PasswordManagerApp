<Page x:Class="PasswordManager.WPF.Views.PasskeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{StaticResource ModernBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32">

            <!-- ═══ Page Header ════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Passkeys"
                                       FontSize="28" FontWeight="Bold" Foreground="#E5E5E5"/>
                            <TextBlock Text="Passwordless authentication credentials"
                                       FontSize="13" Foreground="#6A6A6A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="AddPasskeyButton" Grid.Column="1" Click="AddPasskeyButton_Click"
                        Height="36" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Padding="16,0" Height="36">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2563EB" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add Passkey" Foreground="White"
                                               FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ═══ Stats Row ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="12" Padding="20,16"
                        Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="#11243D">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TotalCount" Text="0" FontSize="24"
                                       FontWeight="Bold" Foreground="#E5E5E5"/>
                            <TextBlock Text="Total Passkeys" FontSize="12" Foreground="#6A6A6A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="12" Padding="20,16"
                        Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="#14532D">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BackedUpCount" Text="0" FontSize="24"
                                       FontWeight="Bold" Foreground="#E5E5E5"/>
                            <TextBlock Text="Backed Up" FontSize="12" Foreground="#6A6A6A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" CornerRadius="12" Padding="20,16"
                        Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="#1A1A3E">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FIDO2" FontSize="20" FontWeight="Bold" Foreground="#E5E5E5"/>
                            <TextBlock Text="WebAuthn Standard" FontSize="12" Foreground="#6A6A6A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" CornerRadius="12" Padding="20,16"
                        Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="#11243D">
                            <TextBlock Text="&#xE8E1;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Zero" FontSize="20" FontWeight="Bold" Foreground="#E5E5E5"/>
                            <TextBlock Text="Phishing Risk" FontSize="12" Foreground="#6A6A6A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Info Banner ════════════════════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Background="#0F1B2D" BorderBrush="#1E3A5F" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="20" Foreground="#60A5FA" Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="What are Passkeys?" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#93C5FD"/>
                        <TextBlock FontSize="12" Foreground="#4A6FA5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Passkeys replace passwords with device-bound cryptographic keys. They use your fingerprint, face, or PIN to authenticate — no password to remember, steal, or phish. Stored here as credentials managed by your vault."/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="LearnMoreButton_Click"
                            Background="Transparent" BorderThickness="0" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#60A5FA" Margin="0,0,5,0"/>
                            <TextBlock Text="Learn more" FontSize="12" Foreground="#60A5FA"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ Windows Hello Integration ══════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Background="#11243D" Margin="0,0,16,0" VerticalAlignment="Top">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Windows Hello" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#E5E5E5" VerticalAlignment="Center"/>
                            <Border x:Name="HelloStatusBadge" CornerRadius="6" Padding="8,2"
                                    Margin="10,0,0,0" Background="#1F2937" VerticalAlignment="Center">
                                <TextBlock x:Name="HelloStatusText" Text="Checking…" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#9D9D9D"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#6A6A6A" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Use your Windows PIN, fingerprint, or face to unlock VaultGuard. This binds a key to this device's secure enclave — the same system Windows uses for platform passkeys."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="SetupHelloButton" Click="SetupHelloButton_Click"
                                Height="34" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="14,0" Height="34">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#1D4ED8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock Text="Set up" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="VerifyHelloButton" Click="VerifyHelloButton_Click" Height="34">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd2" CornerRadius="8" Padding="14,0" Height="34"
                                            Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="#9D9D9D" Margin="0,0,7,0"/>
                                            <TextBlock Text="Test" Foreground="#C8C8C8" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd2" Property="Background" Value="#323232"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Empty State ════════════════════════════════════════════════════ -->
            <Border x:Name="EmptyStateBorder" CornerRadius="16" Padding="48" Margin="0,0,0,24"
                    Background="#141414" BorderBrush="#242424" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                               HorizontalAlignment="Center" Foreground="#2A2A2A" Margin="0,0,0,16"/>
                    <TextBlock Text="No passkeys stored yet"
                               FontSize="20" FontWeight="SemiBold" Foreground="#4A4A4A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Add passkey entries from websites that support passwordless login."
                               FontSize="14" Foreground="#3A3A3A" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,24" MaxWidth="360"/>
                    <Button Click="AddPasskeyButton_Click" HorizontalAlignment="Center"
                            Height="40" Padding="20,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Padding="20,0" Height="40">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="Add Your First Passkey" Foreground="White"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ Passkey Cards ══════════════════════════════════════════════════ -->
            <ItemsControl x:Name="PasskeysList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Margin="0,0,0,10"
                                Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                            <Setter Property="Background" Value="#1E1E1E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- Platform icon -->
                                    <ColumnDefinition Width="*"/>     <!-- Info -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Badges -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                                </Grid.ColumnDefinitions>

                                <!-- Platform / Device Icon -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                        Margin="0,0,16,0" Background="#11243D">
                                    <TextBlock Text="{Binding PlatformIcon}"
                                               FontSize="24" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Website + Username + Last used -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#E5E5E5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Username}" FontSize="13" Foreground="#9D9D9D"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="#4A4A4A" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding LastUsedText}" FontSize="12"
                                                   Foreground="#4A4A4A"/>
                                        <TextBlock Text=" · " FontSize="12" Foreground="#3A3A3A"/>
                                        <TextBlock Text="{Binding DeviceType}" FontSize="12"
                                                   Foreground="#4A4A4A"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Badges -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,0,4"
                                            Background="{Binding BackupBadgeBackground}">
                                        <TextBlock Text="{Binding BackupBadgeText}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding BackupBadgeForeground}"/>
                                    </Border>
                                    <Border CornerRadius="6" Padding="8,3"
                                            Background="#1A1A3E" Margin="0,0,0,0">
                                        <TextBlock Text="FIDO2" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#818CF8"/>
                                    </Border>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Tag="{Binding}" Click="ViewPasskeyButton_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="34" Height="34"
                                            ToolTipService.ToolTip="View details">
                                        <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="#6A6A6A"/>
                                    </Button>
                                    <Button Tag="{Binding}" Click="CopyWebsiteButton_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="34" Height="34"
                                            ToolTipService.ToolTip="Copy website URL">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="#6A6A6A"/>
                                    </Button>
                                    <Button Tag="{Binding}" Click="DeletePasskeyButton_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="34" Height="34"
                                            ToolTipService.ToolTip="Delete passkey">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="#4A4A4A"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Supported Sites Banner ═════════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,8,0,0"
                    Background="#141414" BorderBrush="#242424" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Popular passkey-supported sites" FontSize="13"
                               FontWeight="SemiBold" Foreground="#6A6A6A" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border x:Name="Site1" CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="🔍  Google" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="🍎  Apple ID" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="🐙  GitHub" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="🛒  Amazon" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="🪟  Microsoft" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="📘  X / Twitter" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="💼  LinkedIn" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="#1E1E1E">
                            <TextBlock Text="🎮  PlayStation" FontSize="13" Foreground="#9D9D9D"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
