<Page x:Class="PasswordManager.WPF.Views.PasskeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Background="{DynamicResource ModernBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32">

            <!-- ═══ Page Header ════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center"
                                Background="{DynamicResource ModernPrimaryBrush}">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Passkeys"
                                       FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Passwordless sign-in — FIDO2 keys unlocked by Windows Hello"
                                       FontSize="13" Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="AddPasskeyButton" Grid.Column="1" Click="AddPasskeyButton_Click"
                        Height="36" VerticalAlignment="Center"
                        Background="{DynamicResource ModernPrimaryBrush}" Foreground="White"
                        BorderThickness="0" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Add Passkey" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══ Stats Row ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource ModernPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TotalCount" Text="0" FontSize="24"
                                       FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Total Passkeys" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource ModernSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BackedUpCount" Text="0" FontSize="24"
                                       FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Backed Up" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource ModernPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FIDO2" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="WebAuthn Standard" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" CornerRadius="12" Padding="20,16"
                        Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="&#xE8E1;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource ModernSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Zero" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Phishing Risk" FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Info Banner ════════════════════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernPrimaryBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="20" Foreground="{DynamicResource ModernPrimaryBrush}" Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="What are Passkeys?" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ModernTextPrimaryBrush}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="A passkey is a FIDO2 public/private key pair. The private key never leaves your device and is unlocked with your fingerprint, face, or PIN via Windows Hello — there is no password to remember, reuse, or phish. Each passkey is unique to one site."/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="LearnMoreButton_Click"
                            Background="Transparent" BorderThickness="0" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{DynamicResource ModernPrimaryBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="Learn more" FontSize="12" Foreground="{DynamicResource ModernPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ Windows Hello Integration ══════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Background="{DynamicResource ModernElevatedSurfaceBrush}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource ModernPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Windows Hello" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="HelloStatusBadge" CornerRadius="6" Padding="8,2"
                                    Margin="10,0,0,0" Background="{DynamicResource ModernElevatedSurfaceBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="HelloStatusText" Text="Checking…" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ModernTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Use your Windows PIN, fingerprint, or face to unlock VaultGuard. This binds a key to this device's secure enclave — the same system Windows uses for platform passkeys."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ui:ToggleSwitch x:Name="PasskeyToggle"
                                         OnContent="On" OffContent="Off"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,0,10"
                                         Toggled="PasskeyToggle_Toggled"/>
                        <Button x:Name="SetupHelloButton" Click="SetupHelloButton_Click"
                                Height="34" Margin="0,0,0,8"
                                Background="{DynamicResource ModernPrimaryBrush}" Foreground="White"
                                BorderThickness="0" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                <TextBlock Text="Set up" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="VerifyHelloButton" Click="VerifyHelloButton_Click" Height="34"
                                Background="{DynamicResource ModernElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Test" Foreground="{DynamicResource ModernTextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Empty State ════════════════════════════════════════════════════ -->
            <Border x:Name="EmptyStateBorder" CornerRadius="16" Padding="48" Margin="0,0,0,24"
                    Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="No passkeys stored yet"
                               FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Add passkey entries from websites that support passwordless login."
                               FontSize="14" Foreground="{DynamicResource ModernTextTertiaryBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,24" MaxWidth="360"/>
                    <Button Click="AddPasskeyButton_Click" HorizontalAlignment="Center"
                            Height="40" Padding="20,0"
                            Background="{DynamicResource ModernPrimaryBrush}" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Add Your First Passkey" Foreground="White"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ Passkey Cards ══════════════════════════════════════════════════ -->
            <ItemsControl x:Name="PasskeysList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Margin="0,0,0,10"
                                Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                            <Grid Margin="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- Platform icon -->
                                    <ColumnDefinition Width="*"/>     <!-- Info -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Badges -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                                </Grid.ColumnDefinitions>

                                <!-- Platform / Device Icon -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                        Margin="0,0,16,0" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                                    <TextBlock Text="{Binding PlatformIcon}"
                                               FontSize="24" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Website + Username + Last used -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ModernTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Username}" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{DynamicResource ModernTextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding LastUsedText}" FontSize="12"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding DeviceType}" FontSize="12"
                                                   Foreground="{DynamicResource ModernTextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Badges -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,0,4"
                                            Background="{Binding BackupBadgeBackground}">
                                        <TextBlock Text="{Binding BackupBadgeText}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding BackupBadgeForeground}"/>
                                    </Border>
                                    <Border CornerRadius="6" Padding="8,3"
                                            Background="{DynamicResource ModernElevatedSurfaceBrush}" Margin="0,0,0,0">
                                        <TextBlock Text="FIDO2" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource ModernPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Tag="{Binding}" Click="ViewPasskeyButton_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="34" Height="34"
                                            ToolTipService.ToolTip="View details">
                                        <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    </Button>
                                    <Button Tag="{Binding}" Click="CopyWebsiteButton_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="34" Height="34"
                                            ToolTipService.ToolTip="Copy website URL">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                                    </Button>
                                    <Button Tag="{Binding}" Click="DeletePasskeyButton_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="34" Height="34"
                                            ToolTipService.ToolTip="Delete passkey">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="{DynamicResource ModernErrorBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Supported Sites Banner ═════════════════════════════════════════ -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,8,0,0"
                    Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Popular passkey-supported sites" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border x:Name="Site1" CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="🔍  Google" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="🍎  Apple ID" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="🐙  GitHub" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="🛒  Amazon" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="🪟  Microsoft" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="📘  X / Twitter" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="💼  LinkedIn" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Margin="0,0,8,8" Background="{DynamicResource ModernElevatedSurfaceBrush}">
                            <TextBlock Text="🎮  PlayStation" FontSize="13" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
