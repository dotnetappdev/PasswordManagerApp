<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManager.WPF.Controls.ReadOnlyField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignWidth="400"
    d:DesignHeight="40"
    IsTabStop="True"
    GotFocus="Root_GotFocus"
    LostFocus="Root_LostFocus">

    <Border Background="#1A1A1A" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
            BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Displayed value — crisp white text on dark background -->
            <TextBlock x:Name="ValueTextBlock"
                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="#E5E5E5"
                       FontSize="14"
                       FontFamily="Segoe UI"
                       FontWeight="Normal"/>

            <!-- Inline copy button (shown on focus/hover via code-behind) -->
            <Button x:Name="CopyButton"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Click="CopyButton_Click"
                    Margin="8,0,0,0"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#2A2A2A"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CopyBd" CornerRadius="4" Padding="6,2"
                                Background="#2A2A2A">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#6A6A6A"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CopyBd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
