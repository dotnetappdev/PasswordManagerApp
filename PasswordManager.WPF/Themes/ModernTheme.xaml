<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- 
    Modern Theme for Password Manager (WPF)
    
    Professional design system – Inter typography, deep dark palette,
    gradient brand accents. Aligned with PasswordManager.Models/UI/UIConstants.cs
    
    For full documentation, see: UI_DESIGN_SYSTEM.md
    -->

    <!-- ═══════════════════════════════════════════
         Colour Tokens
    ═══════════════════════════════════════════ -->

    <!-- Brand / Primary — steel blue, no purple -->
    <Color x:Key="ModernPrimaryColor">#2563EB</Color>
    <Color x:Key="ModernPrimaryLightColor">#60A5FA</Color>
    <Color x:Key="ModernPrimaryDarkColor">#1D4ED8</Color>

    <!-- Accent — subtle indigo, used sparingly -->
    <Color x:Key="ModernAccentColor">#6366F1</Color>
    <Color x:Key="ModernAccentLightColor">#818CF8</Color>

    <!-- Semantic -->
    <Color x:Key="ModernSuccessColor">#10B981</Color>
    <Color x:Key="ModernWarningColor">#F59E0B</Color>
    <Color x:Key="ModernErrorColor">#EF4444</Color>
    <Color x:Key="ModernInfoColor">#60A5FA</Color>

    <!-- Windows 11 dark mode neutral grey — zero blue tint -->
    <Color x:Key="ModernBackgroundColor">#1A1A1A</Color>
    <Color x:Key="ModernSurfaceColor">#2D2D2D</Color>
    <Color x:Key="ModernCardColor">#242424</Color>
    <Color x:Key="ModernElevatedSurfaceColor">#3A3A3A</Color>
    <Color x:Key="ModernOverlayColor">#484848</Color>
    <Color x:Key="ModernBorderColor">#FFFFFF1C</Color>
    <Color x:Key="ModernFormBackgroundColor">#141414</Color>

    <!-- Sidebar -->
    <Color x:Key="ModernSidebarBackgroundColor">#141414</Color>
    <Color x:Key="ModernNewItemButtonColor">#2563EB</Color>

    <!-- Light theme variants -->
    <Color x:Key="ModernLightBackgroundColor">#F3F4F6</Color>
    <Color x:Key="ModernLightSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ModernLightCardColor">#FFFFFF</Color>
    <Color x:Key="ModernLightFormBackgroundColor">#F9FAFB</Color>

    <!-- Text — Windows 11 dark mode white / grey -->
    <Color x:Key="ModernTextPrimaryColor">#E5E5E5</Color>
    <Color x:Key="ModernTextSecondaryColor">#9D9D9D</Color>
    <Color x:Key="ModernTextTertiaryColor">#6A6A6A</Color>

    <!-- ═══════════════════════════════════════════
         Solid Brushes
    ═══════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModernPrimaryBrush"          Color="{StaticResource ModernPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryLightBrush"     Color="{StaticResource ModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryDarkBrush"      Color="{StaticResource ModernPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="ModernAccentBrush"           Color="{StaticResource ModernAccentColor}"/>
    <SolidColorBrush x:Key="ModernAccentLightBrush"      Color="{StaticResource ModernAccentLightColor}"/>
    <SolidColorBrush x:Key="ModernSuccessBrush"          Color="{StaticResource ModernSuccessColor}"/>
    <SolidColorBrush x:Key="ModernWarningBrush"          Color="{StaticResource ModernWarningColor}"/>
    <SolidColorBrush x:Key="ModernErrorBrush"            Color="{StaticResource ModernErrorColor}"/>
    <SolidColorBrush x:Key="ModernInfoBrush"             Color="{StaticResource ModernInfoColor}"/>

    <SolidColorBrush x:Key="ModernBackgroundBrush"       Color="{StaticResource ModernBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernSurfaceBrush"          Color="{StaticResource ModernSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernCardBrush"             Color="{StaticResource ModernCardColor}"/>
    <SolidColorBrush x:Key="ModernElevatedSurfaceBrush"  Color="{StaticResource ModernElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernBorderBrush"           Color="{StaticResource ModernBorderColor}"/>
    <SolidColorBrush x:Key="ModernFormBackgroundBrush"   Color="{StaticResource ModernFormBackgroundColor}"/>

    <SolidColorBrush x:Key="ModernSidebarBackgroundBrush"
                     Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernNewItemButtonBrush"
                     Color="{StaticResource ModernNewItemButtonColor}"/>

    <!-- Button state brushes -->
    <SolidColorBrush x:Key="ModernButtonPointerOverBrush" Color="#283141" />
    <SolidColorBrush x:Key="ModernButtonPressedBrush"     Color="#1F2937" />

    <SolidColorBrush x:Key="ModernTextPrimaryBrush"    Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernTextSecondaryBrush"  Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="ModernTextTertiaryBrush"   Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="ModernSecondaryBrush"      Color="{StaticResource ModernAccentColor}"/>

    <!-- Fallback aliases for WinUI3 / system resource keys not provided by ModernWPF -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource ModernSurfaceColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="{StaticResource ModernTextSecondaryColor}"/>

    <!-- ModernWPF TextControl resource overrides — keeps TextBox/PasswordBox dark on all states.
         ModernWPF's built-in templates read these keys via DynamicResource so no custom Template needed. -->
    <SolidColorBrush x:Key="TextControlBackground"                    Color="#1F2937"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"         Color="#283141"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused"             Color="#1F2937"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled"            Color="#1C2433"/>
    <SolidColorBrush x:Key="TextControlForeground"                    Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"         Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused"             Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled"            Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground"         Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"  Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrush"                   Color="{StaticResource ModernBorderColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"        Color="{StaticResource ModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"            Color="{StaticResource ModernPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"           Color="{StaticResource ModernBorderColor}"/>

    <!-- ═══════════════════════════════════════════
         NavigationView overrides — keys WITHOUT ui: prefix so ModernWPF picks them up
    ═══════════════════════════════════════════ -->

    <!-- Pane backgrounds -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"      Color="#0D1117"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"     Color="#0D1117"/>
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground"          Color="#0D1117"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground"          Color="#111827"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBackground"      Color="#111827"/>

    <!-- Item foregrounds -->
    <SolidColorBrush x:Key="NavigationViewItemForeground"             Color="#D1D5DB"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"      Color="#E5E7EB"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled"     Color="#4B5563"/>

    <!-- Item backgrounds -->
    <SolidColorBrush x:Key="NavigationViewItemBackground"                    Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"             Color="#1E3A5F"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"          Color="#1F2937"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"              Color="#374151"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver"  Color="#1E3A5F"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"      Color="#1A3355"/>

    <!-- Separator — thin translucent white line, not yellow -->
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground"    Color="#FFFFFF18"/>

    <!-- Section header text -->
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground"       Color="#6B7280"/>

    <!-- NavigationView margins — zero so content fills properly -->
    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="NavigationViewMinimalContentGridMargin">0</Thickness>
    <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
    <Thickness x:Key="NavigationViewTopHeaderMargin">0</Thickness>
    <Thickness x:Key="NavigationViewContentGridMargin">0</Thickness>

    <!-- Keep the ui: prefixed versions too for any path that reads them -->
    <SolidColorBrush x:Key="ui:NavigationViewDefaultPaneBackground"   Color="#0D1117"/>
    <SolidColorBrush x:Key="ui:NavigationViewExpandedPaneBackground"  Color="#0D1117"/>
    <SolidColorBrush x:Key="ui:NavigationViewTopPaneBackground"       Color="#0D1117"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentBackground"       Color="#111827"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentGridBackground"   Color="#111827"/>
    <Thickness x:Key="ui:NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewContentGridMargin">0</Thickness>

    <!-- ═══════════════════════════════════════════
         Gradient Brushes
    ═══════════════════════════════════════════ -->

    <!-- Brand gradient: blue → indigo -->
    <LinearGradientBrush x:Key="ModernBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"  Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentColor}"   Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary gradient: steel blue tones -->
    <LinearGradientBrush x:Key="ModernPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"      Offset="0"/>
        <GradientStop Color="{StaticResource ModernPrimaryLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent gradient -->
    <LinearGradientBrush x:Key="ModernAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernAccentColor}"      Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card surface gradient -->
    <LinearGradientBrush x:Key="ModernCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#252F3F" Offset="0"/>
        <GradientStop Color="#1F2937" Offset="1"/>
    </LinearGradientBrush>

    <!-- Default Button Style — Windows 11 dark mode neutral grey -->
    <Style TargetType="Button">
        <Setter Property="Background"      Value="#2D2D2D"/>
        <Setter Property="Foreground"      Value="#E5E5E5"/>
        <Setter Property="BorderBrush"     Value="#454545"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,8"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Normal"/>
        <Setter Property="MinHeight"       Value="34"/>
        <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <!-- TextBox — let ModernWPF's template handle VSM animations; override only colours -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground"      Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="CaretBrush"      Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="SelectionBrush"  Value="{StaticResource ModernPrimaryBrush}"/>
    </Style>

    <!-- Enhanced ComboBox Style with 1Password-like behavior -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              x:Name="ContentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <ui:FontIcon Grid.Column="1"
                                      Glyph="&#xE70D;"
                                      FontSize="12"
                                      Foreground="{StaticResource ModernTextSecondaryBrush}"
                                      Margin="0,0,12,0"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Grid.Column="0"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BorderElement" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="ContentPresenter" Property="TextBlock.Foreground" Value="{StaticResource ModernTextTertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced PasswordBox Style with 1Password-like behavior -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="BorderElement"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <!-- Inline brush creates a fresh, non-frozen instance per control so
                             WPF animations can safely target Background.Color without throwing
                             InvalidOperationException on a frozen StaticResource brush. -->
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ModernSurfaceColor}"/>
                        </Border.Background>
                        <Grid>
                            <!-- PART_ContentHost is the required template part name for PasswordBox -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          IsTabStop="False"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryBrush}"/>
                            <Setter TargetName="BorderElement" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="PlaceholderText" Property="Foreground" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BorderElement" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced Modern Primary Button Style -->
    <Style x:Key="ModernPrimaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="MinWidth"        Value="100"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource ModernPrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Secondary Button Style — Windows 11 dark neutral -->
    <Style x:Key="ModernSecondaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"      Value="#2D2D2D"/>
        <Setter Property="Foreground"      Value="#E5E5E5"/>
        <Setter Property="BorderBrush"     Value="#454545"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="MinWidth"        Value="80"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#3A3A3A"/>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger button — red, used for destructive actions -->
    <Style x:Key="ModernDangerButtonStyle" TargetType="Button">
        <Setter Property="Background"     Value="{StaticResource ModernErrorBrush}"/>
        <Setter Property="Foreground"     Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="16,12"/>
        <Setter Property="FontSize"       Value="14"/>
        <Setter Property="FontWeight"     Value="SemiBold"/>
        <Setter Property="MinWidth"       Value="120"/>
        <Setter Property="MinHeight"      Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContentDialog button styles (PrimaryButtonStyle / SecondaryButtonStyle properties) -->
    <Style x:Key="ContentDialogPrimaryButtonStyle"   BasedOn="{StaticResource ModernPrimaryButtonStyle}"   TargetType="Button"/>
    <Style x:Key="ContentDialogSecondaryButtonStyle" BasedOn="{StaticResource ModernSecondaryButtonStyle}" TargetType="Button"/>

    <!-- Modern Card Style -->
    <Style x:Key="ModernCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource ModernCardBrush}"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
    </Style>

    <!-- Modern Elevated Card Style -->
    <Style x:Key="ModernElevatedCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource ModernElevatedSurfaceBrush}"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
    </Style>


    <!-- Removed duplicate Modernui:AutoSuggestBoxStyle (kept enhanced version later) -->


    <Style x:Key="ModernPasswordBoxStyle"
           TargetType="PasswordBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
    </Style>

    <!-- Card Button Style for Item Type Selection — dark surface with hover -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="Background"              Value="#1A2234"/>
        <Setter Property="Foreground"              Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"             Value="#2D3748"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="Padding"                 Value="12"/>
        <Setter Property="HorizontalAlignment"     Value="Stretch"/>
        <Setter Property="VerticalAlignment"       Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#22304A"/>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#3B4D6A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Typography Styles -->
    <Style x:Key="ModernHeading1Style"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="24"/>
        <Setter Property="FontWeight"
                Value="Bold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernHeading2Style"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="20"/>
        <Setter Property="FontWeight"
                Value="Bold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernHeading3Style"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernHeading4Style" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernBodyStrongStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernCaptionStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="FontWeight"
                Value="Normal"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextSecondaryBrush}"/>
    </Style>

    <!-- Implicit dark-mode styles for NavigationView sub-controls.
         These bypass the resource-key lookup entirely and always apply. -->
    <Style TargetType="ui:NavigationViewItemHeader">
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="FontSize"   Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="0,8,0,2"/>
    </Style>

    <Style TargetType="ui:NavigationViewItemSeparator">
        <Setter Property="Background" Value="#FFFFFF14"/>
        <Setter Property="Margin"     Value="12,4"/>
        <Setter Property="Height"     Value="1"/>
    </Style>

    <!-- Modern Navigation Styles -->
    <Style x:Key="ModernNavigationViewStyle"
           TargetType="ui:NavigationView">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="IsPaneToggleButtonVisible"
                Value="True"/>
        <Setter Property="IsBackButtonVisible"
                Value="Collapsed"/>
        <Setter Property="OpenPaneLength"
                Value="0"/>
        <Setter Property="CompactModeThresholdWidth"
                Value="0"/>
        <Setter Property="ExpandedModeThresholdWidth"
                Value="0"/>
        <Setter Property="PaneDisplayMode"
                Value="LeftMinimal"/>
        <Setter Property="Margin"
                Value="0"/>
        <Setter Property="Padding"
                Value="0"/>
    </Style>

    <!-- Enhanced ui:NavigationViewItem Style -->
    <Style x:Key="ModernNavigationViewItemStyle"
           TargetType="ui:NavigationViewItem">
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="Margin"
                Value="8,4"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavigationViewItem">
                    <Border x:Name="LayoutRoot"
                            Background="{TemplateBinding Background}"
                            Margin="{TemplateBinding Margin}">
                        <Grid>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource ModernPrimaryBrush}"
                                    CornerRadius="0,2,2,0"
                                    Opacity="0"/>

                            <Grid x:Name="ContentGrid"
                                  Margin="20,12,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <ContentPresenter x:Name="Icon"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"/>

                                <!-- Content -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>

                                <!-- Expand/Collapse Chevron -->
                                <ui:FontIcon x:Name="ExpandCollapseChevron"
                                          Grid.Column="2"
                                          FontSize="12"
                                          Glyph="&#xE76C;"
                                          Foreground="{StaticResource ModernTextSecondaryBrush}"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Navigation Button Style for Sidebar -->
    <Style x:Key="ModernNavigationButtonStyle"
            TargetType="Button">
        <Setter Property="HorizontalAlignment"
                Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="12,10"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Content Dialog Styles -->
    <Style TargetType="ui:ContentDialog">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
    </Style>

    <!-- Modern 1Password-style Button Style -->
    <Style x:Key="ModernAccentButtonStyle"
            TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="16,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="0"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          />
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Enhanced ui:ContentDialog Styles for 1Password-like forms -->
    <Style x:Key="ui:ContentDialogPrimaryButtonStyle"
            TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="16,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="0"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              />
                            <ui:ProgressRing x:Name="LoadingIndicator"
                                          Width="18"
                                          Height="18"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          Foreground="White"/>
                        </Grid>
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ui:ContentDialogSecondaryButtonStyle"
            TargetType="Button">
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="16,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="120"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          />
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced ui:ContentDialog Style for 1Password-like appearance with proper centering -->
    <Style x:Key="Modern1PasswordDialogStyle"
            TargetType="ui:ContentDialog">
        <Setter Property="Background"
                Value="{StaticResource ModernFormBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="PrimaryButtonStyle"
                Value="{StaticResource ui:ContentDialogPrimaryButtonStyle}"/>
        <Setter Property="SecondaryButtonStyle"
                Value="{StaticResource ui:ContentDialogSecondaryButtonStyle}"/>
        <Setter Property="CloseButtonStyle"
                Value="{StaticResource ui:ContentDialogSecondaryButtonStyle}"/>
        <Setter Property="MaxWidth"
                Value="600"/>
        <Setter Property="MaxHeight"
                Value="800"/>
        <Setter Property="MinWidth"
                Value="400"/>
        <Setter Property="MinHeight"
                Value="200"/>
        <!-- Enhanced centering with proper positioning for all screen sizes -->
        <Setter Property="HorizontalAlignment"
                Value="Center"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0"/>
        <!-- Override template for better centering control -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ContentDialog">
                    <Grid x:Name="Container">
                        <!-- Backdrop -->
                        <Rectangle x:Name="SmokeLayerBackground"
                                   Fill="#99000000"/>
                        
                        <!-- Dialog container with absolute centering -->
                        <Border x:Name="BackgroundElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3A3F4E"
                                BorderThickness="1"
                                CornerRadius="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="{TemplateBinding MaxWidth}"
                                MaxHeight="{TemplateBinding MaxHeight}"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Margin="{TemplateBinding Margin}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.6" Direction="270"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Content area -->
                                <ScrollViewer x:Name="ContentScrollViewer"
                                              Grid.Row="0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              IsTabStop="False"
                                              Padding="24">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Title -->
                                        <ContentControl x:Name="Title"
                                                        Grid.Row="0"
                                                        Content="{TemplateBinding Title}"
                                                        ContentTemplate="{TemplateBinding TitleTemplate}"
                                                        FontSize="20"
                                                        FontWeight="SemiBold"
                                                        
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        IsTabStop="False"
                                                        Margin="0,0,0,20"/>
                                        
                                        <!-- Content -->
                                        <ContentPresenter x:Name="Content"
                                                          Grid.Row="1"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                    </Grid>
                                </ScrollViewer>
                                
                                <!-- Button area -->
                                <Border x:Name="CommandSpace"
                                        Grid.Row="1"
                                        Background="#252F3F"
                                        BorderBrush="#3A3F4E"
                                        BorderThickness="0,1,0,0"
                                        Padding="24,16"
                                        CornerRadius="0,0,12,12">
                                    <Grid x:Name="CommandAreaGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button x:Name="PrimaryButton"
                                                Grid.Column="1"
                                                Content="{TemplateBinding PrimaryButtonText}"
                                                Style="{TemplateBinding PrimaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        
                                        <Button x:Name="SecondaryButton"
                                                Grid.Column="2"
                                                Content="{TemplateBinding SecondaryButtonText}"
                                                Style="{TemplateBinding SecondaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        
                                        <Button x:Name="CloseButton"
                                                Grid.Column="3"
                                                Content="{TemplateBinding CloseButtonText}"
                                                Style="{TemplateBinding CloseButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Enhanced form field grouping style for dark theme -->
    <Style x:Key="FormFieldGroupStyle"
            TargetType="StackPanel">
        <Setter Property="Margin"
                Value="0,0,0,16"/>
        <Setter Property="Background"
                Value="Transparent"/>
    </Style>

    <!-- Enhanced form label style with better contrast -->
    <Style x:Key="FormLabelStyle"
            TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="13"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="Margin"
                Value="0,0,0,6"/>
        <Setter Property="Opacity"
                Value="0.9"/>
    </Style>

    <!-- Enhanced validation message style -->
    <Style x:Key="ValidationMessageStyle"
            TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernErrorBrush}"/>
        <Setter Property="Margin"
                Value="0,4,0,0"/>
        <Setter Property="TextWrapping"
                Value="Wrap"/>
    </Style>

    <!-- Enhanced success message style -->
    <Style x:Key="SuccessMessageStyle"
            TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernSuccessBrush}"/>
        <Setter Property="Margin"
                Value="0,4,0,0"/>
        <Setter Property="TextWrapping"
                Value="Wrap"/>
    </Style>

    <!-- New Item Button Style -->
    <Style x:Key="NewItemButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="12,8"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource ModernPrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Button Style — transparent with hover feedback -->
    <Style x:Key="ModernIconButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource ModernTextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="6"/>
        <Setter Property="MinWidth"        Value="0"/>
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#2A3142"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced TextBox Style -->
    <Style x:Key="ModernTextBoxStyle"
            TargetType="TextBox">
        <Setter Property="Background"      Value="#252F3F"/>
        <Setter Property="Foreground"      Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="#3A3F4E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="MinHeight"       Value="36"/>
        <Setter Property="CaretBrush"      Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

