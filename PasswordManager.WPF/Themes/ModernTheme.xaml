<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- 
    Modern Theme for Password Manager (WinUI)
    
    This theme implements the Password Manager UI Design System.
    Colors are aligned with PasswordManager.Models/UI/UIConstants.cs
    
    For full documentation, see: UI_DESIGN_SYSTEM.md
    -->

    <!-- Enhanced Modern Color Palette - 1Password Style -->
    <Color xmlns:ui="http://schemas.modernwpf.com/2019"
    x:Key="ModernPrimaryColor">#005BFF</Color>
    <Color x:Key="ModernPrimaryLightColor">#3B82F6</Color>
    <Color x:Key="ModernPrimaryDarkColor">#0041CC</Color>
    <Color x:Key="ModernAccentColor">#EC4899</Color>
    <Color x:Key="ModernAccentLightColor">#F472B6</Color>
    <Color x:Key="ModernSuccessColor">#10B981</Color>
    <Color x:Key="ModernWarningColor">#F59E0B</Color>
    <Color x:Key="ModernErrorColor">#EF4444</Color>

    <!-- Enhanced Background Colors - 1Password Dark Theme Style (Default) -->
    <Color x:Key="ModernBackgroundColor">#1A1A1A</Color>
    <Color x:Key="ModernSurfaceColor">#262626</Color>
    <Color x:Key="ModernCardColor">#262626</Color>
    <Color x:Key="ModernElevatedSurfaceColor">#333333</Color>
    <Color x:Key="ModernBorderColor">#404040</Color>
    <Color x:Key="ModernFormBackgroundColor">#262626</Color>

    <!-- Sidebar specific colors as per requirements -->
    <Color x:Key="ModernSidebarBackgroundColor">#141414</Color>

        <!-- New item button color (use primary color for consistency) -->
        <Color x:Key="ModernNewItemButtonColor">#005BFF</Color>

    <!-- Light theme variants (for future use) -->
    <Color x:Key="ModernLightBackgroundColor">#F8F9FA</Color>
    <Color x:Key="ModernLightSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ModernLightCardColor">#FFFFFF</Color>
    <Color x:Key="ModernLightFormBackgroundColor">#F6F8FA</Color>

    <!-- Text Colors for Dark Theme -->
    <Color x:Key="ModernTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ModernTextSecondaryColor">#B0B0B0</Color>
    <Color x:Key="ModernTextTertiaryColor">#808080</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ModernPrimaryBrush"
                     Color="{StaticResource ModernPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryLightBrush"
                     Color="{StaticResource ModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryDarkBrush"
                     Color="{StaticResource ModernPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="ModernAccentBrush"
                     Color="{StaticResource ModernAccentColor}"/>
    <SolidColorBrush x:Key="ModernAccentLightBrush"
                     Color="{StaticResource ModernAccentLightColor}"/>
    <SolidColorBrush x:Key="ModernSuccessBrush"
                     Color="{StaticResource ModernSuccessColor}"/>
    <SolidColorBrush x:Key="ModernWarningBrush"
                     Color="{StaticResource ModernWarningColor}"/>
    <SolidColorBrush x:Key="ModernErrorBrush"
                     Color="{StaticResource ModernErrorColor}"/>

    <SolidColorBrush x:Key="ModernBackgroundBrush"
                     Color="{StaticResource ModernBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernSurfaceBrush"
                     Color="{StaticResource ModernSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernCardBrush"
                     Color="{StaticResource ModernCardColor}"/>
    <SolidColorBrush x:Key="ModernElevatedSurfaceBrush"
                     Color="{StaticResource ModernElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernBorderBrush"
                     Color="{StaticResource ModernBorderColor}"/>
    <SolidColorBrush x:Key="ModernFormBackgroundBrush"
                     Color="{StaticResource ModernFormBackgroundColor}"/>

    <!-- New sidebar and button brushes -->
    <SolidColorBrush x:Key="ModernSidebarBackgroundBrush"
                     Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernNewItemButtonBrush"
                     Color="{StaticResource ModernNewItemButtonColor}"/>

        <!-- Button state brushes (dark theme friendly) -->
        <SolidColorBrush x:Key="ModernButtonPointerOverBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="ModernButtonPressedBrush" Color="#222222" />

    <SolidColorBrush x:Key="ModernTextPrimaryBrush"
                     Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernTextSecondaryBrush"
                     Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="ModernTextTertiaryBrush"
                     Color="{StaticResource ModernTextTertiaryColor}"/>

    <!-- Missing ModernSecondaryBrush that was causing the error -->
    <SolidColorBrush x:Key="ModernSecondaryBrush"
                     Color="{StaticResource ModernTextSecondaryColor}"/>

    <!-- ui:NavigationView Pane Background Brushes (WinUI 3 theme resource overrides) -->
    <SolidColorBrush x:Key="ui:NavigationViewDefaultPaneBackground"
            Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewExpandedPaneBackground"
            Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewTopPaneBackground"
            Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentBackground"
            Color="{StaticResource ModernBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentGridBackground"
            Color="{StaticResource ModernBackgroundColor}"/>

    <!-- Remove any margins or padding from ui:NavigationView content -->
    <Thickness x:Key="ui:NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewMinimalContentGridMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewHeaderMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewTopHeaderMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewContentGridMargin">0</Thickness>
    <Thickness x:Key="Topui:NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="Topui:NavigationViewContentGridMargin">0</Thickness>

    <!-- Modern Gradient Brushes -->
    <LinearGradientBrush x:Key="ModernPrimaryGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"
                      Offset="0"/>
        <GradientStop Color="{StaticResource ModernPrimaryLightColor}"
                      Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernAccentGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernAccentColor}"
                      Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentLightColor}"
                      Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernCardGradientBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#FFFFFF"
                      Offset="0"/>
        <GradientStop Color="#F8FAFC"
                      Offset="1"/>
    </LinearGradientBrush>

    <!-- Default Button Style for consistency -->
    <Style TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius"
                Value="0"/>-->
        <Setter Property="Padding"
                Value="16,12"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="120"/>
        <Setter Property="MinHeight"
                Value="36"/>
    </Style>

    <!-- Enhanced TextBox Style with 1Password-like behavior (simplified for WPF) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <!-- Enhanced ComboBox Style with 1Password-like behavior -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius"
                Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              x:Name="ContentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <ui:FontIcon Grid.Column="1"
                                      Glyph="&#xE70D;"
                                      FontSize="12"
                                      Foreground="{StaticResource ModernTextSecondaryBrush}"
                                      Margin="0,0,12,0"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Grid.Column="0"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="{StaticResource ModernSurfaceBrush}"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="{StaticResource ModernBorderBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="#F5F8FF"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="{StaticResource ModernPrimaryLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="#F5F8FF"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="{StaticResource ModernPrimaryBrush}"/>
                                        <Setter Target="BorderElement.BorderThickness"
                                                Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="#F8F9FA"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="#E9ECEF"/>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource ModernTextTertiaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced PasswordBox Style with 1Password-like behavior -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <!-- <Setter Property="CornerRadius"
                Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          
                                          HorizontalScrollBarVisibility="Hidden"
                                          
                                          VerticalScrollBarVisibility="Hidden"
                                          IsTabStop="False"
                                          />
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="{StaticResource ModernSurfaceBrush}"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="{StaticResource ModernBorderBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="#F5F8FF"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="{StaticResource ModernPrimaryLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="#F5F8FF"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="{StaticResource ModernPrimaryBrush}"/>
                                        <Setter Target="BorderElement.BorderThickness"
                                                Value="1"/>
                                        <Setter Target="PlaceholderText.Foreground"
                                                Value="{StaticResource ModernPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.Background"
                                                Value="#F8F9FA"/>
                                        <Setter Target="BorderElement.BorderBrush"
                                                Value="#E9ECEF"/>
                                        <Setter Target="ContentElement.Foreground"
                                                Value="{StaticResource ModernTextTertiaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced Modern Primary Button Style with 1Password-like behavior -->
    <Style x:Key="ModernPrimaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius"
                Value="0"/>-->
        <Setter Property="Padding"
                Value="16,12"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="120"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <ui:ProgressRing x:Name="LoadingIndicator"
                                          Width="20"
                                          Height="20"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          Foreground="White"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background"
                                                Value="{StaticResource ModernPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background"
                                                Value="{StaticResource ModernPrimaryLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background"
                                                Value="{StaticResource ModernPrimaryDarkBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background"
                                                Value="#E9ECEF"/>
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{StaticResource ModernTextTertiaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

