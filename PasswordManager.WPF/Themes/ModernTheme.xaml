    <!-- Enhanced ui:ContentDialog Style for 1Password-like appearance with proper centering -->
    <Style x:Key="Modern1PasswordDialogStyle"
            TargetType="ui:ContentDialog">
        <Setter Property="Background"
                Value="{StaticResource ModernFormBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="PrimaryButtonStyle"
                Value="{StaticResource ui:ContentDialogPrimaryButtonStyle}"/>
        <Setter Property="SecondaryButtonStyle"
                Value="{StaticResource ui:ContentDialogSecondaryButtonStyle}"/>
        <Setter Property="CloseButtonStyle"
                Value="{StaticResource ui:ContentDialogSecondaryButtonStyle}"/>
        <Setter Property="MaxWidth"
                Value="0"/>
        <Setter Property="MaxHeight"
                Value="0"/>
        <Setter Property="MinWidth"
                Value="0"/>
        <Setter Property="MinHeight"
                Value="0"/>
        <!-- Enhanced centering with proper positioning for all screen sizes -->
        <Setter Property="HorizontalAlignment"
                Value="Center"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0"/>
        <!-- Override template for better centering control -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ContentDialog">
                    <Grid x:Name="Container">
                        <!-- Backdrop -->
                        <Rectangle x:Name="SmokeLayerBackground"
                                   Fill="{DynamicResource ui:ContentDialogSmokeFill}"/>
                        
                        <!-- Dialog container with absolute centering -->
                        <Border x:Name="BackgroundElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="{TemplateBinding MaxWidth}"
                                MaxHeight="{TemplateBinding MaxHeight}"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Margin="{TemplateBinding Margin}">
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Content area -->
                                <ScrollViewer x:Name="ContentScrollViewer"
                                              Grid.Row="0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              IsTabStop="False"
                                              Padding="24">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Title -->
                                        <ContentControl x:Name="Title"
                                                        Grid.Row="0"
                                                        Content="{TemplateBinding Title}"
                                                        ContentTemplate="{TemplateBinding TitleTemplate}"
                                                        FontSize="20"
                                                        FontWeight="SemiBold"
                                                        
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        IsTabStop="False"
                                                        Margin="0,0,0,20"/>
                                        
                                        <!-- Content -->
                                        <ContentPresenter x:Name="Content"
                                                          Grid.Row="1"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                    </Grid>
                                </ScrollViewer>
                                
                                <!-- Button area -->
                                <Border x:Name="CommandSpace"
                                        Grid.Row="1"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="24,16">
                                    <Grid x:Name="CommandAreaGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button x:Name="PrimaryButton"
                                                Grid.Column="1"
                                                Content="{TemplateBinding PrimaryButtonText}"
                                                Style="{TemplateBinding PrimaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        
                                        <Button x:Name="SecondaryButton"
                                                Grid.Column="2"
                                                Content="{TemplateBinding SecondaryButtonText}"
                                                Style="{TemplateBinding SecondaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        
                                        <Button x:Name="CloseButton"
                                                Grid.Column="3"
                                                Content="{TemplateBinding CloseButtonText}"
                                                Style="{TemplateBinding CloseButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


