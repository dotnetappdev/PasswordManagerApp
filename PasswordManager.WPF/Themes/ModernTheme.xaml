                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background"
                                                Value="Transparent"/>
                                        <Setter Target="RootBorder.BorderBrush"
                                                Value="#E9ECEF"/>
