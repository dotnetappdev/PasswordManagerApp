                                                                <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="LayoutRoot.Background"
                                                                                                Value="{StaticResource ModernElevatedSurfaceBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Selected">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="LayoutRoot.Background"
                                                                                                Value="{StaticResource ModernSidebarBackgroundBrush}"/>
                                                                                <Setter Target="SelectionIndicator.Opacity"
                                                                                                Value="0"/>-->
                                                                                <Setter Target="ContentPresenter.Foreground"
                                                                                                Value="{StaticResource ModernTextPrimaryBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="PointerOverSelected">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="LayoutRoot.Background"
                                                                                                Value="{StaticResource ModernSidebarBackgroundBrush}"/>
                                                                                <Setter Target="SelectionIndicator.Opacity"
                                                                                                Value="0"/>-->
                                                                                <Setter Target="ContentPresenter.Foreground"
                                                                                                Value="{StaticResource ModernTextPrimaryBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
