<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- 
    Modern Theme for Password Manager (WPF)
    
    Professional design system – Inter typography, deep dark palette,
    gradient brand accents. Aligned with PasswordManager.Models/UI/UIConstants.cs
    
    For full documentation, see: UI_DESIGN_SYSTEM.md
    -->

    <!-- ═══════════════════════════════════════════
         Colour Tokens
    ═══════════════════════════════════════════ -->

    <!-- Brand / Primary -->
    <Color x:Key="ModernPrimaryColor">#005BFF</Color>
    <Color x:Key="ModernPrimaryLightColor">#3B82F6</Color>
    <Color x:Key="ModernPrimaryDarkColor">#0041CC</Color>

    <!-- Accent (violet) -->
    <Color x:Key="ModernAccentColor">#7C3AED</Color>
    <Color x:Key="ModernAccentLightColor">#A78BFA</Color>

    <!-- Semantic -->
    <Color x:Key="ModernSuccessColor">#10B981</Color>
    <Color x:Key="ModernWarningColor">#F59E0B</Color>
    <Color x:Key="ModernErrorColor">#EF4444</Color>
    <Color x:Key="ModernInfoColor">#3B82F6</Color>

    <!-- Dark theme surfaces (deeper, richer) -->
    <Color x:Key="ModernBackgroundColor">#0F1117</Color>
    <Color x:Key="ModernSurfaceColor">#1A1D27</Color>
    <Color x:Key="ModernCardColor">#1A1D27</Color>
    <Color x:Key="ModernElevatedSurfaceColor">#232635</Color>
    <Color x:Key="ModernOverlayColor">#2C2F42</Color>
    <Color x:Key="ModernBorderColor">#FFFFFF14</Color>   <!-- rgba(255,255,255,0.08) -->
    <Color x:Key="ModernFormBackgroundColor">#1A1D27</Color>

    <!-- Sidebar -->
    <Color x:Key="ModernSidebarBackgroundColor">#0B0D14</Color>
    <Color x:Key="ModernNewItemButtonColor">#005BFF</Color>

    <!-- Light theme variants -->
    <Color x:Key="ModernLightBackgroundColor">#F0F2FF</Color>
    <Color x:Key="ModernLightSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ModernLightCardColor">#FFFFFF</Color>
    <Color x:Key="ModernLightFormBackgroundColor">#F5F7FF</Color>

    <!-- Text (dark theme) -->
    <Color x:Key="ModernTextPrimaryColor">#F0F2FF</Color>
    <Color x:Key="ModernTextSecondaryColor">#8B90A7</Color>
    <Color x:Key="ModernTextTertiaryColor">#5A5F78</Color>

    <!-- ═══════════════════════════════════════════
         Solid Brushes
    ═══════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModernPrimaryBrush"          Color="{StaticResource ModernPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryLightBrush"     Color="{StaticResource ModernPrimaryLightColor}"/>
    <SolidColorBrush x:Key="ModernPrimaryDarkBrush"      Color="{StaticResource ModernPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="ModernAccentBrush"           Color="{StaticResource ModernAccentColor}"/>
    <SolidColorBrush x:Key="ModernAccentLightBrush"      Color="{StaticResource ModernAccentLightColor}"/>
    <SolidColorBrush x:Key="ModernSuccessBrush"          Color="{StaticResource ModernSuccessColor}"/>
    <SolidColorBrush x:Key="ModernWarningBrush"          Color="{StaticResource ModernWarningColor}"/>
    <SolidColorBrush x:Key="ModernErrorBrush"            Color="{StaticResource ModernErrorColor}"/>
    <SolidColorBrush x:Key="ModernInfoBrush"             Color="{StaticResource ModernInfoColor}"/>

    <SolidColorBrush x:Key="ModernBackgroundBrush"       Color="{StaticResource ModernBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernSurfaceBrush"          Color="{StaticResource ModernSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernCardBrush"             Color="{StaticResource ModernCardColor}"/>
    <SolidColorBrush x:Key="ModernElevatedSurfaceBrush"  Color="{StaticResource ModernElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="ModernBorderBrush"           Color="{StaticResource ModernBorderColor}"/>
    <SolidColorBrush x:Key="ModernFormBackgroundBrush"   Color="{StaticResource ModernFormBackgroundColor}"/>

    <SolidColorBrush x:Key="ModernSidebarBackgroundBrush"
                     Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ModernNewItemButtonBrush"
                     Color="{StaticResource ModernNewItemButtonColor}"/>

    <!-- Button state brushes -->
    <SolidColorBrush x:Key="ModernButtonPointerOverBrush" Color="#232635" />
    <SolidColorBrush x:Key="ModernButtonPressedBrush"     Color="#1A1D27" />

    <SolidColorBrush x:Key="ModernTextPrimaryBrush"    Color="{StaticResource ModernTextPrimaryColor}"/>
    <SolidColorBrush x:Key="ModernTextSecondaryBrush"  Color="{StaticResource ModernTextSecondaryColor}"/>
    <SolidColorBrush x:Key="ModernTextTertiaryBrush"   Color="{StaticResource ModernTextTertiaryColor}"/>
    <SolidColorBrush x:Key="ModernSecondaryBrush"      Color="{StaticResource ModernAccentColor}"/>

    <!-- NavigationView pane background overrides -->
    <SolidColorBrush x:Key="ui:NavigationViewDefaultPaneBackground"
            Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewExpandedPaneBackground"
            Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewTopPaneBackground"
            Color="{StaticResource ModernSidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentBackground"
            Color="{StaticResource ModernBackgroundColor}"/>
    <SolidColorBrush x:Key="ui:NavigationViewContentGridBackground"
            Color="{StaticResource ModernBackgroundColor}"/>

    <!-- NavigationView margins -->
    <Thickness x:Key="ui:NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewMinimalContentGridMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewHeaderMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewTopHeaderMargin">0</Thickness>
    <Thickness x:Key="ui:NavigationViewContentGridMargin">0</Thickness>
    <Thickness x:Key="Topui:NavigationViewContentMargin">0</Thickness>
    <Thickness x:Key="Topui:NavigationViewContentGridMargin">0</Thickness>

    <!-- ═══════════════════════════════════════════
         Gradient Brushes
    ═══════════════════════════════════════════ -->

    <!-- Brand gradient: blue → violet (135°) -->
    <LinearGradientBrush x:Key="ModernBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"  Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentColor}"   Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary-only gradient (for buttons) -->
    <LinearGradientBrush x:Key="ModernPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernPrimaryColor}"      Offset="0"/>
        <GradientStop Color="{StaticResource ModernPrimaryLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent gradient -->
    <LinearGradientBrush x:Key="ModernAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ModernAccentColor}"      Offset="0"/>
        <GradientStop Color="{StaticResource ModernAccentLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card surface gradient (subtle top-to-bottom depth) -->
    <LinearGradientBrush x:Key="ModernCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E2130" Offset="0"/>
        <GradientStop Color="#1A1D27" Offset="1"/>
    </LinearGradientBrush>

    <!-- Default Button Style for consistency -->
    <Style TargetType="Button">
        <Setter Property="Background"     Value="{StaticResource ModernBrandGradientBrush}"/>
        <Setter Property="Foreground"     Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="18,10"/>
        <Setter Property="FontSize"       Value="14"/>
        <Setter Property="FontWeight"     Value="SemiBold"/>
        <Setter Property="MinWidth"       Value="120"/>
        <Setter Property="MinHeight"      Value="38"/>
        <Setter Property="Cursor"         Value="Hand"/>
    </Style>

    <!-- Enhanced TextBox Style with 1Password-like behavior (simplified for WPF) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <!-- Enhanced ComboBox Style with 1Password-like behavior -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              x:Name="ContentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <ui:FontIcon Grid.Column="1"
                                      Glyph="&#xE70D;"
                                      FontSize="12"
                                      Foreground="{StaticResource ModernTextSecondaryBrush}"
                                      Margin="0,0,12,0"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Grid.Column="0"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="Background" Value="#F5F8FF"/>
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BorderElement" Property="Background" Value="#F8F9FA"/>
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="#E9ECEF"/>
                            <Setter TargetName="ContentPresenter" Property="TextBlock.Foreground" Value="{StaticResource ModernTextTertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced PasswordBox Style with 1Password-like behavior -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          
                                          HorizontalScrollBarVisibility="Hidden"
                                          
                                          VerticalScrollBarVisibility="Hidden"
                                          IsTabStop="False"
                                          />
                            <TextBlock x:Name="PlaceholderText"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="Background" Value="#F5F8FF"/>
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="BorderElement" Property="Background" Value="#F5F8FF"/>
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource ModernPrimaryBrush}"/>
                            <Setter TargetName="BorderElement" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="PlaceholderText" Property="Foreground" Value="{StaticResource ModernPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BorderElement" Property="Background" Value="#F8F9FA"/>
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="#E9ECEF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced Modern Primary Button Style with 1Password-like behavior -->
    <Style x:Key="ModernPrimaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource ModernPrimaryBrush}"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="16,12"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="120"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              />
                            <ui:ProgressRing x:Name="LoadingIndicator"
                                          Width="20"
                                          Height="20"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          Foreground="White"/>
                        </Grid>
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enhanced Modern Secondary Button Style with 1Password-like behavior -->
    <Style x:Key="ModernSecondaryButtonStyle"
           TargetType="Button">
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="16,12"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="MinWidth"
                Value="120"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          />
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Card Style -->
    <Style x:Key="ModernCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource ModernCardBrush}"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
    </Style>

    <!-- Modern Elevated Card Style -->
    <Style x:Key="ModernElevatedCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource ModernElevatedSurfaceBrush}"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
    </Style>


    <!-- Removed duplicate Modernui:AutoSuggestBoxStyle (kept enhanced version later) -->


    <Style x:Key="ModernPasswordBoxStyle"
           TargetType="PasswordBox">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="MinHeight"
                Value="36"/>
    </Style>

    <!-- Card Button Style for Item Type Selection -->
    <Style x:Key="CardButtonStyle"
            TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ModernBorderBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Padding"
                Value="12"/>
        <Setter Property="HorizontalAlignment"
                Value="Stretch"/>
        <Setter Property="VerticalAlignment"
                Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          />
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Typography Styles -->
    <Style x:Key="ModernHeading1Style"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="24"/>
        <Setter Property="FontWeight"
                Value="Bold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernHeading2Style"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="20"/>
        <Setter Property="FontWeight"
                Value="Bold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernHeading3Style"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernBodyStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="Normal"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernCaptionStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="FontWeight"
                Value="Normal"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextSecondaryBrush}"/>
    </Style>

    <!-- Modern Navigation Styles -->
    <Style x:Key="Modernui:NavigationViewStyle"
           TargetType="ui:NavigationView">
        <Setter Property="Background"
                Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="IsPaneToggleButtonVisible"
                Value="True"/>
        <Setter Property="IsBackButtonVisible"
                Value="Collapsed"/>
        <Setter Property="OpenPaneLength"
                Value="0"/>
        <Setter Property="CompactModeThresholdWidth"
                Value="0"/>
        <Setter Property="ExpandedModeThresholdWidth"
                Value="0"/>
        <Setter Property="PaneDisplayMode"
                Value="LeftMinimal"/>
        <Setter Property="Margin"
                Value="0"/>
        <Setter Property="Padding"
                Value="0"/>
    </Style>

    <!-- Enhanced ui:NavigationViewItem Style -->
    <Style x:Key="Modernui:NavigationViewItemStyle"
           TargetType="ui:NavigationViewItem">
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="FontSize"
                Value="0"/>
        <Setter Property="Margin"
                Value="8,4"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavigationViewItem">
                    <Border x:Name="LayoutRoot"
                            Background="{TemplateBinding Background}"
                            Margin="{TemplateBinding Margin}">
                        <Grid>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource ModernPrimaryBrush}"
                                    CornerRadius="0,2,2,0"
                                    Opacity="0"/>

                            <Grid x:Name="ContentGrid"
                                  Margin="20,12,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <ContentPresenter x:Name="Icon"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"/>

                                <!-- Content -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>

                                <!-- Expand/Collapse Chevron -->
                                <ui:FontIcon x:Name="ExpandCollapseChevron"
                                          Grid.Column="2"
                                          FontSize="12"
                                          Glyph="&#xE76C;"
                                          Foreground="{StaticResource ModernTextSecondaryBrush}"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Navigation Button Style for Sidebar -->
    <Style x:Key="ModernNavigationButtonStyle"
            TargetType="Button">
        <Setter Property="HorizontalAlignment"
                Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="12,10"/>
        <!-- <Setter Property="CornerRadius" Value="0"/>-->
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="Foreground"
                Value="{StaticResource ModernTextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

