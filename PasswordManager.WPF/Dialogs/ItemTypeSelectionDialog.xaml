<?xml version="1.0" encoding="utf-8"?>
<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="PasswordManager.WPF.Dialogs.ItemTypeSelectionDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="What would you like to add?"
               PrimaryButtonText=""
               CloseButtonText=""
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               Background="{StaticResource ModernFormBackgroundBrush}"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               PrimaryButtonStyle="{StaticResource ContentDialogPrimaryButtonStyle}"
               CloseButtonStyle="{StaticResource ContentDialogSecondaryButtonStyle}"
              MaxWidth="760"
              MaxHeight="760">

    <ScrollViewer>
        <StackPanel xmlns:ui="http://schemas.modernwpf.com/2019"
    Margin="16">
           <TextBlock Text="What would you like to add?"
                      FontSize="40"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,4,0,12"/>

           <!-- Search Box -->
           <ui:AutoSuggestBox x:Name="ItemSearchBox"
                            ui:ControlHelper.PlaceholderText="Try searching anything"
                            QueryIcon="Find"
                            Style="{StaticResource ModernAutoSuggestBoxStyle}"
                            CornerRadius="8"
                            Height="40"
                            FontSize="16"/>

            <!-- Main Category Grid - 6 core item types in 3x2 layout -->
            <Grid x:Name="MainCategoryGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top row - Main categories matching navigation menu -->
                <Button x:Name="LoginButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Click="CategoryButton_Click"
                        Tag="Login"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#2563EB"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Login"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SecureNoteButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Click="CategoryButton_Click"
                        Tag="Secure Note"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#f59e0b"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Secure Note"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CreditCardButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Click="CategoryButton_Click"
                        Tag="Credit Card"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#10b981"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Credit Card"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Second row -->
                <Button x:Name="IdentityButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Click="CategoryButton_Click"
                        Tag="Identity"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#8b5cf6"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Identity"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="PasswordButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Click="CategoryButton_Click"
                        Tag="Password"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#ef4444"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE1F5;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Password"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="PasskeyButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Click="CategoryButton_Click"
                        Tag="Passkey"
                        Style="{StaticResource CardButtonStyle}"
                        Margin="8"
                        MinHeight="100">
                    <StackPanel Margin="8">
                        <Border Background="#ec4899"
                                CornerRadius="12"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="24"
                                      Foreground="{StaticResource ModernTextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Passkey"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="Show more"
                       FontSize="14"
                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

            <Border Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="{StaticResource ModernBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Migrate data into PasswordManager"
                               FontSize="18"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{StaticResource ModernTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
