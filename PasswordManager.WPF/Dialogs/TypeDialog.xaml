<?xml version="1.0" encoding="utf-8"?>
<ui:ContentDialog x:Class="PasswordManager.WinUi.Dialogs.TypeDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:PasswordManager.WPF.Controls"
               Title="New Type"
               PrimaryButtonText="Save"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               PrimaryButtonStyle="{StaticResource ui:ContentDialogPrimaryButtonStyle}"
               CloseButtonStyle="{StaticResource ui:ContentDialogSecondaryButtonStyle}">

    <Grid xmlns:ui="http://schemas.modernwpf.com/2019"
    Background="{StaticResource ModernFormBackgroundBrush}"
          MaxWidth="480"
          MaxHeight="600">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24"
                        Margin="32">

                <!-- Error Message -->
                <Border x:Name="ErrorMessageBorder"
                        Background="{StaticResource ModernErrorBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText"
                               Text=""
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Medium"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Type Name Field -->
                <StackPanel Margin="8">
                    <TextBlock Text="Name"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="TypeNameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter type name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     MaxLength="100"/>
                            <controls:ReadOnlyField x:Name="TypeNameTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Type Description Field -->
                <StackPanel Margin="8">
                    <TextBlock Text="Description"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="TypeDescriptionTextBox"
                                     ui:ControlHelper.PlaceholderText="Add description (optional)"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="80"
                                     MaxLength="500"/>
                            <controls:ReadOnlyField x:Name="TypeDescriptionTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Type Icon Selection -->
                <StackPanel Margin="8">
                    <TextBlock Text="Icon"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <Grid>
                            <ComboBox x:Name="TypeIconComboBox"
                                      ui:ControlHelper.PlaceholderText="Choose icon"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="14"
                                      SelectedIndex="0">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE192;"
                                                  FontSize="18"
                                                  Foreground="#3b82f6"/>
                                        <TextBlock Text="Login"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE8C7;"
                                                  FontSize="18"
                                                  Foreground="#10b981"/>
                                        <TextBlock Text="Credit Card"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE70F;"
                                                  FontSize="18"
                                                  Foreground="#f59e0b"/>
                                        <TextBlock Text="Secure Note"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE701;"
                                                  FontSize="18"
                                                  Foreground="#8b5cf6"/>
                                        <TextBlock Text="WiFi Password"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE8D7;"
                                                  FontSize="18"
                                                  Foreground="#ec4899"/>
                                        <TextBlock Text="Passkey"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE77B;"
                                                  FontSize="18"
                                                  Foreground="#ef4444"/>
                                        <TextBlock Text="Identity"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE8FD;"
                                                  FontSize="18"
                                                  Foreground="#6b7280"/>
                                        <TextBlock Text="Document"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <FontIcon Glyph="&#xE734;"
                                                  FontSize="18"
                                                  Foreground="#059669"/>
                                        <TextBlock Text="Other"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <controls:ReadOnlyField x:Name="TypeIconTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Type Color Selection -->
                <StackPanel Margin="8">
                    <TextBlock Text="Color"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="TypeColorComboBox"
                                      Grid.Column="0"
                                      ui:ControlHelper.PlaceholderText="Choose color"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="14"
                                      SelectedIndex="0">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#3b82f6"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Blue"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#10b981"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Green"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#f59e0b"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Orange"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#ef4444"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Red"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#8b5cf6"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Purple"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#ec4899"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Pink"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12">
                                        <Ellipse Fill="#6b7280"
                                                 Width="20"
                                                 Height="20"/>
                                        <TextBlock Text="Gray"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <controls:ReadOnlyField x:Name="TypeColorTextDisplay"
                                                    Grid.Column="0"
                                                    Visibility="Collapsed"/>

                            <Ellipse x:Name="ColorPreview"
                                     Grid.Column="1"
                                     Fill="#3b82f6"
                                     Width="24"
                                     Height="24"
                                     Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:ContentDialog>
