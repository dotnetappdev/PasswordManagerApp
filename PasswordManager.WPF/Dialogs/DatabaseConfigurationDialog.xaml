<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019"
    x:Class="PasswordManager.WPF.Dialogs.DatabaseConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Database Configuration"
    PrimaryButtonText="Save"
    CloseButtonText="Use Default"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <ScrollViewer xmlns:ui="http://schemas.modernwpf.com/2019"
    MaxHeight="500">
        <StackPanel Margin="16" Padding="4">
            <!-- Header -->
            <TextBlock TextWrapping="Wrap" FontSize="14">
                Choose where to store your password database. The database will be created at the location you specify.
            </TextBlock>

            <!-- Default Location Info -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Margin="8">
                    <TextBlock Text="Default Location" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DefaultPathTextBlock" 
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Custom Path Section -->
            <StackPanel Margin="8">
                <TextBlock Text="Custom Database Path (Optional)" FontWeight="SemiBold"/>
                <TextBox x:Name="CustomPathTextBox"
                         ui:ControlHelper.PlaceholderText="Leave empty to use default location"
                         TextChanged="CustomPathTextBox_TextChanged"/>
                <Button x:Name="BrowseButton"
                        Content="Browse..."
                        Click="BrowseButton_Click"/>
            </StackPanel>

            <!-- Warning for custom path -->
            <ui:InfoBar x:Name="CustomPathWarning"
                     Severity="Warning"
                     IsOpen="False"
                     Title="Custom Path Selected"
                     Message="Make sure the folder exists and you have write permissions. The database file will be created automatically."/>

            <!-- Preview -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12"
                    x:Name="PreviewBorder">
                <StackPanel Margin="8">
                    <TextBlock Text="Database will be created at:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PreviewPathTextBlock"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Important Notes -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Margin="8">
                    <TextBlock Text="Important Notes:" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap">
                        • The database file contains all your encrypted passwords
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        • Make sure to backup this file regularly
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        • You can change this location later in Settings
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
