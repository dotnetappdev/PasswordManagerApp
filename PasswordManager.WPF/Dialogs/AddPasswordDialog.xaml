<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="PasswordManager.WPF.Dialogs.AddPasswordDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:PasswordManager.WPF.Controls"
               Title="New Item"
               PrimaryButtonText="Save"
               SecondaryButtonText="Cancel"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               PrimaryButtonStyle="{StaticResource ContentDialogPrimaryButtonStyle}"
               SecondaryButtonStyle="{StaticResource ContentDialogSecondaryButtonStyle}">

    <Grid xmlns:ui="http://schemas.modernwpf.com/2019"
    Background="{StaticResource ModernFormBackgroundBrush}"
          MaxWidth="520"
          MaxHeight="700">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RootStackPanel"
                        Margin="24"
                        Margin="32">

                <!-- Error Message -->
                <Border x:Name="ErrorMessageBorder"
                        Background="{StaticResource ModernErrorBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText"
                               Text=""
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Medium"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Success Message -->
                <Border x:Name="SuccessMessageBorder"
                        Background="{StaticResource ModernSuccessBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SuccessMessageText"
                               Text=""
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Medium"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Category Selection -->
                <StackPanel Margin="8">
                    <TextBlock Text="Category"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="CategoryComboBox"
                                  ui:ControlHelper.PlaceholderText="Choose category"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="14"
                                  HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>

                <!-- Title Field -->
                <StackPanel Margin="8">
                    <TextBlock Text="Title"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="TitleTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter title"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                            <controls:ReadOnlyField x:Name="TitleTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TitleValidationMessage"
                               Style="{StaticResource ValidationErrorTextStyle}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Description Field -->
                <StackPanel Margin="8">
                    <TextBlock Text="Description"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="DescriptionTextBox"
                                     ui:ControlHelper.PlaceholderText="Add description (optional)"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="80"/>
                            <controls:ReadOnlyField x:Name="DescriptionTextDisplay"
                                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Type Selection -->
                <StackPanel Margin="8">
                    <TextBlock Text="Type"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="TypeComboBox"
                                  ui:ControlHelper.PlaceholderText="Choose type"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="14"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="TypeComboBox_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12">
                                    <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="#3b82f6"/>
                                    <TextBlock Text="Login"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="#10b981"/>
                                    <TextBlock Text="Credit Card"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="#f59e0b"/>
                                    <TextBlock Text="Secure Note"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="#8b5cf6"/>
                                    <TextBlock Text="WiFi"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12">
                                    <TextBlock Text="&#xE1F5;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="#ef4444"/>
                                    <TextBlock Text="Password"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Margin="12">
                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="#ec4899"/>
                                    <TextBlock Text="Passkey"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                    <TextBlock x:Name="TypeValidationMessage"
                               Style="{StaticResource ValidationErrorTextStyle}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Favorite Toggle -->
                <Border Background="{StaticResource ModernSurfaceBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource ModernBorderBrush}"
                        BorderThickness="1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE734;"
                                  FontSize="18"
                                  Foreground="{StaticResource ModernTextSecondaryBrush}"
                                  Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Add to favorites"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                            <TextBlock Text="Mark this item as a favorite"
                                       FontSize="12"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="IsFavoriteCheckBox"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Collection Selection -->
                <StackPanel Margin="8">
                    <TextBlock Text="Collection"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <ComboBox x:Name="CollectionComboBox"
                                  ui:ControlHelper.PlaceholderText="Choose collection (optional)"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="14"
                                  HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>

                <!-- Login Fields Panel -->
                <StackPanel x:Name="LoginFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Login Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <!-- Username -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Username"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border x:Name="UsernameFieldBorder"
                                Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="UsernameTextBox"
                                         ui:ControlHelper.PlaceholderText="Enter username"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="16,12"
                                         FontSize="14"/>
                                <controls:ReadOnlyField x:Name="UsernameTextDisplay"
                                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Password"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border x:Name="PasswordFieldBorder"
                                Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <PasswordBox x:Name="PasswordTextBox"
                                                 ui:ControlHelper.PlaceholderText="Enter password"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="16,12"
                                                 FontSize="14"
                                                 RightTapped="PasswordTextBox_RightTapped"/>
                                    <TextBox x:Name="PasswordDisplayTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="16,12"
                                             FontSize="14"
                                             Visibility="Collapsed"/>
                                    <controls:ReadOnlyField x:Name="PasswordTextDisplay"
                                                            Visibility="Collapsed"/>
                                </Grid>
                                <Button x:Name="TogglePasswordVisibilityButton"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8"
                                        Click="TogglePasswordVisibility_Click">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="14"/>
                                </Button>
                                <Button x:Name="GeneratePasswordButton"
                                        Grid.Column="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8"
                                        Click="GeneratePasswordButton_Click">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- URL -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Website URL"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border x:Name="UrlFieldBorder"
                                Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="UrlTextBox"
                                         ui:ControlHelper.PlaceholderText="https://example.com"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="16,12"
                                         FontSize="14"/>
                                <controls:ReadOnlyField x:Name="UrlTextDisplay"
                                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Add Website Button -->
                    <Button x:Name="AddWebsiteButton"
                            Content="+ add website"
                            Background="Transparent"
                            Foreground="{StaticResource ModernAccentBrush}"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="0,8"
                            FontSize="14"
                            Click="AddWebsite_Click"/>

                    <!-- Add More Button -->
                    <Button x:Name="AddMoreLoginButton"
                            Content="+ add more"
                            Background="Transparent"
                            Foreground="{StaticResource ModernAccentBrush}"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="0,8"
                            FontSize="14"
                            Click="AddMoreLogin_Click"/>

                    <!-- Notes -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Notes"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="LoginNotesTextBox"
                                     ui:ControlHelper.PlaceholderText="Add any notes about this item here."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Credit Card Fields Panel -->
                <StackPanel x:Name="CreditCardFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Credit Card Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <!-- Cardholder Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Cardholder Name"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="CardholderNameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter cardholder name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Card Type -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Type"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1"
                                Padding="16,12">
                            <ComboBox x:Name="CardTypeComboBox"
                                      ui:ControlHelper.PlaceholderText="Select card type"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="14"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Visa"/>
                                <ComboBoxItem Content="MasterCard"/>
                                <ComboBoxItem Content="American Express"/>
                                <ComboBoxItem Content="Discover"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Card Number -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Number"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="CardNumberTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter card number"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Verification Number (CVV) -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Verification Number"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="CVVTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter CVV"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     MaxLength="4"/>
                        </Border>
                    </StackPanel>

                    <!-- Expiry Date -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Expiry Date"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="ExpiryDateTextBox"
                                     ui:ControlHelper.PlaceholderText="MM/YYYY"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     MaxLength="7"/>
                        </Border>
                    </StackPanel>

                    <!-- Valid From -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Valid From"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="ValidFromTextBox"
                                     ui:ControlHelper.PlaceholderText="MM/YYYY"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     MaxLength="7"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Secure Note Fields Panel -->
                <StackPanel x:Name="SecureNoteFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Secure Note"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <!-- Note Content -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Content"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="SecureNoteContentTextBox"
                                     ui:ControlHelper.PlaceholderText="Add any notes about this item here."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"/>
                        </Border>
                    </StackPanel>

                    <!-- Add More Button -->
                    <Button x:Name="AddMoreSecureNoteButton"
                            Content="+ add more"
                            Background="Transparent"
                            Foreground="{StaticResource ModernAccentBrush}"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="0,8"
                            FontSize="14"
                            Click="AddMoreSecureNote_Click"/>

                    <!-- Add Location Button -->
                    <Button x:Name="AddLocationButton"
                            Content="+ add a location"
                            Background="Transparent"
                            Foreground="{StaticResource ModernAccentBrush}"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="0,8"
                            FontSize="14"
                            Click="AddLocation_Click"/>
                </StackPanel>

                <!-- Identity Fields Panel -->
                <StackPanel x:Name="IdentityFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Identity Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <TextBlock Text="Identification"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <!-- First Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="First Name"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="FirstNameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter first name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Initial -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Initial"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="InitialTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter initial"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     MaxLength="5"/>
                        </Border>
                    </StackPanel>

                    <!-- Last Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Last Name"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="LastNameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter last name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Gender -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Gender"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="GenderTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter gender"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Birth Date -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Birth Date"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1"
                                Padding="16,12">
                            <DatePicker x:Name="BirthDatePicker"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Occupation -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Occupation"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="OccupationTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter occupation"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Company -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Company"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="CompanyTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter company"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Department -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Department"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="DepartmentTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter department"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Job Title -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Job Title"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="JobTitleTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter job title"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- WiFi Fields Panel -->
                <StackPanel x:Name="WiFiFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="WiFi Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- WiFi fields would go here -->
                </StackPanel>

                <!-- API Credentials Fields Panel -->
                <StackPanel x:Name="APICredentialsFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="API Credentials"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <!-- Username -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Username"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="ApiUsernameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter username"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Credential Password -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Credential"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <PasswordBox x:Name="ApiCredentialPasswordBox"
                                         ui:ControlHelper.PlaceholderText="Enter credential"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="16,12"
                                         FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Type -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Type"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="ApiTypeTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter type"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Filename -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Filename"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="ApiFilenameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter filename"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Valid From -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Valid From"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1"
                                Padding="16,12">
                            <DatePicker x:Name="ApiValidFromDatePicker"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Expires -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Expires"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1"
                                Padding="16,12">
                            <DatePicker x:Name="ApiExpiresDatePicker"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Hostname -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Hostname"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="ApiHostnameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter hostname"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Passkey Fields Panel -->
                <StackPanel x:Name="PasskeyFieldsPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Passkey Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>

                    <!-- Passkey Website -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Website"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyWebsiteTextBox"
                                     ui:ControlHelper.PlaceholderText="Website name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Passkey URL -->
                    <StackPanel Margin="8">
                        <TextBlock Text="URL"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyUrlTextBox"
                                     ui:ControlHelper.PlaceholderText="https://example.com"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Passkey Username -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Username"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyUsernameTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter username"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Passkey Display Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Display Name"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyDisplayNameTextBox"
                                     ui:ControlHelper.PlaceholderText="Display name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Passkey Device Type -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Device Type"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyDeviceTypeTextBox"
                                     ui:ControlHelper.PlaceholderText="Device type"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Passkey Verification Required -->
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Requires Verification"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource ModernTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="PasskeyRequiresVerificationCheckBox"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Passkey Is Backed Up -->
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Is Backed Up"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource ModernTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="PasskeyIsBackedUpCheckBox"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Passkey Notes -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Notes"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="PasskeyNotesTextBox"
                                     ui:ControlHelper.PlaceholderText="Additional notes"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="80"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Custom Fields Section -->
                <StackPanel x:Name="CustomFieldsSection"
                            Margin="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Custom Fields"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="AddCustomFieldButton"
                                Grid.Column="1"
                                Content="+ Add another field"
                                Background="{StaticResource ModernAccentBrush}"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,8"
                                FontSize="14"
                                FontWeight="Medium"
                                Click="AddCustomField_Click"/>
                    </Grid>

                    <!-- Dynamic Custom Fields Container -->
                    <StackPanel x:Name="CustomFieldsContainer"
                                Margin="8"/>
                </StackPanel>

                <!-- Item Selection Panel (for dialog mode switching) -->
                <StackPanel x:Name="ItemSelectionPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Select Item Type"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- Item type buttons would go here -->
                </StackPanel>

                <!-- Login Detail Panel (alternative view) -->
                <StackPanel x:Name="LoginDetailPanel"
                            Margin="12"
                            Visibility="Collapsed">
                    <TextBlock Text="Login Item Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <!-- Alternative login view would go here -->
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <Border x:Name="LoadingIndicator"
                Background="{StaticResource ModernSurfaceBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource ModernBorderBrush}"
                BorderThickness="1"
                Padding="24"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Margin="16"
                        HorizontalAlignment="Center">
                <ui:ProgressRing IsActive="True"
                              Style="{StaticResource Modernui:ProgressRingStyle}"/>
                <TextBlock x:Name="LoadingText"
                           Text="Saving item..."
                           FontSize="14"
                           Foreground="{StaticResource ModernTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Password Generator Popup -->
        <Border x:Name="PasswordGeneratorPopup"
                Background="{StaticResource ModernSurfaceBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource ModernBorderBrush}"
                BorderThickness="1"
                Padding="24"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Margin="16"
                        MinWidth="300">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password Generator"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            Click="ClosePasswordGenerator_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Generated Password Display -->
                <Border Background="{StaticResource ModernFormBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource ModernBorderBrush}"
                        BorderThickness="1"
                        Padding="12">
                    <TextBlock x:Name="GeneratedPasswordText"
                               Text="Generated password will appear here"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="{StaticResource ModernTextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Password Length -->
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Length"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                        <TextBlock x:Name="PasswordLengthText"
                                   Grid.Column="1"
                                   Text="12"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource ModernAccentBrush}"/>
                    </Grid>
                    <Slider x:Name="PasswordLengthSlider"
                            Minimum="8"
                            Maximum="64"
                            Value="12"
                            ValueChanged="PasswordLengthSlider_ValueChanged"/>
                </StackPanel>

                <!-- Options -->
                <StackPanel Margin="12">
                    <ToggleSwitch x:Name="NumbersToggle"
                                  Header="Include Numbers"
                                  IsOn="True"/>
                    <ToggleSwitch x:Name="SymbolsToggle"
                                  Header="Include Symbols"
                                  IsOn="False"/>
                </StackPanel>

                <!-- Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Refresh"
                            Click="RefreshPassword_Click"
                            Style="{StaticResource ModernSecondaryButtonStyle}"/>
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Margin="8,0,0,0"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Click="CancelPasswordGenerator_Click"/>
                    <Button Grid.Column="2"
                            Content="Use Password"
                            Margin="8,0,0,0"
                            Style="{StaticResource ModernPrimaryButtonStyle}"
                            Click="UseGeneratedPassword_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:ContentDialog>
