<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="PasswordManager.WPF.Dialogs.AddPasswordDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:PasswordManager.WPF.Controls"
               Title="New Item"
               PrimaryButtonText="Save"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               Style="{StaticResource Modern1PasswordDialogStyle}"
               PrimaryButtonStyle="{StaticResource ContentDialogPrimaryButtonStyle}"
               MaxWidth="1500"
               MaxHeight="920">

    <Grid xmlns:ui="http://schemas.modernwpf.com/2019"
          MinWidth="900"
          MaxWidth="1460"
          MaxHeight="880">
        <Grid.Background><SolidColorBrush Color="{StaticResource ModernFormBackgroundColor}"/></Grid.Background>
        <ScrollViewer x:Name="DialogScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      MaxHeight="820" VerticalAlignment="Stretch"
                      PreviewMouseWheel="DialogScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="24,16,24,8">

                <!-- Error / Success banners -->
                <Border x:Name="ErrorMessageBorder" Background="{StaticResource ModernErrorBrush}"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText" Foreground="White" FontSize="14"
                               FontWeight="Medium" TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="SuccessMessageBorder" Background="{StaticResource ModernSuccessBrush}"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="SuccessMessageText" Foreground="White" FontSize="14"
                               FontWeight="Medium" TextWrapping="Wrap"/>
                </Border>

                <!-- ═══ ROW 1 — Category (full width) ═══ -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                        <ComboBox x:Name="CategoryComboBox"
                                  ui:ControlHelper.PlaceholderText="Choose a category"
                                  Foreground="{StaticResource ModernTextPrimaryBrush}"
                                  Background="{StaticResource ModernSurfaceBrush}" BorderThickness="0"
                                  FontSize="14" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CategoryComboBox_SelectionChanged"/>
                    </Border>
                </StackPanel>

                <!-- Hidden TypeComboBox — driven automatically from category selection (indices match ItemType-1) -->
                <ComboBox x:Name="TypeComboBox" Visibility="Collapsed"
                          SelectionChanged="TypeComboBox_SelectionChanged">
                    <ComboBoxItem/><!-- 0=Login -->
                    <ComboBoxItem/><!-- 1=CreditCard -->
                    <ComboBoxItem/><!-- 2=SecureNote -->
                    <ComboBoxItem/><!-- 3=WiFi -->
                    <ComboBoxItem/><!-- 4=Password -->
                    <ComboBoxItem/><!-- 5=Passkey -->
                    <ComboBoxItem/><!-- 6=Identity -->
                </ComboBox>
                <TextBlock x:Name="TypeValidationMessage"
                           Style="{StaticResource ValidationErrorTextStyle}"
                           Visibility="Collapsed"/>

                <!-- ═══ ROW 2 — Title (full width) ═══ -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Title" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                        <Grid>
                            <TextBox x:Name="TitleTextBox"
                                     ui:ControlHelper.PlaceholderText="Enter title"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            <controls:ReadOnlyField x:Name="TitleTextDisplay" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TitleValidationMessage"
                               Style="{StaticResource ValidationErrorTextStyle}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- ═══ ROW 3 — Description (full width) ═══ -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="DescriptionTextBox"
                                     ui:ControlHelper.PlaceholderText="Add description (optional)"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,10" FontSize="14"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72"/>
                            <controls:ReadOnlyField x:Name="DescriptionTextDisplay" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Vault field removed — VaultId column not yet in database -->

                <!-- ═══ ROW 5 — Favorite toggle (full width) ═══ -->
                <Border Background="{StaticResource ModernSurfaceBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource ModernBorderBrush}"
                        BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0" Glyph="&#xE734;" FontSize="16"
                                  Foreground="{StaticResource ModernTextSecondaryBrush}"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Add to favorites"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="IsFavoriteCheckBox" Grid.Column="2"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ═══ LOGIN FIELDS PANEL ═══ -->
                <StackPanel x:Name="LoginFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <!-- Section header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{StaticResource ModernPrimaryBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="Login Details"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>

                    <!-- Username | Password (2 cols) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Username -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="UsernameFieldBorder"
                                    Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <Grid>
                                    <TextBox x:Name="UsernameTextBox"
                                             ui:ControlHelper.PlaceholderText="Enter username"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                                    <controls:ReadOnlyField x:Name="UsernameTextDisplay" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Password with reveal -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="PasswordFieldBorder"
                                    Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="PasswordTextBox"
                                                     ui:ControlHelper.PlaceholderText="Enter or generate password"
                                                     Background="Transparent" BorderThickness="0"
                                                     Padding="12,0" FontSize="14"
                                                     VerticalContentAlignment="Center"/>
                                        <TextBox x:Name="PasswordDisplayTextBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="12,0" FontSize="14"
                                                 VerticalContentAlignment="Center"
                                                 Visibility="Collapsed"/>
                                        <controls:ReadOnlyField x:Name="PasswordTextDisplay" Visibility="Collapsed"/>
                                    </Grid>
                                    <Button x:Name="TogglePasswordVisibilityButton"
                                            Grid.Column="1" Background="Transparent"
                                            BorderThickness="0" Padding="8,6"
                                            VerticalAlignment="Center"
                                            Click="TogglePasswordVisibility_Click">
                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Password strength meter (updates live as you type) -->
                    <StackPanel x:Name="PasswordStrengthPanel" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StrengthSeg1" Grid.Column="0" Height="5" CornerRadius="3" Background="{DynamicResource ModernElevatedSurfaceBrush}"/>
                            <Border x:Name="StrengthSeg2" Grid.Column="2" Height="5" CornerRadius="3" Background="{DynamicResource ModernElevatedSurfaceBrush}"/>
                            <Border x:Name="StrengthSeg3" Grid.Column="4" Height="5" CornerRadius="3" Background="{DynamicResource ModernElevatedSurfaceBrush}"/>
                            <Border x:Name="StrengthSeg4" Grid.Column="6" Height="5" CornerRadius="3" Background="{DynamicResource ModernElevatedSurfaceBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StrengthLabel" Grid.Column="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ModernTextSecondaryBrush}"/>
                            <TextBlock x:Name="StrengthCrackTime" Grid.Column="1" FontSize="11"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Generate Password button row -->
                    <Border Margin="0,0,0,10" Padding="0">
                        <Button x:Name="GeneratePasswordButton"
                                HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,4" Cursor="Hand"
                                Click="GeneratePasswordButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource ModernPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generate strong password" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource ModernPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- ═══ INLINE PASSWORD GENERATOR ═══ -->
                    <Border x:Name="InlinePasswordGeneratorPanel" Visibility="Collapsed"
                            Background="{StaticResource ModernCardBrush}"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Generator header -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource ModernPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Password Generator" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Background="{StaticResource ModernSurfaceBrush}"
                                        BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1"
                                        Padding="10,5" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                        Click="RefreshPassword_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource ModernTextPrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Regenerate" FontSize="12" Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                        Padding="4" Cursor="Hand" Click="ClosePasswordGenerator_Click">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Generated password preview + Use button -->
                            <Border Background="{StaticResource ModernFormBackgroundBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1"
                                    Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GeneratedPasswordText"
                                               FontFamily="Consolas" FontSize="16" FontWeight="Medium"
                                               Foreground="{StaticResource ModernPrimaryBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="Click Regenerate to generate a password"/>
                                    <Button Grid.Column="1" Content="Use Password"
                                            Background="{StaticResource ModernPrimaryBrush}"
                                            Foreground="White" BorderThickness="0"
                                            Padding="12,7" FontSize="12" FontWeight="SemiBold"
                                            MinWidth="0" Cursor="Hand"
                                            Click="UseGeneratedPassword_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ModernPrimaryDarkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Length slider -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Length" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource ModernTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="PasswordLengthSlider" Grid.Column="1"
                                        Minimum="8" Maximum="64" Value="20"
                                        VerticalAlignment="Center"
                                        ValueChanged="PasswordLengthSlider_ValueChanged"/>
                                <Border Grid.Column="2" Background="{StaticResource ModernSurfaceBrush}"
                                        CornerRadius="4" BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,2">
                                    <TextBlock x:Name="PasswordLengthText" Text="20" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource ModernTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Character type toggles -->
                            <WrapPanel>
                                <ToggleButton x:Name="UppercaseToggle" IsChecked="True"
                                              Style="{StaticResource PasswordOptionChipStyle}"
                                              Margin="0,0,8,0"
                                              Checked="PasswordOption_Changed" Unchecked="PasswordOption_Changed"
                                              Content="A–Z  Uppercase"/>
                                <ToggleButton x:Name="LowercaseToggle" IsChecked="True"
                                              Style="{StaticResource PasswordOptionChipStyle}"
                                              Margin="0,0,8,0"
                                              Checked="PasswordOption_Changed" Unchecked="PasswordOption_Changed"
                                              Content="a–z  Lowercase"/>
                                <ToggleButton x:Name="NumbersToggle" IsChecked="True"
                                              Style="{StaticResource PasswordOptionChipStyle}"
                                              Margin="0,0,8,0"
                                              Checked="PasswordOption_Changed" Unchecked="PasswordOption_Changed"
                                              Content="0–9  Numbers"/>
                                <ToggleButton x:Name="SymbolsToggle" IsChecked="True"
                                              Style="{StaticResource PasswordOptionChipStyle}"
                                              Checked="PasswordOption_Changed" Unchecked="PasswordOption_Changed"
                                              Content="!@#  Symbols"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- URL (full width) -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Website URL" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border x:Name="UrlFieldBorder"
                                Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                            <Grid>
                                <TextBox x:Name="UrlTextBox"
                                         ui:ControlHelper.PlaceholderText="https://example.com"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                                <controls:ReadOnlyField x:Name="UrlTextDisplay" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Link buttons row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="AddWebsiteButton" Content="+ add website"
                                Background="Transparent" Foreground="{StaticResource ModernAccentBrush}"
                                BorderThickness="0" Padding="0,6" FontSize="13"
                                Click="AddWebsite_Click"/>
                        <Button x:Name="UploadBrandIconButton" Content="+ upload icon"
                                Background="Transparent" Foreground="{StaticResource ModernAccentBrush}"
                                BorderThickness="0" Padding="16,6,0,6" FontSize="13"
                                Click="UploadBrandIcon_Click"/>
                        <Button x:Name="RemoveBrandIconButton" Content="remove icon"
                                Background="Transparent" Foreground="{StaticResource ModernAccentBrush}"
                                BorderThickness="0" Padding="12,6,0,6" FontSize="13"
                                Visibility="Collapsed" Click="RemoveBrandIcon_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="BrandIconStatusText" FontSize="11"
                               Foreground="{StaticResource ModernTextSecondaryBrush}"
                               Margin="0,0,0,8"
                               Text="We'll use the website icon automatically, or you can upload your own."/>

                    <!-- Notes (full width) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1">
                            <TextBox x:Name="LoginNotesTextBox"
                                     ui:ControlHelper.PlaceholderText="Add notes here."
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,10" FontSize="14"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                        </Border>
                    </StackPanel>

                    <!-- Authenticator key (TOTP) — Bitwarden-style verification codes -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Authenticator key (TOTP)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                            <TextBox x:Name="TotpSecretTextBox"
                                     ui:ControlHelper.PlaceholderText="Base32 secret or otpauth:// URI"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </Border>
                        <TextBlock FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Paste the 2FA setup key and a live verification code will appear on the item."/>
                    </StackPanel>

                    <Button x:Name="AddMoreLoginButton" Content="+ add more"
                            Background="Transparent" Foreground="{StaticResource ModernAccentBrush}"
                            BorderThickness="0" HorizontalAlignment="Left"
                            Padding="0,6" FontSize="13" Click="AddMoreLogin_Click"/>
                </StackPanel>

                <!-- ═══ CREDIT CARD FIELDS PANEL ═══ -->
                <StackPanel x:Name="CreditCardFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{StaticResource ModernSuccessBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="Credit Card Details"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>

                    <!-- Cardholder | Card Type -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cardholder Name" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="CardholderNameTextBox"
                                         ui:ControlHelper.PlaceholderText="Enter cardholder name"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Card Type" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <ComboBox x:Name="CardTypeComboBox"
                                          ui:ControlHelper.PlaceholderText="Select card type"
                                          Background="Transparent" BorderThickness="0"
                                          FontSize="14" HorizontalAlignment="Stretch" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Visa"/>
                                    <ComboBoxItem Content="MasterCard"/>
                                    <ComboBoxItem Content="American Express"/>
                                    <ComboBoxItem Content="Discover"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Card Number | CVV -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Card Number" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="CardNumberTextBox"
                                         ui:ControlHelper.PlaceholderText="•••• •••• •••• ••••"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CVV" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="CVVTextBox"
                                         ui:ControlHelper.PlaceholderText="•••"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14" MaxLength="4"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Expiry | Valid From -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Expiry Date" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="ExpiryDateTextBox"
                                         ui:ControlHelper.PlaceholderText="MM/YYYY"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14" MaxLength="7"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valid From" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="ValidFromTextBox"
                                         ui:ControlHelper.PlaceholderText="MM/YYYY"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14" MaxLength="7"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Notes (full width, large) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1">
                            <TextBox x:Name="CreditCardNotesTextBox"
                                     ui:ControlHelper.PlaceholderText="Billing address, PIN reminders, support phone number..."
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,10" FontSize="14"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="140"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ SECURE NOTE FIELDS PANEL ═══ -->
                <StackPanel x:Name="SecureNoteFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{StaticResource ModernWarningBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="Secure Note"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Content" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1">
                            <TextBox x:Name="SecureNoteContentTextBox"
                                     ui:ControlHelper.PlaceholderText="Write your note here..."
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,10" FontSize="14"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"/>
                        </Border>
                    </StackPanel>

                    <!-- Protect this note -->
                    <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                         Foreground="{StaticResource ModernTextSecondaryBrush}"
                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Protect this note" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                <TextBlock Text="Hide the content until you reveal it (Windows Hello when available)."
                                           FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ProtectNoteCheckBox" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddMoreSecureNoteButton" Content="+ add more"
                                Background="Transparent" Foreground="{StaticResource ModernAccentBrush}"
                                BorderThickness="0" Padding="0,6" FontSize="13"
                                Click="AddMoreSecureNote_Click"/>
                        <Button x:Name="AddLocationButton" Content="+ add location"
                                Background="Transparent" Foreground="{StaticResource ModernAccentBrush}"
                                BorderThickness="0" Padding="16,6,0,6" FontSize="13"
                                Click="AddLocation_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ IDENTITY FIELDS PANEL ═══ -->
                <StackPanel x:Name="IdentityFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{StaticResource ModernAccentBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="Identity Details"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>

                    <!-- First Name | Last Name -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="FirstNameTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="First name"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="LastNameTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Last name"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Initial | Gender -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Initial" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="InitialTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="M."
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14" MaxLength="5"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gender" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="GenderTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Gender"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Birth Date | Occupation -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Birth Date" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40" Padding="12,0">
                                <DatePicker x:Name="BirthDatePicker" Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Occupation" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="OccupationTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Occupation"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Company | Department -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Company" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="CompanyTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Company name"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Department" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="DepartmentTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Department"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Job Title (full width) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Job Title" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                            <TextBox x:Name="JobTitleTextBox" Background="Transparent" BorderThickness="0"
                                     ui:ControlHelper.PlaceholderText="Job title"
                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ WIFI FIELDS PANEL ═══ -->
                <StackPanel x:Name="WiFiFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{DynamicResource ModernPrimaryBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="WiFi Details"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- ═══ API CREDENTIALS FIELDS PANEL ═══ -->
                <StackPanel x:Name="APICredentialsFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{StaticResource ModernInfoBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="API Credentials"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>

                    <!-- Username | Credential -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="ApiUsernameTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Enter username"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Credential" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <PasswordBox x:Name="ApiCredentialPasswordBox" Background="Transparent" BorderThickness="0"
                                             ui:ControlHelper.PlaceholderText="Enter credential"
                                             Padding="12,0" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Type | Filename -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Type" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="ApiTypeTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Type"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Filename" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="ApiFilenameTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Filename"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Valid From | Expires -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Valid From" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40" Padding="12,0">
                                <DatePicker x:Name="ApiValidFromDatePicker" Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Expires" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40" Padding="12,0">
                                <DatePicker x:Name="ApiExpiresDatePicker" Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Hostname (full width) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Hostname" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                            <TextBox x:Name="ApiHostnameTextBox" Background="Transparent" BorderThickness="0"
                                     ui:ControlHelper.PlaceholderText="Hostname"
                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ PASSKEY FIELDS PANEL ═══ -->
                <StackPanel x:Name="PasskeyFieldsPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{DynamicResource ModernAccentBrush}"
                                Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1" Text="Passkey Details"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource ModernBorderBrush}" Margin="0,0,0,12"/>

                    <!-- Website | URL -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Website" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="PasskeyWebsiteTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Website name"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="URL" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="PasskeyUrlTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="https://example.com"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Username | Display Name -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="PasskeyUsernameTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Username"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Display Name" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="PasskeyDisplayNameTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Display name"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Device Type | Toggles -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Device Type" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1" Height="40">
                                <TextBox x:Name="PasskeyDeviceTypeTextBox" Background="Transparent" BorderThickness="0"
                                         ui:ControlHelper.PlaceholderText="Device type"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Requires Verification" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="PasskeyRequiresVerificationCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1"
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Is Backed Up" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource ModernTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="PasskeyIsBackedUpCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Notes (full width) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource ModernSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="1">
                            <TextBox x:Name="PasskeyNotesTextBox" Background="Transparent" BorderThickness="0"
                                     ui:ControlHelper.PlaceholderText="Additional notes"
                                     Padding="12,10" FontSize="14"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ CUSTOM FIELDS SECTION ═══ -->
                <StackPanel x:Name="CustomFieldsSection" Margin="0,8,0,0">
                    <Border Background="{StaticResource ModernSurfaceBrush}"
                            BorderBrush="{StaticResource ModernBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                        Background="{StaticResource ModernTextSecondaryBrush}"
                                        Margin="0,2,10,2" VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="1" Text="Custom Fields"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="AddCustomFieldButton" Grid.Column="2"
                                        Content="+ Add field"
                                        Background="{StaticResource ModernAccentBrush}"
                                        Foreground="White" Padding="10,6"
                                        FontSize="13" FontWeight="Medium"
                                        Click="AddCustomField_Click"/>
                            </Grid>

                            <!-- Field type picker — shown below the header when "+ Add field" is clicked -->
                            <Border x:Name="FieldTypePickerPanel" Visibility="Collapsed"
                                    Background="{DynamicResource ModernCardBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,4,0,6">
                                <StackPanel>
                                    <TextBlock Text="Choose field type" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ModernTextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Text"      Tag="Text"     Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Password"  Tag="Password" Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Email"     Tag="Email"    Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="URL"       Tag="Url"      Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Phone"     Tag="Phone"    Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Number"    Tag="Number"   Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Date"      Tag="Date"     Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Yes / No"  Tag="Toggle"   Margin="0,0,6,6" Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                        <Button Content="Multiline" Tag="TextArea" Margin="0,0,0,6"  Padding="10,5" FontSize="13" Click="FieldTypeButton_Click" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,4,0,4">
                                <Button Content="+ website" Margin="0,0,8,6" Padding="8,4" Click="AddWebsite_Click"/>
                                <Button Content="+ more" Margin="0,0,8,6" Padding="8,4" Click="AddMoreLogin_Click"/>
                                <Button Content="+ notes" Margin="0,0,8,6" Padding="8,4" Click="AddMoreSecureNote_Click"/>
                                <Button Content="+ location" Margin="0,0,0,6" Padding="8,4" Click="AddLocation_Click"/>
                            </WrapPanel>
                            <StackPanel x:Name="CustomFieldsContainer"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Placeholder panels for dialog mode switching -->
                <StackPanel x:Name="ItemSelectionPanel" Margin="0,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="LoginDetailPanel" Margin="0,8,0,0" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Indicator overlay -->
        <Border x:Name="LoadingIndicator"
                Background="{StaticResource ModernSurfaceBrush}"
                CornerRadius="12" BorderBrush="{StaticResource ModernBorderBrush}"
                BorderThickness="1" Padding="24" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="16" HorizontalAlignment="Center">
                <ui:ProgressRing IsActive="True" Style="{StaticResource ModernProgressRingStyle}"/>
                <TextBlock x:Name="LoadingText" Text="Saving item..."
                           FontSize="14" Foreground="{StaticResource ModernTextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</ui:ContentDialog>
