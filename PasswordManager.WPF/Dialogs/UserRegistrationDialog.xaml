<ui:ContentDialog xmlns:ui="http://schemas.modernwpf.com/2019" x:Class="PasswordManager.WPF.Dialogs.UserRegistrationDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:converters="clr-namespace:PasswordManager.WPF.Converters"
               Title="Create New User Account"
               PrimaryButtonText="Create Account"
               SecondaryButtonText="Cancel"
               DefaultButton="Primary"
               Background="#404040">

    <ui:ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </ui:ContentDialog.Resources>

    <ScrollViewer xmlns:ui="http://schemas.modernwpf.com/2019"
    MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,20,0,0">
            
            <!-- ui:InfoBar for validation messages -->
            
            
            <!-- Personal Information Section -->
            <Border Background="#2D2D2D" 
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Margin="16">
                    <TextBlock Text="Personal Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    
                    <!-- First Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="First Name" Foreground="#B0B0B0" FontSize="14"/>
                        <Border x:Name="FirstNameBorder"
                                x:FieldModifier="private"
                                Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <TextBox x:Name="FirstNameTextBox"
                                    x:FieldModifier="private"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    ui:ControlHelper.PlaceholderText="Enter first name"
                                    TextChanged="FirstNameTextBox_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Last Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Last Name" Foreground="#B0B0B0" FontSize="14"/>
                        <Border x:Name="LastNameBorder"
                                x:FieldModifier="private"
                                Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <TextBox x:Name="LastNameTextBox"
                                    x:FieldModifier="private"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    ui:ControlHelper.PlaceholderText="Enter last name"
                                    TextChanged="LastNameTextBox_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Email Address" Foreground="#B0B0B0" FontSize="14"/>
                        <Border x:Name="EmailBorder"
                                x:FieldModifier="private"
                                Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <TextBox x:Name="EmailTextBox"
                                    x:FieldModifier="private"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    ui:ControlHelper.PlaceholderText="Enter email address"
                                    TextChanged="EmailTextBox_TextChanged"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Account Security Section -->
            <Border Background="#2D2D2D" 
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Margin="16">
                    <TextBlock Text="Account Security"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    
                    <!-- Master Password -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Master Password" Foreground="#B0B0B0" FontSize="14"/>
                        <Border x:Name="MasterPasswordBorder"
                                x:FieldModifier="private"
                                Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <PasswordBox x:Name="MasterPasswordBox"
                                        x:FieldModifier="private"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        ui:ControlHelper.PlaceholderText="Create a strong master password"
                                        PasswordChanged="MasterPasswordBox_PasswordChanged"/>
                        </Border>
                        <!-- Password Strength Indicator -->
                        <StackPanel x:Name="PasswordStrengthPanel"
                                   x:FieldModifier="private"
                                   Margin="4"
                                   Visibility="Collapsed">
                            <ProgressBar x:Name="PasswordStrengthBar"
                                        x:FieldModifier="private"
                                        Height="4"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="0"/>-->
                            <TextBlock x:Name="PasswordStrengthText"
                                      x:FieldModifier="private"
                                      FontSize="12"
                                      Foreground="#B0B0B0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Confirm Master Password -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Confirm Master Password" Foreground="#B0B0B0" FontSize="14"/>
                        <Border x:Name="ConfirmPasswordBorder"
                                x:FieldModifier="private"
                                Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                        x:FieldModifier="private"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        ui:ControlHelper.PlaceholderText="Confirm your master password"
                                        PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Password Hint -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Password Hint (Optional)" Foreground="#B0B0B0" FontSize="14"/>
                        <Border Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <TextBox x:Name="PasswordHintTextBox"
                                    x:FieldModifier="private"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    ui:ControlHelper.PlaceholderText="Enter a hint to help remember your password"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Account Role Section -->
            <Border Background="#2D2D2D" 
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Margin="16">
                    <TextBlock Text="Account Role"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    
                    <!-- Admin Toggle -->
                    <Border Background="#3A3A3A"
                            CornerRadius="8"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            Padding="16,12"
                            Visibility="{Binding CanCreateAdminAccount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Administrator Account"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           FontSize="16"/>
                                <TextBlock Text="Full access to all features and user management"
                                           Foreground="#B0B0B0"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <CheckBox x:Name="AdminToggleSwitch"
                                         x:FieldModifier="private"
                                         Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Checked="AdminToggleSwitch_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Role Selection ComboBox (when not admin) -->
                    <StackPanel Margin="8" 
                                Visibility="{Binding ShowRoleSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="User Role" Foreground="#B0B0B0" FontSize="14"/>
                        <Border Background="#3A3A3A"
                                CornerRadius="8"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Padding="12">
                            <ComboBox x:Name="RoleComboBox"
                                     x:FieldModifier="private"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     HorizontalAlignment="Stretch"
                                     SelectionChanged="RoleComboBox_SelectionChanged">
                                <ComboBoxItem Content="Parent User" Tag="Parent"/>
                                <ComboBoxItem Content="Standard User" Tag="User" IsSelected="True"/>
                                <ComboBoxItem Content="Child User" Tag="Child"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Role Description -->
                    <Border Background="#1E3A5F"
                            CornerRadius="8"
                            BorderBrush="#4A90E2"
                            BorderThickness="1"
                            Padding="12">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" 
                                     FontSize="16" 
                                     Foreground="#4A90E2"
                                     VerticalAlignment="Top"/>
                            <TextBlock x:Name="RoleDescriptionTextBlock"
                                      x:FieldModifier="private"
                                      Text="Standard users can manage their own passwords and access all features."
                                      Foreground="#B0D4FF"
                                      TextWrapping="Wrap"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Error Message -->
            <Border x:Name="ErrorMessageBorder"
                    x:FieldModifier="private"
                    Background="#5D2A2A"
                    BorderBrush="#DC2626"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="8">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Foreground="#DC2626"/>
                    <TextBlock x:Name="ErrorMessageTextBlock"
                               x:FieldModifier="private"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
