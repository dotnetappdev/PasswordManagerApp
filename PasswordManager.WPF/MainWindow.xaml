<Window xmlns:ui="http://schemas.modernwpf.com/2019"
    x:Class="PasswordManager.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PasswordManager.WPF.Controls">

    <Grid Background="{StaticResource ModernBackgroundBrush}">
        <!-- Login Frame (shown during authentication) -->
        <Frame x:Name="LoginFrame"
               x:FieldModifier="private"
               Background="{StaticResource ModernBackgroundBrush}"
               NavigationUIVisibility="Hidden"
               Visibility="Visible"
               Navigated="Frame_Navigated"/>

        <!-- Main Navigation View (shown after authentication) -->
        <ui:NavigationView x:Name="MainNavigationView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactModeThresholdWidth="0"
                        ExpandedModeThresholdWidth="0"
                        SelectionChanged="MainNavigationView_SelectionChanged"
                        Visibility="Collapsed"
                        Margin="0"
                        Padding="0">

            <!-- Pane Header: App name + profile + search + new item -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="0,0,0,4">

                    <!-- App branding -->
                    <Border Padding="16,14,16,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#2D2D2D"
                                    BorderBrush="#3A3A3A" BorderThickness="1"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#D1D5DB"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Password Manager"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModernTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- hairline divider -->
                    <Border Height="1" Background="#FF3A3A3A" Margin="12,0"/>

                    <!-- Profile button -->
                    <Button x:Name="ProfileButton"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Click="ProfileButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                    Background="#383838"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="UserAvatarText" Text="?"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText"
                                           Text="My Account"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource ModernTextPrimaryBrush}"/>
                                <TextBlock Text="Personal Vault"
                                           FontSize="11"
                                           Foreground="{StaticResource ModernTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE019;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource ModernTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Search -->
                    <Border Padding="12,6">
                        <ui:AutoSuggestBox x:Name="SearchBox"
                                        QueryIcon="Find"
                                        ui:ControlHelper.PlaceholderText="Search..."
                                        TextChanged="SearchBox_TextChanged"
                                        QuerySubmitted="SearchBox_QuerySubmitted"
                                        Style="{StaticResource ModernAutoSuggestBoxStyle}"
                                        Height="34"/>
                    </Border>

                    <!-- New Item button -->
                    <Border Padding="12,0,12,10">
                        <Button HorizontalAlignment="Stretch"
                                Height="34"
                                Click="NewItemButton_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            CornerRadius="6" Padding="10,6"
                                            BorderThickness="1">
                                        <Border.Background><SolidColorBrush Color="#2D2D2D"/></Border.Background>
                                        <Border.BorderBrush><SolidColorBrush Color="#454545"/></Border.BorderBrush>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="#B0B0B0" Margin="0,0,6,0"/>
                                            <TextBlock Text="New Item" Foreground="#E5E5E5"
                                                       FontSize="13" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value><SolidColorBrush Color="#3A3A3A"/></Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Bd" Property="BorderBrush">
                                                <Setter.Value><SolidColorBrush Color="#555555"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value><SolidColorBrush Color="#272727"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- hairline divider -->
                    <Border Height="1" Background="#FF2B2B2B" Margin="0,0"/>

                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- Nav items -->
            <ui:NavigationView.MenuItems>

                <!-- ── Quick Access ── -->
                <ui:NavigationViewItem x:Name="AllItemsNavItem"
                                       Content="All Items"
                                       Background="#FF2B2B2B"
                                       Tag="AllItems"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Favourites" Tag="Favorites"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE734;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── Item Types ── -->
                <ui:NavigationViewItemSeparator Background="#FF2B2B2B"/>
                <ui:NavigationViewItemHeader Foreground="#6B7280" Content="Item Types"/>

                <ui:NavigationViewItem Content="Logins" Tag="LoginCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE1A3;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Credit Cards" Tag="CreditCardCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8C7;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Secure Notes" Tag="SecureNotesCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE70B;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Wi-Fi Networks" Tag="WiFiCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE701;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Identities" Tag="IdentityCategory"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE77B;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── Security ── -->
                <ui:NavigationViewItemSeparator Background="#FF2B2B2B"/>
                <ui:NavigationViewItemHeader Foreground="#6B7280" Content="Security"/>

                <ui:NavigationViewItem Content="Passkeys" Tag="Passkeys"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8D7;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Vaults" Tag="Vaults"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE72E;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Security Dashboard" Tag="SecurityDashboard"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8E1;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- ── Manage ── -->
                <ui:NavigationViewItemSeparator Background="#FF2B2B2B"/>
                <ui:NavigationViewItemHeader Foreground="#6B7280" Content="Manage"/>

                <ui:NavigationViewItem Content="Categories" Tag="Categories"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8FD;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Import / Export" Tag="Import"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <!-- Footer nav items -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Archive" Tag="Archive"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE7B8;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Recently Deleted" Tag="RecentlyDeleted"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE74D;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Settings" Tag="Settings"
                                       MouseRightButtonUp="NavigationItem_RightTapped">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- Pane footer: dynamic vaults + tags (capped height so Settings stays visible) -->
            <ui:NavigationView.PaneFooter>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260" Margin="0,0,0,4">
                <StackPanel Margin="0,0,0,8">
                    <!-- hairline divider -->
                    <Border Height="1" Background="#FF3A3A3A" Margin="0,4"/>

                    <!-- Dynamic favourite categories -->
                    <Grid Margin="16,6,8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VAULTS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Padding="4" MinWidth="0" MinHeight="0"
                                ToolTipService.ToolTip="Add Category"
                                Click="AddCategoryNavButton_Click">
                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="FavoriteCategoriesPanel"/>

                    <!-- Dynamic tags -->
                    <Grid Margin="16,10,8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TAGS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModernTextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Padding="4" MinWidth="0" MinHeight="0"
                                ToolTipService.ToolTip="Add Tag"
                                Click="AddTagNavButton_Click">
                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource ModernTextTertiaryBrush}"/>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="SidebarTagsPanel"/>
                </StackPanel>
                </ScrollViewer>
            </ui:NavigationView.PaneFooter>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame"
                   Background="{StaticResource ModernBackgroundBrush}"
                   NavigationUIVisibility="Hidden"
                   Navigated="Frame_Navigated"/>

        </ui:NavigationView>

        <!-- Toast overlay — sits on top of everything, bottom-right -->
        <controls:ToastHost IsHitTestVisible="True"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Panel.ZIndex="9999"/>
    </Grid>
</Window>
