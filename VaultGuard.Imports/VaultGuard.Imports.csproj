<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress NU1608: Pomelo.EntityFrameworkCore.MySql (transitive) has no EF Core 10 build yet and
         constrains Relational to 9.x. Matches Services/Web/API/DAL.MySql. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultGuard.Models\VaultGuard.Models.csproj" />
    <ProjectReference Include="..\VaultGuard.Services\VaultGuard.Services.csproj" />
  </ItemGroup>

</Project>
