{
  "Api": {
    "BaseUrl": "https://localhost:7001",
    "TimeoutMinutes": 5
  },
  "Sync": {
    "EnableAutoSync": true,
    "SyncOnStartup": true,
    "SyncIntervalMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "VaultGuard.App.Services": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "DatabaseProvider": "sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "SqlServerConnection": "Server=localhost;Database=VaultGuard;User Id=sa;Password=your_password;",
    "MySqlConnection": "Server=localhost;Database=VaultGuard;User=root;Password=your_password;",
    "PostgresConnection": "Host=localhost;Database=VaultGuard;Username=postgres;Password=your_password;",
    "SqliteConnection": "Data Source=VaultGuard.db"
  },
  "EncryptionSettings": {
    "KeyDerivationIterations": 100000
  },
  "ExceptionReporting": {
    "SentryDsn": ""
  }
}
