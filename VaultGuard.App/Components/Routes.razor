<Router AppAssembly="@typeof(MauiProgram).Assembly"
        AdditionalAssemblies="new[] { typeof(VaultGuard.Components.Shared._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(VaultGuard.Components.Shared.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        @{
            NavigationManager.NavigateTo("/masterpassword", replace: true);
        }
    </NotFound>
</Router>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
