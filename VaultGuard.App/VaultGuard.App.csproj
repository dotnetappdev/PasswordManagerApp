<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
    <!-- Set target frameworks per host OS.
      On Windows: build BOTH Android and Windows so Visual Studio (on Windows) can deploy to the Android
        emulator/device AND run the Windows app. (The Android workload must be installed — it is.)
      On macOS: build Android, iOS and MacCatalyst targets.
      Elsewhere (CI/Linux): Android only. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) And !$([MSBuild]::IsOSPlatform('osx'))">net10.0-android</TargetFrameworks>
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
        <!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>VaultGuard.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>VaultGuard.App</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.passwordmanager.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

        <!-- Windows Desktop (WinUI) needs a RID scoped to just this TFM - it can't be AnyCPU. Setting
             it here (conditioned on the inner-build's own TargetFramework) instead of passing it via
             CLI keeps it from leaking into the Android inner-build's own restore, which otherwise
             tries (and fails) to resolve a win-x64 flavored Mono runtime pack. -->
        <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
        <AndroidResource Remove="Components\Pages\Admin\**" />
        <Compile Remove="Components\Pages\Admin\**" />
        <Content Remove="Components\Pages\Admin\**" />
        <EmbeddedResource Remove="Components\Pages\Admin\**" />
        <MauiXaml Remove="Components\Pages\Admin\**" />
        <None Remove="Components\Pages\Admin\**" />
        <Content Remove="Components\Pages\Home.razor" />
        <Content Remove="Components\Pages\Login.razor" />
        
        <!-- Configuration files -->
        <MauiAsset Include="appsettings.json" />
    </ItemGroup>
  <Target Name="CopyProviderPlugins" AfterTargets="Build">
    <!-- Ensure plugin subfolders exist and copy provider DLLs -->
    <MakeDir Directories="$(OutputPath)plugins\SqlServer" />
    <MakeDir Directories="$(OutputPath)plugins\MySql" />
    <MakeDir Directories="$(OutputPath)plugins\Postgres" />
    <Copy SourceFiles="$(SolutionDir)VaultGuard.DAL.SqlServer\bin\$(Configuration)\net10.0\VaultGuard.DAL.SqlServer.dll" DestinationFolder="$(OutputPath)plugins\SqlServer" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.DAL.SqlServer\bin\$(Configuration)\net10.0\VaultGuard.DAL.SqlServer.dll')" />
    <Copy SourceFiles="$(SolutionDir)VaultGuard.DAL.MySql\bin\$(Configuration)\net10.0\VaultGuard.DAL.MySql.dll" DestinationFolder="$(OutputPath)plugins\MySql" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.DAL.MySql\bin\$(Configuration)\net10.0\VaultGuard.DAL.MySql.dll')" />
    <Copy SourceFiles="$(SolutionDir)VaultGuard.DAL.Postgres\bin\$(Configuration)\net10.0\VaultGuard.DAL.Postgres.dll" DestinationFolder="$(OutputPath)plugins\Postgres" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.DAL.Postgres\bin\$(Configuration)\net10.0\VaultGuard.DAL.Postgres.dll')" />
    <!-- Write plugin.json for each provider -->
    <WriteLinesToFile File="$(OutputPath)plugins\SqlServer\plugin.json" Lines="{&quot;name&quot;:&quot;SqlServer&quot;,&quot;type&quot;:&quot;provider&quot;,&quot;enabled&quot;:true,&quot;description&quot;:&quot;SQL Server EF Core provider plugin.&quot;}" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)plugins\MySql\plugin.json" Lines="{&quot;name&quot;:&quot;MySql&quot;,&quot;type&quot;:&quot;provider&quot;,&quot;enabled&quot;:true,&quot;description&quot;:&quot;MySQL EF Core provider plugin.&quot;}" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)plugins\Postgres\plugin.json" Lines="{&quot;name&quot;:&quot;Postgres&quot;,&quot;type&quot;:&quot;provider&quot;,&quot;enabled&quot;:true,&quot;description&quot;:&quot;PostgreSQL EF Core provider plugin.&quot;}" Overwrite="true" />
    <!-- Imports: ensure folder and copy DLLs -->
    <MakeDir Directories="$(OutputPath)plugins\imports" />
    <Copy SourceFiles="$(SolutionDir)VaultGuard.Imports\bin\$(Configuration)\net10.0\VaultGuard.Imports.dll" DestinationFolder="$(OutputPath)plugins\imports" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuard.Imports\bin\$(Configuration)\net10.0\VaultGuard.Imports.dll')" />
    <Copy SourceFiles="$(SolutionDir)VaultGuardImports.1Password\bin\$(Configuration)\net10.0\VaultGuardImports.1Password.dll" DestinationFolder="$(OutputPath)plugins\imports" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)VaultGuardImports.1Password\bin\$(Configuration)\net10.0\VaultGuardImports.1Password.dll')" />
    <WriteLinesToFile File="$(OutputPath)plugins\imports\VaultGuard.Imports.plugin.json" Lines="{&quot;name&quot;:&quot;Imports&quot;,&quot;type&quot;:&quot;import&quot;,&quot;enabled&quot;:true,&quot;description&quot;:&quot;Core import plugin.&quot;}" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)plugins\imports\VaultGuardImports.1Password.plugin.json" Lines="{&quot;name&quot;:&quot;1Password&quot;,&quot;type&quot;:&quot;import&quot;,&quot;enabled&quot;:true,&quot;description&quot;:&quot;1Password import plugin.&quot;}" Overwrite="true" />
  </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.80" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
        <PackageReference Include="Sentry.Maui" Version="6.6.0" />
        <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.1.30" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\VaultGuard.DAL\VaultGuard.DAL.csproj" />
      <ProjectReference Include="..\VaultGuard.Models\VaultGuard.Models.csproj" />
      <ProjectReference Include="..\VaultGuard.Services\VaultGuard.Services.csproj" />
      <ProjectReference Include="..\VaultGuard.Imports\VaultGuard.Imports.csproj" />
      <ProjectReference Include="..\VaultGuardImports.1Password\VaultGuardImports.1Password.csproj" />
      <ProjectReference Include="..\VaultGuard.Crypto\VaultGuard.Crypto.csproj" />
      <ProjectReference Include="..\VaultGuard.Components.Shared\VaultGuard.Components.Shared.csproj" />
      <ProjectReference Include="..\VaultGuard.ExceptionReporting\VaultGuard.ExceptionReporting.csproj" />
      <ProjectReference Include="..\VaultGuard.ExceptionReporting.Sentry\VaultGuard.ExceptionReporting.Sentry.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Components\Pages\" />
    </ItemGroup>

</Project>
