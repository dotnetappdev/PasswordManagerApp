@page "/signup"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Create account - VaultGuard Admin</PageTitle>

<MudPaper Class="pa-8" Width="420px" Elevation="4">
    <MudText Typo="Typo.h5" Class="mb-1">Create an account</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
        This creates a normal VaultGuard account. An existing SuperAdmin must grant you the
        <strong>SuperAdmin</strong> role (Users page) before you can sign in here.
    </MudText>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
    }

    <form method="post" action="/admin-auth/register">
        <AntiforgeryToken />
        <div class="mb-3">
            <label for="email" style="display:block;margin-bottom:4px;">Email</label>
            <input id="email" name="email" type="email" style="width:100%;padding:8px;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;" required />
        </div>
        <div class="mb-3">
            <label for="password" style="display:block;margin-bottom:4px;">Password</label>
            <input id="password" name="password" type="password" minlength="8" style="width:100%;padding:8px;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;" required />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
            Create account
        </MudButton>
    </form>

    <MudText Typo="Typo.body2" Class="mt-4">
        Already have access? <MudLink Href="/login">Sign in</MudLink>
    </MudText>
</MudPaper>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
