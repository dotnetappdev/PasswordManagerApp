@page "/login"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in - VaultGuard Admin</PageTitle>

<MudPaper Class="pa-8" Width="420px" Elevation="4">
    <MudText Typo="Typo.h5" Class="mb-1">VaultGuard Admin</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">Sign in with a SuperAdmin account.</MudText>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
    }
    @if (Registered)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Account created. Ask an existing SuperAdmin to grant you the SuperAdmin role, then sign in.
        </MudAlert>
    }

    <form method="post" action="/admin-auth/login">
        <AntiforgeryToken />
        <div class="mb-3">
            <label for="email" style="display:block;margin-bottom:4px;">Email</label>
            <input id="email" name="email" type="email" style="width:100%;padding:8px;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;" required />
        </div>
        <div class="mb-3">
            <label for="password" style="display:block;margin-bottom:4px;">Password</label>
            <input id="password" name="password" type="password" style="width:100%;padding:8px;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;" required />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
            Sign in
        </MudButton>
    </form>

    <MudText Typo="Typo.body2" Class="mt-4">
        No account? <MudLink Href="/signup">Create one</MudLink>
    </MudText>
</MudPaper>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public bool Registered { get; set; }
}
