@inject AdminApiClient Api

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }
        @if (_issued is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">
                License issued: <code>@_issued.KeyCode</code>
                @if (_mode == AssignMode.User)
                {
                    <span> and assigned to @_selectedUser?.Email — an active subscription was created for them automatically.</span>
                }
                else if (_mode == AssignMode.Tenant)
                {
                    <span> for tenant @_selectedTenant?.Name — an org-wide license.</span>
                }
                else
                {
                    <span> — copy this now and send it to the customer.</span>
                }
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Who is this license for?</MudText>
            <MudRadioGroup T="AssignMode" @bind-Value="_mode" Class="mb-3">
                <MudRadio T="AssignMode" Value="AssignMode.Email" Dense="true">By email (self-activate)</MudRadio>
                <MudRadio T="AssignMode" Value="AssignMode.User" Dense="true">An existing account</MudRadio>
                <MudRadio T="AssignMode" Value="AssignMode.Tenant" Dense="true">A tenant (org-wide)</MudRadio>
            </MudRadioGroup>

            @if (_mode == AssignMode.User)
            {
                <MudAutocomplete T="UserDto" Label="User" @bind-Value="_selectedUser"
                                 SearchFunc="SearchUsers" ToStringFunc="@(u => u == null ? "" : $"{u.Email} ({u.FirstName} {u.LastName})")"
                                 Variant="Variant.Outlined" Class="mb-3" Required="true"
                                 ResetValueOnEmptyText="true" CoerceText="false" />
            }
            else if (_mode == AssignMode.Tenant)
            {
                <MudSelect T="TenantResponse" @bind-Value="_selectedTenant" Label="Tenant" Variant="Variant.Outlined" Class="mb-3" Required="true"
                           ToStringFunc="@(t => t?.Name ?? "")">
                    @foreach (var tenant in _tenants)
                    {
                        <MudSelectItem T="TenantResponse" Value="@tenant">@tenant.Name (@tenant.Slug)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField T="string" @bind-Value="_customerEmail" Label="Customer Email" Variant="Variant.Outlined" Class="mb-3" Required="true" />
                <MudTextField T="string" @bind-Value="_customerName" Label="Customer Name (optional)" Variant="Variant.Outlined" Class="mb-3" />
            }

            <MudSelect T="LicensePlan" @bind-Value="_plan" Label="Plan" Variant="Variant.Outlined" Class="mb-3">
                @foreach (var plan in Enum.GetValues<LicensePlan>())
                {
                    <MudSelectItem T="LicensePlan" Value="@plan">@plan</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField @bind-Value="_maxActivations" Label="Max Activations (devices)" Variant="Variant.Outlined" Min="1" Class="mb-3" />
            <MudDatePicker @bind-Date="_expiresAt" Label="Expires (leave blank for perpetual)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_notes" Label="Notes (optional)" Variant="Variant.Outlined" Lines="2" />
        }
    </DialogContent>
    <DialogActions>
        @if (_issued is not null)
        {
            <MudButton OnClick="Done" Color="Color.Primary">Done</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Issue" Disabled="@(_issuing || !CanIssue)">
                Issue
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TenantResponse? PreselectedTenant { get; set; }

    private enum AssignMode { Email, User, Tenant }

    private AssignMode _mode = AssignMode.Email;
    private List<UserDto> _users = new();
    private UserDto? _selectedUser;
    private List<TenantResponse> _tenants = new();
    private TenantResponse? _selectedTenant;
    private string _customerEmail = "";
    private string? _customerName;
    private LicensePlan _plan = LicensePlan.Pro;
    private int _maxActivations = 1;
    private DateTime? _expiresAt;
    private string? _notes;
    private bool _issuing;
    private string? _error;
    private LicenseKeyResponse? _issued;

    private bool CanIssue => _mode switch
    {
        AssignMode.User => _selectedUser is not null,
        AssignMode.Tenant => _selectedTenant is not null,
        _ => !string.IsNullOrWhiteSpace(_customerEmail)
    };

    protected override async Task OnInitializedAsync()
    {
        _users = await Api.GetUsersAsync();
        _tenants = await Api.GetTenantsAsync();

        if (PreselectedTenant is not null)
        {
            _mode = AssignMode.Tenant;
            _selectedTenant = _tenants.FirstOrDefault(t => t.Id == PreselectedTenant.Id) ?? PreselectedTenant;
        }

        var settings = await Api.GetLicensingSettingsAsync();
        if (settings is not null)
        {
            _plan = settings.DefaultPlan;
            _maxActivations = settings.DefaultMaxActivations;
        }
    }

    private Task<IEnumerable<UserDto>> SearchUsers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(_users.Take(20));
        return Task.FromResult(_users.Where(u =>
            u.Email.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            $"{u.FirstName} {u.LastName}".Contains(value, StringComparison.OrdinalIgnoreCase)).Take(20));
    }

    private async Task Issue()
    {
        _issuing = true;
        _error = null;
        var (success, license, error) = await Api.IssueLicenseAsync(new IssueLicenseRequest
        {
            CustomerEmail = _mode == AssignMode.Email ? _customerEmail : null,
            CustomerName = _mode == AssignMode.Email ? _customerName : null,
            UserId = _mode == AssignMode.User ? _selectedUser?.Id : null,
            TenantId = _mode == AssignMode.Tenant ? _selectedTenant?.Id : null,
            Plan = _plan,
            MaxActivations = _maxActivations,
            ExpiresAt = _expiresAt,
            Notes = _notes
        });
        _issuing = false;

        if (success) _issued = license;
        else _error = error ?? "Could not issue license.";
    }

    private void Done() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
