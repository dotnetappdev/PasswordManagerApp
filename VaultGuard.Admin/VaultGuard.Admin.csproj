<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>vaultguard-admin</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- VaultGuard.Admin is a pure client of VaultGuard.API (a BFF, not a second data layer) — it
         intentionally does not reference VaultGuard.DAL/Crypto/Services. All data access, licensing
         crypto, and business logic stay in the API; this project only needs the shared enums/DTOs. -->
    <PackageReference Include="MudBlazor" Version="8.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultGuard.Models\VaultGuard.Models.csproj" />
  </ItemGroup>

</Project>
