# Docker Environment Variables Configuration
# Copy this file to .env and update with your own values

# SQL Server Configuration
SQL_SA_PASSWORD=YourStrong@Password123

# HTTPS Certificate Configuration (optional)
# Leave empty if using development certificates
CERT_PASSWORD=

# Database Configuration
DATABASE_NAME=PasswordManagerDB

# API Configuration
API_HTTPS_PORT=51650
API_HTTP_PORT=51651

# SQL Server Port
SQL_SERVER_PORT=1433
