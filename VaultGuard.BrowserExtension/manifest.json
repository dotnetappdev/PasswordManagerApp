{
  "manifest_version": 3,
  "name": "Vault Guard Extension",
  "key": "",
  "browser_specific_settings": {
    "gecko": { "id": "vaultguard@dotnetappdevni.com", "strict_min_version": "115.0" }
  },
  "version": "1.1.0",
  "description": "Browser extension for the Vault Guard App - securely autofill login credentials and generate passwords",
  
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "nativeMessaging"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jsQR.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vault Guard",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content.css", "inpage.js", "jsQR.js"],
      "matches": ["<all_urls>"]
    }
  ]
}